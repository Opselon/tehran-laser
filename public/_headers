# Cloudflare Pages/Workers static-asset headers — Tehran Laser PWA

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=604800

# Imagery is content-stable (filenames are not hashed, so keep immutable off)
# — a week of browser caching removes a repeat-visit download of ~2.4 MB.
/images/*
  Cache-Control: public, max-age=604800

# Self-hosted Vazirmatn variable font.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Fontsource ships under /_astro/ (hashed filenames) — safe to pin forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
