{
  "name": "tehran-laser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tehran Laser — premium clinic website, booking platform and admin control center (Astro SSR + Cloudflare Workers + D1)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit && astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "cf:types": "wrangler types",
    "cf:deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tehran-laser-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tehran-laser-db --remote",
    "db:seed:admin": "wrangler d1 execute tehran-laser-db --local --file scripts/seed-dev-admin.sql",
    "hash:password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "astro": "^7.3.5",
    "jalaali-js": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  }
}
