{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tehran-laser",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tehran-laser-db",
      // Owner-account database (created 2026-11-01 during the account migration;
      // see issue #16 and docs/DOMAIN-CUTOVER.md). The previous id 6ded6ab1-…
      // belongs to the workers.dev account the platform is moving away from.
      "database_id": "bcbc46f0-16dd-4aec-82da-8201496b9036",
    },
  ],
  "vars": {
    "BUSINESS_TIMEZONE": "Asia/Tehran",
    // Public origin used for canonical/OG/sitemap URLs. Must be the LIVE origin.
    // tehranlesar.ir is the clinic's custom domain, bound to this worker in the
    // owner's Cloudflare account (TLS verified 2026-11-01). Do NOT set this to
    // https://tehranlaser.ir — that different domain answers from a foreign
    // nginx host and is not under this account's control.
    "SITE_URL": "https://tehranlesar.ir",
  },
}
