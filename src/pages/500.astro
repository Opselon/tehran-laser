---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  title="خطای موقت سرور — کلینیک تهران لیزر"
  description="متأسفانه در پردازش درخواست شما خطایی رخ داده است. لطفاً لحظاتی دیگر تلاش فرمایید."
>
  <section class="section py-5 text-center">
    <div class="container container-sm">
      <div class="error-page-card py-5">
        <div class="error-badge mb-3">خطای سرور</div>
        <h1 class="error-title text-2xl font-bold mb-3">بروز اختلال موقت در ارتباط با سامانه</h1>
        <p class="error-desc text-muted mb-4">
          در حال حاضر سرور قادر به پردازش درخواست شما نیست. همکاران فنی ما در حال رفع اختلال هستند.
        </p>
        <div class="error-actions-group">
          <button type="button" class="btn btn-primary ml-2" onclick="window.location.reload()">
            تلاش مجدد
          </button>
          <a href="/" class="btn btn-outline ml-2">بازگشت به صفحه اصلی</a>
          <a href="tel:+989035555090" class="btn btn-outline" dir="ltr">تماس تلفنی با پذیرش</a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
