---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { createBreadcrumbSchema } from '../lib/seo';
import '../styles/legal.css';

const breadcrumbs = [
  { name: 'صفحه اصلی', url: '/' },
  { name: 'حریم خصوصی', url: '/privacy' },
];

// Generate BreadcrumbList JSON-LD schema for SEO (same pattern as faq.astro)
const breadcrumbJsonLd = createBreadcrumbSchema(breadcrumbs);
---

<PublicLayout
  title="حریم خصوصی و محرمانگی داده‌های بالینی — کلینیک تهران لیزر"
  description="سیاست‌های حفاظت از حریم خصوصی، امنیت پرونده‌های پزشکی و محرمانگی داده‌های بالینی مراجعین در کلینیک تخصصی تهران لیزر پاسداران."
  canonicalUrl="/privacy"
  jsonLd={[breadcrumbJsonLd]}
  theme="dark"
>
  <div class="legal-page-wrapper">
    <Breadcrumbs items={breadcrumbs} />
    <!-- Hero / Header Strip -->
    <header class="legal-hero">
      <div class="container container-sm text-center">
        <div class="legal-badge">
          <Icon name="lock" size={16} />
          <span>منشور رسمی محرمانگی و امانت‌داری پزشکی</span>
        </div>
        <h1 class="legal-hero-title">سیاست حفظ حریم خصوصی و امنیت پرونده‌های پزشکی</h1>
        <p class="legal-hero-subtitle">
          تعهد بنیادین کلینیک تخصصی تهران لیزر به رازداری بالینی، حفاظت سایبری و پاسداری از حریم
          خصوصی مراجعین گرامی
        </p>

        <!-- Metadata bar & Action Toolbar -->
        <div class="legal-meta-strip">
          <div class="meta-item">
            <Icon name="shield" size={14} />
            <span>منطبق با ضوابط محرمانگی سوگند پزشکی</span>
          </div>
          <div class="meta-item">
            <Icon name="checkCircle" size={14} />
            <span>رمزنگاری سرتاسری TLS 1.3 در لایه لبه</span>
          </div>
          <div class="meta-item">
            <Icon name="clock" size={14} />
            <span>مدت زمان مطالعه: ۳ دقیقه</span>
          </div>
        </div>

        <div class="legal-actions-bar">
          <button
            type="button"
            class="btn-print"
            onclick="window.print()"
            aria-label="چاپ یا ذخیره نسخه چاپی منشور حریم خصوصی"
          >
            <Icon name="document" size={16} />
            <span>نسخه قابل چاپ (Print-Ready)</span>
          </button>
          <a
            href="tel:+989035555090"
            class="btn-contact-quick"
            aria-label="تماس با واحد حفاظت اطلاعات کلینیک ۰۹۰۳ ۵۵۵ ۵۰۹۰"
          >
            <Icon name="phone" size={15} />
            <span>
              <bdi dir="ltr">۰۹۰۳ ۵۵۵ ۵۰۹۰</bdi>
            </span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Section -->
    <main class="legal-main-section">
      <div class="container container-sm">
        <!-- Critical Medical Confidentiality Callout (Obsidian-Gold 3D Card) -->
        <section class="privacy-guarantee-alert" aria-label="ضمانت‌نامه رازداری پزشکی">
          <div class="alert-glow"></div>
          <div class="alert-header">
            <div class="alert-icon-box">
              <Icon name="shield" size={24} />
            </div>
            <div>
              <h2 class="alert-title">سوگند رازداری بالینی و منشور پاسداری از داده‌ها</h2>
              <p class="alert-desc">
                کلینیک تهران لیزر محرمانگی سوابق درمان و مشخصات هویتی شما را با بالاترین
                استانداردهای اخلاق پزشکی تضمین می‌نماید:
              </p>
            </div>
          </div>

          <div class="guarantee-grid">
            <div class="guarantee-item">
              <div class="guarantee-icon">
                <Icon name="lock" size={16} />
              </div>
              <div class="guarantee-content">
                <strong>رازداری حرفه‌ای بالینی:</strong>
                <span>
                  اطلاعات پرونده پزشکی، یادداشت‌های اپراتور و تاریخچه جلسات جزء اسرار پزشکی بوده و
                  بدون رضایت شخص یا حکم قضایی صریح افشا نخواهد شد.
                </span>
              </div>
            </div>

            <div class="guarantee-item">
              <div class="guarantee-icon">
                <Icon name="shield" size={16} />
              </div>
              <div class="guarantee-content">
                <strong>عدم فروش یا واگذاری تجاری:</strong>
                <span>
                  شماره تماس و داده‌های فردی مراجعین به هیچ عنوان در اختیار هیچ آژانس تبلیغاتی،
                  بازاریاب شخص ثالث یا سامانه خارجی قرار نمی‌گیرد.
                </span>
              </div>
            </div>

            <div class="guarantee-item">
              <div class="guarantee-icon">
                <Icon name="database" size={16} />
              </div>
              <div class="guarantee-content">
                <strong>رمزنگاری دیتابیس در لبه ابری:</strong>
                <span>
                  کلیه اطلاعات بر روی زیرساخت محافظت‌شده کلودفلر با استاندارد امنیتی پیشرفته و
                  دسترسی‌های لایه‌بندی‌شده ذخیره‌سازی می‌گردند.
                </span>
              </div>
            </div>

            <div class="guarantee-item">
              <div class="guarantee-icon">
                <Icon name="checkCircle" size={16} />
              </div>
              <div class="guarantee-content">
                <strong>حق ویرایش و لغو پیامک‌ها:</strong>
                <span>
                  هر مراجعه‌کننده اختیار تام دارد در هر زمان با ارسال پیامک یا تماس با کلینیک،
                  دریافت اعلان‌های یادآوری را متوقف یا اطلاعات خود را اصلاح کند.
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- Medical-Consent Callout Card (informed consent for clinical data) -->
        <section
          class="privacy-guarantee-alert consent-card"
          aria-label="رضایت‌نامه آگاهانه پردازش داده‌های بالینی"
        >
          <div class="alert-glow"></div>
          <div class="alert-header">
            <div class="alert-icon-box">
              <Icon name="document" size={24} />
            </div>
            <div>
              <h2 class="alert-title">رضایت آگاهانه پزشکی برای پردازش داده‌های بالینی</h2>
              <p class="alert-desc">
                با ثبت هر نوبت، شما اذعان می‌دارید که موارد زیر را خوانده، فهمیده و پذیرفته‌اید:
              </p>
            </div>
          </div>

          <div class="guarantee-grid">
            <div class="guarantee-item">
              <div class="guarantee-icon">
                <Icon name="checkCircle" size={16} />
              </div>
              <div class="guarantee-content">
                <strong>افشای محدود بالینی:</strong>
                <span>
                  تیپ پوستی، سوابق دارویی و پارامترهای هر جلسه تنها در پرونده بالینی شما ثبت و فقط
                  در اختیار اپراتور مسئول و مدیر کلینیک قرار می‌گیرد.
                </span>
              </div>
            </div>

            <div class="guarantee-item">
              <div class="guarantee-icon">
                <Icon name="shield" size={16} />
              </div>
              <div class="guarantee-content">
                <strong>صداق اطلاعات اعلامی:</strong>
                <span>
                  پنهان‌کاری درباره بارداری، مصرف راکوتان، حساسیت‌ها یا داروهای حساس‌کننده نور،
                  رضایت شما را باطل و جلسه را لغو می‌کند.
                </span>
              </div>
            </div>

            <div class="guarantee-item">
              <div class="guarantee-icon">
                <Icon name="lock" size={16} />
              </div>
              <div class="guarantee-content">
                <strong>حق انصراف در هر زمان:</strong>
                <span>
                  می‌توانید هر لحظه با تماس با پذیرش، از ادامه درمان یا پیامک‌های یادآوری انصراف
                  دهید و خواستار امحای اطلاعات هویتی طبق قانون شوید.
                </span>
              </div>
            </div>

            <div class="guarantee-item">
              <div class="guarantee-icon">
                <Icon name="warning" size={16} />
              </div>
              <div class="guarantee-content">
                <strong>اقارب زیر ۱۸ سال:</strong>
                <span>
                  حضور ولی قانونی در جلسه اول الزامی است و امضای دیجیتال این رضایت‌نامه از سوی ایشان
                  انجام می‌پذیرد.
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- Structured Legal Accordions Group -->
        <section class="legal-accordions-container" aria-label="فهرست اصول حریم خصوصی">
          <!-- Accordion 1 -->
          <details class="legal-accordion" open>
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۱</span>
                <span class="accordion-title">
                  اطلاعاتی که از مراجعین جمع‌آوری و نگهداری می‌شود
                </span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                کلینیک تخصصی تهران لیزر به اصل «کمینه‌سازی داده‌ها» (Data Minimization) پایبند است؛
                ما تنها داده‌هایی را ثبت می‌کنیم که برای فرآیند نوبت‌دهی، محاسبات بالینی و سلامت
                فردی شما حیاتی هستند:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>اطلاعات تماس و هویت:</strong> نام، نام خانوادگی و شماره تلفن همراه فعال
                  جهت تشکیل پرونده بالینی و ارسال پیامک‌های سیستمی تأیید نوبت.
                </li>
                <li>
                  <strong>اطلاعات بالینی پوست و مو:</strong> تعیین تیپ پوستی فیتزپاتریک (Fitzpatrick
                  Skin Type I-VI)، ضخامت و تراکم تار مو، سابقه سوختگی، حساسیت‌های پوستی و سوابق مصرف
                  راکوتان.
                </li>
                <li>
                  <strong>سوابق تنظیمی جلسات (Laser Parameters):</strong> ژول بر سانتی‌متر مربع
                  (Fluence)، عرض پالس (Pulse Duration)، اندازه سَری (Spot Size) و میزان سرمایش
                  پیوسته در هر جلسه جهت کالیبراسیون دقیق جلسات بعد.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 2 -->
          <details class="legal-accordion" open>
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۲</span>
                <span class="accordion-title">
                  اهداف و موارد استفاده از داده‌ها در فرآیند درمان
                </span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                داده‌های بالینی ذخیره‌شده صرفاً در چرخه مراقبت و ارتقای ایمنی درمانی شما استفاده
                می‌شوند:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>کالیبراسیون ایمن دستگاه:</strong> مقایسه پاسخ پوست در جلسه پیشین با جلسه
                  جاری و تنظیم دقیق توان لیزر برای دستیابی به حداکثر ریزش مو بدون آسیب به ملانین
                  پوست.
                </li>
                <li>
                  <strong>یادآوری‌های ضروری:</strong> ارسال پیامک خودکار ۲۴ ساعت پیش از جلسه شامل
                  یادآوری ساعت نوبت و نکات الزامی شیو موضع.
                </li>
                <li>
                  <strong>پیگیری بعد از درمان (Follow-up):</strong> ارتباط با مراجع جهت سنجش وضعیت
                  پوست و پاسخگویی به هرگونه ابهام دارویی یا مراقبتی پس از لیزر.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 3 -->
          <details class="legal-accordion">
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۳</span>
                <span class="accordion-title">تدابیر فنی، سایبری و امنیت سوابق</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                حفاظت از اطلاعات مراجعین از طریق چند لایه امنیتی فیزیکی و نرم‌افزاری اجرا می‌شود:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>کنترل دسترسی نقش‌محور (RBAC):</strong> پرسنل پذیرش تنها به اطلاعات تماس و
                  زمان‌بندی دسترسی دارند؛ پرونده‌های فیزیولوژیک فقط در اختیار اپراتور مسئول و مدیر
                  کلینیک قرار دارد.
                </li>
                <li>
                  <strong>رمزنگاری سراسری:</strong> کلیه تبادلات شبکه با گواهینامه SSL معتبر و
                  پروتکل امنیتی TLS 1.3 انجام و دیتابیس در برابر حملات تزریق و نفوذ ایزوله شده است.
                </li>
                <li>
                  <strong>تفکیک پایگاه داده مالی از پرونده پزشکی:</strong> سوابق تراکنش‌ها و
                  کارت‌خوان بانکی در لایه‌ای کاملاً مستقل از تاریخچه درمانی مراجعین ذخیره می‌گردد.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 4 -->
          <details class="legal-accordion">
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۴</span>
                <span class="accordion-title">سیاست پیامک‌ها و حریم ارتباطات مراجعین</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                ما برای آرامش خاطر مراجعین احترام کامل قائل هستیم و ضوابط سفت و سختی برای ارتباطات
                متنی وضع نموده‌ایم:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>عدم ارسال پیام در ساعات استراحت:</strong> هیچ پیامکی از خطوط اختصاصی
                  کلینیک قبل از ساعت ۹ صبح و بعد از ساعت ۲۰ عصر ارسال نخواهد شد.
                </li>
                <li>
                  <strong>لغو عضویت فوری:</strong> در صورتی که مایل به دریافت اطلاعیه‌های
                  جشنواره‌های فصلی نیستید، کافی است با شماره کلینیک تماس گرفته یا واژه «لغو» را به
                  سامانه پیامکی ما ارسال فرمایید.
                </li>
                <li>
                  <strong>پیام‌های حیاتی نوبت:</strong> پیام‌های مربوط به کد تایید رزرو، تاخیر
                  احتمالی کادر یا لغو وقت حتی در صورت مسدودی پیامک‌های تبلیغاتی توسط خط شما، از طریق
                  سرشماره خدماتی ارسال می‌گردد.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 5 -->
          <details class="legal-accordion">
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۵</span>
                <span class="accordion-title">حقوق مراجعین و شیوه اصلاح اطلاعات</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                هر مراجعه‌کننده کلینیک تهران لیزر طبق قانون حقوق بیمار و ضوابط نظام پزشکی از حقوق
                زیر برخوردار است:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>حق دسترسی به خلاصه سوابق:</strong> هر مراجع می‌تواند با ارائه کارت شناسایی
                  معتبر، خلاصه پرونده و پارامترهای جلسات گذشته خود را دریافت نماید.
                </li>
                <li>
                  <strong>حق تصحیح اطلاعات:</strong> در صورت تغییر شماره تماس یا بروز بیماری جدید،
                  پرونده در کمتر از چند دقیقه توسط پذیرش به‌روزرسانی خواهد شد.
                </li>
                <li>
                  <strong>امحای پرونده پس از اتمام دوره:</strong> در صورت درخواست رسمی مراجع و پس از
                  سپری شدن دوره قانونی نگهداری اسناد، اطلاعات هویتی از سامانه فعال خارج و بایگانی
                  امن می‌گردد.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 6 -->
          <details class="legal-accordion">
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۶</span>
                <span class="accordion-title">کوکی‌ها و فایل‌های موقت وب‌سایت</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                سایت تهران لیزر از حداقل کوکی‌های ممکن فقط برای بهبود تجربه کاربری استفاده می‌کند:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>کوکی‌های ضروری و عملکردی:</strong> جهت حفظ وضعیت فرآیند رزرو نوبت و سبد
                  خدمات انتخابی در طی یک نشست کاری (Session).
                </li>
                <li>
                  <strong>عدم استفاده از ردیاب‌های جاسوسی:</strong> ما از هیچ اسکریپت ردیابی رفتار
                  کاربر برای فروش آمار به شبکه‌های تبلیغاتی استفاده نمی‌کنیم.
                </li>
              </ul>
            </div>
          </details>
        </section>

        <!-- Bottom Assistance Card -->
        <div class="legal-support-card">
          <div class="support-card-content">
            <div class="support-icon">
              <Icon name="lock" size={28} />
            </div>
            <div>
              <h3 class="support-title">پرسشی درباره حریم خصوصی و امنیت داده‌ها دارید؟</h3>
              <p class="support-desc">
                تیم مدیریت و حراست کلینیک تهران لیزر در ساعات کاری آماده پاسخگویی به ابهامات شما
                عزیزان است.
              </p>
            </div>
          </div>
          <div class="support-actions">
            <a href="tel:+989035555090" class="btn-gold-primary">
              <Icon name="phone" size={16} />
              <span>تماس با مسئول حریم خصوصی</span>
            </a>
            <a href="/booking" class="btn-obsidian-secondary">
              <Icon name="calendar" size={16} />
              <span>رزرو آنلاین نوبت</span>
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</PublicLayout>

<!-- Legal/compliance styling lives in src/styles/legal.css (shared by
     privacy + terms). Kept out of the page so both documents cannot drift. -->
