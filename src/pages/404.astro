---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/404.css';
---

<PublicLayout
  title="صفحه پیدا نشد (خطای ۴۰۴) — کلینیک تهران لیزر"
  description="متأسفانه صفحه مورد نظر شما در سایت کلینیک تهران لیزر یافت نشد. می‌توانید از طریق بخش‌های زیر به رزرو نوبت یا صفحه اصلی مراجعه فرمایید."
  noindex={true}
  theme="dark"
>
  <div class="error-page-wrapper">
    <!-- <div> not <main>: PublicLayout already renders <main id="mainContent">
         around this slot, and a nested <main> is an invalid duplicate landmark. -->
    <div class="error-main-container">
      <div class="container container-sm text-center">

        <!-- 3D Obsidian-Gold Illustration Component -->
        <div class="illustration-wrapper" aria-hidden="true">
          <div class="glow-orb"></div>
          <svg class="svg-3d-404" viewBox="0 0 480 260" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- Gold metallic gradients -->
              <linearGradient id="goldGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#a7f3d0" />
                <stop offset="35%" stop-color="#10b981" />
                <stop offset="70%" stop-color="#aa8624" />
                <stop offset="100%" stop-color="#6e5414" />
              </linearGradient>
              <linearGradient id="obsidianGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#1f242d" />
                <stop offset="50%" stop-color="#12151b" />
                <stop offset="100%" stop-color="#0a0b0e" />
              </linearGradient>
              <linearGradient id="laserBeamGrad" x1="0%" y1="50%" x2="100%" y2="50%">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0" />
                <stop offset="50%" stop-color="#34d399" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#aa8624" stop-opacity="0" />
              </linearGradient>
              <filter id="goldGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="8" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- Ground shadow & platform ring -->
            <ellipse cx="240" cy="225" rx="180" ry="24" fill="#000000" opacity="0.6" />
            <ellipse cx="240" cy="220" rx="160" ry="18" stroke="url(#goldGrad1)" stroke-width="1.5" stroke-dasharray="6 8" opacity="0.4" />
            <ellipse cx="240" cy="220" rx="120" ry="12" fill="url(#obsidianGrad)" stroke="rgba(16, 185, 129,0.3)" stroke-width="1" />

            <!-- Isometric Obsidian Monolith / Broken Laser Focal Emitter -->
            <polygon points="240,45 300,80 300,165 240,200 180,165 180,80" fill="url(#obsidianGrad)" stroke="url(#goldGrad1)" stroke-width="2" />
            <!-- Crystal facets -->
            <polygon points="240,45 240,200 300,165 300,80" fill="#151820" opacity="0.7" />
            <polygon points="240,45 240,200 180,165 180,80" fill="#242b38" opacity="0.5" />
            <line x1="240" y1="45" x2="240" y2="200" stroke="#34d399" stroke-width="1.5" opacity="0.7" />

            <!-- Laser refraction rings -->
            <ellipse cx="240" cy="120" rx="45" ry="14" stroke="#34d399" stroke-width="2" opacity="0.8" filter="url(#goldGlow)" />
            <ellipse cx="240" cy="120" rx="70" ry="22" stroke="rgba(16, 185, 129,0.4)" stroke-width="1" stroke-dasharray="4 4" />

            <!-- Laser beam horizontal slice -->
            <path d="M 60 120 L 420 120" stroke="url(#laserBeamGrad)" stroke-width="3" filter="url(#goldGlow)" />

            <!-- Stylized 3D Metallic "404" numbers hovering -->
            <!-- Number 4 (Left) -->
            <g transform="translate(65, 75)">
              <text x="0" y="70" font-family="sans-serif" font-weight="900" font-size="74" fill="#000000" opacity="0.5" dx="4" dy="6">۴</text>
              <text x="0" y="70" font-family="sans-serif" font-weight="900" font-size="74" fill="url(#goldGrad1)" filter="url(#goldGlow)">۴</text>
            </g>

            <!-- Center Target Null Indicator (0) -->
            <g transform="translate(240, 120)">
              <circle cx="0" cy="0" r="18" fill="none" stroke="url(#goldGrad1)" stroke-width="2.5" />
              <line x1="-12" y1="-12" x2="12" y2="12" stroke="#34d399" stroke-width="2" />
            </g>

            <!-- Number 4 (Right) -->
            <g transform="translate(355, 75)">
              <text x="0" y="70" font-family="sans-serif" font-weight="900" font-size="74" fill="#000000" opacity="0.5" dx="4" dy="6">۴</text>
              <text x="0" y="70" font-family="sans-serif" font-weight="900" font-size="74" fill="url(#goldGrad1)" filter="url(#goldGlow)">۴</text>
            </g>

            <!-- Sparkle nodes -->
            <circle cx="100" cy="40" r="2" fill="#fff" opacity="0.8" />
            <circle cx="380" cy="50" r="2.5" fill="#34d399" opacity="0.9" />
            <circle cx="240" cy="20" r="3" fill="#a7f3d0" filter="url(#goldGlow)" />
          </svg>
        </div>

        <!-- Error Identification Header -->
        <div class="error-badge">
          <Icon name="warning" size={15} />
          <span>کد خطا: ۴۰۴ | صفحه یافت نشد</span>
        </div>

        <h1 class="error-title">صفحه مورد نظر در مدار کلینیک قرار ندارد</h1>
        
        <p class="error-subtitle">
          آدرس اینترنتی که وارد نموده‌اید تغییر یافته، حذف شده یا در نشانی آن خطای تایپی وجود دارد.
        </p>

        <!-- Diagnostic Note Card -->
        <div class="diagnostic-card">
          <div class="diagnostic-header">
            <div class="diagnostic-icon">
              <Icon name="info" size={18} />
            </div>
            <div class="diagnostic-title">راهنمای بازگردانی و هدایت بالینی</div>
          </div>
          <p class="diagnostic-text">
            نگران نباشید! هیچ اختلالی در روند رزرو وقت و تعرفه خدمات به وجود نیامده است. جهت دسترسی سریع به بخش مورد نظر خود از میانبرهای زیر استفاده فرمایید:
          </p>

          <!-- Quick Navigation Hub -->
          <div class="quick-nav-grid">
            <a href="/" class="quick-nav-item">
              <span class="nav-item-icon">
                <Icon name="dashboard" size={18} />
              </span>
              <div class="nav-item-info">
                <strong>صفحه اصلی</strong>
                <span>معرفی کلینیک و تجهیزات</span>
              </div>
            </a>

            <a href="/booking" class="quick-nav-item highlighted">
              <span class="nav-item-icon gold">
                <Icon name="calendar" size={18} />
              </span>
              <div class="nav-item-info">
                <strong>رزرو آنلاین نوبت</strong>
                <span>تخفیف ویژه جشنواره پاییزه</span>
              </div>
            </a>

            <a href="/services" class="quick-nav-item">
              <span class="nav-item-icon">
                <Icon name="services" size={18} />
              </span>
              <div class="nav-item-info">
                <strong>تعرفه‌ها و خدمات</strong>
                <span>لیست قیمت الکساندرایت</span>
              </div>
            </a>

            <a href="/contact" class="quick-nav-item">
              <span class="nav-item-icon">
                <Icon name="phone" size={18} />
              </span>
              <div class="nav-item-info">
                <strong>تماس و آدرس</strong>
                <span>لوکیشن پاسداران و تلفن</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Primary Action Buttons -->
        <div class="error-actions-group">
          <a href="/" class="btn-primary-3d">
            <Icon name="arrowRight" size={18} />
            <span>بازگشت به صفحه اصلی</span>
          </a>
          <a href="/booking" class="btn-secondary-3d">
            <Icon name="calendar" size={18} />
            <span>رزرو آنلاین نوبت لیزر</span>
          </a>
          <a href="tel:+989035555090" class="btn-phone-quick" aria-label="تماس با پذیرش کلینیک ۰۹۰۳ ۵۵۵ ۵۰۹۰">
            <Icon name="phone" size={16} />
            <span><bdi dir="ltr">۰۹۰۳ ۵۵۵ ۵۰۹۰</bdi></span>
          </a>
        </div>

      </div>
    </div>
  </div>
</PublicLayout>

