import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  title="قوانین و مقررات نوبت‌دهی — کلینیک تهران لیزر"
  description="شرایط و قوانین حضور در کلینیک، لغو و تغییر زمان نوبت و تعهدات مراجعین و کلینیک تهران لیزر پاسداران."
>
  <div class="page-header-strip">
    <div class="container container-sm text-center">
      <h1 class="page-title">قوانین و ضوابط نوبت‌دهی</h1>
      <p class="page-subtitle">ضوابط حضور در کلینیک و فرآیند لغو و جابجایی نوبت‌ها</p>
    </div>
  </div>

  <section class="section">
    <div class="container container-sm">
      <div class="legal-content-card">
        <h3 class="font-bold mb-3">۱. زمان حضور در کلینیک</h3>
        <p class="leading-relaxed mb-4">
          خواهشمند است حداقل ۱۰ دقیقه پیش از ساعت رزرو در کلینیک حضور به هم رسانید تا فرآیند تشکیل پرونده و آماده‌سازی بدون تعجیل و تأخیر انجام گیرد. در صورت تأخیر بیش از ۱۵ دقیقه، ممکن است جهت حفظ نوبت سایر مراجعین، زمان شما با هماهنگی به ساعت دیگری موکول گردد.
        </p>

        <h3 class="font-bold mb-3">۲. شرایط لغو و تغییر زمان (Reschedule)</h3>
        <p class="leading-relaxed mb-4">
          در صورت بروز هرگونه پیشامد غیرمنتظره و نیاز به لغو یا جابجایی نوبت، خواهشمند است حداقل ۲۴ ساعت پیش از موعد مقرر، از طریق تماس تلفنی با پذیرش به شماره <a href="tel:+989035555090" dir="ltr">+98 903 555 5090</a> هماهنگی لازم را به عمل آورید.
        </p>

        <h3 class="font-bold mb-3">۳. تعهدات بهداشتی مراجعین</h3>
        <p class="leading-relaxed">
          مراجعین محترم موظف به رعایت نکات آمادگی اعلام‌شده (شیو ۲۴ ساعت قبل با ژیلت، عدم مصرف لوسیون و عطر روی موضع) هستند. در صورت وجود سوختگی، زخم باز یا مصرف داروهای خاص، اپراتور حق تعویق جلسه را تا رفع منع پزشکی محفوظ می‌دارد.
        </p>
      </div>
    </div>
  </section>
</PublicLayout>
