---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { createBreadcrumbSchema } from '../lib/seo';

// Generate BreadcrumbList JSON-LD schema for SEO (same pattern as faq.astro)
const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
  { name: 'قوانین و مقررات', url: '/terms' },
]);
---

<PublicLayout
  title="قوانین و مقررات نوبت‌دهی و رضایت‌نامه پزشکی — کلینیک تهران لیزر"
  description="شرایط و قوانین حضور در کلینیک، ضوابط لغو و جابجایی نوبت، منشور بهداشتی و رضایت‌نامه آگاهانه خدمات لیزر موهای زائد تهران لیزر پاسداران."
  canonicalUrl="/terms"
  jsonLd={[breadcrumbJsonLd]}
  theme="dark"
>
  <div class="legal-page-wrapper">
    <!-- Hero / Header Strip -->
    <header class="legal-hero">
      <div class="container container-sm text-center">
        <div class="legal-badge">
          <Icon name="shield" size={16} />
          <span>سند رسمی ضوابط و منشور بالینی</span>
        </div>
        <h1 class="legal-hero-title">قوانین و مقررات نوبت‌دهی و رضایت‌نامه پزشکی</h1>
        <p class="legal-hero-subtitle">
          منشور شفاف تعهدات متقابل مراجعین گرامی و کادر درمانی کلینیک تخصصی تهران لیزر (پاسداران)
        </p>
        
        <!-- Metadata bar & Action Toolbar -->
        <div class="legal-meta-strip">
          <div class="meta-item">
            <Icon name="document" size={14} />
            <span>نسخه مصوب: ۲.۴ (مهر ۱۴۰۵)</span>
          </div>
          <div class="meta-item">
            <Icon name="checkCircle" size={14} />
            <span>منطبق با ضوابط سازمان نظام پزشکی</span>
          </div>
          <div class="meta-item">
            <Icon name="clock" size={14} />
            <span>مدت زمان مطالعه: ۴ دقیقه</span>
          </div>
        </div>

        <div class="legal-actions-bar">
          <button type="button" class="btn-print" onclick="window.print()" aria-label="چاپ یا ذخیره نسخه چاپی قوانین">
            <Icon name="document" size={16} />
            <span>نسخه قابل چاپ (Print-Ready)</span>
          </button>
          <a href="tel:+989035555090" class="btn-contact-quick" dir="ltr" aria-label="تماس با پذیرش کلینیک">
            <Icon name="phone" size={15} />
            <span>۰۹۰۳ ۵۵۵ ۵۰۹۰</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Section -->
    <main class="legal-main-section">
      <div class="container container-sm">

        <!-- Critical Medical Notice Callout (Obsidian-Gold 3D Card) -->
        <section class="medical-consent-alert" aria-label="نکات حیاتی و منع پزشکی لیزر">
          <div class="alert-glow"></div>
          <div class="alert-header">
            <div class="alert-icon-box">
              <Icon name="warning" size={24} />
            </div>
            <div>
              <h2 class="alert-title">نکات حیاتی پیش از درمان (چک‌لیست منع پزشکی)</h2>
              <p class="alert-desc">مراجعه‌کننده محترم، شروع فرآیند لیزر منوط به عدم وجود موارد زیر در پرونده بالینی شماست:</p>
            </div>
          </div>

          <div class="alert-grid">
            <div class="alert-item">
              <div class="alert-item-bullet">
                <Icon name="shield" size={16} />
              </div>
              <div class="alert-item-content">
                <strong>داروهای حساس‌کننده (راکوتان / ایزوترتینوئین):</strong>
                <span>حداقل ۶ ماه باید از آخرین مصرف قرص راکوتان سپری شده باشد. در صورت مصرف، جلسه لیزر به تعویق می‌افتد.</span>
              </div>
            </div>

            <div class="alert-item">
              <div class="alert-item-bullet">
                <Icon name="shield" size={16} />
              </div>
              <div class="alert-item-content">
                <strong>برنزه‌سازی (سولاریوم، حمام آفتاب و لوسیون):</strong>
                <span>پوست باید کاملاً به رنگ پایه بازگشته باشد (حداقل ۴ تا ۶ هفته فاصله). انجام لیزر روی پوست برنزه ممنوع و خطرناک است.</span>
              </div>
            </div>

            <div class="alert-item">
              <div class="alert-item-bullet">
                <Icon name="shield" size={16} />
              </div>
              <div class="alert-item-content">
                <strong>دوران بارداری و شیردهی:</strong>
                <span>انجام لیزر در دوران بارداری به صورت کامل منع شده است. در دوران شیردهی نیازمند تاییدیه کتبی پزشک متخصص است.</span>
              </div>
            </div>

            <div class="alert-item">
              <div class="alert-item-bullet">
                <Icon name="shield" size={16} />
              </div>
              <div class="alert-item-content">
                <strong>اصلاح صحیح موضع (شیو با ژیلت):</strong>
                <span>حداقل ۴ هفته از آخرین اپیلاسیون، وکس، بند یا موچین گذشته باشد و تنها ۲۴ ساعت قبل از جلسه با تیغ ژیلت اصلاح شود.</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Structured Legal Accordions Group -->
        <section class="legal-accordions-container" aria-label="فهرست کامل مقررات">
          
          <!-- Accordion 1 -->
          <details class="legal-accordion" open>
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۱</span>
                <span class="accordion-title">زمان‌بندی حضور، پذیرش و سیاست تأخیر</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                جهت حفظ انضباط اتاق‌های لیزر، کالیبراسیون دستگاه الکساندرایت پیش از ورود شما، و تکمیل معاینات بالینی پوست، ضوابط زیر برقرار است:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>حضور به‌موقع:</strong> مراجعین گرامی موظفند حداقل <strong>۱۰ دقیقه پیش از ساعت رزرو</strong> در لابی کلینیک حضور به هم رسانند تا فرآیند پذیرش، سنجش دما و آماده‌سازی موضع بدون استرس انجام پذیرد.
                </li>
                <li>
                  <strong>سیاست تأخیر بیش از ۱۵ دقیقه:</strong> با توجه به زمان‌بندی دقیق نوبت‌های متوالی مراجعین بعدی، در صورت تأخیر بیش از ۱۵ دقیقه، جلسه لغو شده یا با صلاحدید سرپرست کلینیک به انتهای روز موکول خواهد گردید.
                </li>
                <li>
                  <strong>تست شات رایگان:</strong> برای اولین جلسه و تایپ‌های پوستی حساس، انجام تست شات ۲۴ ساعت قبل الزامی است تا حساسیت ملانین سنجیده شود.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 2 -->
          <details class="legal-accordion" open>
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۲</span>
                <span class="accordion-title">شرایط لغو نوبت، تغییر زمان (Reschedule) و ودیعه</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                رزرو نوبت در کلینیک تهران لیزر به معنای تخصیص قطعی اتاق درمانی، کادر اپراتور مجرب و انرژی دستگاه است:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>تغییر یا لغو رایگان (تا ۲۴ ساعت قبل):</strong> مراجعین می‌توانند تا ۲۴ ساعت قبل از موعد مقرر، از طریق سامانه رزرو یا تماس با شماره <a href="tel:+989035555090" class="gold-link" dir="ltr">+98 903 555 5090</a> نوبت خود را بدون هیچ‌گونه جریمه جابجا نمایند.
                </li>
                <li>
                  <strong>لغو کمتر از ۲۴ ساعت یا عدم حضور (No-Show):</strong> در صورت لغو در فاصله کمتر از ۲۴ ساعت یا عدم حضور، ۵۰٪ از مبلغ بیعانه واریزی به عنوان هزینه رزرو اتاق کسر خواهد شد.
                </li>
                <li>
                  <strong>استرداد وجه:</strong> کلیه وجوه قابل استرداد، ظرف ۲۴ الی ۴۸ ساعت اداری به شماره شبای ثبت‌شده به نام همان مراجع واریز خواهد گردید.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 3 -->
          <details class="legal-accordion">
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۳</span>
                <span class="accordion-title">پروتکل‌های بهداشتی، آمادگی قبل و مراقبت‌های بعد</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                اثربخشی پرتوی لیزر و ایمنی بافت پوست وابستگی مستقیمی به رعایت دقیق اصول زیر توسط مراجع محترم دارد:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>پاکیزگی موضع:</strong> پوست ناحیه درمان باید عاری از هرگونه کرم‌پودر، لوسیون، مام، بادی‌اسپلش، عطر و ضدتعریق باشد. وجود مواد آرایشی ممکن است منجر به سوختگی سطحی ناشی از جذب ناهمگن نور گردد.
                </li>
                <li>
                  <strong>شیو اصولی ۲۴ ساعت قبل:</strong> سطح موضع باید کاملاً صاف تراشیده شود تا انرژی نور مستقیماً به ریشه فولیکول اصابت کند و ساقه مو روی سطح نسوزد.
                </li>
                <li>
                  <strong>مراقبت‌های پس از جلسه:</strong> پرهیز از دوش آب گرم، استخر، سونا و تعریق شدید به مدت ۲۴ ساعت. استفاده مستمر از کرم ترمیم‌کننده زینک اکساید و ضدآفتاب بدون رنگ با فاکتور حفاظتی بالا (SPF 50+).
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 4 -->
          <details class="legal-accordion">
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۴</span>
                <span class="accordion-title">موارد منع پزشکی و ارزیابی سلامت فردی</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                سلامت مراجعین اولویت مطلق کلینیک تهران لیزر است. انجام خدمات لیزر در صورت احراز هر یک از شرایط زیر موقتاً یا دائم ممنوع خواهد بود:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>منع قطعی:</strong> بارداری، بیماری‌های پوستی واگیر، تبخال فعال، وجود ضایعات مشکوک یا بدخیمی در موضع، سابقه کلوئیدسازی شدید (گوشت اضافه)، و وجود باتری قلبی (Pacemaker).
                </li>
                <li>
                  <strong>منع موقت و نیازمند مشاوره:</strong> سابقه تشنج بر اثر تحریک نور، مصرف آنتی‌بیوتیک‌های فوتوسنسیتیو (نظیر داکسی‌سایکلین و سیپروفلوکساسین)، و تزریق ژل یا بوتاکس در موضع ظرف ۲ هفته گذشته.
                </li>
                <li>
                  <strong>اختلالات هورمونی:</strong> افراد مبتلا به سندرم تخمدان پلی‌کیستیک (PCOS) یا اختلالات تیروئید باید تحت نظر پزشک غدد باشند؛ اثربخشی بدون کنترل هورمونی محدودتر خواهد بود.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 5 -->
          <details class="legal-accordion">
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۵</span>
                <span class="accordion-title">عوارض طبیعی گذرای لیزر و تعهدات کلینیک</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                کلینیک تهران لیزر با بهره‌گیری از به‌روزترین دستگاه‌های الکساندرایت نوبلکس و کاندلا ۲۰۲۴ مجهز به سیستم کولینگ قوی (DCD) خطرات را به حداقل رسانده است:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>واکنش‌های طبیعی:</strong> اریتم (قرمزی خفیف) و تورم دور فولیکولی (Perifollicular Edema) واکنش طبیعی پوست به تخریب فولیکول بوده و طی ۲ الی ۱۲ ساعت برطرف می‌گردد.
                </li>
                <li>
                  <strong>سَری‌های شخصی و بهداشت استریل:</strong> برای هر مراجعه‌کننده از سَری (اسپات‌سایز) ضدعفونی‌شده و سلفون‌کشی یک‌بار مصرف استفاده می‌شود.
                </li>
                <li>
                  <strong>حضور پزشک و پشتیبانی بالینی:</strong> در صورت بروز هرگونه حساسیت پوستی، معاینه رایگان توسط پزشک مقیم کلینیک انجام و نسخه دارویی مناسب تجویز می‌گردد.
                </li>
              </ul>
            </div>
          </details>

          <!-- Accordion 6 -->
          <details class="legal-accordion">
            <summary class="accordion-summary">
              <div class="summary-left">
                <span class="accordion-number">۰۶</span>
                <span class="accordion-title">رضایت‌نامه آگاهانه، محرمانگی و رسیدگی به شکایات</span>
              </div>
              <span class="accordion-chevron">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="accordion-body">
              <p>
                ثبت رزرو در سامانه تهران لیزر به منزله مطالعه دقیق، درک کامل و امضای دیجیتال این توافق‌نامه است:
              </p>
              <ul class="legal-list">
                <li>
                  <strong>صحت اطلاعات:</strong> مراجع متعهد است سوابق درمانی، دارویی و تغییرات فیزیولوژیک خود را در هر جلسه به طور صادقانه به اپراتور و پزشک اعلام فرماید.
                </li>
                <li>
                  <strong>محرمانگی اسناد:</strong> کلیه پرونده‌ها و سوابق تنظیمی دستگاه‌ها تحت کدینگ امنیتی نظام پزشکی نگهداری و در اختیار هیچ شخص ثالثی قرار نمی‌گیرد.
                </li>
                <li>
                  <strong>انتقادات و پیشنهادات:</strong> واحد نظارت بر حقوق مراجعین کلینیک تهران لیزر به صورت روزانه از طریق شماره تماس ۰۹۰۳ ۵۵۵ ۵۰۹۰ آماده دریافت نظرات و رسیدگی فوری به موضوعات است.
                </li>
              </ul>
            </div>
          </details>

        </section>

        <!-- Bottom Assistance Card -->
        <div class="legal-support-card">
          <div class="support-card-content">
            <div class="support-icon">
              <Icon name="calendar" size={28} />
            </div>
            <div>
              <h3 class="support-title">نیاز به راهنمایی یا مشاوره با پزشک دارید؟</h3>
              <p class="support-desc">کارشناسان پذیرش و پزشکان کلینیک آماده پاسخگویی به ابهامات بالینی و تنظیم وقت مشاوره رایگان هستند.</p>
            </div>
          </div>
          <div class="support-actions">
            <a href="/booking" class="btn-gold-primary">
              <Icon name="sparkles" size={16} />
              <span>رزرو آنلاین نوبت</span>
            </a>
            <a href="/contact" class="btn-obsidian-secondary">
              <Icon name="phone" size={16} />
              <span>تماس و نشانی کلینیک</span>
            </a>
          </div>
        </div>

      </div>
    </main>
  </div>
</PublicLayout>

<style>
  /* ─────────────────────────────────────────────────────────────
     Dark 3D Obsidian-Gold Design System for Legal Pages
     ───────────────────────────────────────────────────────────── */
  .legal-page-wrapper {
    background-color: #0a0b0d;
    color: #e4e7eb;
    min-height: 100vh;
    padding-bottom: 80px;
    font-family: inherit;
    overflow-x: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  /* Hero Section */
  .legal-hero {
    background: radial-gradient(circle at 50% -20%, rgba(16, 185, 129, 0.15) 0%, rgba(10, 11, 13, 0.95) 70%);
    border-bottom: 1px solid rgba(16, 185, 129, 0.18);
    padding: 64px 20px 48px;
    position: relative;
    overflow: hidden;
  }

  .legal-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.5), transparent);
  }

  .legal-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.1);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 20px;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.1);
  }

  .legal-hero-title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.35;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .legal-hero-subtitle {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: #a4abb6;
    line-height: 1.8;
    max-width: 640px;
    margin: 0 auto 28px;
  }

  /* Metadata Strip */
  .legal-meta-strip {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 28px;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.825rem;
    color: #aab2bd;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 6px 14px;
    border-radius: 8px;
  }

  .meta-item svg {
    color: #10b981;
  }

  /* Action Toolbar */
  .legal-actions-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .btn-print {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.05));
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
    padding: 10px 22px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
