---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { env } from 'cloudflare:workers';
import { findPublicServiceBySlug } from '../../server/repositories';
import Icon from '../../components/ui/Icon.astro';
import {
  createMedicalProcedureSchema,
  createBreadcrumbSchema,
} from '../../lib/seo';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/services');

const service = await findPublicServiceBySlug(env.DB, slug);
if (!service) return Astro.redirect('/404');

const femalePrice = service.prices.find((p) => p.pricingCategory === 'female');
const malePrice = service.prices.find((p) => p.pricingCategory === 'male');
const isPromo = service.slug === 'full-body';
const basePrice = femalePrice?.amount ?? 0; // in thousands (IRT)

// Persian number formatter — amounts are stored in thousands of tomans
function formatToman(amountInThousands: number): string {
  return (amountInThousands * 1000).toLocaleString('fa-IR');
}

// Clinical metadata per treatment area (wavelength, sessions, comfort, results).
// Falls back to the Alexandrite 755nm default so every detail page renders
// full clinical context even for slugs added later.
interface AreaMeta {
  wavelength: string;
  wavelengthShort: string;
  sessions: string;
  interval: string;
  painLevel: string;
  results: string;
}

const areaMeta: Record<string, AreaMeta> = {
  'full-body': {
    wavelength: 'الکساندرایت ۷۵۵nm + ان‌دی‌یاگ ۱۰۶۴nm',
    wavelengthShort: 'دو طول موج (Dual)',
    sessions: '۶ الی ۸ جلسه',
    interval: '۶ الی ۸ هفته',
    painLevel: 'بدون درد (کرایو DCD)',
    results: 'کاهش دائمی ۸۵٪ الی ۹۵٪',
  },
  face: {
    wavelength: 'الکساندرایت ۷۵۵nm',
    wavelengthShort: '۷۵۵nm',
    sessions: '۶ الی ۸ جلسه',
    interval: '۴ الی ۵ هفته',
    painLevel: 'بدون درد (کرایو DCD)',
    results: 'کاهش دائمی ۸۵٪ الی ۹۵٪',
  },
  underarm: {
    wavelength: 'الکساندرایت ۷۵۵nm',
    wavelengthShort: '۷۵۵nm',
    sessions: '۶ الی ۸ جلسه',
    interval: '۵ الی ۶ هفته',
    painLevel: 'بدون درد (کرایو DCD)',
    results: 'رفع تیرگی ناشی از شیو',
  },
  bikini: {
    wavelength: 'الکساندرایت ۷۵۵nm',
    wavelengthShort: '۷۵۵nm',
    sessions: '۶ الی ۸ جلسه',
    interval: '۶ الی ۸ هفته',
    painLevel: 'بدون درد (کرایو DCD)',
    results: 'کاهش دائمی ۸۵٪ الی ۹۵٪',
  },
  'full-legs': {
    wavelength: 'الکساندرایت ۷۵۵nm',
    wavelengthShort: '۷۵۵nm',
    sessions: '۶ الی ۸ جلسه',
    interval: '۶ الی ۸ هفته',
    painLevel: 'بدون درد (کرایو DCD)',
    results: 'کاهش دائمی ۸۵٪ الی ۹۵٪',
  },
  'full-arms': {
    wavelength: 'الکساندرایت ۷۵۵nm',
    wavelengthShort: '۷۵۵nm',
    sessions: '۶ الی ۸ جلسه',
    interval: '۵ الی ۷ هفته',
    painLevel: 'بدون درد (کرایو DCD)',
    results: 'کاهش دائمی ۸۵٪ الی ۹۵٪',
  },
};

const meta: AreaMeta =
  areaMeta[service.slug] ?? {
    wavelength: 'الکساندرایت ۷۵۵nm',
    wavelengthShort: '۷۵۵nm',
    sessions: '۶ الی ۸ جلسه',
    interval: '۵ الی ۸ هفته',
    painLevel: 'بدون درد (کرایو DCD)',
    results: 'کاهش دائمی ۸۵٪ الی ۹۵٪',
  };

const promoFinalPrice = 1940; // thousands — matches the /services catalogue offer
const promoOriginalPrice = 2290;
const isDualWavelength =
  meta.wavelengthShort.includes('دو طول موج') || meta.wavelengthShort.includes('Dual');

// Schema.org MedicalProcedure JSON-LD for Candela GentleMax Pro treatments (§31, §135)
// Price must be full tomans: catalogue amounts are stored in thousands.
const serviceJsonLd = createMedicalProcedureSchema({
  name: service.name,
  slug: service.slug,
  description: service.description,
  durationMinutes: service.durationMinutes,
  price: (isPromo ? promoFinalPrice : basePrice) * 1000 || undefined,
});

// BreadcrumbList schema for nested service pages (§31, §135)
const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
  { name: 'خدمات و تعرفه‌ها', url: '/services' },
  { name: service.name, url: `/services/${service.slug}` },
]);

const serviceJsonLdArray = [serviceJsonLd, breadcrumbJsonLd];

const careSteps = [
  'ناحیه مورد نظر را ۲۴ ساعت قبل از مراجعه صرفاً با ژیلت شیو فرمایید.',
  'از حداقل ۲ الی ۴ هفته پیش از جلسه از وکس، اپیلاسیون یا بندانداختن خودداری فرمایید.',
  'پوست ناحیه لیزر باید عاری از هرگونه کرم، لوسیون، مام یا ضدآفتاب باشد.',
  'در صورت مصرف داروهای خاص (مانند راکوتان)، لطفاً به اپراتور کلینیک اطلاع دهید.',
];

const afterCareSteps = [
  'تا ۲۴ ساعت پس از جلسه از دوش آب داغ، سونا و استخر خودداری فرمایید.',
  'از کرم آلوئه‌ورا و زینک اکساید برای تسکین و آبرسانی پوست استفاده کنید.',
  'فعالیت ورزشی سنگین را تا ۲۴ ساعت به تعویق بیندازید.',
  'در معرض تابش مستقیم آفتاب قرار نگیرید و از ضدآفتاب استفاده کنید.',
];
---

<PublicLayout
  title={`لیزر ${service.name} در پاسداران — تعرفه و رزرو | کلینیک تهران لیزر`}
  description={`خدمات تخصصی لیزر ${service.name} در کلینیک تهران لیزر پاسداران. مدت زمان ${service.durationMinutes} دقیقه، اپراتور مجرب، دستگاه خنک‌کننده بدون درد و تعرفه مصوب.`}
  canonicalUrl={`/services/${service.slug}`}
  jsonLd={serviceJsonLdArray}
>
  <!-- 3D Obsidian-Gold Page Header Strip -->
  <section class="detail-hero">
    <div class="container hero-container">
      <nav class="detail-breadcrumbs" aria-label="مسیر صفحه">
        <a href="/">
          <Icon name="chevronLeft" size={13} />
          <span>صفحه اصلی</span>
        </a>
        <span class="bc-sep">/</span>
        <a href="/services">خدمات و تعرفه‌ها</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">{service.name}</span>
      </nav>

      <div class="hero-badge">
        <Icon name="sparkles" size={15} />
        <span>تعرفه مصوب و شفاف — کلینیک تهران لیزر پاسداران</span>
      </div>

      <h1 class="hero-title">
        لیزر تخصصی <span class="gold-gradient">{service.name}</span>
      </h1>
      <p class="hero-subtitle">
        ارائه خدمات با مدرن‌ترین تجهیزات خنک‌کننده و بالاترین استاندارد بهداشتی در منطقه پاسداران
      </p>

      <!-- Candela GentleMax Pro Technology Badges -->
      <div class="tech-badges-strip">
        <div class="tech-badge">
          <Icon name="lightning" size={15} />
          <span>کندلا جنتل‌مکس پرو ۲۰۲۴ (Candela USA)</span>
        </div>
        <div class="tech-badge">
          <Icon name="shield" size={15} />
          <span>طول موج {meta.wavelengthShort} — دستگاه اصل آمریکا</span>
        </div>
        <div class="tech-badge">
          <Icon name="snowflake" size={15} />
          <span>کولینگ کرایو DCD منهای ۳۰ درجه بدون درد</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section detail-section">
    <div class="container detail-grid">
      <!-- ════════════ MAIN: 3D Service Detail Card ════════════ -->
      <div class="service-detail-card">
        <div class="detail-header-row">
          <div class="detail-header-text">
            <span class="badge-gold">
              <Icon name="services" size={13} />
              <span>خدمات پوست و لیزر</span>
            </span>
            <h2 class="service-full-name">{service.name}</h2>
          </div>
          <div class="duration-pill">
            <Icon name="clock" size={15} />
            <span>مدت جلسه:</span>
            <strong>{service.durationMinutes} دقیقه</strong>
          </div>
        </div>

        <p class="service-long-description">{service.description}</p>

        <!-- ════ Obsidian Pricing Tiers (Female / Male) ════ -->
        <div class="pricing-tier-card">
          <div class="tier-card-title">
            <Icon name="wallet" size={17} />
            <span>تعرفه‌های مصوب رزرو آنلاین</span>
          </div>

          <!-- Women's tier -->
          <div class:list={`tier-row ${isPromo ? 'tier-row-promo' : ''}`}>
            <div class="tier-row-head">
              <span class="tier-icon">
                <Icon name="sparkles" size={15} />
              </span>
              <span class="tier-label">تعرفه بخش بانوان</span>
              {isPromo && (
                <span class="tier-promo-chip">
                  <Icon name="star" size={11} />
                  <span>۱۵٪ تخفیف سایت</span>
                </span>
              )}
            </div>
            <div class="tier-value">
              {femalePrice ? (
                isPromo ? (
                  <div class="promo-price-block">
                    <span class="strikethrough-price">{formatToman(promoOriginalPrice)}</span>
                    <span class="promo-final-price">{formatToman(promoFinalPrice)}</span>
                    <span class="price-currency">تومان / هر جلسه</span>
                  </div>
                ) : (
                  <div class="price-block">
                    <span class="final-price">{formatToman(basePrice)}</span>
                    <span class="price-currency">تومان / هر جلسه</span>
                  </div>
                )
              ) : (
                <span class="tier-note">استعلام تلفنی</span>
              )}
            </div>
          </div>

          {femalePrice && (
            <div class="session-cost-note">
              <Icon name="info" size={13} />
              <span>
                هزینه تقریبی دوره کامل (۶ تا ۸ جلسه):{' '}
                <strong>
                  {formatToman((isPromo ? promoFinalPrice : basePrice) * 6)} تا{' '}
                  {formatToman((isPromo ? promoFinalPrice : basePrice) * 8)} تومان
                </strong>
              </span>
            </div>
          )}

          <!-- Men's tier -->
          <div class="tier-row">
            <div class="tier-row-head">
              <span class="tier-icon">
                <Icon name="users" size={15} />
              </span>
              <span class="tier-label">تعرفه بخش آقایان</span>
            </div>
            <div class="tier-value">
              {malePrice ? (
                <div class="price-block">
                  <span class="final-price">{formatToman(malePrice.amount)}</span>
                  <span class="price-currency">تومان / هر جلسه</span>
                </div>
              ) : (
                <span class="tier-note">استعلام قیمت بر اساس تراکم و وسعت در کلینیک یا تماس تلفنی</span>
              )}
            </div>
          </div>

          <div class="tier-foot-note">
            <Icon name="info" size={13} />
            <span>تمامی تعرفه‌ها شامل سری شخصی یکبار مصرف، کولینگ کرایو و نظارت پزشک می‌باشد.</span>
          </div>
        </div>

        <!-- ════ Candela Wavelength Badge ════ -->
        <div class="wavelength-card">
          <div class="wavelength-card-head">
            <Icon name="lightning" size={18} />
            <span>طول موج دستگاه کندلا جنتل‌مکس پرو</span>
          </div>
          <div class="wavelength-badges">
            {isDualWavelength ? (
              <>
                <span class="wave-badge">
                  <Icon name="shield" size={13} />
                  <span>الکساندرایت ۷۵۵nm</span>
                </span>
                <span class="wave-badge">
                  <Icon name="shield" size={13} />
                  <span>ان‌دی‌یاگ Nd:YAG ۱۰۶۴nm</span>
                </span>
              </>
            ) : (
              <span class="wave-badge">
                <Icon name="shield" size={13} />
                <span>{meta.wavelength}</span>
              </span>
            )}
          </div>
          <p class="wavelength-desc">
            طول موج الکساندرایت ۷۵۵ نانومتر با بیشترین میزان جذب ملانین، ریشه‌های موی ضخیم و سیاه را
            هدف قرار می‌دهد؛ همزمان سیستم کولینگ داینامیک (DCD) با شات گاز مبرد منهای ۳۰ درجه،
            پوست را بی‌حس کرده و درد و ریسک سوختگی را به صفر می‌رساند.
          </p>
        </div>

        <!-- ════ Clinical Session Recommendations ════ -->
        <div class="sessions-card">
          <div class="sessions-card-head">
            <Icon name="calendar" size={18} />
            <span>توصیه‌های بالینی تعداد جلسات</span>
          </div>
          <div class="sessions-grid">
            <div class="session-cell">
              <Icon name="calendar" size={16} />
              <span class="cell-label">تعداد جلسات:</span>
              <strong>{meta.sessions}</strong>
            </div>
            <div class="session-cell">
              <Icon name="clock" size={16} />
              <span class="cell-label">فاصله جلسات:</span>
              <strong>{meta.interval}</strong>
            </div>
            <div class="session-cell">
              <Icon name="snowflake" size={16} />
              <span class="cell-label">میزان درد:</span>
              <strong>{meta.painLevel}</strong>
            </div>
            <div class="session-cell">
              <Icon name="award" size={16} />
              <span class="cell-label">نتیجه مورد انتظار:</span>
              <strong>{meta.results}</strong>
            </div>
          </div>
        </div>

        <!-- ════ Preparation ════ -->
        <div class="care-card">
          <div class="care-card-head">
            <div class="icon-circle-gold">
              <Icon name="checkCircle" size={20} />
            </div>
            <div>
              <h3 class="care-title">مراقبت‌های ضروری پیش از جلسه لیزر {service.name}</h3>
              <p class="care-subtitle">رعایت این موارد بازدهی جلسه را به حداکثر می‌رساند</p>
            </div>
          </div>
          <ul class="care-list">
            {careSteps.map((step) => (
              <li>
                <span class="care-check">
                  <Icon name="check" size={12} />
                </span>
                <span>{step}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- ════ Aftercare ════ -->
        <div class="care-card">
          <div class="care-card-head">
            <div class="icon-circle-gold">
              <Icon name="snowflake" size={20} />
            </div>
            <div>
              <h3 class="care-title">مراقبت‌های پس از جلسه لیزر</h3>
              <p class="care-subtitle">برای جلوگیری از تحریک و تسریع بهبودی پوست</p>
            </div>
          </div>
          <ul class="care-list">
            {afterCareSteps.map((step) => (
              <li>
                <span class="care-check">
                  <Icon name="check" size={12} />
                </span>
                <span>{step}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- ════ Booking Actions ════ -->
        <div class="detail-actions">
          <a href={`/booking?service=${service.slug}`} class="btn-3d-gold btn-block">
            <Icon name="calendar" size={18} />
            <span>رزرو آنلاین نوبت برای {service.name}</span>
          </a>
          <div class="actions-row">
            <a href="tel:+989****5090" class="btn-3d-subtle">
              <Icon name="phone" size={16} />
              <span>مشاوره تلفنی</span>
            </a>
            <a href="/services" class="btn-3d-subtle">
              <Icon name="chevronRight" size={16} />
              <span>بازگشت به لیست خدمات</span>
            </a>
          </div>
        </div>
      </div>

      <!-- ════════════ SIDEBAR: Sticky Summary ════════════ -->
      <aside class="detail-sidebar" aria-label="خلاصه خدمت">
        <div class="sidebar-card">
          <div class="sidebar-head">
            <Icon name="gem" size={17} />
            <span>خلاصه خدمت</span>
          </div>
          <ul class="sidebar-list">
            <li>
              <span class="sb-label"><Icon name="clock" size={14} /> مدت جلسه</span>
              <strong>{service.durationMinutes} دقیقه</strong>
            </li>
            <li>
              <span class="sb-label"><Icon name="calendar" size={14} /> تعداد جلسات</span>
              <strong>{meta.sessions}</strong>
            </li>
            <li>
              <span class="sb-label"><Icon name="shield" size={14} /> طول موج</span>
              <strong>{meta.wavelengthShort}</strong>
            </li>
            <li>
              <span class="sb-label"><Icon name="snowflake" size={14} /> کولینگ</span>
              <strong>کرایو DCD</strong>
            </li>
            <li>
              <span class="sb-label"><Icon name="award" size={14} /> دستگاه</span>
              <strong>جنتل‌مکس پرو ۲۰۲۴</strong>
            </li>
          </ul>

          <div class="sidebar-price-box">
            <span class="sb-price-label">تعرفه مصوب بانوان:</span>
            {femalePrice ? (
              isPromo ? (
                <div class="sb-promo">
                  <span class="sb-old">{formatToman(promoOriginalPrice)}</span>
                  <span class="sb-final">{formatToman(promoFinalPrice)} تومان</span>
                </div>
              ) : (
                <span class="sb-final">{formatToman(basePrice)} تومان</span>
              )
            ) : (
              <span class="sb-note">استعلام تلفنی</span>
            )}
          </div>

          <a href={`/booking?service=${service.slug}`} class="btn-3d-gold btn-block">
            <Icon name="calendar" size={17} />
            <span>رزرو نوبت</span>
          </a>

          <div class="sidebar-trust">
            <div class="trust-item">
              <Icon name="checkCircle" size={14} />
              <span>سری شخصی یکبار مصرف</span>
            </div>
            <div class="trust-item">
              <Icon name="checkCircle" size={14} />
              <span>ضمانت کیفیت کلینیکال</span>
            </div>
            <div class="trust-item">
              <Icon name="checkCircle" size={14} />
              <span>اپراتور دارای مدرک بین‌المللی</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
</PublicLayout>

<style>
  /* ─────────────────────────────────────────────────────────────
     Dark 3D Obsidian-Gold Aesthetics (#0a0b0d / #121417 / #10b981)
     Mirrors the token vocabulary of src/pages/services/index.astro
     ───────────────────────────────────────────────────────────── */
  :root {
    --obsidian-bg: #0a0b0d;
    --obsidian-surface: #12151c;
    --obsidian-card: #151922;
    --obsidian-hover: #1c222e;
    --gold-primary: #10b981;
    --gold-light: #34d399;
    --gold-dark: #047857;
    --gold-glow: rgba(16, 185, 129, 0.25);
    --border-gold-subtle: rgba(16, 185, 129, 0.22);
    --border-gold-strong: rgba(16, 185, 129, 0.45);
  }

  /* Zero horizontal overflow insurance */
  .detail-hero,
  .detail-section,
  .hero-container,
  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .detail-section *,
  .detail-hero * {
    box-sizing: border-box;
  }

  /* ════ Hero ════ */
  .detail-hero {
    background: radial-gradient(circle at 50% 0%, #1a1e28 0%, #0a0b0d 75%);
    padding: clamp(22px, 3vw, 34px) 16px clamp(18px, 2.5vw, 28px);
    text-align: center;
    border-bottom: 1px solid var(--border-gold-subtle);
    position: relative;
    overflow: hidden;
  }

  .detail-breadcrumbs {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.8rem;
    color: #8c857b;
    margin-bottom: 12px;
  }

  .detail-breadcrumbs a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #c9c3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .detail-breadcrumbs a:hover {
    color: var(--gold-light);
  }

  .detail-breadcrumbs :global(svg) {
    color: var(--gold-primary);
    flex-shrink: 0;
  }

  .bc-sep {
    color: #4d4a45;
  }

  .bc-current {
    color: var(--gold-light);
    font-weight: 700;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.12);
    color: var(--gold-light);
    border: 1px solid var(--border-gold-strong);
    padding: 5px 15px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 12px;
    box-shadow: 0 0 16px rgba(16, 185, 129, 0.15);
  }

  .hero-badge :global(svg),
  .tech-badge :global(svg) {
    color: var(--gold-light);
    flex-shrink: 0;
  }

  .hero-title {
