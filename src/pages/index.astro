---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import DeviceShowcase from '../components/public/DeviceShowcase.astro';
import ProtocolSection from '../components/public/ProtocolSection.astro';
import TestimonialsSection from '../components/public/TestimonialsSection.astro';
import ClinicGallery from '../components/public/ClinicGallery.astro';
import { defaultFaqs } from '../data/faqs';
import { MENS_ONLY_SLUG_SET } from '../data/male-pricing';
import { env } from 'cloudflare:workers';
import { listPublicServices, listFaqItems, getPublicSettings } from '../server/repositories';
import { createFAQPageSchema, createBreadcrumbSchema } from '../lib/seo';

// Fetch public services and FAQs server-side for instant SEO & zero JS dependence (§3, §31, §191)
let services: Awaited<ReturnType<typeof listPublicServices>> = [];
let faqs: Awaited<ReturnType<typeof listFaqItems>> = [];

try {
  [services, faqs] = await Promise.all([
    listPublicServices(env.DB),
    listFaqItems(env.DB),
  ]);
} catch (e) {
  console.error('SSR homepage data fetch failure:', e);
}

// Fallback FAQs if database is empty
const activeFaqs = faqs && faqs.length > 0 ? faqs : defaultFaqs;

// Generate FAQPage + BreadcrumbList JSON-LD for rich snippets (§31, §135)
const faqJsonLd = createFAQPageSchema(
  activeFaqs.slice(0, 6).map((f) => ({ question: f.question, answer: f.answer })),
);

const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
]);

// ── Unified gender price table (Lane B) ──────────────────────────────────────
// One row per zone with BOTH tariffs, so women's and men's prices read side by
// side. Amounts are stored in thousands of IRT (330 → ۳۳۰٬۰۰۰ تومان).
interface PriceRowView {
  name: string;
  slug: string;
  durationMinutes: number;
  femaleAmount: number | null;
  maleAmount: number | null;
  mensOnly: boolean;
}

function toman(amountInThousands: number): string {
  return (amountInThousands * 1000).toLocaleString('fa-IR');
}

// DB is authoritative and already ordered by display_order (nulls sort last),
// then name — so men's-only zones land after the 20 shared zones with no
// client-side sorting.
const priceRows: PriceRowView[] = services.map((s) => {
  const female = s.prices.find((p) => p.pricingCategory === 'female');
  const male = s.prices.find((p) => p.pricingCategory === 'male');
  return {
    name: s.name,
    slug: s.slug,
    durationMinutes: s.durationMinutes,
    femaleAmount: female ? female.amount : null,
    maleAmount: male ? male.amount : null,
    mensOnly: MENS_ONLY_SLUG_SET.has(s.slug),
  };
});

// ── Instagram preview data (owner-requested homepage section) ────────────────
// Public settings only; every value is validated before it reaches an href so
// a malformed admin entry can never inject a scheme or markup.
let publicSettings: Record<string, string> = {};
try {
  publicSettings = await getPublicSettings(env.DB);
} catch (e) {
  console.error('SSR homepage settings fetch failure:', e);
}

const igHandleRaw = (publicSettings.instagram_username || '').replace(/[^A-Za-z0-9._]/g, '').slice(0, 30);
const igHandle = igHandleRaw || 'tehranlaser_clinic';
const igProfileUrl = `https://www.instagram.com/${igHandle}/`;
const igReelCandidate = (publicSettings.instagram_latest_reel_url || '').trim();
const igReelUrl = /^https:\/\/(www\.)?instagram\.com\//i.test(igReelCandidate) ? igReelCandidate : igProfileUrl;
const igPromoCode = (publicSettings.instagram_promo_code || '').replace(/[^\w-]/g, '').slice(0, 24);
const igDiscountPct = (publicSettings.instagram_follower_discount_percent || '').replace(/\D/g, '').slice(0, 2);
const igBioLinkCandidate = (publicSettings.instagram_bio_link || '').trim();
const igBioLink = /^https:\/\//i.test(igBioLinkCandidate) ? igBioLinkCandidate : '';

// Persian digits + ٪ for display (e.g. ۲۵٪ instead of %25)
function faDigits(value: string): string {
  return value.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'.charAt(Number(d)));
}
---

<PublicLayout
  title="تهران لیزر — مرکز تخصصی لیزر تماسی رادو پلاس در پاسداران"
  description="کلینیک تخصصی تهران لیزر در خیابان پایدارفرد پاسداران. مجهز به دستگاه لیزر تماسی رادو پلاس با سه طول موج ۷۵۵ و ۸۰۸ و ۱۰۶۴ نانومتر، سرمایش پیوسته بدون درد، کاور یکبار مصرف اختصاصی، تعرفه شفاف و ۱۵٪ تخفیف رزرو آنلاین."
  canonicalUrl="/"
  jsonLd={[faqJsonLd, breadcrumbJsonLd]}
  theme="dark"
  preload={[
    /* Mirrors the <picture> candidate lists exactly — a preload whose
       `imagesrcset` does not match what the element resolves to downloads the
       image twice (measured: 110 KB of 1600w fetched for a 390 px viewport
       while the element went on to use the 800w file). */
    {
      href: '/images/facial-treatment-800.avif',
      as: 'image',
      type: 'image/avif',
      media: '(max-width: 767px)',
      imagesrcset: '/images/facial-treatment-560.avif 560w, /images/facial-treatment-800.avif 800w',
      imagesizes: '96vw',
    },
    {
      href: '/images/facial-treatment-800.avif',
      as: 'image',
      type: 'image/avif',
      media: '(min-width: 768px) and (max-width: 1023px)',
      imagesrcset: '/images/facial-treatment-800.avif 800w, /images/facial-treatment.avif 1600w',
      imagesizes: '96vw',
    },
    {
      href: '/images/facial-treatment.avif',
      as: 'image',
      type: 'image/avif',
      media: '(min-width: 1024px)',
      imagesrcset: '/images/facial-treatment.avif 1600w',
      imagesizes: '46vw',
    },
  ]}
>
  <!-- Hero Section (§38) -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-badge">
          <Icon name="award" size={14} />
          <span>مرکز تخصصی لیزر و زیبایی پاسداران — لیزر تماسی رادو پلاس</span>
        </div>

        <h1 class="hero-title">
          تجربه‌ای لوکس، بدون درد و قطعی از <span class="gold-gradient-text">لیزر موهای زائد</span> در پاسداران
        </h1>

        <p class="hero-subtitle">
          لیزر تماسی <b>رادو پلاس</b> با سه طول موج، سرمایش پیوسته و پک استریل اختصاصی — زیر نظر کادر درمانی.
        </p>

        <div class="hero-cta-group">
          <a href="/booking" class="btn btn-primary btn-lg hero-btn-book">
            <Icon name="calendar" size={18} />
            <span>رزرو آنلاین نوبت</span>
            <span class="promo-tag">۱۵٪ تخفیف</span>
            <Icon name="arrowLeft" size={17} />
          </a>
          <a href="#services" class="btn btn-outline btn-lg hero-btn-services">
            <Icon name="services" size={18} />
            <span>مشاهده تعرفه‌ها</span>
          </a>
          <a href="tel:+989035555090" class="hero-phone-chip" aria-label="مشاوره و پذیرش: ۰۹۰۳ ۵۵۵ ۵۰۹۰">
            <Icon name="phone" size={15} />
            <span>مشاوره و پذیرش: <bdi dir="ltr">۰۹۰۳ ۵۵۵ ۵۰۹۰</bdi></span>
          </a>
        </div>
      </div>

      <!-- Hero visual (Lane L2): imagery-led, decorative ambience only.
           Photo is licensed stock art of a skincare treatment — NOT a photo of
           this clinic or of the Rado Plus device, so the alt text and caption
           describe ambience only and make no equipment/facility claim. -->
      <figure class="hero-visual">
        <div class="hero-visual-frame">
          <picture>
            <!-- Mobile (<768px): a phone shows this band at ≤96vw (≈400 CSS px).
                 Capping the candidate list at 800w keeps DPR-3 phones from
                 pulling the 1600w file (~110 KB) for a ~400 px box; 800w at
                 2.05× is visually identical. -->
            <source
              type="image/avif"
              media="(max-width: 767px)"
              srcset="/images/facial-treatment-560.avif 560w, /images/facial-treatment-800.avif 800w"
              sizes="96vw"
            />
            <source
              type="image/webp"
              media="(max-width: 767px)"
              srcset="/images/facial-treatment-800.webp 800w"
              sizes="96vw"
            />
            <source
              type="image/avif"
              srcset="/images/facial-treatment-800.avif 800w, /images/facial-treatment.avif 1600w"
              sizes="(min-width: 1024px) 46vw, 96vw"
            />
            <source
              type="image/webp"
              srcset="/images/facial-treatment-800.webp 800w, /images/facial-treatment.webp 1600w"
              sizes="(min-width: 1024px) 46vw, 96vw"
            />
            <img
              class="hero-visual-img"
              src="/images/facial-treatment.jpg"
              alt="مراقبت تخصصی پوست توسط کارشناس در فضایی آرام و حرفه‌ای"
              width="1600"
              height="1067"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <div class="hero-visual-overlay" aria-hidden="true"></div>
          <div class="hero-visual-chips">
            <span class="hvc-item">
              <Icon name="lightning" size={14} />
              <span>توان ۱۶۰۰ وات</span>
            </span>
            <span class="hvc-item">
              <Icon name="target" size={14} />
              <span><bdi>۷۵۵ / ۸۰۸ / ۱۰۶۴</bdi> نانومتر</span>
            </span>
            <span class="hvc-item">
              <Icon name="snowflake" size={14} />
              <span>سرمایش TEC Double</span>
            </span>
          </div>
        </div>
        <figcaption class="hero-visual-caption">
          لیزر تماسی رادو پلاس با تست شات رایگان پیش از شروع دوره — پاسداران، خیابان پایدارفرد
          <span class="hero-visual-note">تصویر بالا تزئینی است و دستگاه یا محل مرکز را نشان نمی‌دهد.</span>
        </figcaption>
      </figure>

      <!-- Hero Trust Metrics Grid -->
      <div class="hero-trust-metrics">
        <div class="metric-item">
          <div class="metric-top">
            <Icon name="shield" size={16} class="metric-icon" />
            <span class="metric-val">۱۰۰٪</span>
          </div>
          <span class="metric-label">پک بهداشتی و سری استریل اختصاصی هر مراجع</span>
        </div>

        <div class="metric-item">
          <div class="metric-top">
            <Icon name="percent" size={16} class="metric-icon" />
            <span class="metric-val">۱۵٪</span>
          </div>
          <span class="metric-label">تخفیف رزرو اینترنتی پکیج فول بادی</span>
        </div>

        <div class="metric-item">
          <div class="metric-top">
            <Icon name="target" size={16} class="metric-icon" />
            <span class="metric-val"><bdi>۷۵۵</bdi> + <bdi>۱۰۶۴</bdi></span>
          </div>
          <span class="metric-label">طول موج دوگانه الکس و یاگ برای انواع تیپ پوست</span>
        </div>

        <div class="metric-item">
          <div class="metric-top">
            <Icon name="pin" size={16} class="metric-icon" />
            <span class="metric-val">پاسداران</span>
          </div>
          <span class="metric-label">لوکیشن پایدارفرد با دسترسی آسان و پارکینگ</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Rado Plus Contact Laser Showcase (§37, §38) -->
  <DeviceShowcase />

  <!-- Trust Strip (§37) -->
  <section class="trust-strip">
    <div class="container trust-grid">
      <div class="trust-card">
        <div class="trust-icon">
          <Icon name="doctor" size={26} />
        </div>
        <h3 class="trust-title">اپراتورهای ارشد دوره‌دیده</h3>
        <p class="trust-desc">ارائه خدمات توسط اپراتورهای دارای گواهینامه کاربری لیزرهای پزشکی، در لاین‌های کاملاً مجزای بانوان و آقایان</p>
      </div>

      <div class="trust-card">
        <div class="trust-icon">
          <Icon name="clean" size={26} />
        </div>
        <h3 class="trust-title">پک بهداشتی و سری اختصاصی</h3>
        <p class="trust-desc">سلفون‌کشی کامل، ملحفه یکبار مصرف و سری مجزا برای هر مراجعه‌کننده با تضمین سلامت کامل پزشکی</p>
      </div>

      <div class="trust-card">
        <div class="trust-icon">
          <Icon name="gem" size={26} />
        </div>
        <h3 class="trust-title">تعرفه‌های شفاف و مصوب</h3>
        <p class="trust-desc">هزینه‌های اعلامی قطعی بوده و هیچ‌گونه هزینه پنهان یا تغییر قیمت در محل کلینیک اخذ نمی‌گردد</p>
      </div>

      <div class="trust-card">
        <div class="trust-icon">
          <Icon name="sparkles" size={26} />
        </div>
        <h3 class="trust-title">گارانتی اثربخشی دوره</h3>
        <p class="trust-desc">ریزش بین ۸۰ تا ۹۵ درصد موهای زائد در پایان دوره استاندارد ۶ الی ۸ جلسه‌ای تحت پروتکل علمی</p>
      </div>
    </div>
  </section>

  <!-- Clinic ambience band (Lane L2) — imagery-led visual proof -->
  <ClinicGallery />

  <!-- Services & Pricing Section (§10, §11, §253, §254) -->
  <section id="services" class="section services-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">تعرفه‌های مصوب و شفاف کلینیک</span>
        <h2 class="section-title">تعرفه لیزر بانوان و آقایان — کنار هم</h2>
        <p class="section-desc">
          تعرفه‌های رسمی کلینیک تهران لیزر با دستگاه لیزر تماسی رادو پلاس برای هر دو لاین بانوان و آقایان. رزرو آنلاین پکیج کل بدن مشمول ۱۵٪ تخفیف ویژه می‌باشد.
        </p>
      </div>

      <!-- Featured Promo Banner -->
      <div class="featured-promo-card">
        <div class="promo-badge-ribbon">
          <Icon name="sparkles" size={14} />
          <span>پیشنهاد طلایی رزرو آنلاین</span>
        </div>
        <div class="promo-content">
          <div class="promo-info">
            <h3 class="promo-title">پکیج طلایی کل بدن بانوان (Full Body)</h3>
            <p class="promo-desc">شامل دست کامل، پا کامل، زیر بغل، بیکینی، خط باسن، خط ناف و شکم با شات نامحدود</p>
            <ul class="promo-features">
              <li>
                <Icon name="checkCircle" size={16} class="check-icon" />
                <span>انجام توسط اپراتور ارشد با شات نامحدود واقعی</span>
              </li>
              <li>
                <Icon name="checkCircle" size={16} class="check-icon" />
                <span>سرمایش پیوسته TEC Double بدون درد</span>
              </li>
              <li>
                <Icon name="checkCircle" size={16} class="check-icon" />
                <span>پک بهداشتی و سری اختصاصی استریل</span>
              </li>
            </ul>
          </div>
          <div class="promo-pricing-box">
            <div class="old-price">
              <span class="strikethrough">۲٬۲۹۰٬۰۰۰</span>
              <span class="price-unit">تومان</span>
            </div>
            <div class="new-price">
              <span class="final-amount">۱٬۹۴۰٬۰۰۰</span>
              <span class="price-unit">تومان</span>
            </div>
            <span class="discount-tag">۱۵٪ تخفیف اختصاصی رزرو سایت</span>
            <a href="/booking?service=full-body" class="btn btn-primary btn-block mt-3">
              <Icon name="calendar" size={18} />
              <span>رزرو نوبت پکیج کل بدن</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Unified gender price table — تعرفه بانوان و آقایان کنار هم (Lane B) -->
      <div class="gender-price-table-wrap mt-5">
        <table class="gender-price-table">
          <thead>
            <tr>
              <th scope="col" class="gpt-th-zone">ناحیه خدمت</th>
              <th scope="col" class="gpt-th-female">تعرفه بانوان</th>
              <th scope="col" class="gpt-th-male">تعرفه آقایان</th>
              <th scope="col" class="gpt-th-action">رزرو</th>
            </tr>
          </thead>
          <tbody>
            {priceRows.map((row) => (
              <tr class={row.mensOnly ? 'gpt-row gpt-row-mens' : 'gpt-row'}>
                <td class="gpt-cell-zone">
                  <span class="gpt-zone-name">{row.name}</span>
                  {row.mensOnly && <span class="gpt-mens-tag">مخصوص آقایان</span>}
                </td>
                <td class="gpt-cell-female" data-label="بانوان">
                  {row.femaleAmount !== null ? (
                    <span class="gpt-price">
                      <span class="gpt-amount">{toman(row.femaleAmount)}</span>
                      <span class="gpt-unit">تومان</span>
                    </span>
                  ) : (
                    <span class="gpt-na">—</span>
                  )}
                </td>
                <td class="gpt-cell-male" data-label="آقایان">
                  {row.maleAmount !== null ? (
                    <span class="gpt-price">
                      <span class="gpt-amount">{toman(row.maleAmount)}</span>
                      <span class="gpt-unit">تومان</span>
                    </span>
                  ) : (
                    <span class="gpt-na">استعلام تلفنی</span>
                  )}
                </td>
                <td class="gpt-cell-action">
                  <a href={`/booking?service=${row.slug}`} class="gpt-book-btn" aria-label={`رزرو ${row.name}`}>
                    <Icon name="calendar" size={14} />
                    <span>رزرو</span>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="text-center mt-5">
        <a href="/services" class="btn btn-outline btn-lg">
          <span>مشاهده جزئیات کامل هر ناحیه و راهنمای مراقبت</span>
          <Icon name="arrowLeft" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- Male Services Section Info (§11) -->
  <section class="section male-services-strip">
    <div class="container male-strip-inner">
      <div class="male-text">
        <span class="badge badge-outline">
          <Icon name="shield" size={14} />
          <span>لاین درمانی مجزا</span>
        </span>
        <h3 class="male-title">خدمات اختصاصی لیزر آقایان با اپراتور آقا</h3>
        <p class="male-desc">
          کلینیک تهران لیزر مجهز به لاین اختصاصی آقایان با اپراتورهای مجرب آقا و پروتکل‌های ویژه موهای ضخیم می‌باشد. نواحی آنکارد ریش، خط گردن و گونه، پشت، شانه‌ها، سینه و پکیج کامل کل بدن با تعیین وقت قبلی و در کمال حریم شخصی ارائه می‌گردد.
        </p>
      </div>
      <div class="male-cta">
        <a href="/booking" class="btn btn-outline btn-lg">
          <Icon name="calendar" size={18} />
          <span>رزرو نوبت لاین اختصاصی آقایان</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Clinical Protocol & Trust Standards Section -->
  <ProtocolSection />

  <!-- Patient Testimonials Section -->
  <TestimonialsSection />

  <!-- FAQ Section (§31, §256) -->
  <section id="faq" class="section faq-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">پاسخ به سوالات پرتکرار</span>
        <h2 class="section-title">سوالات متداول مراجعین تهران لیزر</h2>
      </div>

      <div class="faq-accordion">
        {activeFaqs.map((faq) => (
          <details class="faq-card">
            <summary class="faq-question">
              <span>{faq.question}</span>
              <span class="faq-toggle-icon">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinic Location & Direct CTA (§34, §35, §36) -->
  <section class="section clinic-location-section">
    <div class="container location-container">
      <div class="location-card">
        <span class="section-subtitle">موقعیت مکانی و راه‌های ارتباطی</span>
        <h2 class="location-heading">کلینیک تهران لیزر در منطقه پاسداران</h2>

        <div class="location-details-list">
          <div class="loc-detail-item">
            <Icon name="pin" size={20} class="loc-icon" />
            <div class="loc-text">
              <strong>نشانی دقیق:</strong> تهران، پاسداران، خیابان پایدارفرد، نبش بوستان هفتم
            </div>
          </div>

          <div class="loc-detail-item">
            <Icon name="phone" size={20} class="loc-icon" />
            <div class="loc-text">
              <strong>تلفن پذیرش و هماهنگی:</strong>
              <a href="tel:+989035555090" class="loc-phone-link"><bdi dir="ltr">۰۹۰۳ ۵۵۵ ۵۰۹۰</bdi></a>
            </div>
          </div>

          <div class="loc-detail-item">
            <Icon name="clock" size={20} class="loc-icon" />
            <div class="loc-text">
