---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import DeviceShowcase from '../components/public/DeviceShowcase.astro';
import ProtocolSection from '../components/public/ProtocolSection.astro';
import TestimonialsSection from '../components/public/TestimonialsSection.astro';
import ClinicGallery from '../components/public/ClinicGallery.astro';
import JournalStrip from '../components/public/JournalStrip.astro';
import { defaultFaqs } from '../data/faqs';
import { MENS_ONLY_SLUG_SET } from '../data/male-pricing';
import { CLINIC_CONTACT } from '../lib/seo/meta';
import { env } from 'cloudflare:workers';
import {
  listPublicServices,
  listFaqItems,
  getPublicSettings,
  listPublicBlogPosts,
} from '../server/repositories';
import { getModuleStateMap } from '../server/features';
import {
  enabledConfig,
  isModuleOn,
  mergeModuleStates,
  resolveInstagram,
  toStateMap,
} from '../domain/features/state';
import { createFAQPageSchema, createBreadcrumbSchema } from '../lib/seo';
import '../styles/index.css';

// Fetch public services and FAQs server-side for instant SEO & zero JS dependence (§3, §31, §191)
let services: Awaited<ReturnType<typeof listPublicServices>> = [];
let faqs: Awaited<ReturnType<typeof listFaqItems>> = [];

try {
  [services, faqs] = await Promise.all([listPublicServices(env.DB), listFaqItems(env.DB)]);
} catch (e) {
  console.error('SSR homepage data fetch failure:', e);
}

/* ── Feature modules (the plugin gate) ───────────────────────────────────────
   A section renders only when its module is enabled in the plugin hub. If D1
   cannot be read we fall back to the REGISTRY DEFAULTS rather than an empty
   map: a transient DB error must never blank the clinic's marketing page, and
   those defaults are exactly the state a fresh install ships with. */
let moduleStates: Map<string, ReturnType<typeof mergeModuleStates>[number]>;
try {
  moduleStates = await getModuleStateMap(env.DB);
} catch (e) {
  console.error('SSR homepage feature-state fetch failure:', e);
  moduleStates = toStateMap(mergeModuleStates([]));
}
const isOn = (key: string) => isModuleOn(moduleStates, key);

const pricingCfg = enabledConfig(moduleStates, 'pricing-table');
const faqCfg = enabledConfig(moduleStates, 'faq');
const mensCfg = enabledConfig(moduleStates, 'mens-line');
const closingCfg = enabledConfig(moduleStates, 'closing-cta');
const statsCfg = enabledConfig(moduleStates, 'stat-band');
const igModuleCfg = enabledConfig(moduleStates, 'instagram-hub');

const str = (value: unknown, fallback = ''): string =>
  typeof value === 'string' && value.trim() !== '' ? value : fallback;

/* ── Journal strip data (module `content-blog`) ──────────────────────────────
   Read only when the module is on: a disabled blog must not pay a D1 query, and
   a read failure renders no strip rather than a section of empty cards. */
let journalPosts: Awaited<ReturnType<typeof listPublicBlogPosts>>['items'] = [];
if (isModuleOn(moduleStates, 'content-blog')) {
  try {
    const page = await listPublicBlogPosts(env.DB, 3);
    journalPosts = page.items.slice(0, 3);
  } catch (e) {
    console.error('SSR homepage journal fetch failure:', e);
  }
}

// Fallback FAQs if database is empty
const activeFaqs = faqs && faqs.length > 0 ? faqs : defaultFaqs;

// Generate FAQPage + BreadcrumbList JSON-LD for rich snippets (§31, §135)
const faqJsonLd = createFAQPageSchema(
  activeFaqs.slice(0, 6).map((f) => ({ question: f.question, answer: f.answer })),
);

const breadcrumbJsonLd = createBreadcrumbSchema([{ name: 'صفحه اصلی', url: '/' }]);

// ── Unified gender price table (Lane B) ──────────────────────────────────────
// One row per zone with BOTH tariffs, so women's and men's prices read side by
// side. Amounts are stored in thousands of IRT (330 → ۳۳۰٬۰۰۰ تومان).
interface PriceRowView {
  name: string;
  slug: string;
  durationMinutes: number;
  femaleAmount: number | null;
  maleAmount: number | null;
  mensOnly: boolean;
}

function toman(amountInThousands: number): string {
  return (amountInThousands * 1000).toLocaleString('fa-IR');
}

// DB is authoritative and already ordered by display_order (nulls sort last),
// then name — so men's-only zones land after the 20 shared zones with no
// client-side sorting.
const priceRows: PriceRowView[] = services.map((s) => {
  const female = s.prices.find((p) => p.pricingCategory === 'female');
  const male = s.prices.find((p) => p.pricingCategory === 'male');
  return {
    name: s.name,
    slug: s.slug,
    durationMinutes: s.durationMinutes,
    femaleAmount: female ? female.amount : null,
    maleAmount: male ? male.amount : null,
    mensOnly: MENS_ONLY_SLUG_SET.has(s.slug),
  };
});

// ── Instagram preview data (owner-requested homepage section) ────────────────
// Public settings only; every value is validated before it reaches an href so
// a malformed admin entry can never inject a scheme or markup.
let publicSettings: Record<string, string> = {};
try {
  publicSettings = await getPublicSettings(env.DB);
} catch (e) {
  console.error('SSR homepage settings fetch failure:', e);
}

const ig = resolveInstagram(igModuleCfg, publicSettings);
const igHandle = ig.handle;
const igProfileUrl = ig.profileUrl;
const igReelUrl = ig.reelUrl;
const igPromoCode = ig.promoCode;
const igDiscountPct = ig.discountPercent;
const igBioLink = ig.bioLink;

// Persian digits + ٪ for display (e.g. ۲۵٪ instead of %25)
function faDigits(value: string): string {
  return value.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'.charAt(Number(d)));
}
---

<PublicLayout
  title="تهران لیزر — مرکز تخصصی لیزر تماسی رادو پلاس در پاسداران"
  description="کلینیک تخصصی تهران لیزر در خیابان پایدارفرد پاسداران. مجهز به دستگاه لیزر تماسی رادو پلاس با سه طول موج ۷۵۵ و ۸۰۸ و ۱۰۶۴ نانومتر، سرمایش پیوسته بدون درد، کاور یکبار مصرف اختصاصی، تعرفه شفاف و ۱۵٪ تخفیف رزرو آنلاین."
  canonicalUrl="/"
  jsonLd={[faqJsonLd, breadcrumbJsonLd]}
  theme="dark"
  preload={[
    /* Mirrors the <picture> candidate lists exactly — a preload whose
       `imagesrcset` does not match what the element resolves to downloads the
       image twice (measured: 110 KB of 1600w fetched for a 390 px viewport
       while the element went on to use the 800w file). */
    {
      href: '/images/hero-laser-700.avif',
      as: 'image',
      type: 'image/avif',
      media: '(max-width: 767px)',
      imagesrcset: '/images/hero-laser-700.avif 700w',
      imagesizes: '96vw',
    },
    {
      href: '/images/hero-laser-1400.avif',
      as: 'image',
      type: 'image/avif',
      media: '(min-width: 768px) and (max-width: 1023px)',
      imagesrcset: '/images/hero-laser-700.avif 700w, /images/hero-laser-1400.avif 1400w',
      imagesizes: '96vw',
    },
    {
      href: '/images/hero-laser-1400.avif',
      as: 'image',
      type: 'image/avif',
      media: '(min-width: 1024px)',
      imagesrcset: '/images/hero-laser-700.avif 700w, /images/hero-laser-1400.avif 1400w',
      imagesizes: '46vw',
    },
  ]}
>
  <!-- Hero Section (§38) — module gate: plugin `hero` -->
  {isOn('hero') && (
    <section class="hero-section">
      <!-- The stage: three light sources, a hairline grid and one gold beam.
         Decorative only — nothing here is announced, focusable or measureable. -->
      <div class="hero-stage" aria-hidden="true">
        <span class="hero-aura hero-aura-gold"></span>
        <span class="hero-aura hero-aura-emerald"></span>
        <span class="hero-grid-lines"></span>
        <span class="hero-noise"></span>
        <svg class="hero-beam" viewBox="0 0 1200 620" preserveAspectRatio="none" focusable="false">
          <defs>
            <linearGradient id="beam-gold" x1="1" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#e8cb8f" stop-opacity="0.5" />
              <stop offset="0.55" stop-color="#e8cb8f" stop-opacity="0.12" />
              <stop offset="1" stop-color="#e8cb8f" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="beam-emerald" x1="1" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3bd9a4" stop-opacity="0.28" />
              <stop offset="1" stop-color="#3bd9a4" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path
            class="hero-beam-line"
            d="M1180 12 C 900 120, 660 300, 360 600"
            stroke="url(#beam-gold)"
          />
          <path
            class="hero-beam-line hero-beam-line-2"
            d="M1100 0 C 840 150, 640 330, 430 620"
            stroke="url(#beam-emerald)"
          />
          <path
            class="hero-beam-line hero-beam-line-3"
            d="M1240 60 C 980 170, 760 330, 540 620"
            stroke="url(#beam-gold)"
          />
        </svg>
      </div>

      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <Icon name="award" size={14} />
            <span>مرکز تخصصی لیزر و زیبایی پاسداران — لیزر تماسی رادو پلاس</span>
          </div>

          <h1 class="hero-title">
            تجربه‌ای لوکس، بدون درد و قطعی از{' '}
            <span class="gold-gradient-text">لیزر موهای زائد</span> در پاسداران
          </h1>

          <p class="hero-subtitle">
            لیزر تماسی <b>رادو پلاس</b> با سه طول موج، سرمایش پیوسته و پک استریل اختصاصی — با پروتکل
            بهداشتی ثبت‌شده برای هر جلسه.
          </p>

          <div class="hero-cta-group">
            <a href="/booking" class="btn btn-primary btn-lg hero-btn-book">
              <Icon name="calendar" size={18} />
              <span>رزرو آنلاین نوبت</span>
              <span class="promo-tag">۱۵٪ تخفیف</span>
              <Icon name="arrowLeft" size={17} />
            </a>
            <a href="#services" class="btn btn-outline btn-lg hero-btn-services">
              <Icon name="services" size={18} />
              <span>مشاهده تعرفه‌ها</span>
            </a>
            <a
              href="tel:+989035555090"
              class="hero-phone-chip"
              aria-label="مشاوره و پذیرش: ۰۹۰۳ ۵۵۵ ۵۰۹۰"
            >
              <Icon name="phone" size={15} />
              <span>
                مشاوره و پذیرش: <bdi dir="ltr">۰۹۰۳ ۵۵۵ ۵۰۹۰</bdi>
              </span>
            </a>
          </div>
        </div>

        <!-- Hero visual (Lane L2): imagery-led, decorative ambience only.
           Image is generated illustration of a laser hair-removal session —
           NOT a photo of this clinic or of the Rado Plus device, so the alt
           text and caption describe ambience only and make no equipment or
           facility claim. Replace with a real clinic photo when one exists. -->
        <figure class="hero-visual">
          <div class="hero-visual-stage">
            <div class="hero-visual-frame">
              <picture>
                <!-- Mobile (<768px): a phone shows this band at ≤96vw (≈400 CSS px).
                 Capping the candidate list at 700w keeps DPR-3 phones from
                 pulling the 1400w file (~97 KB) for a ~400 px box. -->
                <source
                  type="image/avif"
                  media="(max-width: 767px)"
                  srcset="/images/hero-laser-700.avif 700w"
                  sizes="96vw"
                />
                <source
                  type="image/webp"
                  media="(max-width: 767px)"
                  srcset="/images/hero-laser-700.webp 700w"
                  sizes="96vw"
                />
                <source
                  type="image/avif"
                  srcset="/images/hero-laser-700.avif 700w, /images/hero-laser-1400.avif 1400w"
                  sizes="(min-width: 1024px) 46vw, 96vw"
                />
                <source
                  type="image/webp"
                  srcset="/images/hero-laser-700.webp 700w, /images/hero-laser-1400.webp 1400w"
                  sizes="(min-width: 1024px) 46vw, 96vw"
                />
                <img
                  class="hero-visual-img"
                  src="/images/hero-laser-1400.jpg"
                  srcset="/images/hero-laser-700.jpg 700w, /images/hero-laser-1400.jpg 1400w"
                  sizes="(min-width: 1024px) 46vw, 96vw"
                  alt="جلسه لیزر موهای زائد با دستگاه تماسی روی پوست پا در فضایی آرام و استریل"
                  width="1400"
                  height="933"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
              <div class="hero-visual-overlay" aria-hidden="true"></div>
              <span class="hero-corner hero-corner-1" aria-hidden="true"></span>
              <span class="hero-corner hero-corner-2" aria-hidden="true"></span>
              <span class="hero-corner hero-corner-3" aria-hidden="true"></span>
              <span class="hero-corner hero-corner-4" aria-hidden="true"></span>
            </div>

            <!-- Device seal: a slow-turning spec ring breaking the photo's frame.
             Decorative, so it is hidden from AT and from reduced-motion users. -->
            <div class="hero-seal" aria-hidden="true">
              <svg viewBox="0 0 100 100" class="hero-seal-ring" focusable="false">
                <defs>
                  <path id="seal-path" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" />
                </defs>
                <text>
                  <textPath href="#seal-path" startOffset="0%">
                    RADO PLUS · CONTACT LASER ·{' '}
                  </textPath>
                </text>
              </svg>
              <span class="hero-seal-core">
                <Icon name="sparkles" size={17} />
              </span>
            </div>

            <!-- Spec panel — the device numbers, read as instrumentation instead of
             three glass chips floating on the photo's scrim. -->
            <div class="hero-spec-card">
              <span class="hero-spec-head">
                <Icon name="target" size={13} />
                <span>مشخصات دستگاه رادو پلاس</span>
              </span>
              <dl class="hero-spec-list">
                <div class="hero-spec-row">
                  <dt>طول موج</dt>
                  <dd>
                    <bdi dir="ltr">۷۵۵ · ۸۰۸ · ۱۰۶۴</bdi> <span>نانومتر</span>
                  </dd>
                </div>
                <div class="hero-spec-row">
                  <dt>سرمایش</dt>
                  <dd>TEC Double</dd>
                </div>
                <div class="hero-spec-row">
                  <dt>توان</dt>
                  <dd>
                    <bdi>۱۶۰۰</bdi> <span>وات</span>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
          <figcaption class="hero-visual-caption">
            لیزر تماسی رادو پلاس با تست شات رایگان پیش از شروع دوره — پاسداران، خیابان پایدارفرد
            <span class="hero-visual-note">
              تصویر بالا تزئینی است و دستگاه یا محل مرکز را نشان نمی‌دهد.
            </span>
          </figcaption>
        </figure>

        <!-- Hero Trust Metrics Grid -->
        <div class="hero-trust-metrics">
          <div class="metric-item">
            <div class="metric-top">
              <Icon name="shield" size={16} class="metric-icon" />
              <span class="metric-val">۱۰۰٪</span>
            </div>
            <span class="metric-label">پک بهداشتی و سری استریل اختصاصی هر مراجع</span>
          </div>

          <div class="metric-item">
            <div class="metric-top">
              <Icon name="percent" size={16} class="metric-icon" />
              <span class="metric-val">۱۵٪</span>
            </div>
            <span class="metric-label">تخفیف رزرو اینترنتی پکیج فول بادی</span>
          </div>

          <div class="metric-item">
            <div class="metric-top">
              <Icon name="target" size={16} class="metric-icon" />
              <span class="metric-val">
                <bdi dir="ltr">۷۵۵ · ۸۰۸ · ۱۰۶۴</bdi>
              </span>
            </div>
            <span class="metric-label">سه طول موج الکس، دایود و یاگ برای همه تیپ‌های پوستی</span>
          </div>

          <div class="metric-item">
            <div class="metric-top">
              <Icon name="pin" size={16} class="metric-icon" />
              <span class="metric-val">پاسداران</span>
            </div>
            <span class="metric-label">لوکیشن پایدارفرد با دسترسی آسان و پارکینگ</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Rado Plus Contact Laser Showcase (§37, §38) -->
  {isOn('device-showcase') && <DeviceShowcase />}

  <!-- Trust Strip (§37) -->
  {isOn('trust-strip') && (
    <section class="trust-strip">
      <div class="container trust-grid">
        <div class="trust-card">
          <div class="trust-icon">
            <Icon name="doctor" size={26} />
          </div>
          <h3 class="trust-title">اپراتورهای ارشد دوره‌دیده</h3>
          <p class="trust-desc">
            ارائه خدمات توسط اپراتورهای دارای گواهینامه کاربری لیزرهای پزشکی، در لاین‌های کاملاً
            مجزای بانوان و آقایان
          </p>
        </div>

        <div class="trust-card">
          <div class="trust-icon">
            <Icon name="clean" size={26} />
          </div>
          <h3 class="trust-title">پک بهداشتی و سری اختصاصی</h3>
          <p class="trust-desc">
            سلفون‌کشی کامل، ملحفه یکبار مصرف و سری مجزا برای هر مراجعه‌کننده با تضمین سلامت کامل
            پزشکی
          </p>
        </div>

        <div class="trust-card">
          <div class="trust-icon">
            <Icon name="gem" size={26} />
          </div>
          <h3 class="trust-title">تعرفه‌های شفاف و مصوب</h3>
          <p class="trust-desc">
            هزینه‌های اعلامی قطعی بوده و هیچ‌گونه هزینه پنهان یا تغییر قیمت در محل کلینیک اخذ
            نمی‌گردد
          </p>
        </div>

        <div class="trust-card">
          <div class="trust-icon">
            <Icon name="sparkles" size={26} />
          </div>
          <h3 class="trust-title">گارانتی اثربخشی دوره</h3>
          <p class="trust-desc">
            ریزش بین ۸۰ تا ۹۵ درصد موهای زائد در پایان دوره استاندارد ۶ الی ۸ جلسه‌ای تحت پروتکل
            علمی
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Clinic ambience band (Lane L2) — imagery-led visual proof -->
  {isOn('clinic-gallery') && <ClinicGallery />}

  <!-- Services & Pricing Section (§10, §11, §253, §254) -->
  {isOn('pricing-table') && (
    <section id="services" class="section services-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-subtitle">تعرفه‌های مصوب و شفاف کلینیک</span>
          <h2 class="section-title">تعرفه لیزر بانوان و آقایان — کنار هم</h2>
          <p class="section-desc">
            تعرفه‌های رسمی کلینیک تهران لیزر با دستگاه لیزر تماسی رادو پلاس برای هر دو لاین بانوان و
            آقایان. رزرو آنلاین پکیج کل بدن مشمول ۱۵٪ تخفیف ویژه می‌باشد.
          </p>
        </div>

        <!-- Featured Promo Banner -->
        <div class="featured-promo-card">
          <div class="promo-badge-ribbon">
            <Icon name="sparkles" size={14} />
            <span>{str(pricingCfg.promoBadge, 'پیشنهاد طلایی رزرو آنلاین')}</span>
          </div>
          <div class="promo-content">
            <div class="promo-info">
              <h3 class="promo-title">
                {str(pricingCfg.promoTitle, 'پکیج طلایی کل بدن بانوان (Full Body)')}
              </h3>
              <p class="promo-desc">
                شامل دست کامل، پا کامل، زیر بغل، بیکینی، خط باسن، خط ناف و شکم با شات نامحدود
              </p>
              <ul class="promo-features">
                <li>
                  <Icon name="checkCircle" size={16} class="check-icon" />
                  <span>انجام توسط اپراتور ارشد با شات نامحدود واقعی</span>
                </li>
                <li>
                  <Icon name="checkCircle" size={16} class="check-icon" />
                  <span>سرمایش پیوسته TEC Double بدون درد</span>
                </li>
                <li>
                  <Icon name="checkCircle" size={16} class="check-icon" />
                  <span>پک بهداشتی و سری اختصاصی استریل</span>
                </li>
              </ul>
            </div>
            <div class="promo-pricing-box">
              <div class="old-price">
                <span class="strikethrough">{str(pricingCfg.promoOldPrice, '۲٬۲۹۰٬۰۰۰')}</span>
                <span class="price-unit">تومان</span>
              </div>
              <div class="new-price">
                <span class="final-amount">{str(pricingCfg.promoNewPrice, '۱٬۹۴۰٬۰۰۰')}</span>
                <span class="price-unit">تومان</span>
              </div>
              <span class="discount-tag">
                {str(pricingCfg.promoDiscountLabel, '۱۵٪ تخفیف اختصاصی رزرو سایت')}
              </span>
              <a
                href={`/booking?service=${encodeURIComponent(str(pricingCfg.promoServiceSlug, 'full-body'))}`}
                class="btn btn-primary btn-block mt-3"
              >
                <Icon name="calendar" size={18} />
                <span>رزرو نوبت پکیج کل بدن</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Unified gender price table — تعرفه بانوان و آقایان کنار هم (Lane B) -->
        <div class="gender-price-table-wrap mt-5">
          <table class="gender-price-table">
            <thead>
              <tr>
                <th scope="col" class="gpt-th-zone">
                  ناحیه خدمت
                </th>
                <th scope="col" class="gpt-th-female">
                  تعرفه بانوان <span class="gpt-th-unit">(تومان)</span>
                </th>
                <th scope="col" class="gpt-th-male">
                  تعرفه آقایان <span class="gpt-th-unit">(تومان)</span>
                </th>
