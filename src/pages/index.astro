<script is:inline>
  (function () {
    document.querySelectorAll('.ig-copy-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var code = btn.getAttribute('data-code') || '';
        var done = function () {
          btn.textContent = 'کپی شد';
          btn.classList.add('is-copied');
          setTimeout(function () {
            btn.textContent = 'کپی کد';
            btn.classList.remove('is-copied');
          }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(done).catch(done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = code;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) { /* noop */ }
          document.body.removeChild(ta);
          done();
        }
      });
    });
  })();
</script>

<style>
  /* ── Homepage-local refinements only ─────────────────────────────────
     This block used to carry ~940 lines of a second, page-scoped design
     system (hero visual, gender price table, Instagram hub, closing CTA,
     promo card) that fought the shared sheets on specificity and hid large
     parts of the page below 768px behind a self-imposed "height budget" —
     no subtitle, no hero photo, two of four trust cards, two of four
     protocol steps, and the FAQ cut to three items, all on the breakpoint
     that carries almost all of this clinic's traffic.

     Those decisions now live in ONE place: `src/styles/site-v2.css`, which
     is mobile-first, loads after public.css, and ships to every public
     route. What remains here is genuinely page-local: the two tariff
     columns hold different product lines, so the men-only rows keep a
     neutral tint that is neither a gold nor an emerald fill. */
  .gpt-row-mens {
    background: rgba(30, 36, 48, 0.35);
  }
</style>

<script is:inline>
  // Keep the sticky table header clear of the (also sticky) site header by
  // publishing the header's real height as a CSS custom property.
  (function () {
    function syncHeaderOffset() {
      var header = document.querySelector('.site-header');
      if (!header) return;
      var h = Math.round(header.getBoundingClientRect().height);
      if (h > 0) {
        document.documentElement.style.setProperty('--tl-header-offset', h + 'px');
      }
    }
    syncHeaderOffset();
    window.addEventListener('resize', syncHeaderOffset);
    window.addEventListener('orientationchange', syncHeaderOffset);
  })();
</script>

