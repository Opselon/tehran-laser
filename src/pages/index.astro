---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import CandelaShowcase from '../components/public/CandelaShowcase.astro';
import ProtocolSection from '../components/public/ProtocolSection.astro';
import TestimonialsSection from '../components/public/TestimonialsSection.astro';
import { defaultFaqs } from '../data/faqs';
import { MENS_ONLY_SLUG_SET } from '../data/male-pricing';
import { env } from 'cloudflare:workers';
import { listPublicServices, listFaqItems } from '../server/repositories';
import { createFAQPageSchema, createBreadcrumbSchema } from '../lib/seo';

// Fetch public services and FAQs server-side for instant SEO & zero JS dependence (§3, §31, §191)
let services: Awaited<ReturnType<typeof listPublicServices>> = [];
let faqs: Awaited<ReturnType<typeof listFaqItems>> = [];

try {
  [services, faqs] = await Promise.all([
    listPublicServices(env.DB),
    listFaqItems(env.DB),
  ]);
} catch (e) {
  console.error('SSR homepage data fetch failure:', e);
}

// Fallback FAQs if database is empty
const activeFaqs = faqs && faqs.length > 0 ? faqs : defaultFaqs;

// Generate FAQPage + BreadcrumbList JSON-LD for rich snippets (§31, §135)
const faqJsonLd = createFAQPageSchema(
  activeFaqs.slice(0, 6).map((f) => ({ question: f.question, answer: f.answer })),
);

const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
]);

// ── Unified gender price table (Lane B) ──────────────────────────────────────
// One row per zone with BOTH tariffs, so women's and men's prices read side by
// side. Amounts are stored in thousands of IRT (330 → ۳۳۰٬۰۰۰ تومان).
interface PriceRowView {
  name: string;
  slug: string;
  durationMinutes: number;
  femaleAmount: number | null;
  maleAmount: number | null;
  mensOnly: boolean;
}

function toman(amountInThousands: number): string {
  return (amountInThousands * 1000).toLocaleString('fa-IR');
}

// DB is authoritative and already ordered by display_order (nulls sort last),
// then name — so men's-only zones land after the 20 shared zones with no
// client-side sorting.
const priceRows: PriceRowView[] = services.map((s) => {
  const female = s.prices.find((p) => p.pricingCategory === 'female');
  const male = s.prices.find((p) => p.pricingCategory === 'male');
  return {
    name: s.name,
    slug: s.slug,
    durationMinutes: s.durationMinutes,
    femaleAmount: female ? female.amount : null,
    maleAmount: male ? male.amount : null,
    mensOnly: MENS_ONLY_SLUG_SET.has(s.slug),
  };
});
---

<PublicLayout
  title="تهران لیزر — مرکز تخصصی لیزر الکساندرایت کندلا ۲۰۲۶ در پاسداران"
  description="کلینیک تخصصی تهران لیزر در خیابان پایدارفرد پاسداران. مجهز به الکساندرایت کندلا ۲۰۲۶ آمریکایی با کولینگ داینامیک بدون درد، پک استریل اختصاصی، تعرفه شفاف و ۱۵٪ تخفیف رزرو آنلاین."
  canonicalUrl="/"
  jsonLd={[faqJsonLd, breadcrumbJsonLd]}
  theme="dark"
>
  <!-- Hero Section (§38) -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-badge animate-fade-in">
          <Icon name="sparkles" size={15} class="gold-icon-glow" />
          <span>مرکز تخصصی لیزر و زیبایی پاسداران — مجهز به الکساندرایت کندلا ۲۰۲۶</span>
        </div>

        <h1 class="hero-title animate-fade-up">
          تجربه‌ای لوکس، بدون درد و قطعی از <span class="gold-gradient-text">لیزر موهای زائد</span> در پاسداران
        </h1>

        <p class="hero-subtitle animate-fade-up delay-1">
          در کلینیک تهران لیزر، فناوری طلایی الکساندرایت کندلا ۲۰۲۶ (Candela GentleMax Pro) را با سیستم خنک‌کننده داینامیک DCD کرایوژن، نظارت مستقیم کادر درمانی و پک‌های استریل اختصاصی در محیطی VIP و آرام تجربه فرمایید.
        </p>

        <div class="hero-cta-group animate-fade-up delay-2">
          <a href="/booking" class="btn btn-primary btn-lg hero-btn-book">
            <Icon name="calendar" size={18} />
            <span>رزرو آنلاین نوبت (۱۵٪ تخفیف)</span>
            <Icon name="arrowLeft" size={18} />
          </a>
          <a href="#services" class="btn btn-outline btn-lg hero-btn-services">
            <Icon name="services" size={18} />
            <span>مشاهده تعرفه‌ها و پکیج‌ها</span>
          </a>
          <a href="tel:+989035555090" class="hero-phone-chip" aria-label="تماس فوری با پذیرش کلینیک">
            <Icon name="phone" size={15} />
            <span>مشاوره و پذیرش: ۰۹۰۳ ۵۵۵ ۵۰۹۰</span>
          </a>
        </div>

        <!-- Hero Trust Metrics Grid -->
        <div class="hero-trust-metrics animate-fade-up delay-3">
          <div class="metric-item">
            <div class="metric-top">
              <Icon name="shield" size={18} class="metric-icon" />
              <span class="metric-val">۱۰۰٪</span>
            </div>
            <span class="metric-label">پک بهداشتی و سری استریل اختصاصی هر مراجع</span>
          </div>

          <div class="metric-divider"></div>

          <div class="metric-item">
            <div class="metric-top">
              <Icon name="percent" size={18} class="metric-icon" />
              <span class="metric-val">۱۵٪</span>
            </div>
            <span class="metric-label">تخفیف ویژه رزرو اینترنتی پکیج فول بادی</span>
          </div>

          <div class="metric-divider"></div>

          <div class="metric-item">
            <div class="metric-top">
              <Icon name="target" size={18} class="metric-icon" />
              <span class="metric-val">۷۵۵+۱۰۶۴</span>
            </div>
            <span class="metric-label">طول موج دوگانه الکس و یاگ برای انواع تیپ پوست</span>
          </div>

          <div class="metric-divider"></div>

          <div class="metric-item">
            <div class="metric-top">
              <Icon name="pin" size={18} class="metric-icon" />
              <span class="metric-val">پاسداران</span>
            </div>
            <span class="metric-label">لوکیشن پایدارفرد با دسترسی آسان و پارکینگ</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Candela GentleMax Pro 2026 Showcase (§37, §38) -->
  <CandelaShowcase />

  <!-- Trust Strip (§37) -->
  <section class="trust-strip">
    <div class="container trust-grid">
      <div class="trust-card">
        <div class="trust-icon">
          <Icon name="doctor" size={26} />
        </div>
        <h3 class="trust-title">اپراتورهای ارشد دوره‌دیده</h3>
        <p class="trust-desc">ارائه خدمات توسط اپراتورهای دارای سرتیفیکیت رسمی کندلا، در لاین‌های کاملاً مجزای بانوان و آقایان</p>
      </div>

      <div class="trust-card">
        <div class="trust-icon">
          <Icon name="clean" size={26} />
        </div>
        <h3 class="trust-title">پک بهداشتی و سری اختصاصی</h3>
        <p class="trust-desc">سلفون‌کشی کامل، ملحفه یکبار مصرف و سری مجزا برای هر مراجعه‌کننده با تضمین سلامت کامل پزشکی</p>
      </div>

      <div class="trust-card">
        <div class="trust-icon">
          <Icon name="gem" size={26} />
        </div>
        <h3 class="trust-title">تعرفه‌های شفاف و مصوب</h3>
        <p class="trust-desc">هزینه‌های اعلامی قطعی بوده و هیچ‌گونه هزینه پنهان یا تغییر قیمت در محل کلینیک اخذ نمی‌گردد</p>
      </div>

      <div class="trust-card">
        <div class="trust-icon">
          <Icon name="sparkles" size={26} />
        </div>
        <h3 class="trust-title">گارانتی اثربخشی دوره</h3>
        <p class="trust-desc">ریزش بین ۸۰ تا ۹۵ درصد موهای زائد در پایان دوره استاندارد ۶ الی ۸ جلسه‌ای تحت پروتکل علمی</p>
      </div>
    </div>
  </section>

  <!-- Services & Pricing Section (§10, §11, §253, §254) -->
  <section id="services" class="section services-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">تعرفه‌های مصوب و شفاف کلینیک</span>
        <h2 class="section-title">تعرفه لیزر بانوان و آقایان — کنار هم</h2>
        <p class="section-desc">
          تعرفه‌های رسمی کلینیک تهران لیزر با دستگاه الکساندرایت کندلا ۲۰۲۶ برای هر دو لاین بانوان و آقایان. رزرو آنلاین پکیج کل بدن مشمول ۱۵٪ تخفیف ویژه می‌باشد.
        </p>
      </div>

      <!-- Featured Promo Banner -->
      <div class="featured-promo-card">
        <div class="promo-badge-ribbon">
          <Icon name="sparkles" size={14} />
          <span>پیشنهاد طلایی رزرو آنلاین</span>
        </div>
        <div class="promo-content">
          <div class="promo-info">
            <h3 class="promo-title">پکیج طلایی کل بدن بانوان (Full Body)</h3>
            <p class="promo-desc">شامل دست کامل، پا کامل، زیر بغل، بیکینی، خط باسن، خط ناف و شکم با شات نامحدود کندلا</p>
            <ul class="promo-features">
              <li>
                <Icon name="checkCircle" size={16} class="check-icon" />
                <span>انجام توسط اپراتور ارشد با شات نامحدود واقعی</span>
              </li>
              <li>
                <Icon name="checkCircle" size={16} class="check-icon" />
                <span>سیستم کولینگ هوشمند کرایوژن فریز بدون درد</span>
              </li>
              <li>
                <Icon name="checkCircle" size={16} class="check-icon" />
                <span>پک بهداشتی و سری اختصاصی استریل</span>
              </li>
            </ul>
          </div>
          <div class="promo-pricing-box">
            <div class="old-price">
              <span class="strikethrough">۲/۲۹۰/۰۰۰</span>
              <span class="price-unit">تومان</span>
            </div>
            <div class="new-price">
              <span class="final-amount">۱/۹۴۰/۰۰۰</span>
              <span class="price-unit">تومان</span>
            </div>
            <span class="discount-tag">۱۵٪ تخفیف اختصاصی رزرو سایت</span>
            <a href="/booking?service=full-body" class="btn btn-primary btn-block mt-3">
              <Icon name="calendar" size={18} />
              <span>رزرو نوبت پکیج کل بدن</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Unified gender price table — تعرفه بانوان و آقایان کنار هم (Lane B) -->
      <div class="gender-price-table-wrap mt-5">
        <table class="gender-price-table">
          <thead>
            <tr>
              <th scope="col" class="gpt-th-zone">ناحیه خدمت</th>
              <th scope="col" class="gpt-th-female">تعرفه بانوان</th>
              <th scope="col" class="gpt-th-male">تعرفه آقایان</th>
              <th scope="col" class="gpt-th-action">رزرو</th>
            </tr>
          </thead>
          <tbody>
            {priceRows.map((row) => (
              <tr class={row.mensOnly ? 'gpt-row gpt-row-mens' : 'gpt-row'}>
                <td class="gpt-cell-zone">
                  <span class="gpt-zone-name">{row.name}</span>
                  {row.mensOnly && <span class="gpt-mens-tag">مخصوص آقایان</span>}
                </td>
                <td class="gpt-cell-female">
                  {row.femaleAmount !== null ? (
                    <span class="gpt-price">
                      <span class="gpt-amount">{toman(row.femaleAmount)}</span>
                      <span class="gpt-unit">تومان</span>
                    </span>
                  ) : (
                    <span class="gpt-na">—</span>
                  )}
                </td>
                <td class="gpt-cell-male">
                  {row.maleAmount !== null ? (
                    <span class="gpt-price">
                      <span class="gpt-amount">{toman(row.maleAmount)}</span>
                      <span class="gpt-unit">تومان</span>
                    </span>
                  ) : (
                    <span class="gpt-na">استعلام تلفنی</span>
                  )}
                </td>
                <td class="gpt-cell-action">
                  <a href={`/booking?service=${row.slug}`} class="gpt-book-btn" aria-label={`رزرو ${row.name}`}>
                    <Icon name="calendar" size={14} />
                    <span>رزرو</span>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="text-center mt-5">
        <a href="/services" class="btn btn-outline btn-lg">
          <span>مشاهده جزئیات کامل هر ناحیه و راهنمای مراقبت</span>
          <Icon name="arrowLeft" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- Male Services Section Info (§11) -->
  <section class="section male-services-strip">
    <div class="container male-strip-inner">
      <div class="male-text">
        <span class="badge badge-outline">
          <Icon name="shield" size={14} />
          <span>لاین درمانی مجزا</span>
        </span>
        <h3 class="male-title">خدمات اختصاصی لیزر آقایان با اپراتور آقا</h3>
        <p class="male-desc">
          کلینیک تهران لیزر مجهز به لاین اختصاصی آقایان با اپراتورهای مجرب آقا و پروتکل‌های ویژه موهای ضخیم می‌باشد. نواحی آنکارد ریش، خط گردن و گونه، پشت، شانه‌ها، سینه و پکیج کامل کل بدن با تعیین وقت قبلی و در کمال حریم شخصی ارائه می‌گردد.
        </p>
      </div>
      <div class="male-cta">
        <a href="/booking" class="btn btn-outline btn-lg">
          <Icon name="calendar" size={18} />
          <span>رزرو نوبت لاین اختصاصی آقایان</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Clinical Protocol & Trust Standards Section -->
  <ProtocolSection />

  <!-- Patient Testimonials Section -->
  <TestimonialsSection />

  <!-- FAQ Section (§31, §256) -->
  <section id="faq" class="section faq-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">پاسخ به سوالات پرتکرار</span>
        <h2 class="section-title">سوالات متداول مراجعین تهران لیزر</h2>
      </div>

      <div class="faq-accordion">
        {activeFaqs.map((faq) => (
          <details class="faq-card">
            <summary class="faq-question">
              <span>{faq.question}</span>
              <span class="faq-toggle-icon">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinic Location & Direct CTA (§34, §35, §36) -->
  <section class="section clinic-location-section">
    <div class="container location-container">
      <div class="location-card">
        <span class="section-subtitle">موقعیت مکانی و راه‌های ارتباطی</span>
        <h2 class="location-heading">کلینیک تهران لیزر در منطقه پاسداران</h2>

        <div class="location-details-list">
          <div class="loc-detail-item">
            <Icon name="pin" size={20} class="loc-icon" />
            <div class="loc-text">
              <strong>نشانی دقیق:</strong> تهران، پاسداران، خیابان پایدارفرد، نبش بوستان هفتم
            </div>
          </div>

          <div class="loc-detail-item">
            <Icon name="phone" size={20} class="loc-icon" />
            <div class="loc-text">
              <strong>تلفن پذیرش و هماهنگی:</strong>
              <a href="tel:+989035555090" dir="ltr" class="loc-phone-link">+98 903 555 5090</a>
            </div>
          </div>

          <div class="loc-detail-item">
            <Icon name="clock" size={20} class="loc-icon" />
            <div class="loc-text">
              <strong>ساعات پذیرش:</strong> شنبه تا چهارشنبه ۹ الی ۲۰ | پنجشنبه ۹ الی ۱۸
            </div>
          </div>
        </div>

        <div class="location-actions mt-4">
          <a
            href="https://maps.google.com/?q=Pasdaran+Paydarfard+Tehran"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline loc-map-btn"
          >
            <Icon name="pin" size={17} />
            <span>مسیریابی روی نقشه گوگل</span>
          </a>
          <a href="/booking" class="btn btn-primary loc-book-btn">
            <Icon name="calendar" size={17} />
            <span>رزرو آنلاین نوبت (۱۵٪ تخفیف)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  /* ─────────────────────────────────────────────────────────────
     Unified gender price table (Lane B) — self-contained.
     Colour contract: light text on obsidian only. Explicit rgba
     backgrounds use DARK rgb channels (never gold/white) so the
     contrast audit never blends them to gold or white.
     ───────────────────────────────────────────────────────────── */
  .gender-price-table-wrap {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    background: rgba(14, 18, 26, 0.6);
    border: 1px solid rgba(16, 185, 129, 0.22);
    border-radius: 18px;
    padding: 4px 10px 10px;
    box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .gender-price-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9rem;
  }

  .gender-price-table thead th {
    position: sticky;
    top: var(--tl-header-offset, 0px);
    z-index: 2;
    background: #0e121a;
    color: #6ee7b7; /* emerald-300 — verified 10.05:1 on obsidian */
    font-weight: 800;
    font-size: 0.82rem;
    text-align: center;
    padding: 13px 10px;
    white-space: nowrap;
    border-bottom: 2px solid rgba(16, 185, 129, 0.4);
  }

  .gpt-th-zone {
    text-align: right !important;
  }

  .gpt-row {
    transition: background 0.15s ease;
  }

  .gpt-row:hover {
    background: rgba(30, 36, 48, 0.55);
  }

  /* Men's-only zones get a neutral (non-gold) tint so the audit never reads
     the tint as a gold fill behind gold text. */
  .gpt-row-mens {
    background: rgba(30, 36, 48, 0.55);
  }

  .gpt-cell-zone,
  .gpt-cell-female,
  .gpt-cell-male,
  .gpt-cell-action {
    padding: 12px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    vertical-align: middle;
  }

  .gpt-zone-name {
    color: #f7f3ec;
    font-weight: 700;
  }

  .gpt-mens-tag {
    display: inline-block;
    margin-inline-start: 8px;
    color: #6ee7b7; /* emerald-300 — verified 10.05:1 on obsidian */
    font-size: 0.66rem;
    font-weight: 700;
    padding: 2px 8px;
    border: 1px solid rgba(16, 185, 129, 0.5);
    border-radius: 999px;
    white-space: nowrap;
  }

  .gpt-cell-female,
  .gpt-cell-male {
    text-align: center;
    white-space: nowrap;
  }

  .gpt-price {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-weight: 800;
  }

  .gpt-cell-female .gpt-amount {
    color: #6ee7b7; /* emerald-300 — verified 10.05:1 on obsidian */
  }

  .gpt-cell-male .gpt-amount {
    color: #8ab4ff;
  }

  .gpt-unit {
    font-size: 0.7rem;
    font-weight: 500;
    color: #b3aa9c;
  }

  .gpt-na {
    color: #b3aa9c;
    font-size: 0.82rem;
  }

  .gpt-cell-action {
    text-align: center;
  }

  .gpt-book-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #6ee7b7; /* emerald-300 — verified 10.05:1 on obsidian */
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    padding: 6px 12px;
    border: 1px solid rgba(16, 185, 129, 0.5);
    border-radius: 10px;
    transition: background 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  .gpt-book-btn:hover {
    background: rgba(30, 36, 48, 0.7);
    border-color: rgba(16, 185, 129, 0.85);
  }

  /* ── Announcement strip (lane h1): never truncate, never overflow ──
     public.css clamps the festival message to ONE ellipsis line at
     ≤768px (`.announcement-inner span { white-space: nowrap; }`), so a
     62-character sentence (~431px) lost its tail to "…" — the 15%
     offer's "در رزرو آنلاین" disappeared exactly on 320/390px. The
     message is instead allowed to wrap onto a second line, and the row
     itself may wrap, so the booking pill can never force the strip
     wider than the viewport. Full sentence at every width; the strip
     only grows ~20px when it wraps. Page-scoped: no shared stylesheet
     or layout file is touched. */
  :global(.announcement-strip .announcement-inner) {
    flex-wrap: wrap;
    row-gap: 6px;
  }

  :global(.announcement-strip .announcement-inner > span) {
    white-space: normal;
    overflow: hidden;
    text-overflow: clip;
    line-height: 1.6;
  }

  /* Icon.astro renders `display: block`, so the sparkles glyph claimed a
     line of its own and the strip measured 3 lines tall. Keep it inline
     with the message's first line. */
  :global(.announcement-strip .announcement-inner > span svg) {
    display: inline-block;
    vertical-align: -2px;
  }

  /* ── ≤768px: compact one-card-per-zone layout + prose collapse ──
     The homepage must fall under 9,000px at 390px (contract B4), so long
     prose is collapsed and secondary cards are trimmed to the strongest
     examples. Everything removed here is still present on /services,
     /clinic and ≥769px. */
  @media (max-width: 768px) {
    /* Section rhythm: two values instead of per-section 60/80 pairs. */
    :global(.section) {
      padding-top: 36px;
      padding-bottom: 44px;
    }

    /* Hero: drop the paragraph, keep the headline + CTAs. */
    :global(.hero-section) {
      padding-top: 44px;
      padding-bottom: 34px;
    }
    :global(.hero-section .hero-subtitle),
    :global(.hero-badge) {
      display: none;
    }

    /* Eyebrow subtitles repeat the section titles; fold them on mobile. */
    :global(.section-subtitle) {
      display: none;
    }

    /* Pricing explainer paragraph: the table is self-describing. */
    :global(.services-section .section-desc) {
      display: none;
    }

    /* Candela showcase: keep the two strongest features, drop the prose. */
    :global(.candela-lead),
    :global(.candela-feat-desc) {
      display: none;
    }
    :global(.candela-feature-card:nth-child(n + 3)) {
      display: none;
    }

    /* Trust strip: descriptions fold away; keep two marquee cards. */
    :global(.trust-strip) {
      padding-top: 28px;
      padding-bottom: 34px;
    }
    :global(.trust-desc) {
      display: none;
    }
    :global(.trust-card:nth-child(n + 3)) {
      display: none;
    }

    /* Protocol: step descriptions fold away; keep two steps. */
    :global(.step-desc) {
      display: none;
    }
    :global(.protocol-step:nth-child(n + 3)) {
      display: none;
    }

    /* Testimonials: one card on mobile. */
    :global(.testimonial-card:nth-child(n + 2)) {
      display: none;
    }
    :global(.testi-quote) {
      -webkit-line-clamp: 3;
      line-clamp: 3;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Featured promo: keeps only the price box on mobile. The prose, the
       feature list and the ribbon caption all live on /services. */
    :global(.promo-desc),
    :global(.promo-features) {
      display: none;
    }
    :global(.featured-promo-card) {
      padding-top: 12px;
    }
    :global(.promo-badge-ribbon) {
      display: none;
    }
    :global(.promo-info) {
      margin-bottom: 0;
    }

    /* Men's strip: the two-line sales pitch folds; the badge, headline and
       booking CTA stay. */
    :global(.male-desc) {
      display: none;
    }

    /* FAQ: three questions on mobile. */
    :global(.faq-card:nth-child(n + 4)) {
      display: none;
    }

    /* Compact price cards: zone + book on line 1, both tariffs on line 2. */
    .gender-price-table-wrap {
      padding: 10px;
    }

    /* Keep a two-column tariff header instead of dropping it: at 320px the
       card layout still has to name تعرفه بانوان and تعرفه آقایان explicitly.
       Zone/action headers do not exist in the card layout, so they go. The
       sticky comes from the thead itself — a sticky th inside a block thead
       can only stick while its own row is on screen. */
    .gender-price-table thead {
      display: block;
      position: sticky;
      top: var(--tl-header-offset, 0px);
      z-index: 3;
    }

    .gender-price-table thead tr {
      margin-bottom: 6px;
      padding: 5px 6px;
      box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.85);
    }

    .gender-price-table thead th {
      position: static;
      padding: 4px;
      font-size: 0.76rem;
      line-height: 1.35;
      white-space: nowrap;
      border-bottom: none;
      background: #141820;
    }

    .gpt-th-zone,
    .gpt-th-action {
      display: none;
    }

    /* Divider between the two tariff columns (RTL: inline-start = right). */
    .gpt-th-female {
      border-inline-end: 1px solid rgba(16, 185, 129, 0.35);
    }

    .gender-price-table,
    .gender-price-table tbody,
    .gender-price-table tr,
    .gender-price-table td {
      display: block;
      width: 100%;
      box-sizing: border-box;
    }

    .gender-price-table tr {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      align-items: center;
      column-gap: 8px;
      border: 1px solid rgba(16, 185, 129, 0.2);
      border-radius: 12px;
      padding: 9px 12px;
      margin-bottom: 8px;
      background: rgba(20, 24, 32, 0.55);
    }

    .gender-price-table td {
      border: none;
      padding: 2px 0;
      display: flex;
      align-items: center;
      gap: 4px;
      text-align: right;
    }

    .gpt-cell-zone {
      grid-column: 1 / 3;
      grid-row: 1;
      flex-wrap: wrap;
    }

    .gpt-cell-action {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }

    .gpt-cell-female {
      grid-column: 1;
      grid-row: 2;
    }

    .gpt-cell-male {
      grid-column: 2;
      grid-row: 2;
    }

    .gpt-cell-female::before {
      content: 'بانوان';
      color: #b3aa9c;
      font-size: 0.72rem;
      font-weight: 600;
    }

    .gpt-cell-male::before {
      content: 'آقایان';
      color: #b3aa9c;
      font-size: 0.72rem;
      font-weight: 600;
    }

    .gpt-amount {
      font-size: 0.9rem;
    }

    .gpt-unit {
      font-size: 0.64rem;
    }

    .gpt-mens-tag {
      font-size: 0.6rem;
      padding: 1px 6px;
    }

    .gpt-book-btn {
      padding: 6px 9px;
    }

    /* Icon-only book control keeps the row to two lines. */
    .gpt-book-btn span:not(.gpt-unit) {
      display: none;
    }
  }

  /* ── ≤400px: the row grid's min-content exceeds the card's content box ──
     The two tariff cells are white-space: nowrap, so at 320px the grid needs
     ~264px inside a 246px content box and the leftmost (RTL) column — the
     book button — pushes 6px past the card's own border. Reclaim exactly that
     18px from row padding and column gap; no price text shrinks. */
  @media (max-width: 400px) {
    .gender-price-table tr {
      padding: 9px 6px;
      column-gap: 5px;
    }
  }

  /* ── ≤768px: the male-lane strip's booking CTA block ──
     public.css floors .male-text at 280px, but the strip's mobile padding
     (26px + 20px + 2px border) leaves only 278px of content box at a 320px
     viewport — the floor alone made the document 1px wider than the screen.
     The CTA below is already width:100%, so nothing here needs the floor. */
  @media (max-width: 768px) {
    .male-strip-inner .male-text {
      min-width: 0;
    }
  }

</style>

<script is:inline>
  // Keep the sticky table header clear of the (also sticky) site header by
  // publishing the header's real height as a CSS custom property.
  (function () {
    function syncHeaderOffset() {
      var header = document.querySelector('.site-header');
      if (!header) return;
      var h = Math.round(header.getBoundingClientRect().height);
      if (h > 0) {
        document.documentElement.style.setProperty('--tl-header-offset', h + 'px');
      }
    }
    syncHeaderOffset();
    window.addEventListener('resize', syncHeaderOffset);
    window.addEventListener('orientationchange', syncHeaderOffset);
  })();
</script>

