---
import PublicLayout from '../layouts/PublicLayout.astro';
import { BookingWizard } from '../components/booking/BookingWizard';
import Icon from '../components/ui/Icon.astro';
import { env } from 'cloudflare:workers';
import { listPublicServices } from '../server/repositories';
import { createBreadcrumbSchema } from '../lib/seo';

let services: Awaited<ReturnType<typeof listPublicServices>> = [];
try {
  services = await listPublicServices(env.DB);
} catch (e) {
  console.error('Failed to load services for booking page:', e);
}

const serviceParam = Astro.url.searchParams.get('service') ?? undefined;

// BreadcrumbList schema for the booking funnel (§31, §135)
const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
  { name: 'رزرو آنلاین نوبت', url: '/booking' },
]);
---

<PublicLayout
  title="رزرو آنلاین نوبت — کلینیک تخصصی تهران لیزر"
  description="سامانه هوشمند و شبانه‌روزی رزرو آنلاین نوبت کلینیک تهران لیزر پاسداران. انتخاب خدمت، ساعت و تاریخ بدون معطلی با ۱۵٪ تخفیف ویژه سایت."
  canonicalUrl="/booking"
  theme="dark"
  keywords={[
    'رزرو آنلاین نوبت لیزر تهران',
    'رزرو وقت لیزر پاسداران',
    'نوبت دهی لیزر تهران لیزر',
    'تخفیف رزرو آنلاین لیزر',
  ]}
  jsonLd={breadcrumbJsonLd}
>
  <div class="booking-page-header">
    <div class="container text-center">
      <span class="section-subtitle">پذیرش هوشمند و بدون معطلی</span>
      <h1 class="page-title">رزرو آنلاین نوبت کلینیک تهران لیزر</h1>
      <p class="page-subtitle">
        مراحل زیر را جهت ثبت نوبت خود تکمیل نمایید. تأییدیه و جزئیات نوبت بلافاصله ثبت خواهد شد.
      </p>
      <ul class="booking-trust-row">
        <li>
          <Icon name="check" size={16} stroke={2.6} class="trust-ico" />
          ثبت آنی نوبت در سامانه
        </li>
        <li>
          <Icon name="percent" size={16} stroke={2.4} class="trust-ico" />
          ۱۵٪ تخفیف ویژه رزرو آنلاین
        </li>
        <li>
          <Icon name="sms" size={16} stroke={2.1} class="trust-ico" />
          پشتیبانی پیامکی پس از ثبت
        </li>
      </ul>
    </div>
  </div>

  <section class="section booking-page-section">
    <div class="container container-sm">
      <BookingWizard
        client:load
        initialServices={services}
        preselectedSlug={serviceParam}
      />
    </div>
  </section>
</PublicLayout>

<style>
  /* Dark 3D Obsidian-Gold page chrome for the booking funnel.
     The shared stylesheet has no theme-dark-obsidian rules for these
     header elements, so they are themed here (Astro scopes them to this page). */
  .booking-page-header {
    background:
      radial-gradient(circle at 82% 18%, rgba(16, 185, 129, 0.16) 0%, transparent 45%),
      radial-gradient(circle at 15% 90%, rgba(180, 140, 45, 0.1) 0%, transparent 45%),
      linear-gradient(180deg, #121417 0%, #0a0b0d 100%);
    border-bottom: 1px solid rgba(16, 185, 129, 0.22);
    padding: 52px 0 40px;
  }

  .booking-page-header .page-title {
    color: #34d399;
    text-shadow: 0 0 34px rgba(110, 231, 183, 0.28);
  }

  .booking-page-header .page-subtitle {
    color: #9aa3b2;
  }

  .booking-trust-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    color: rgba(110, 231, 183, 0.94);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .booking-trust-row li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .trust-ico {
    flex: 0 0 auto;
    color: #10b981;
    filter: drop-shadow(0 0 6px rgba(110, 231, 183, 0.45));
  }

  @media (max-width: 576px) {
    .booking-page-header {
      padding: 38px 0 30px;
    }

    .booking-trust-row {
      gap: 8px 14px;
      font-size: 0.78rem;
    }
  }

  /* public.css themes .section-subtitle for light surfaces
     (--color-accent-on-light); on this dark header it measured 3.31:1.
     Accent-on-dark restores AA (9.45:1 on the obsidian background). */
  .booking-page-header .section-subtitle {
    color: var(--gold-400);
  }

  /* ═════════════════════════════════════════════════════════════
     SITE-CHROME TOUCH TARGETS (page-scoped).
     The header/footer are rendered by PublicLayout, so these rules
     must use :global(). Measured before: .announcement-link 34px,
     .footer-phone-link 26px, .legal-links a 24px, .admin-entry-link
     24px, .footer-social-link 42px, .sticky-book 36px — all below
     the 44px WCAG 2.5.8 minimum.
     ═════════════════════════════════════════════════════════════ */
  :global(.announcement-link),
  :global(.footer-phone-link),
  :global(.clinic-direct-contact a),
  :global(.footer-social-link),
  :global(.legal-links a),
  :global(.admin-entry-link),
  :global(.sticky-book),
  :global(.mobile-menu-btn),
  :global(.header-phone) {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  :global(.mobile-menu-btn),
  :global(.header-phone) {
    min-width: 44px;
    justify-content: center;
  }

  :global(.legal-links) {
    align-items: center;
    flex-wrap: wrap;
    row-gap: 0;
  }


  /* ═════════════════════════════════════════════════════════════
     MODERNIZATION LAYER — consistent rhythm + Persian typography.
     The booking funnel itself lives in the shared BookingWizard
     component (out of this lane's scope); this only shapes the page
     chrome around it.
     ═════════════════════════════════════════════════════════════ */

  .booking-page-header {
    padding: clamp(44px, 6vw, 76px) 0 clamp(32px, 4.5vw, 56px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .booking-page-header .section-subtitle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.4);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .booking-page-section {
    padding-block: clamp(28px, 4vw, 48px) clamp(48px, 6vw, 80px);
  }

  .booking-page-header .page-title {
    letter-spacing: normal;
    line-height: 1.45;
  }

  .booking-page-header .page-subtitle {
    line-height: 2;
    max-width: 42rem;
    margin-inline: auto;
  }

  /* public.css tracks .section-subtitle; on this dark header the text is
     Persian, where letter-spacing breaks glyph joining. */
  .booking-page-header .section-subtitle,
  .section-subtitle {
    letter-spacing: normal;
  }

  .booking-trust-row {
    gap: 12px 28px;
    margin-top: clamp(20px, 3vw, 28px);
    line-height: 1.9;
  }

  .booking-trust-row li {
    min-height: 32px;
  }

  @media (max-width: 576px) {
    .booking-page-header {
      padding: 36px 0 30px;
    }

    .booking-trust-row {
      gap: 10px 16px;
    }
  }

  /* ─────────────────────────────────────────────────────────────
     The shared booking wizard renders on this route. These scoped
     rules only tighten the controls that measured under the 44px
     minimum on /booking; component markup is untouched.
     ───────────────────────────────────────────────────────────── */
  :global(.btn-advance),
  :global(.btn),
  :global(.date-slot-card),
  :global(.gender-card),
  :global(.card-radio),
  :global(.chip-remove-btn),
  :global(.basket-close) {
    min-height: 44px;
  }

  :global(.step-desc),
  :global(.form-hint),
  :global(.card-desc) {
    line-height: 1.95;
  }

  :global(.stepper-counter) {
    font-variant-numeric: tabular-nums;
  }

</style>
