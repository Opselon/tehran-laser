          </div>

          <div class="sheba-items-grid">
            <!-- Account Owner & Bank -->
            <div class="sheba-item">
              <div class="sheba-item-head">
                <span class="sheba-label">صاحب حساب رسمی:</span>
              </div>
              <div class="sheba-value-display">
                <strong>کلینیک تخصصی تهران لیزر (مدیریت مالی)</strong>
                <span class="bank-name">بانک سامان / ملت</span>
              </div>
            </div>

            <!-- Card Number -->
            <div class="sheba-item">
              <div class="sheba-item-head">
                <span class="sheba-label">شماره کارت:</span>
                <button
                  type="button"
                  class="btn-copy-chip copy-trigger-btn"
                  data-copy="6104337890123456"
                  data-label="شماره کارت"
                  aria-label="کپی شماره کارت"
                >
                  <Icon name="document" size={14} class="btn-icon" />
                  <span class="btn-text">کپی کارت</span>
                </button>
              </div>
              <div class="sheba-value-display code-font" dir="ltr">
                <span>6104-3378-9012-3456</span>
