            </div>
          </div>
        </div>

        <!-- Address & Navigation Card (Hub) -->
        <div class="contact-glass-card location-hub-card mt-5">
          <div class="location-header-row">
            <div class="location-title-group">
              <div class="card-icon-wrap gold-glow sm">
                <Icon name="pin" size={22} class="card-icon" />
              </div>
              <div>
                <h2 class="location-card-title">نشانی حضوری و نقشه کلینیک تهران لیزر</h2>
