                <Icon name="external" size={15} />
                <span>مسیریابی با بلد</span>
              </a>
              <a
                href="https://maps.google.com/?q=35.7645,51.4628+(Tehran+Laser+Clinic)"
                target="_blank"
                rel="noopener noreferrer"
                class="nav-app-btn"
                aria-label="مسیریابی در گوگل مپ"
