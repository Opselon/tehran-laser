---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { createBreadcrumbSchema, resolveCanonicalOrigin } from '../lib/seo';
import '../styles/contact.css';

// ContactPage entity + breadcrumbs. The clinic node itself is emitted once by
// the layout (canonical @id <origin>/#clinic), so we only link to it.
// Origin is resolved at runtime from SITE_URL — tehranlaser.ir is a parked
// domain and must never be emitted as an @id/url.
const origin = resolveCanonicalOrigin();
const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['ContactPage', 'MedicalWebPage'],
  '@id': `${origin}/contact#contact`,
  url: `${origin}/contact`,
  name: 'تماس و آدرس کلینیک تهران لیزر پاسداران',
  description:
    'راه‌های ارتباطی، آدرس دقیق در پاسداران خیابان پایدارفرد، شماره تماس مستقیم پذیرش، مشاوره فوری در واتساپ و لوکیشن مسیریابی.',
  inLanguage: 'fa-IR',
  mainEntity: { '@id': `${origin}/#clinic` },
  isPartOf: { '@id': `${origin}/#website` },
};

const breadcrumbItems = [
  { name: 'صفحه اصلی', url: '/' },
  { name: 'تماس و آدرس', url: '/contact' },
];

const breadcrumbJsonLd = createBreadcrumbSchema(breadcrumbItems);
---

<PublicLayout
  title="تماس و آدرس کلینیک تهران لیزر — پاسداران، خیابان پایدارفرد"
  description="راه‌های ارتباطی، آدرس دقیق در پاسداران خیابان پایدارفرد، شماره تماس مستقیم پذیرش، مشاوره فوری در واتساپ و لوکیشن مسیریابی کلینیک تهران لیزر."
  canonicalUrl="/contact"
  keywords={[
    'تماس کلینیک تهران لیزر',
    'آدرس لیزر پاسداران',
    'شماره تلفن لیزر پایدارفرد',
    'واتساپ کلینیک لیزر تهران',
  ]}
  jsonLd={[contactJsonLd, breadcrumbJsonLd]}
  theme="dark"
>
  <div class="contact-page-wrapper">
    <Breadcrumbs items={breadcrumbItems} />
    <!-- Header Hero -->
    <div class="contact-hero-strip">
      <div class="container text-center">
        <div class="luxury-badge">
          <Icon name="sparkles" size={14} class="badge-icon" />
          <span>ارتباط مستقیم با مرکز تخصصی پاسداران</span>
        </div>
        <h1 class="page-title">تماس با کلینیک تهران لیزر</h1>
        <p class="page-subtitle">
          تیم پذیرش و مشاورین پوست و لیزر ما همه‌روزه در ساعات کاری آماده پاسخگویی، مشاوره تخصصی و راهنمایی شما هستند
        </p>

        <!-- Live Operating Status Indicator -->
        <div class="live-status-pill" id="liveStatusPill">
          <span class="status-dot"></span>
          <span class="status-text" id="liveStatusText">ساعات پاسخگویی: شنبه تا چهارشنبه ۹ الی ۲۰ | پنجشنبه ۹ الی ۱۸</span>
        </div>
      </div>
    </div>

    <!-- Main Content Section -->
    <section class="contact-main-section">
      <div class="container container-contact">
        <!-- 3 Primary Communication Cards -->
        <div class="contact-cards-grid">
          <!-- Card 1: Direct Phone Call -->
          <div class="contact-glass-card phone-card">
            <div class="card-icon-wrap gold-glow">
              <Icon name="phone" size={26} class="card-icon" />
            </div>
            <h2 class="card-title">تماس تلفنی مستقیم</h2>
            <p class="card-desc">
              رزرو تلفنی سریع، پیگیری پرونده، مشاوره اولیه و استعلام تعرفه اختصاصی آقایان
            </p>
            <div class="card-actions-box">
              <a href="tel:+989035555090" class="btn-contact-gold dial-link" aria-label="تماس مستقیم با ۰۹۰۳ ۵۵۵ ۵۰۹۰">
                <Icon name="phone" size={16} />
                <span><bdi dir="ltr">۰۹۰۳ ۵۵۵ ۵۰۹۰</bdi></span>
              </a>
              <button
                type="button"
                class="btn-contact-outline copy-trigger-btn"
                data-copy="09035555090"
                data-label="شماره تلفن"
                aria-label="کپی شماره تلفن کلینیک"
              >
                <Icon name="document" size={15} class="btn-icon" />
                <span class="btn-text">کپی شماره تماس</span>
              </button>
            </div>
            <div class="card-footer-meta">
              <Icon name="clock" size={13} />
              <span>پاسخگویی سریع توسط مشاورین پذیرش</span>
            </div>
          </div>

          <!-- Card 2: WhatsApp Instant Consultation -->
          <div class="contact-glass-card whatsapp-card">
            <div class="card-icon-wrap emerald-glow">
              <Icon name="sms" size={26} class="card-icon" />
            </div>
            <div class="card-badge-instant">
              <Icon name="sparkles" size={12} />
              <span>پاسخگویی آنلاین</span>
            </div>
            <h2 class="card-title">مشاوره فوری در واتساپ</h2>
            <p class="card-desc">
              مشاوره نوع پوست و مو، استعلام تخفیف‌ها، ارسال عکس و دریافت لوکیشن مستقیم
            </p>
            <div class="whatsapp-triggers-list">
              <a
                href="https://wa.me/989035555090?text=%D8%B3%D9%84%D8%A7%D9%85%D8%8C%20%D8%AC%D9%87%D8%AA%20%D9%85%D8%B4%D8%A7%D9%88%D8%B1%D9%87%20%D9%88%20%D8%B1%D8%B2%D8%B1%D9%88%20%D9%86%D9%88%D8%A8%D8%AA%20%D9%84%DB%8C%D8%B2%D8%B1%20%D9%BE%DB%8C%D8%A7%D9%85%20%D9%85%DB%8C%E2%80%8C%D8%AF%D9%87%D9%85."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-contact-gold wa-main-btn"
              >
                <Icon name="send" size={16} />
                <span>شروع گفتگوی فوری و مشاوره</span>
              </a>
              <div class="quick-wa-chips">
                <a
                  href="https://wa.me/989035555090?text=%D8%B3%D9%84%D8%A7%D9%85%D8%8C%20%D8%AC%D9%87%D8%AA%20%D8%A7%D8%B3%D8%AA%D8%B9%D9%84%D8%A7%D9%85%20%D8%AA%D8%B9%D8%B1%D9%81%D9%87%20%D9%88%20%D9%86%D9%88%D8%A8%D8%AA%E2%80%8C%D8%AF%D9%87%DB%8C%20%D9%84%D8%A7%DB%8C%D9%86%20%D8%A2%D9%82%D8%A7%DB%8C%D8%A7%D9%86%20%D9%BE%DB%8C%D8%A7%D9%85%20%D9%85%DB%8C%E2%80%8C%D8%AF%D9%87%D9%85."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa-chip"
                >
                  <Icon name="arrowLeft" size={12} />
                  <span>استعلام تعرفه آقایان</span>
                </a>
                <a
                  href="https://wa.me/989035555090?text=%D8%B3%D9%84%D8%A7%D9%85%D8%8C%20%D9%84%D8%B7%D9%81%D8%A7%D9%8B%20%D9%84%D9%88%DA%A9%DB%8C%D8%B4%D9%86%20%D8%AF%D9%82%DB%8C%D9%82%20%DA%A9%D9%84%DB%8C%D9%86%DB%8C%DA%A9%20%D8%AA%D9%87%D8%B1%D8%A7%D9%86%20%D9%84%DB%8C%D8%B2%D8%B1%20%D8%B1%D8%A7%20%D8%A7%D8%B1%D8%B3%D8%A7%D9%84%20%D9%81%D8%B1%D9%85%D8%A7%DB%8C%DB%8C%D8%AF."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa-chip"
                >
                  <Icon name="arrowLeft" size={12} />
                  <span>ارسال لوکیشن در واتساپ</span>
                </a>
              </div>
            </div>
            <div class="card-footer-meta">
              <Icon name="checkCircle" size={13} />
              <span>پاسخگویی آنلاین در کمتر از ۱۵ دقیقه</span>
            </div>
          </div>

          <!-- Card 3: Telegram & Social Channels -->
          <div class="contact-glass-card social-card">
            <div class="card-icon-wrap sapphire-glow">
              <Icon name="send" size={26} class="card-icon" />
            </div>
            <h2 class="card-title">کانال تلگرام و رسانه‌ها</h2>
            <p class="card-desc">
              اطلاع‌رسانی جشنواره‌های ماهانه، تخفیف‌های لحظه‌ای و محتوای علمی مراقبت از پوست
            </p>
            <div class="social-links-stack">
              <a
                href="https://t.me/tehranlaser_clinic"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-contact-outline social-link-item"
              >
                <div class="social-btn-inner">
                  <Icon name="send" size={16} />
                  <span>عضویت در کانال تلگرام</span>
                </div>
                <Icon name="external" size={14} class="ext-icon" />
              </a>
              <a
                href="https://instagram.com/tehranlaser"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-contact-outline social-link-item"
              >
                <div class="social-btn-inner">
                  <Icon name="camera" size={16} />
                  <span>صفحه اینستاگرام کلینیک</span>
                </div>
                <Icon name="external" size={14} class="ext-icon" />
              </a>
            </div>
            <div class="card-footer-meta">
              <Icon name="sparkles" size={13} />
              <span>کدهای تخفیف فصلی ویژه اعضای کانال</span>
            </div>
          </div>
        </div>

        <!-- Address & Navigation Card (Hub) -->
        <div class="contact-glass-card location-hub-card mt-5">
          <div class="location-header-row">
            <div class="location-title-group">
              <div class="card-icon-wrap gold-glow sm">
                <Icon name="pin" size={22} class="card-icon" />
              </div>
              <div>
                <h2 class="location-card-title">نشانی حضوری و نقشه کلینیک تهران لیزر</h2>
                <p class="location-card-subtitle">دسترسی سرراست و بدون ترافیک در منطقه پاسداران تهران</p>
              </div>
            </div>
            <div class="copy-address-action">
              <button
                type="button"
                class="btn-contact-outline copy-trigger-btn copy-address-btn"
                data-copy="تهران، خیابان پاسداران، خیابان پایدارفرد، نبش بوستان هفتم، کلینیک تهران لیزر"
                data-label="نشانی کامل"
                aria-label="کپی نشانی کامل کلینیک"
              >
                <Icon name="document" size={16} class="btn-icon" />
                <span class="btn-text">کپی نشانی کامل</span>
              </button>
            </div>
          </div>

          <div class="address-highlight-box">
            <Icon name="pin" size={20} class="pin-gold" />
            <span class="address-main-text">
              تهران، خیابان پاسداران، خیابان پایدارفرد، نبش بوستان هفتم
            </span>
          </div>

          <!-- Quick Navigation Apps -->
          <div class="navigation-apps-container">
            <span class="nav-apps-label">مسیریابی هوشمند با اپلیکیشن‌های نقشه:</span>
            <div class="nav-apps-grid">
              <a
                href="https://nshn.ir"
                target="_blank"
                rel="noopener noreferrer"
                class="nav-app-btn"
                aria-label="مسیریابی در نشان"
              >
                <Icon name="external" size={15} />
                <span>مسیریابی با نشان</span>
              </a>
              <a
                href="https://balad.ir/location?latitude=35.7645&longitude=51.4628"
                target="_blank"
                rel="noopener noreferrer"
                class="nav-app-btn"
                aria-label="مسیریابی در بلد"
              >
                <Icon name="external" size={15} />
                <span>مسیریابی با بلد</span>
              </a>
              <a
                href="https://maps.google.com/?q=35.7645,51.4628+(Tehran+Laser+Clinic)"
                target="_blank"
                rel="noopener noreferrer"
                class="nav-app-btn"
                aria-label="مسیریابی در گوگل مپ"
              >
                <Icon name="external" size={15} />
                <span>Google Maps</span>
              </a>
              <a
                href="https://waze.com/ul?ll=35.7645,51.4628&navigate=yes"
                target="_blank"
                rel="noopener noreferrer"
                class="nav-app-btn"
                aria-label="مسیریابی در ویز"
              >
                <Icon name="external" size={15} />
                <span>Waze</span>
              </a>
            </div>
          </div>

          <!-- Stylized Dark 3D Obsidian Visual Map -->
          <div class="map-visual-container">
            <div class="map-visual-bg">
              <div class="map-grid-overlay"></div>
              <div class="map-pin-pulse">
                <div class="pulse-ring"></div>
                <div class="pulse-ring delay"></div>
                <div class="pin-marker">
                  <Icon name="pin" size={24} />
                </div>
                <div class="pin-popup">
                  <strong>کلینیک تهران لیزر</strong>
                  <span>پاسداران، نبش بوستان ۷</span>
                </div>
              </div>
              <div class="map-coords-badge">
                <span>35.7645° N, 51.4628° E</span>
              </div>
            </div>
          </div>

          <!-- Access and Parking Guide -->
          <div class="access-guide-grid">
            <div class="access-guide-item">
              <div class="access-icon-col">
                <Icon name="clock" size={20} class="text-gold" />
              </div>
              <div class="access-text-col">
                <h3 class="access-item-title">ساعات کاری و پذیرش کلینیک</h3>
                <p class="access-item-desc">
                  <strong>شنبه تا چهارشنبه:</strong> ۹:۰۰ صبح الی ۲۰:۰۰ شب<br />
                  <strong>پنجشنبه‌ها:</strong> ۹:۰۰ صبح الی ۱۸:۰۰ عصر<br />
                  <strong>جمعه‌ها و تعطیلات رسمی:</strong> تعطیل (پشتیبانی واتساپ فعال)
                </p>
              </div>
            </div>

            <div class="access-guide-item">
              <div class="access-icon-col">
                <Icon name="shield" size={20} class="text-gold" />
              </div>
              <div class="access-text-col">
                <h3 class="access-item-title">راهنمای دسترسی و پارکینگ</h3>
                <p class="access-item-desc">
                  <strong>دسترسی خودرو:</strong> دسترسی روان از بزرگراه صیاد شیرازی و شهید همت به پاسداران.<br />
                  <strong>جای پارک:</strong> امکان پارک خودرو در خیابان پایدارفرد و بوستان هفتم فراهم است.<br />
                  <strong>مترو:</strong> ایستگاه میدان نوبنیاد (خط ۳) یا شریعتی + تاکسی خطی پاسداران.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Deposit guidance — account and card numbers are NEVER published on
             the public site. Reception sends verified payment details privately
             after a booking is confirmed, closing a card-fraud surface. -->
        <div class="contact-glass-card payment-card mt-5">
          <div class="payment-head">
            <div class="card-icon-wrap gold-glow sm">
              <Icon name="card" size={22} class="card-icon" />
            </div>
            <div>
              <h2 class="payment-title">واریز بیعانه و تسویه حساب</h2>
              <p class="payment-subtitle">اطلاعات پرداخت فقط از طریق پذیرش کلینیک اعلام می‌شود</p>
            </div>
          </div>
          <p class="payment-body">
            برای پیشگیری از سوءاستفاده، شماره کارت و شبای کلینیک در وب‌سایت منتشر نمی‌شود. پس از ثبت نوبت، کارشناس پذیرش اطلاعات پرداخت تأییدشده را به‌صورت مستقیم برای شما ارسال می‌کند.
          </p>
          <div class="payment-note">
            <Icon name="shield" size={16} class="info-icon" />
            <span>فقط به اطلاعات پرداختی که از کانال رسمی کلینیک دریافت کرده‌اید واریز کنید.</span>
          </div>
        </div>

        <!-- Bottom Quick Action Strip -->
        <div class="contact-bottom-cta mt-5">
          <div class="cta-inner">
            <div class="cta-text">
              <h3 class="cta-title">آماده رزرو نوبت خود هستید؟</h3>
              <p class="cta-desc">رزرو اینترنتی شامل ۱۵٪ تخفیف ویژه پکیج کل بدن می‌باشد</p>
            </div>
            <div class="cta-buttons">
              <a href="/booking" class="btn-contact-gold cta-book-btn">
                <Icon name="calendar" size={18} />
                <span>رزرو آنلاین نوبت (با تخفیف)</span>
              </a>
              <a href="/faq" class="btn-contact-outline">
                <Icon name="search" size={18} />
                <span>مشاهده سوالات متداول</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Interactive Client-side Script: Copy to Clipboard & Real-time Live Status -->
  <script is:inline>
    // Copy to clipboard with visual feedback
    document.querySelectorAll('.copy-trigger-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var textToCopy = btn.getAttribute('data-copy');
        var label = btn.getAttribute('data-label') || '';
        var btnTextEl = btn.querySelector('.btn-text');
        var originalText = btnTextEl ? btnTextEl.textContent : '';

        if (!textToCopy) return;

        function showSuccess() {
          btn.classList.add('copied-success');
          if (btnTextEl) btnTextEl.textContent = 'کپی شد!';
          setTimeout(function() {
            btn.classList.remove('copied-success');
            if (btnTextEl) btnTextEl.textContent = originalText;
          }, 2000);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(textToCopy).then(showSuccess).catch(function() {
            fallbackCopy(textToCopy, showSuccess);
          });
        } else {
          fallbackCopy(textToCopy, showSuccess);
        }
      });
    });

    function fallbackCopy(text, cb) {
      var textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        if (typeof document.execCommand === 'function') {
          document.execCommand('copy');
        }
        cb();
      } catch (e) {
        console.error('Copy failed', e);
      }
      document.body.removeChild(textarea);
    }

    // Live clinic opening status checker (Asia/Tehran timezone)
    function updateClinicStatus() {
      try {
        var now = new Date();
        var utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        var tehranDate = new Date(utc + (3.5 * 3600000));
        var day = tehranDate.getDay(); // 0 is Sunday, 6 is Saturday
        var hour = tehranDate.getHours();
        var minute = tehranDate.getMinutes();
        var timeDecimal = hour + (minute / 60);

        var isOpen = false;
        var statusMsg = '';

        if (day === 5) {
          // Friday
          isOpen = false;
          statusMsg = 'جمعه: کلینیک تعطیل است (پاسخگویی آنلاین واتساپ فعال)';
        } else if (day === 4) {
          // Thursday: 9:00 - 18:00
          if (timeDecimal >= 9 && timeDecimal < 18) {
            isOpen = true;
            statusMsg = 'هم‌اکنون کلینیک باز است (پاسخگویی تلفنی و حضوری تا ۱۸:۰۰)';
          } else {
            isOpen = false;
            statusMsg = 'کلینیک اکنون خارج از ساعت کاری است (بازگشایی: شنبه ۹ صبح)';
          }
        } else {
          // Saturday to Wednesday: 9:00 - 20:00
          if (timeDecimal >= 9 && timeDecimal < 20) {
            isOpen = true;
            statusMsg = 'هم‌اکنون کلینیک باز است (پاسخگویی تلفنی و پذیرش تا ۲۰:۰۰)';
          } else {
            isOpen = false;
            statusMsg = 'کلینیک اکنون خارج از ساعت کاری است (بازگشایی: فردا ۹ صبح)';
          }
        }

        var pill = document.getElementById('liveStatusPill');
        var textEl = document.getElementById('liveStatusText');
        if (pill && textEl) {
          if (isOpen) {
            pill.classList.add('status-open');
            pill.classList.remove('status-closed');
          } else {
            pill.classList.add('status-closed');
            pill.classList.remove('status-open');
          }
          textEl.textContent = statusMsg;
        }
      } catch (err) {
        console.error('Error updating status:', err);
      }
    }
    updateClinicStatus();
  </script>
</PublicLayout>

