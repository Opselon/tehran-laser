                <Icon name="external" size={15} />
                <span>Waze</span>
              </a>
            </div>
          </div>

          <!-- Stylized Dark 3D Obsidian Visual Map -->
          <div class="map-visual-container">
            <div class="map-visual-bg">
              <div class="map-grid-overlay"></div>
              <div class="map-pin-pulse">
                <div class="pulse-ring"></div>
                <div class="pulse-ring delay"></div>
                <div class="pin-marker">
                  <Icon name="pin" size={24} />
                </div>
                <div class="pin-popup">
                  <strong>کلینیک تهران لیزر</strong>
                  <span>پاسداران، نبش بوستان ۷</span>
                </div>
              </div>
              <div class="map-coords-badge">
                <span>35.7645° N, 51.4628° E</span>
              </div>
            </div>
          </div>

          <!-- Access and Parking Guide -->
          <div class="access-guide-grid">
            <div class="access-guide-item">
              <div class="access-icon-col">
                <Icon name="clock" size={20} class="text-gold" />
              </div>
              <div class="access-text-col">
                <h3 class="access-item-title">ساعات کاری و پذیرش کلینیک</h3>
                <p class="access-item-desc">
                  <strong>شنبه تا چهارشنبه:</strong> ۹:۰۰ صبح الی ۲۰:۰۰ شب<br />
                  <strong>پنجشنبه‌ها:</strong> ۹:۰۰ صبح الی ۱۸:۰۰ عصر<br />
                  <strong>جمعه‌ها و تعطیلات رسمی:</strong> تعطیل (پشتیبانی واتساپ فعال)
                </p>
              </div>
            </div>

            <div class="access-guide-item">
              <div class="access-icon-col">
                <Icon name="shield" size={20} class="text-gold" />
              </div>
              <div class="access-text-col">
                <h3 class="access-item-title">راهنمای دسترسی و پارکینگ</h3>
                <p class="access-item-desc">
                  <strong>دسترسی خودرو:</strong> دسترسی روان از بزرگراه صیاد شیرازی و شهید همت به پاسداران.<br />
                  <strong>جای پارک:</strong> امکان پارک خودرو در خیابان پایدارفرد و بوستان هفتم فراهم است.<br />
                  <strong>مترو:</strong> ایستگاه میدان نوبنیاد (خط ۳) یا شریعتی + تاکسی خطی پاسداران.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Official Bank / Sheba Account Details Card (Copyable) -->
        <div class="contact-glass-card sheba-details-card mt-5">
          <div class="sheba-header-row">
            <div class="sheba-title-group">
              <div class="card-icon-wrap gold-glow sm">
                <Icon name="card" size={22} class="card-icon" />
              </div>
              <div>
                <h2 class="sheba-card-title">اطلاعات حساب و شماره شبا جهت واریز بیعانه</h2>
