---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { createBreadcrumbSchema, resolveCanonicalOrigin } from '../lib/seo';

// ContactPage entity + breadcrumbs. The clinic node itself is emitted once by
// the layout (canonical @id <origin>/#clinic), so we only link to it.
// Origin is resolved at runtime from SITE_URL — tehranlaser.ir is a parked
// domain and must never be emitted as an @id/url.
const origin = resolveCanonicalOrigin();
const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['ContactPage', 'MedicalWebPage'],
  '@id': `${origin}/contact#contact`,
  url: `${origin}/contact`,
  name: 'تماس و آدرس کلینیک تهران لیزر پاسداران',
  description:
    'راه‌های ارتباطی، آدرس دقیق در پاسداران خیابان پایدارفرد، شماره تماس مستقیم پذیرش، مشاوره فوری در واتساپ و لوکیشن مسیریابی.',
  inLanguage: 'fa-IR',
  mainEntity: { '@id': `${origin}/#clinic` },
  isPartOf: { '@id': `${origin}/#website` },
};

const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
  { name: 'تماس و آدرس', url: '/contact' },
]);
---

<PublicLayout
  title="تماس و آدرس کلینیک تهران لیزر — پاسداران، خیابان پایدارفرد"
  description="راه‌های ارتباطی، آدرس دقیق در پاسداران خیابان پایدارفرد، شماره تماس مستقیم پذیرش، مشاوره فوری در واتساپ و لوکیشن مسیریابی کلینیک تهران لیزر."
  canonicalUrl="/contact"
  keywords={[
    'تماس کلینیک تهران لیزر',
    'آدرس لیزر پاسداران',
    'شماره تلفن لیزر پایدارفرد',
    'واتساپ کلینیک لیزر تهران',
  ]}
  jsonLd={[contactJsonLd, breadcrumbJsonLd]}
  theme="dark"
>
  <div class="contact-page-wrapper">
    <!-- Header Hero -->
    <div class="contact-hero-strip">
      <div class="container text-center">
        <div class="luxury-badge">
          <Icon name="sparkles" size={14} class="badge-icon" />
          <span>ارتباط مستقیم با مرکز تخصصی پاسداران</span>
        </div>
        <h1 class="page-title">تماس با کلینیک تهران لیزر</h1>
        <p class="page-subtitle">
          تیم پذیرش و مشاورین پوست و لیزر ما همه‌روزه در ساعات کاری آماده پاسخگویی، مشاوره تخصصی و راهنمایی شما هستند
        </p>

        <!-- Live Operating Status Indicator -->
        <div class="live-status-pill" id="liveStatusPill">
          <span class="status-dot"></span>
          <span class="status-text" id="liveStatusText">ساعات پاسخگویی: شنبه تا چهارشنبه ۹ الی ۲۰ | پنجشنبه ۹ الی ۱۸</span>
        </div>
      </div>
    </div>

    <!-- Main Content Section -->
    <section class="contact-main-section">
      <div class="container container-contact">
        <!-- 3 Primary Communication Cards -->
        <div class="contact-cards-grid">
          <!-- Card 1: Direct Phone Call -->
          <div class="contact-glass-card phone-card">
            <div class="card-icon-wrap gold-glow">
              <Icon name="phone" size={26} class="card-icon" />
            </div>
            <h2 class="card-title">تماس تلفنی مستقیم</h2>
            <p class="card-desc">
              رزرو تلفنی سریع، پیگیری پرونده، مشاوره اولیه و استعلام تعرفه اختصاصی آقایان
            </p>
            <div class="card-actions-box">
              <a href="tel:+989035555090" class="btn-contact-gold dial-link" dir="ltr" aria-label="تماس مستقیم با 09035555090">
                <Icon name="phone" size={16} />
                <span>+98 903 555 5090</span>
              </a>
              <button
                type="button"
                class="btn-contact-outline copy-trigger-btn"
                data-copy="09035555090"
                data-label="شماره تلفن"
                aria-label="کپی شماره تلفن کلینیک"
              >
                <Icon name="document" size={15} class="btn-icon" />
                <span class="btn-text">کپی شماره تماس</span>
              </button>
            </div>
            <div class="card-footer-meta">
              <Icon name="clock" size={13} />
              <span>پاسخگویی سریع توسط مشاورین پذیرش</span>
            </div>
          </div>

          <!-- Card 2: WhatsApp Instant Consultation -->
          <div class="contact-glass-card whatsapp-card">
            <div class="card-icon-wrap emerald-glow">
              <Icon name="sms" size={26} class="card-icon" />
            </div>
            <div class="card-badge-instant">
              <Icon name="sparkles" size={12} />
              <span>پاسخگویی آنلاین</span>
            </div>
            <h2 class="card-title">مشاوره فوری در واتساپ</h2>
            <p class="card-desc">
              مشاوره نوع پوست و مو، استعلام تخفیف‌ها، ارسال عکس و دریافت لوکیشن مستقیم
            </p>
            <div class="whatsapp-triggers-list">
              <a
                href="https://wa.me/989035555090?text=%D8%B3%D9%84%D8%A7%D9%85%D8%8C%20%D8%AC%D9%87%D8%AA%20%D9%85%D8%B4%D8%A7%D9%88%D8%B1%D9%87%20%D9%88%20%D8%B1%D8%B2%D8%B1%D9%88%20%D9%86%D9%88%D8%A8%D8%AA%20%D9%84%DB%8C%D8%B2%D8%B1%20%D9%BE%DB%8C%D8%A7%D9%85%20%D9%85%DB%8C%E2%80%8C%D8%AF%D9%87%D9%85."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-contact-gold wa-main-btn"
              >
                <Icon name="send" size={16} />
                <span>شروع گفتگوی فوری و مشاوره</span>
              </a>
              <div class="quick-wa-chips">
                <a
                  href="https://wa.me/989035555090?text=%D8%B3%D9%84%D8%A7%D9%85%D8%8C%20%D8%AC%D9%87%D8%AA%20%D8%A7%D8%B3%D8%AA%D8%B9%D9%84%D8%A7%D9%85%20%D8%AA%D8%B9%D8%B1%D9%81%D9%87%20%D9%88%20%D9%86%D9%88%D8%A8%D8%AA%E2%80%8C%D8%AF%D9%87%DB%8C%20%D9%84%D8%A7%DB%8C%D9%86%20%D8%A2%D9%82%D8%A7%DB%8C%D8%A7%D9%86%20%D9%BE%DB%8C%D8%A7%D9%85%20%D9%85%DB%8C%E2%80%8C%D8%AF%D9%87%D9%85."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa-chip"
                >
                  <Icon name="arrowLeft" size={12} />
                  <span>استعلام تعرفه آقایان</span>
                </a>
                <a
                  href="https://wa.me/989035555090?text=%D8%B3%D9%84%D8%A7%D9%85%D8%8C%20%D9%84%D8%B7%D9%81%D8%A7%D9%8B%20%D9%84%D9%88%DA%A9%DB%8C%D8%B4%D9%86%20%D8%AF%D9%82%DB%8C%D9%82%20%DA%A9%D9%84%DB%8C%D9%86%DB%8C%DA%A9%20%D8%AA%D9%87%D8%B1%D8%A7%D9%86%20%D9%84%DB%8C%D8%B2%D8%B1%20%D8%B1%D8%A7%20%D8%A7%D8%B1%D8%B3%D8%A7%D9%84%20%D9%81%D8%B1%D9%85%D8%A7%DB%8C%DB%8C%D8%AF."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa-chip"
                >
                  <Icon name="arrowLeft" size={12} />
                  <span>ارسال لوکیشن در واتساپ</span>
                </a>
              </div>
            </div>
            <div class="card-footer-meta">
              <Icon name="checkCircle" size={13} />
              <span>پاسخگویی آنلاین در کمتر از ۱۵ دقیقه</span>
            </div>
          </div>

          <!-- Card 3: Telegram & Social Channels -->
          <div class="contact-glass-card social-card">
            <div class="card-icon-wrap sapphire-glow">
              <Icon name="send" size={26} class="card-icon" />
            </div>
            <h2 class="card-title">کانال تلگرام و رسانه‌ها</h2>
            <p class="card-desc">
