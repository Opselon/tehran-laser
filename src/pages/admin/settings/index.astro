  <script>
    // Tab Switching
    const tabBtns = document.querySelectorAll('.settings-tab-btn');
    const tabPanels = document.querySelectorAll('.settings-panel');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        tabBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach((p) => {
          p.classList.remove('active');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const activePanel = document.getElementById(`panel-${target}`);
        if (activePanel) {
          activePanel.classList.add('active');
        }
        if (target) {
          history.replaceState(null, '', `#tab-${target}`);
        }
      });
    });

    // Hash deep-linking
    const currentHash = window.location.hash.replace('#tab-', '');
    if (currentHash) {
      const matchingBtn = document.querySelector(`.settings-tab-btn[data-tab="${currentHash}"]`) as HTMLButtonElement | null;
      if (matchingBtn) matchingBtn.click();
    }

    // Toggle API Key Masking
    const toggleApiKeyBtn = document.getElementById('toggleApiKeyBtn');
    const smsApiKeyInput = document.getElementById('smsApiKeyInput') as HTMLInputElement | null;
    if (toggleApiKeyBtn && smsApiKeyInput) {
      toggleApiKeyBtn.addEventListener('click', () => {
        smsApiKeyInput.type = smsApiKeyInput.type === 'password' ? 'text' : 'password';
      });
    }

    // D1 JSON Backup Export
    const exportBackupBtn = document.getElementById('exportBackupBtn');
    const settingsForm = document.getElementById('settingsForm') as HTMLFormElement | null;
    if (exportBackupBtn && settingsForm) {
      exportBackupBtn.addEventListener('click', () => {
        const formData = new FormData(settingsForm);
        const dump: Record<string, any> = {};
        formData.forEach((v, k) => {
          dump[k] = String(v).trim();
        });
        const backupPayload = {
          exported_at: new Date().toISOString(),
          clinic: dump.business_name || 'Tehran Laser',
          database: 'Cloudflare D1 (tehran-laser-db)',
          engine: 'SQLite on Edge',
          settings: dump,
        };
        const blob = new Blob([JSON.stringify(backupPayload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const dateStr = new Date().toISOString().slice(0, 10);
        a.href = url;
        a.download = `tehran-laser-settings-backup-${dateStr}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Live D1 Health Ping Test
    const pingHealthBtn = document.getElementById('pingHealthBtn') as HTMLButtonElement | null;
    const healthPingResult = document.getElementById('healthPingResult');
    if (pingHealthBtn && healthPingResult) {
      pingHealthBtn.addEventListener('click', async () => {
        pingHealthBtn.disabled = true;
        healthPingResult.style.display = 'block';
        healthPingResult.innerHTML = '<span style="color: #f5d77f;">در حال اندازه‌گیری پینگ اتصال به Cloudflare D1...</span>';
        const t0 = performance.now();
        try {
          const res = await fetch('/api/health');
          const elapsed = Math.round(performance.now() - t0);
          const json = (await res.json()) as any;
          if (res.ok && json.data) {
            healthPingResult.innerHTML = `
              <div style="display:flex; align-items:center; gap:8px; color:#34d399; font-weight:700; flex-wrap:wrap;">
                <span class="live-dot"></span>
                <span>وضعیت: ${json.data.database === 'ok' ? 'سالم و پایدار' : json.data.database}</span>
                <span style="color:#94a3b8;">|</span>
                <span style="color:#f5d77f;">تاخیر: ${elapsed} میلی‌ثانیه</span>
                <span style="color:#94a3b8;">|</span>
                <span style="color:#94a3b8; font-size:0.78rem;">نسخه: ${json.data.version}</span>
              </div>
            `;
          } else {
            healthPingResult.innerHTML = `<span style="color:#f87171;">خطای بررسی سلامت دیتابیس D1.</span>`;
          }
        } catch {
          healthPingResult.innerHTML = `<span style="color:#f87171;">خطای شبکه در اتصال به سرویس سلامت.</span>`;
        } finally {
          pingHealthBtn.disabled = false;
        }
      });
    }

    // Quick SMS Test
    const testSmsBtn = document.getElementById('testSmsBtn') as HTMLButtonElement | null;
    const testSmsPhone = document.getElementById('testSmsPhone') as HTMLInputElement | null;
    const testSmsResult = document.getElementById('testSmsResult');
    if (testSmsBtn && testSmsPhone && testSmsResult) {
      testSmsBtn.addEventListener('click', async () => {
        const phone = testSmsPhone.value.trim();
        if (!phone) {
          testSmsResult.style.display = 'block';
          testSmsResult.innerHTML = '<span style="color:#f87171;">شماره موبایل تست را وارد کنید.</span>';
          return;
        }
        testSmsBtn.disabled = true;
        testSmsResult.style.display = 'block';
        testSmsResult.innerHTML = '<span style="color:#f5d77f;">در حال ارسال پیامک آزمایشی...</span>';
        try {
          const res = await fetch('/api/v1/admin/sms/send', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              phone,
              message: 'پیامک تستی اتصال وب‌سرویس کلینیک تهران لیزر با موفقیت ارسال شد.',
              templateName: 'test',
            }),
          });
          const json = (await res.json()) as any;
          if (res.ok && json.data) {
            testSmsResult.innerHTML = '<span style="color:#34d399;">پیامک تست با موفقیت ارسال و در صف مخابرات قرار گرفت.</span>';
          } else {
            testSmsResult.innerHTML = `<span style="color:#f87171;">خطا در ارسال: ${json.error?.message || 'پاسخ ناموفق از درگاه.'}</span>`;
          }
        } catch {
          testSmsResult.innerHTML = '<span style="color:#f87171;">خطای ارتباط با وب‌سرویس پیامک.</span>';
        } finally {
          testSmsBtn.disabled = false;
        }
      });
    }

    // Reset Form
    const resetSettingsBtn = document.getElementById('resetSettingsBtn');
    if (resetSettingsBtn && settingsForm) {
      resetSettingsBtn.addEventListener('click', () => {
        settingsForm.reset();
      });
    }

    // Form Submit (API First)
    const saveBtn = document.getElementById('saveSettingsBtn') as HTMLButtonElement | null;
    const saveBtnText = document.getElementById('saveBtnText');
    const alertBox = document.getElementById('settingsAlert');
    const alertText = document.getElementById('settingsAlertText');
    const successBox = document.getElementById('settingsSuccess');

    if (settingsForm && saveBtn) {
      settingsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        saveBtn.disabled = true;
        if (saveBtnText) saveBtnText.innerText = 'در حال ذخیره‌سازی در دیتابیس...';
        if (alertBox) alertBox.style.display = 'none';
        if (successBox) successBox.style.display = 'none';

        const formData = new FormData(settingsForm);
        const payload: Record<string, any> = {};

        formData.forEach((val, key) => {
          payload[key] = String(val).trim();
        });

        // Collect Toggle Checkboxes
        const toggleKeys = [
          'booking_enabled',
          'sms_booking_confirm_enabled',
          'sms_reminder_24h_enabled',
          'sms_birthday_enabled',
          'sms_next_session_enabled',
        ];
        toggleKeys.forEach((k) => {
          const el = settingsForm.elements.namedItem(k) as HTMLInputElement | null;
          if (el) {
            payload[k] = el.checked ? 'true' : 'false';
          }
        });

        // Numeric Parsing
        const numericKeys = [
          'slot_granularity_minutes',
          'booking_buffer_minutes',
          'min_lead_minutes',
          'max_advance_days',
          'discount_percent',
          'site_discount_percent',
          'session_ttl_hours',
        ];
        numericKeys.forEach((k) => {
          if (payload[k] !== undefined && payload[k] !== '') {
            payload[k] = Number(payload[k]);
          }
        });

        if (payload['discount_percent'] !== undefined) {
          payload['site_discount_percent'] = payload['discount_percent'];
        }

        try {
          const res = await fetch('/api/v1/admin/settings', {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const json = (await res.json()) as any;
          if (res.ok && json.data) {
            if (saveBtnText) saveBtnText.innerText = 'ذخیره شد!';
            if (successBox) successBox.style.display = 'flex';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            setTimeout(() => {
              saveBtn.disabled = false;
              if (saveBtnText) saveBtnText.innerText = 'ذخیره کلیه تنظیمات در دیتابیس D1';
            }, 2400);
          } else {
            if (alertText) alertText.innerText = json.error?.message || 'خطا در ذخیره تنظیمات.';
            if (alertBox) alertBox.style.display = 'flex';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            saveBtn.disabled = false;
            if (saveBtnText) saveBtnText.innerText = 'ذخیره کلیه تنظیمات در دیتابیس D1';
          }
        } catch {
          if (alertText) alertText.innerText = 'خطای ارتباط با سرور.';
          if (alertBox) alertBox.style.display = 'flex';
          window.scrollTo({ top: 0, behavior: 'smooth' });
          saveBtn.disabled = false;
          if (saveBtnText) saveBtnText.innerText = 'ذخیره کلیه تنظیمات در دیتابیس D1';
        }
      });
    }
  </script>
</AdminLayout>