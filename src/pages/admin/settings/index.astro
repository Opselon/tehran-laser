---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/ui/Icon.astro';
import { env } from 'cloudflare:workers';
import { getAllSettings } from '../../../server/repositories';

let settings: Record<string, string> = {};
let dbStats = {
  tables: 14,
  settingsCount: 0,
  customersCount: 0,
  bookingsCount: 0,
};

try {
  if (env?.DB) {
    const allSets = await getAllSettings(env.DB);
    settings = { ...allSets.public, ...allSets.private };

    const [setsCount, custCount, bookCount] = await Promise.all([
      env.DB.prepare('SELECT COUNT(*) AS c FROM settings').first<{ c: number }>(),
      env.DB.prepare('SELECT COUNT(*) AS c FROM customers').first<{ c: number }>(),
      env.DB.prepare('SELECT COUNT(*) AS c FROM bookings').first<{ c: number }>(),
    ]);

    dbStats = {
      tables: 14,
      settingsCount: setsCount?.c ?? Object.keys(settings).length,
      customersCount: custCount?.c ?? 0,
      bookingsCount: bookCount?.c ?? 0,
    };
  }
} catch (e) {
  console.error('Failed to load settings:', e);
}
---

<AdminLayout title="تنظیمات کلینیک" activeNav="settings">
  <div class="admin-content-pad settings-container">
    <!-- 3D Header Row -->
    <div class="dashboard-header-row">
      <div>
        <h1 class="admin-page-title" style="display: flex; align-items: center; gap: 10px;">
          <Icon name="settings" size={26} class="title-icon" />
          <span>تنظیمات و پیکربندی مرکزی کلینیک</span>
        </h1>
        <p class="section-block-sub">
          مدیریت یکپارچه مشخصات کلینیک، درگاه پیامک، شیفت‌های کاری، امنیت دسترسی و پشتیبان‌گیری دیتابیس D1
        </p>
      </div>
      <div class="actions">
        <span class="d1-status-badge">
          <span class="live-dot"></span>
          <Icon name="database" size={15} />
          <span>پایگاه داده Cloudflare D1 فعال</span>
        </span>
      </div>
    </div>

    <!-- Alert Notices -->
    <div id="settingsAlert" class="alert-3d-danger" style="display: none;" role="alert">
      <Icon name="warning" size={20} />
      <span id="settingsAlertText"></span>
    </div>

    <div id="settingsSuccess" class="alert-3d-success" style="display: none;" role="status">
      <Icon name="checkCircle" size={20} />
      <span>تنظیمات با موفقیت در پایگاه داده لایو D1 ذخیره و اعمال شد.</span>
    </div>

    <!-- 3D Settings Tab Bar -->
    <nav class="settings-tab-bar" aria-label="دسته‌بندی تنظیمات">
      <button type="button" class="settings-tab-btn active" data-tab="profile" role="tab" aria-selected="true">
        <Icon name="gem" size={17} />
        <span>مشخصات کلینیک</span>
      </button>
      <button type="button" class="settings-tab-btn" data-tab="sms" role="tab" aria-selected="false">
        <Icon name="sms" size={17} />
        <span>درگاه پیامک</span>
      </button>
      <button type="button" class="settings-tab-btn" data-tab="schedule" role="tab" aria-selected="false">
        <Icon name="clock" size={17} />
        <span>زمان‌بندی و شیفت‌ها</span>
      </button>
      <button type="button" class="settings-tab-btn" data-tab="security" role="tab" aria-selected="false">
        <Icon name="shield" size={17} />
        <span>امنیت و نشست‌ها</span>
      </button>
      <button type="button" class="settings-tab-btn" data-tab="backup" role="tab" aria-selected="false">
        <Icon name="database" size={17} />
        <span>پشتیبان‌گیری و دیتابیس D1</span>
      </button>
    </nav>

    <!-- Main Settings Form -->
    <form id="settingsForm">
      <!-- 1. CLINIC PROFILE PANEL -->
      <section id="panel-profile" class="settings-panel active" role="tabpanel">
        <div class="admin-section-block">
          <div class="section-block-header">
            <h2 class="section-block-title">
              <Icon name="gem" size={20} />
              <span>هویت تجاری و مشخصات رسمی کلینیک</span>
            </h2>
            <p class="section-block-sub">اطلاعات برندینگ که در فاکتورها، سربرگ‌ها، رزرو و پیامک‌های ارسالی درج می‌شود.</p>
          </div>

          <div class="settings-grid">
            <div class="field-group">
              <label class="field-label" for="business_name">
                <Icon name="gem" size={15} />
                <span>نام تجاری رسمی (فارسی):</span>
              </label>
              <input
                id="business_name"
                type="text"
                name="business_name"
                class="form-control-modal"
                value={settings.business_name || 'تهران لیزر'}
                required
              />
              <span class="field-hint">نام رسمی کلینیک برای سربرگ، پیامک‌ها و فاکتور مشتریان.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="business_name_en">
                <Icon name="globe" size={15} />
                <span>نام بین‌المللی (انگلیسی):</span>
              </label>
              <input
                id="business_name_en"
                type="text"
                name="business_name_en"
                dir="ltr"
                class="form-control-modal"
                value={settings.business_name_en || 'Tehran Laser'}
                required
              />
              <span class="field-hint">جهت متادیتای وب‌سایت، نقشه گوگل و اسناد لاتین.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="phone">
                <Icon name="phone" size={15} />
                <span>شماره تماس و نوبت‌دهی مستقیم:</span>
              </label>
              <input
                id="phone"
                type="tel"
                name="phone"
                dir="ltr"
                class="form-control-modal"
                value={settings.phone || '+98 903 555 5090'}
                required
              />
              <span class="field-hint">شماره تلفن پاسخگویی مستقیم و ثبت نوبت کلینیک.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="support_phone">
                <Icon name="mobile" size={15} />
                <span>شماره پشتیبانی پیام‌رسان‌ها:</span>
              </label>
              <input
                id="support_phone"
                type="tel"
                name="support_phone"
                dir="ltr"
                class="form-control-modal"
                value={settings.support_phone || '+98 903 555 5090'}
              />
              <span class="field-hint">شماره خط پشتیبانی واتساپ و تلگرام مراجعین.</span>
            </div>

            <div class="field-group settings-grid-full">
              <label class="field-label" for="address">
                <Icon name="pin" size={15} />
                <span>نشانی دقیق کلینیک:</span>
              </label>
              <input
                id="address"
                type="text"
                name="address"
                class="form-control-modal"
                value={settings.address || 'تهران، پاسداران، خیابان پایدارفرد، نبش بوستان هفتم'}
                required
              />
              <span class="field-hint">آدرس ارسالی در پیامک‌های تایید نوبت و نمایش در فوتر سایت.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="currency">
                <Icon name="card" size={15} />
                <span>واحد پول سیستم:</span>
              </label>
              <input
                id="currency"
                type="text"
                name="currency"
                dir="ltr"
                class="form-control-modal"
                value={settings.currency || 'IRT'}
                required
              />
              <span class="field-hint">کد ارزی سامانه (پیش‌فرض: IRT تومان).</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="currency_label">
                <Icon name="tag" size={15} />
                <span>برچسب نمایشی واحد قیمت:</span>
              </label>
              <input
                id="currency_label"
                type="text"
                name="currency_label"
                class="form-control-modal"
                value={settings.currency_label || 'هزار تومان'}
                required
              />
              <span class="field-hint">عنوانی که در کنار ارقام تعرفه‌ها درج می‌شود.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="discount_percent">
                <Icon name="percent" size={15} />
                <span>درصد تخفیف پکیج‌های فول‌بادی:</span>
              </label>
              <div style="position: relative;">
                <input
                  id="discount_percent"
                  type="number"
                  name="discount_percent"
                  class="form-control-modal"
                  value={settings.discount_percent || settings.site_discount_percent || '15'}
                  min="0"
                  max="100"
                  required
                />
                <span style="position: absolute; left: 16px; top: 12px; color: #94a3b8; font-weight: 700;">٪</span>
              </div>
              <span class="field-hint">میزان کسر تخفیف پیش‌فرض برای پکیج‌های کل بدن بانوان.</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. SMS INTEGRATION PANEL -->
      <section id="panel-sms" class="settings-panel" role="tabpanel">
        <div class="admin-section-block">
          <div class="section-block-header">
            <h2 class="section-block-title">
              <Icon name="sms" size={20} />
              <span>پیکربندی درگاه پیامک و امنیت وب‌سرویس</span>
            </h2>
            <p class="section-block-sub">تنظیم ارائه‌دهنده پیامک خدماتی، سرشماره ارسال و کلیدهای امنیتی احراز هویت.</p>
          </div>

          <div class="settings-grid" style="margin-bottom: 24px;">
            <div class="field-group">
              <label class="field-label" for="sms_provider">
                <Icon name="sms" size={15} />
                <span>انتخاب ارائه‌دهنده پیامک:</span>
              </label>
              <select id="sms_provider" name="sms_provider" class="form-control-modal">
                <option value="kavenegar" selected={settings.sms_provider === 'kavenegar' || !settings.sms_provider}>کاوه نگار (Kavenegar Webhook / Pattern)</option>
                <option value="farazsms" selected={settings.sms_provider === 'farazsms'}>فراز اس‌ام‌اس (FarazSMS / IPPanel)</option>
                <option value="melipayamak" selected={settings.sms_provider === 'melipayamak'}>ملی پیامک (MeliPayamak)</option>
              </select>
              <span class="field-hint">وب‌سرویس مورد استفاده برای ارسال پترن‌های خدماتی بدون بلک‌لیست.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="sms_sender_number">
                <Icon name="send" size={15} />
                <span>خط خدماتی / سرشماره فرستنده:</span>
              </label>
              <input
                id="sms_sender_number"
                type="text"
                name="sms_sender_number"
                dir="ltr"
                class="form-control-modal"
                value={settings.sms_sender_number || '10008585'}
              />
              <span class="field-hint">شماره خط خدماتی ثبت‌شده در سامانه پیامکی.</span>
            </div>

            <div class="field-group settings-grid-full">
              <label class="field-label" for="smsApiKeyInput">
                <Icon name="lock" size={15} />
                <span>کلید امنیتی وب‌سرویس (API Key):</span>
              </label>
              <div class="credential-field-wrap">
                <input
                  id="smsApiKeyInput"
                  type="password"
                  name="sms_api_key"
                  class="form-control-modal"
                  value={settings.sms_api_key || ''}
                  placeholder="••••••••••••••••••••••••••••••••"
                  autocomplete="off"
                  dir="ltr"
                />
                <button
                  type="button"
                  id="toggleApiKeyBtn"
                  class="credential-toggle-btn"
                  title="نمایش / پنهان‌سازی کلید"
                  aria-label="تغییر حالت نمایش کلید امنیتی"
                >
                  <Icon name="eye" size={16} />
                </button>
              </div>
              <div class="security-badge-pill">
                <Icon name="shield" size={14} />
                <span>رمزنگاری‌شده در لبه کلودفلر — در فرانت‌اند مراجعین هرگز افشا نمی‌شود.</span>
              </div>
            </div>
          </div>

          <div class="section-block-header" style="margin-top: 24px;">
            <h3 class="section-block-title" style="font-size: 1.05rem;">
              <Icon name="bell" size={18} />
              <span>ارسال خودکار پیامک‌ها (Automation Triggers)</span>
            </h3>
            <p class="section-block-sub">تنظیم اعلان‌های خودکار برای هر چرخه از تجربه مراجعین کلینیک.</p>
          </div>

          <div style="display: flex; flex-direction: column; gap: 12px;">
            <div class="toggle-row">
              <div>
                <strong style="display: block; font-size: 0.9rem; color: #f8fafc; margin-bottom: 2px;">ارسال پیامک تایید آنی نوبت رزرو</strong>
                <span class="field-hint">ارسال خودکار کد پیگیری، تاریخ، ساعت و نشانی کلینیک بلافاصله پس از ثبت نوبت.</span>
              </div>
              <label class="toggle-switch-3d" aria-label="ارسال تایید نوبت">
                <input type="checkbox" name="sms_booking_confirm_enabled" checked={settings.sms_booking_confirm_enabled !== 'false'} />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="toggle-row">
              <div>
                <strong style="display: block; font-size: 0.9rem; color: #f8fafc; margin-bottom: 2px;">یادآوری هوشمند نوبت ۲۴ ساعت قبل</strong>
                <span class="field-hint">یادآوری آماده‌سازی قبل لیزر (شیو کردن) و اعلام زمان حضور به مراجع.</span>
              </div>
              <label class="toggle-switch-3d" aria-label="یادآوری ۲۴ ساعته">
                <input type="checkbox" name="sms_reminder_24h_enabled" checked={settings.sms_reminder_24h_enabled !== 'false'} />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="toggle-row">
              <div>
                <strong style="display: block; font-size: 0.9rem; color: #f8fafc; margin-bottom: 2px;">تبریک سالروز تولد همراه با کوپن تخفیف</strong>
                <span class="field-hint">ارسال پیامک تبریک صمیمانه همراه با هدیه شارژ کیف پول یا ۳۰٪ تخفیف جلسه.</span>
              </div>
              <label class="toggle-switch-3d" aria-label="پیامک تبریک تولد">
                <input type="checkbox" name="sms_birthday_enabled" checked={settings.sms_birthday_enabled !== 'false'} />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="toggle-row">
              <div>
                <strong style="display: block; font-size: 0.9rem; color: #f8fafc; margin-bottom: 2px;">یادآوری جلسه بعدی دوره درمان</strong>
                <span class="field-hint">ارسال پیامک جهت رزرو جلسه بعد در بازه طلایی ۴ الی ۶ هفته پس از جلسه فعلی.</span>
              </div>
              <label class="toggle-switch-3d" aria-label="یادآوری جلسه بعد">
                <input type="checkbox" name="sms_next_session_enabled" checked={settings.sms_next_session_enabled !== 'false'} />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <!-- Quick Test SMS Box -->
          <div style="margin-top: 24px; padding: 18px; background: rgba(10, 14, 22, 0.6); border: 1px dashed rgba(212, 175, 55, 0.3); border-radius: 16px;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
              <div>
                <strong style="display: block; font-size: 0.88rem; color: #f5d77f; margin-bottom: 4px;">تست ارتباط وب‌سرویس پیامکی:</strong>
                <span class="field-hint">یک پیامک تستی به شماره زیر ارسال کنید تا از اتصال درگاه مطمئن شوید.</span>
              </div>
              <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <input
                  id="testSmsPhone"
                  type="tel"
                  dir="ltr"
                  placeholder="۰۹۱۲۳۴۵۶۷۸۹"
                  class="form-control-modal"
                  style="width: 170px; margin-top: 0; padding: 8px 12px; font-size: 0.86rem;"
                />
                <button type="button" id="testSmsBtn" class="btn-3d-secondary" style="padding: 8px 16px; min-height: 38px; font-size: 0.82rem;">
                  <Icon name="send" size={14} />
                  <span>ارسال پیامک آزمایشی</span>
                </button>
              </div>
            </div>
            <div id="testSmsResult" style="display: none; margin-top: 10px; font-size: 0.82rem;"></div>
          </div>
        </div>
      </section>

      <!-- 3. WORKING HOURS & SCHEDULE PANEL -->
      <section id="panel-schedule" class="settings-panel" role="tabpanel">
        <div class="admin-section-block">
          <div class="section-block-header">
            <h2 class="section-block-title">
              <Icon name="clock" size={20} />
              <span>موتور نوبت‌دهی و زمان‌بندی هوشمند</span>
            </h2>
            <p class="section-block-sub">تنظیم گام زمانی، بافر بهداشتی دستگاه‌ها و قواعد افق رزرو آنلاین کلینیک.</p>
          </div>

          <div class="settings-grid" style="margin-bottom: 24px;">
            <div class="field-group">
              <label class="field-label" for="slot_granularity_minutes">
                <Icon name="clock" size={15} />
                <span>گام اسلات‌های نوبت‌دهی (دقیقه):</span>
              </label>
              <input
                id="slot_granularity_minutes"
                type="number"
                name="slot_granularity_minutes"
                class="form-control-modal"
                value={settings.slot_granularity_minutes || '15'}
                min="5"
                max="120"
                required
              />
              <span class="field-hint">فاصله‌ی زمانی بین شروع هر نوبت در تقویم (پیش‌فرض: ۱۵ یا ۳۰ دقیقه).</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="booking_buffer_minutes">
                <Icon name="shield" size={15} />
                <span>زمان بافر استریل و ضدعفونی (دقیقه):</span>
              </label>
              <input
                id="booking_buffer_minutes"
                type="number"
                name="booking_buffer_minutes"
                class="form-control-modal"
                value={settings.booking_buffer_minutes || '0'}
                min="0"
                max="60"
                required
              />
              <span class="field-hint">فرصت پاکسازی سری دستگاه لیزر و تعویض رول بعد از هر جلسه.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="min_lead_minutes">
                <Icon name="lightning" size={15} />
                <span>حداقل زمان پیش‌خرید نوبت (دقیقه):</span>
              </label>
              <input
                id="min_lead_minutes"
                type="number"
                name="min_lead_minutes"
                class="form-control-modal"
                value={settings.min_lead_minutes || '0'}
                min="0"
                max="1440"
                required
              />
              <span class="field-hint">حداقل فاصله زمانی بین ثبت آنلاین تا ساعت حضور مراجع.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="max_advance_days">
                <Icon name="calendar" size={15} />
                <span>حداکثر افق تقویم برای رزرو آینده (روز):</span>
              </label>
              <input
                id="max_advance_days"
                type="number"
                name="max_advance_days"
                class="form-control-modal"
                value={settings.max_advance_days || '90'}
                min="7"
                max="365"
                required
              />
              <span class="field-hint">مراجعین تا چند روز آینده می‌توانند در سایت نوبت ثبت کنند.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="timezone">
                <Icon name="globe" size={15} />
                <span>منطقه زمانی سرور رزرواسیون:</span>
              </label>
              <input
                id="timezone"
                type="text"
                name="timezone"
                dir="ltr"
                class="form-control-modal"
                value={settings.timezone || 'Asia/Tehran'}
                required
              />
              <span class="field-hint">مبنای محاسبه اوقات شیفت‌ها و تقویم شمسی.</span>
            </div>
          </div>

          <div class="toggle-row" style="margin-bottom: 24px;">
            <div>
              <strong style="display: block; font-size: 0.9rem; color: #f8fafc; margin-bottom: 2px;">سامانه نوبت‌دهی آنلاین سراسری (Online Booking Engine)</strong>
              <span class="field-hint">با غیرفعال‌سازی این گزینه، فرم نوبت‌دهی در وب‌سایت بسته شده و فقط رزرو تلفنی پذیرفته می‌شود.</span>
            </div>
            <label class="toggle-switch-3d" aria-label="فعال بودن نوبت‌دهی آنلاین">
              <input type="checkbox" name="booking_enabled" checked={settings.booking_enabled !== 'false'} />
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- Working Days Summary Card -->
          <div class="shift-card">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; color: #f5d77f; font-weight: 800; font-size: 0.92rem; margin-bottom: 4px;">
                <Icon name="calendar" size={18} />
                <span>شیفت‌های کاری هفتگی و تعطیلات تقویم</span>
              </div>
              <p class="field-hint" style="margin: 0;">
