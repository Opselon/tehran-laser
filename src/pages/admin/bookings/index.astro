---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listAdminBookings, listPublicServices } from '../../../server/repositories';
import { formatJalaliDate } from '../../../lib/datetime/jalali';

const url = Astro.url;
const statusFilter = url.searchParams.get('status') || undefined;
const searchFilter = url.searchParams.get('q') || undefined;
const serviceFilter = url.searchParams.get('service') || undefined;

let bookings: Awaited<ReturnType<typeof listAdminBookings>> = { items: [], nextCursor: null };
let services: Awaited<ReturnType<typeof listPublicServices>> = [];

try {
  [bookings, services] = await Promise.all([
    listAdminBookings(env.DB, {
      status: statusFilter,
      search: searchFilter,
      limit: 50,
    }),
    listPublicServices(env.DB),
  ]);
} catch (e) {
  console.error('Failed to load admin bookings:', e);
}
---

<AdminLayout title="مدیریت نوبت‌ها" activeNav="bookings">
  <div class="admin-content-pad">
    <!-- 3D Page Title Row -->
    <div class="dashboard-header-row">
      <div>
        <h1 class="admin-page-title">دفتر مدیریت نوبت‌ها و رزروها</h1>
        <p class="section-block-sub">
          مشاهده، فیلتر و جستجوی جامع تمامی رزروهای آنلاین و حضوری مراجعین کلینیک تهران لیزر
        </p>
      </div>
      <div class="actions">
        <span style="font-size: 0.88rem; color: #f5d77f; background: rgba(212, 175, 55, 0.15); border: 1px solid rgba(212, 175, 55, 0.35); padding: 8px 16px; border-radius: 12px;">
          مجموع نتایج: {bookings.items.length.toLocaleString('fa-IR')} رزرو
        </span>
      </div>
    </div>

    <!-- 3D Filters Block -->
    <div class="admin-section-block" style="padding: 24px; margin-bottom: 28px;">
      <form method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) auto; gap: 16px; align-items: flex-end;">
        <div>
          <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #cbd5e1; margin-bottom: 6px;">
            وضعیت نوبت:
          </label>
          <select name="status" class="form-control-modal" style="margin-top: 0; padding: 10px 14px;">
            <option value="">همه وضعیت‌ها</option>
            <option value="pending" selected={statusFilter === 'pending'}>در انتظار تأیید</option>
            <option value="confirmed" selected={statusFilter === 'confirmed'}>تأییدشده</option>
            <option value="completed" selected={statusFilter === 'completed'}>انجام‌شده</option>
            <option value="cancelled" selected={statusFilter === 'cancelled'}>لغوشده</option>
            <option value="rejected" selected={statusFilter === 'rejected'}>ردشده</option>
            <option value="no_show" selected={statusFilter === 'no_show'}>عدم حضور</option>
          </select>
        </div>

        <div>
          <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #cbd5e1; margin-bottom: 6px;">
            فیلتر بر اساس خدمت:
          </label>
          <select name="service" class="form-control-modal" style="margin-top: 0; padding: 10px 14px;">
            <option value="">همه خدمات</option>
            {services.map((s) => (
              <option value={s.slug} selected={serviceFilter === s.slug}>{s.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #cbd5e1; margin-bottom: 6px;">
            جستجوی مراجع / کد رهگیری / تلفن:
          </label>
          <input
            type="text"
            name="q"
            class="form-control-modal"
            style="margin-top: 0; padding: 10px 14px;"
            placeholder="نام، ۰۹۱۲ یا کد رهگیری..."
            value={searchFilter || ''}
          />
        </div>

        <div style="display: flex; gap: 8px;">
          <button type="submit" class="btn-3d-refresh" style="padding: 10px 18px;">
            🔍 اعمال فیلتر
          </button>
          <a href="/admin/bookings" class="btn-table-action" style="display: inline-flex; align-items: center; padding: 10px 14px;">
            ✕ پاک کردن
          </a>
        </div>
      </form>
    </div>

    <!-- 3D Bookings Table -->
    <div class="admin-section-block" style="padding: 0; overflow: hidden;">
      {bookings.items.length === 0 ? (
        <div class="empty-state-card" style="border: none; margin: 20px;">
          <span class="empty-icon">🔍</span>
          <p class="empty-text">نوبتی با مشخصات واردشده یافت نشد.</p>
        </div>
      ) : (
        <div class="today-table-wrapper" style="border: none; border-radius: 0;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>کد رزرو</th>
                <th>نام مراجع</th>
                <th>شماره همراه</th>
                <th>خدمت</th>
                <th>بخش</th>
                <th>تاریخ و ساعت نوبت</th>
                <th>مبلغ مصوب</th>
                <th>وضعیت</th>
              </tr>
            </thead>
            <tbody>
              {bookings.items.map((b) => {
                const dateStr = b.startsAt.slice(0, 10);
                const timeStr = new Date(b.startsAt).toLocaleTimeString('fa-IR', {
                  hour: '2-digit',
                  minute: '2-digit',
                  timeZone: 'Asia/Tehran',
                });

                return (
                  <tr>
                    <td dir="ltr" style={{ fontFamily: 'monospace', fontWeight: 800, color: '#f5d77f' }}>
                      {b.reference}
                    </td>
                    <td style={{ fontWeight: 700 }}>{b.customer.name}</td>
                    <td dir="ltr">
                      <a href={`tel:${b.customer.phone}`} style={{ color: '#38bdf8', textDecoration: 'none' }}>
                        {b.customer.phone}
                      </a>
                    </td>
                    <td>{b.service.name}</td>
                    <td>{b.pricingCategory === 'female' ? 'بانوان' : 'آقایان'}</td>
                    <td>
                      <div style={{ fontWeight: 600 }}>{formatJalaliDate(dateStr)}</div>
                      <span style={{ fontSize: '0.78rem', color: '#94a3b8' }}>⏱ ساعت {timeStr}</span>
                    </td>
                    <td>
                      <div style={{ fontWeight: 700 }}>{(b.quotedAmount * 1000).toLocaleString('fa-IR')} تومان</div>
                      {b.discountAmount > 0 && (
                        <span style={{ fontSize: '0.75rem', color: '#34d399' }}>
                          (تخفیف: {(b.discountAmount * 1000).toLocaleString('fa-IR')})
                        </span>
                      )}
                    </td>
                    <td>
                      <span class={`badge-status badge-status-${b.status}`}>
                        {b.status === 'confirmed' && 'تأییدشده'}
                        {b.status === 'pending' && 'در انتظار تأیید'}
                        {b.status === 'completed' && 'انجام‌شده'}
                        {b.status === 'cancelled' && 'لغوشده'}
                        {b.status === 'no_show' && 'عدم حضور'}
                        {b.status === 'rejected' && 'ردشده'}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</AdminLayout>