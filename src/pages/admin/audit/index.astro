    }

    .verify-result.bad {
      color: #f87171;
    }

    .audit-footnote {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-top: 14px;
      font-size: 0.75rem;
      line-height: 1.8;
      color: #8b96a8;
    }

    .audit-footnote :global(svg) {
      flex: 0 0 auto;
      margin-top: 4px;
      color: rgba(212, 175, 55, 0.7);
