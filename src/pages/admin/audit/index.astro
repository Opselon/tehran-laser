    @media (max-width: 640px) {
      .audit-select {
        max-width: 100%;
        width: 100%;
      }

      .audit-select-wrap {
        flex: 1 1 150px;
      }

      .audit-count {
        margin-inline-start: 0;
      }
    }
  </style>

  <script>
    const search = document.getElementById('auditSearch') as HTMLInputElement | null;
    const catSel = document.getElementById('auditCat') as HTMLSelectElement | null;
    const sevSel = document.getElementById('auditSev') as HTMLSelectElement | null;
    const rangeSel = document.getElementById('auditRange') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('auditReset');
    const countEl = document.getElementById('auditCount');
    const body = document.getElementById('auditBody');

    function applyFilters() {
      if (!body) return;
      const q = (search?.value ?? '').trim().toLowerCase();
      const cat = catSel?.value ?? '';
      const sev = sevSel?.value ?? '';
      const rangeMin = rangeSel?.value ? Number(rangeSel.value) : 0;
      const cutoff = rangeMin ? Date.now() - rangeMin * 60000 : 0;

      let visible = 0;
      const trs = body.querySelectorAll<HTMLTableRowElement>('tr[data-seal]');
      trs.forEach((tr) => {
        const ts = Number(tr.dataset.ts ?? '0');
        const okQ = !q || (tr.dataset.search ?? '').includes(q);
        const okCat = !cat || tr.dataset.cat === cat;
        const okSev = !sev || tr.dataset.sev === sev;
        const okRange = !cutoff || ts >= cutoff;
        const show = okQ && okCat && okSev && okRange;
        tr.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (countEl) countEl.textContent = `${visible.toLocaleString('fa-IR')} نمایش`;
    }

    [search, catSel, sevSel, rangeSel].forEach((el) => {
      el?.addEventListener('input', applyFilters);
      el?.addEventListener('change', applyFilters);
    });

    resetBtn?.addEventListener('click', () => {
      if (search) search.value = '';
      if (catSel) catSel.value = '';
      if (sevSel) sevSel.value = '';
      if (rangeSel) rangeSel.value = '';
      applyFilters();
    });

    async function sha256Hex(input: string): Promise<string> {
      const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(input));
      return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    const verifyBtn = document.getElementById('verifyChainBtn');
    const verifyResult = document.getElementById('verifyResult');

    verifyBtn?.addEventListener('click', async () => {
      if (!body || !verifyResult) return;
      verifyBtn.setAttribute('disabled', 'true');
      verifyResult.textContent = 'در حال محاسبه…';
      verifyResult.className = 'verify-result';

      try {
        const rows = Array.from(body.querySelectorAll<HTMLTableRowElement>('tr[data-seal]')).sort(
          (a, b) => Number(a.dataset.idx) - Number(b.dataset.idx),
        );
        let broken = 0;
        for (const tr of rows) {
          const payload = `${tr.dataset.prev}|${tr.dataset.id}|${tr.dataset.actor}|${tr.dataset.action}|${tr.dataset.entity}|${tr.dataset.eid}|${tr.dataset.created}`;
          const hex = await sha256Hex(payload);
          if (hex !== tr.dataset.seal) broken++;
        }
        if (broken === 0) {
          verifyResult.textContent = `زنجیره سالم است — ${rows.length.toLocaleString('fa-IR')} مهر تأیید شد.`;
          verifyResult.className = 'verify-result ok';
        } else {
          verifyResult.textContent = `${broken.toLocaleString('fa-IR')} ردیف دستکاری شده است!`;
          verifyResult.className = 'verify-result bad';
        }
      } catch {
        verifyResult.textContent = 'محاسبه ممکن نشد (WebCrypto در دسترس نیست).';
        verifyResult.className = 'verify-result bad';
      } finally {
        verifyBtn.removeAttribute('disabled');
      }
    });
  </script>
</AdminLayout>
