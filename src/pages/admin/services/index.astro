---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listAdminServices } from '../../../server/repositories';
import Icon from '../../../components/ui/Icon.astro';

let services: Awaited<ReturnType<typeof listAdminServices>> = [];
try {
  services = await listAdminServices(env.DB);
} catch (e) {
  console.error('Failed to load admin services:', e);
}

interface CategoryMeta {
  key: string;
  label: string;
  icon: string;
  color: string;
  bg: string;
  border: string;
}

function getServiceCategory(slug: string, name: string): CategoryMeta {
  const s = slug.toLowerCase();
  const n = name.toLowerCase();
  if (s.includes('body') || n.includes('بدن') || s.includes('package') || n.includes('پکیج')) {
    return {
      key: 'package',
      label: 'پکیج طلایی',
      icon: 'gem',
      color: '#f5d77f',
      bg: 'rgba(212, 175, 55, 0.15)',
      border: 'rgba(212, 175, 55, 0.4)',
    };
  }
  if (
    s.includes('face') ||
    s.includes('lip') ||
    s.includes('chin') ||
    s.includes('neck') ||
    n.includes('صورت') ||
    n.includes('لب') ||
    n.includes('چانه') ||
    n.includes('گردن')
  ) {
    return {
      key: 'face',
      label: 'صورت و گردن',
      icon: 'sparkles',
      color: '#f472b6',
      bg: 'rgba(244, 114, 182, 0.12)',
      border: 'rgba(244, 114, 182, 0.35)',
    };
  }
  if (
    s.includes('arm') ||
    s.includes('forearm') ||
    s.includes('underarm') ||
    n.includes('دست') ||
    n.includes('بازو') ||
    n.includes('ساعد') ||
    n.includes('زیر بغل') ||
    n.includes('زیربغل')
  ) {
    return {
      key: 'arms',
      label: 'دست و بازو',
      icon: 'services',
      color: '#38bdf8',
      bg: 'rgba(56, 189, 248, 0.12)',
      border: 'rgba(56, 189, 248, 0.35)',
    };
  }
  if (
    s.includes('chest') ||
    s.includes('abdomen') ||
    s.includes('navel') ||
    s.includes('back') ||
    n.includes('سینه') ||
    n.includes('شکم') ||
    n.includes('ناف') ||
    n.includes('کمر') ||
    n.includes('پشت')
  ) {
    return {
      key: 'torso',
      label: 'تنه و بالاتنه',
      icon: 'shield',
      color: '#c084fc',
      bg: 'rgba(192, 132, 252, 0.12)',
      border: 'rgba(192, 132, 252, 0.35)',
    };
  }
  if (
    s.includes('leg') ||
    s.includes('thigh') ||
    s.includes('bikini') ||
    s.includes('buttock') ||
    s.includes('gluteal') ||
    n.includes('پا') ||
    n.includes('ران') ||
    n.includes('ساق') ||
    n.includes('بیکینی') ||
    n.includes('باسن')
  ) {
    return {
      key: 'legs',
      label: 'پا و نواحی خاص',
      icon: 'tag',
      color: '#34d399',
      bg: 'rgba(52, 211, 153, 0.12)',
      border: 'rgba(52, 211, 153, 0.35)',
    };
  }
  return {
    key: 'other',
    label: 'سایر خدمات',
    icon: 'gem',
    color: '#94a3b8',
    bg: 'rgba(148, 163, 184, 0.12)',
    border: 'rgba(148, 163, 184, 0.35)',
  };
}

const activeCount = services.filter((s) => s.active).length;
const inactiveCount = services.length - activeCount;
const maxDisplayOrder = services.reduce((max, s) => Math.max(max, s.displayOrder || 0), 0);
const nextDisplayOrder = maxDisplayOrder + 1;

/** How many services already carry a real (non-zero) tariff for each gender list. */
const pricedCount = (category: 'female' | 'male') =>
  services.filter((s) => s.prices.some((p) => p.pricingCategory === category && p.amount > 0)).length;
const femalePricedCount = pricedCount('female');
const malePricedCount = pricedCount('male');

interface CategoryCounters {
  all: number;
  face: number;
  arms: number;
  torso: number;
  legs: number;
  package: number;
  other: number;
}

const categoryCounts: CategoryCounters = {
  all: services.length,
  face: 0,
  arms: 0,
  torso: 0,
  legs: 0,
  package: 0,
  other: 0,
};

for (const s of services) {
  const cat = getServiceCategory(s.slug, s.name);
  const key = cat.key as keyof CategoryCounters;
  categoryCounts[key] = (categoryCounts[key] || 0) + 1;
}
---

<AdminLayout title="خدمات و تعرفه‌ها" activeNav="services">
  <div class="admin-content-pad services-page-container" id="servicesPageRoot" data-tariff-gender="female">
    <!-- 3D Header Row -->
    <div class="dashboard-header-row services-header-3d">
      <div class="services-header-info">
        <div class="services-title-wrapper">
          <span class="services-icon-box">
            <Icon name="services" size={24} />
          </span>
          <h1 class="admin-page-title">کاتالوگ خدمات و تعرفه‌های مصوب کلینیک</h1>
        </div>
        <p class="section-block-sub">
          مدیریت نواحی تحت پوشش لیزر، ویرایش زمان جلسات و به‌روزرسانی تعرفه مصوب بانوان و آقایان (کاملاً API First)
        </p>
      </div>

      <div class="services-header-actions">
        <div class="stats-pills-row">
          <span class="stat-pill stat-pill--active" title="تعداد خدمات فعال در وب‌سایت">
            <Icon name="checkCircle" size={14} />
            <span>فعال: {activeCount.toLocaleString('fa-IR')}</span>
          </span>
          <span class="stat-pill stat-pill--inactive" title="تعداد خدمات غیرفعال">
            <Icon name="eye" size={14} />
            <span>غیرفعال: {inactiveCount.toLocaleString('fa-IR')}</span>
          </span>
          <span class="stat-pill stat-pill--total" title="کل خدمات ثبت شده در سامانه">
            <Icon name="list" size={14} />
            <span>مجموع: {services.length.toLocaleString('fa-IR')}</span>
          </span>
        </div>

        <button type="button" id="openNewServiceBtn" class="btn-3d-gold add-service-btn">
          <Icon name="plus" size={16} />
          <span>افزودن خدمت جدید</span>
        </button>
      </div>
    </div>

    <!-- 3D Filter & Search Toolbar -->
    <div class="admin-section-block services-toolbar-block">
      <!-- Gender tariff switch — the two price lists are kept fully separate -->
      <div class="tariff-gender-switch" role="tablist" aria-label="انتخاب فهرست تعرفه">
        <button
          type="button"
          class="tariff-gender-btn active"
          role="tab"
          aria-selected="true"
          data-gender="female"
          id="tariffTabFemale"
        >
          <span class="tariff-gender-dot tariff-gender-dot--female"></span>
          <Icon name="heart" size={14} />
          <span class="tariff-gender-text">تعرفه مصوب بانوان</span>
          <span class="tariff-gender-count">{femalePricedCount.toLocaleString('fa-IR')}</span>
        </button>
        <button
          type="button"
          class="tariff-gender-btn"
          role="tab"
          aria-selected="false"
          data-gender="male"
          id="tariffTabMale"
        >
          <span class="tariff-gender-dot tariff-gender-dot--male"></span>
          <Icon name="shield" size={14} />
          <span class="tariff-gender-text">تعرفه مصوب آقایان</span>
          <span class="tariff-gender-count">{malePricedCount.toLocaleString('fa-IR')}</span>
        </button>
      </div>

      <div class="services-toolbar-top">
        <div class="services-search-col">
          <div class="search-input-wrap">
            <span class="search-icon">
              <Icon name="search" size={16} />
            </span>
            <input
              type="text"
              id="serviceSearchInput"
              class="form-control-modal search-input-field"
              placeholder="جستجوی سریع با نام خدمت یا شناسه (مثال: صورت، arms، زیر بغل)..."
            />
            <button type="button" id="clearSearchBtn" class="clear-search-btn" style="display: none;" title="پاک کردن جستجو">
              <Icon name="close" size={14} />
            </button>
          </div>
        </div>

        <div class="services-status-filter-col">
          <select id="statusFilterSelect" class="form-control-modal status-filter-select">
            <option value="all">همه وضعیت‌ها (فعال و غیرفعال)</option>
            <option value="active">فقط خدمات فعال (منتشر شده)</option>
            <option value="inactive">فقط خدمات غیرفعال (مخفی)</option>
          </select>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="services-categories-bar">
        <div class="category-tabs-scroll">
          <button type="button" class="category-tab-btn active" data-category="all">
            <Icon name="list" size={14} />
            <span>همه ({categoryCounts.all.toLocaleString('fa-IR')})</span>
          </button>
          <button type="button" class="category-tab-btn" data-category="face">
            <Icon name="sparkles" size={14} />
            <span>صورت و گردن ({categoryCounts.face.toLocaleString('fa-IR')})</span>
          </button>
          <button type="button" class="category-tab-btn" data-category="arms">
            <Icon name="services" size={14} />
            <span>دست و بازو ({categoryCounts.arms.toLocaleString('fa-IR')})</span>
          </button>
          <button type="button" class="category-tab-btn" data-category="torso">
            <Icon name="shield" size={14} />
            <span>تنه و بالاتنه ({categoryCounts.torso.toLocaleString('fa-IR')})</span>
          </button>
          <button type="button" class="category-tab-btn" data-category="legs">
            <Icon name="tag" size={14} />
            <span>پا و نواحی خاص ({categoryCounts.legs.toLocaleString('fa-IR')})</span>
          </button>
          <button type="button" class="category-tab-btn" data-category="package">
            <Icon name="gem" size={14} />
            <span>پکیج طلایی ({categoryCounts.package.toLocaleString('fa-IR')})</span>
          </button>
        </div>

        <div class="services-counter-indicator" id="servicesCounterIndicator">
          نمایش {services.length.toLocaleString('fa-IR')} خدمت
        </div>
      </div>
    </div>

    <!-- 3D Services Management Table (Desktop View) -->
    <div class="admin-section-block services-table-section desktop-only-table" style="padding: 0; overflow: hidden;">
      <div class="today-table-wrapper services-table-wrapper" style="border: none; border-radius: 0;">
        <table class="admin-table services-3d-table" id="servicesTable">
          <thead>
            <tr>
              <th style="width: 50px; text-align: center;">ترتیب</th>
              <th>نام خدمت و دسته‌بندی</th>
              <th>شناسه یکتا (Slug)</th>
              <th>مدت جلسه</th>
              <th class="col-gender-female">تعرفه مصوب بانوان</th>
              <th class="col-gender-male">تعرفه مصوب آقایان</th>
              <th style="text-align: center;">وضعیت سایت</th>
              <th style="text-align: center;">عملیات</th>
            </tr>
          </thead>
          <tbody id="servicesTableBody">
            {services.map((s) => {
              const femalePrice = s.prices.find((p) => p.pricingCategory === 'female');
              const malePrice = s.prices.find((p) => p.pricingCategory === 'male');
              const femalePriceAmount = femalePrice ? femalePrice.amount : 0;
              const malePriceAmount = malePrice ? malePrice.amount : 0;
              const isPromo = s.slug === 'full-body';
              const cat = getServiceCategory(s.slug, s.name);

              return (
                <tr
                  class="service-row"
                  data-id={s.id}
                  data-name={s.name.toLowerCase()}
                  data-slug={s.slug.toLowerCase()}
                  data-category={cat.key}
                  data-active={s.active ? 'true' : 'false'}
                >
                  <td style={{ textAlign: 'center' }}>
                    <span class="order-pill-badge">{s.displayOrder}</span>
                  </td>
                  <td>
                    <div class="service-name-cell">
                      <div class="service-title-text">{s.name}</div>
                      <div class="service-category-badge" style={`color: ${cat.color}; background: ${cat.bg}; border: 1px solid ${cat.border};`}>
                        <Icon name={cat.icon} size={11} />
                        <span>{cat.label}</span>
                      </div>
                      {s.shortDescription && (
                        <div class="service-short-desc">{s.shortDescription}</div>
                      )}
                    </div>
                  </td>
                  <td dir="ltr" style={{ fontFamily: 'monospace', color: '#f5d77f', fontSize: '0.85rem' }}>
                    <span class="slug-tag">{s.slug}</span>
                  </td>
                  <td>
                    <span class="duration-badge">
                      <Icon name="clock" size={13} />
                      <span>{s.durationMinutes} دقیقه</span>
                    </span>
                  </td>
                  <td class="col-gender-female">
                    <div class="tariff-cell-wrap">
                      {femalePrice ? (
                        isPromo ? (
                          <div class="promo-price-block">
                            <span class="promo-old-price">
                              ۲٬۲۹۰٬۰۰۰
                            </span>
                            <span class="promo-new-price">
                              ۱٬۹۴۰٬۰۰۰ تومان
                            </span>
                            <span class="promo-tag">ویژه سایت</span>
                          </div>
                        ) : (
                          <span class="price-badge-female">
                            {(femalePrice.amount * 1000).toLocaleString('fa-IR')} تومان
                          </span>
                        )
                      ) : (
                        <span class="price-badge-unset">
                          <Icon name="info" size={11} />
                          <span>استعلام تلفنی</span>
                        </span>
                      )}
                      <button
                        type="button"
                        class="btn-quick-edit js-quick-edit-price"
                        title="ویرایش سریع تعرفه بانوان"
                        data-id={s.id}
                        data-target="female"
                      >
                        <Icon name="edit" size={11} />
                      </button>
                    </div>
                  </td>
                  <td class="col-gender-male">
                    <div class="tariff-cell-wrap">
                      {malePrice && malePrice.amount > 0 ? (
                        <span class="price-badge-male">
                          {(malePrice.amount * 1000).toLocaleString('fa-IR')} تومان
                        </span>
                      ) : (
                        <span class="price-badge-unset">
                          <Icon name="info" size={11} />
                          <span>استعلام تلفنی</span>
                        </span>
                      )}
                      <button
                        type="button"
                        class="btn-quick-edit js-quick-edit-price"
                        title="ویرایش سریع تعرفه آقایان"
                        data-id={s.id}
                        data-target="male"
                      >
                        <Icon name="edit" size={11} />
                      </button>
                    </div>
                  </td>
                  <td style={{ textAlign: 'center' }}>
                    <button
                      type="button"
                      class="switch-3d js-toggle-active"
                      data-id={s.id}
                      data-active={s.active ? 'true' : 'false'}
                      data-name={s.name}
                      title={s.active ? 'کلیک جهت غیرفعال کردن خدمت' : 'کلیک جهت فعال کردن خدمت'}
                    >
                      <span class={`switch-3d-track ${s.active ? 'active' : ''}`}>
                        <span class="switch-3d-thumb"></span>
                      </span>
                      <span class="switch-3d-label">{s.active ? 'فعال' : 'غیرفعال'}</span>
                    </button>
                  </td>
                  <td style={{ textAlign: 'center' }}>
                    <button
                      type="button"
                      class="btn-table-action edit-service-btn"
                      data-id={s.id}
                      data-name={s.name}
                      data-slug={s.slug}
                      data-duration={s.durationMinutes}
                      data-active={s.active ? 'true' : 'false'}
                      data-order={s.displayOrder}
                      data-shortdesc={s.shortDescription || ''}
                      data-price-female={femalePriceAmount}
                      data-price-male={malePriceAmount}
                    >
                      <Icon name="edit" size={13} />
                      <span>ویرایش خدمت</span>
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>

        <!-- Empty state row -->
        <div id="noResultsDesktop" class="empty-results-box" style="display: none;">
          <Icon name="search" size={28} />
          <p>هیچ خدمتی مطابق با جستجو یا فیلتر دسته‌بندی انتخاب‌شده یافت نشد.</p>
        </div>
      </div>
    </div>

    <!-- 3D Mobile Cards View (< 768px, specifically 320px & 390px) -->
    <div class="services-cards-mobile" id="servicesMobileList">
      {services.map((s) => {
        const femalePrice = s.prices.find((p) => p.pricingCategory === 'female');
        const malePrice = s.prices.find((p) => p.pricingCategory === 'male');
        const femalePriceAmount = femalePrice ? femalePrice.amount : 0;
        const malePriceAmount = malePrice ? malePrice.amount : 0;
        const isPromo = s.slug === 'full-body';
        const cat = getServiceCategory(s.slug, s.name);

        return (
          <div
            class="service-card-mobile service-row"
            data-id={s.id}
            data-name={s.name.toLowerCase()}
            data-slug={s.slug.toLowerCase()}
            data-category={cat.key}
            data-active={s.active ? 'true' : 'false'}
          >
            <div class="card-mobile-top">
              <div class="card-mobile-title-col">
                <span class="order-pill-badge">{s.displayOrder}</span>
                <span class="card-service-title">{s.name}</span>
                <span class="service-category-badge" style={`color: ${cat.color}; background: ${cat.bg}; border: 1px solid ${cat.border};`}>
                  <Icon name={cat.icon} size={11} />
                  <span>{cat.label}</span>
                </span>
              </div>
              <div class="card-mobile-switch-col">
                <button
                  type="button"
                  class="switch-3d js-toggle-active"
                  data-id={s.id}
                  data-active={s.active ? 'true' : 'false'}
                  data-name={s.name}
                  title={s.active ? 'کلیک جهت غیرفعال کردن' : 'کلیک جهت فعال کردن'}
                >
                  <span class={`switch-3d-track ${s.active ? 'active' : ''}`}>
                    <span class="switch-3d-thumb"></span>
                  </span>
                  <span class="switch-3d-label">{s.active ? 'فعال' : 'غیرفعال'}</span>
                </button>
              </div>
            </div>

            <div class="card-mobile-meta">
              <span class="slug-tag" dir="ltr">{s.slug}</span>
              <span class="duration-badge">
                <Icon name="clock" size={12} />
                <span>{s.durationMinutes} دقیقه</span>
              </span>
            </div>

            {s.shortDescription && (
              <div class="card-mobile-desc">{s.shortDescription}</div>
            )}

            <div class="card-mobile-tariffs">
              <div class="tariff-box-mobile col-gender-female">
                <span class="tariff-box-label">تعرفه مصوب بانوان:</span>
                <div class="tariff-box-val">
                  {femalePrice ? (
                    isPromo ? (
                      <span class="promo-new-price" style="font-size: 0.86rem;">
                        ۱٬۹۴۰٬۰۰۰ تومان (تخفیف سایت)
                      </span>
                    ) : (
                      <span class="price-badge-female">
                        {(femalePrice.amount * 1000).toLocaleString('fa-IR')} تومان
                      </span>
                    )
                  ) : (
                    <span class="price-badge-unset">استعلام تلفنی</span>
                  )}
                </div>
              </div>

              <div class="tariff-box-mobile col-gender-male">
                <span class="tariff-box-label">تعرفه مصوب آقایان:</span>
                <div class="tariff-box-val">
                  {malePrice && malePrice.amount > 0 ? (
                    <span class="price-badge-male">
                      {(malePrice.amount * 1000).toLocaleString('fa-IR')} تومان
                    </span>
                  ) : (
                    <span class="price-badge-unset">استعلام تلفنی</span>
                  )}
                </div>
              </div>
            </div>

            <div class="card-mobile-actions">
              <button
                type="button"
                class="btn-table-action edit-service-btn btn-mobile-edit"
                data-id={s.id}
                data-name={s.name}
                data-slug={s.slug}
                data-duration={s.durationMinutes}
                data-active={s.active ? 'true' : 'false'}
                data-order={s.displayOrder}
                data-shortdesc={s.shortDescription || ''}
                data-price-female={femalePriceAmount}
                data-price-male={malePriceAmount}
              >
                <Icon name="edit" size={14} />
                <span>ویرایش مشخصات و تعرفه خدمت</span>
              </button>
            </div>
          </div>
        );
      })}

      <div id="noResultsMobile" class="empty-results-box" style="display: none;">
        <Icon name="search" size={28} />
        <p>هیچ خدمتی مطابق با جستجو یا فیلتر دسته‌بندی انتخاب‌شده یافت نشد.</p>
      </div>
    </div>

    <!-- 3D Edit Service Modal -->
    <div id="serviceEditModal" class="modal-backdrop services-modal-backdrop" style="display: none;">
      <div class="modal-dialog services-modal-dialog">
        <div class="modal-header-row">
          <div class="modal-title-wrap">
            <span class="modal-title-icon-gold">
              <Icon name="edit" size={20} />
            </span>
            <h3 class="modal-title">ویرایش خدمت و تعرفه مصوب</h3>
          </div>
          <button type="button" id="closeEditModalX" class="modal-close-icon-btn" title="بستن">
            <Icon name="close" size={16} />
          </button>
        </div>

        <p class="modal-subtitle-text">
          تغییر نام ناحیه، زمان تخصیصی جلسه و نرخ‌گذاری هر فهرست تعرفه (بانوان / آقایان) به‌صورت کاملاً جداگانه، مستقیماً در دیتابیس D1 ذخیره می‌شود.
        </p>

        <div id="serviceAlert" class="alert-3d-danger" style="display: none;">
          <Icon name="warning" size={16} />
          <span id="serviceAlertText"></span>
        </div>

        <form id="editServiceForm" class="services-modal-form">
          <input type="hidden" id="editServiceId" />

          <div class="form-grid-2col">
            <div class="form-group-item">
              <label for="editServiceName" class="form-label-gold">نام ناحیه / خدمت (فارسی):</label>
              <input
                type="text"
                id="editServiceName"
                class="form-control-modal"
                required
                minlength="2"
                maxlength="80"
              />
            </div>

            <div class="form-group-item">
              <label for="editServiceSlug" class="form-label-gold">شناسه یکتا (Slug):</label>
              <input
                type="text"
                id="editServiceSlug"
                class="form-control-modal slug-input"
                dir="ltr"
                required
                pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$"
