  <script>
    // State management
    let activeCategory = 'all';
    let activeStatus = 'all';
    let searchQuery = '';
    /** Which single gender tariff list is on screen — the two lists are never mixed. */
    let activeGender: 'female' | 'male' = 'female';
    /** sessionStorage key so the chosen list survives the save-triggered page reload. */
    const GENDER_STORAGE_KEY = 'adminServices.tariffGender';

    // ── API error helpers ──────────────────────────────────────
    // The API responds with { error: { code, message, fields } } on 4xx.
    interface ApiErrorResponse {
      error?: string | { message?: string; fields?: Record<string, string[]>; code?: string };
    }

    function extractApiError(data: ApiErrorResponse, fallback: string): string {
      const err = data?.error;
      if (!err) return fallback;
      if (typeof err === 'string') return err;
      if (err.fields) {
        const parts: string[] = [];
        for (const msgs of Object.values(err.fields)) {
          if (Array.isArray(msgs) && msgs.length > 0 && typeof msgs[0] === 'string') {
            parts.push(msgs[0]);
          }
        }
        if (parts.length > 0) return parts.join(' — ');
      }
      return err.message || fallback;
    }

    // Elements
    const searchInput = document.getElementById('serviceSearchInput') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clearSearchBtn') as HTMLButtonElement | null;
    const statusSelect = document.getElementById('statusFilterSelect') as HTMLSelectElement | null;
    const categoryBtns = document.querySelectorAll('.category-tab-btn');
    const counterDisplay = document.getElementById('servicesCounterIndicator');

    // Gender tariff switch (page scope) + gender tabs inside the tariff panels
    const pageRoot = document.getElementById('servicesPageRoot');
    const genderSwitchBtns = document.querySelectorAll<HTMLButtonElement>('.tariff-gender-btn');
    const editTariffsPanel = document.getElementById('editTariffsPanel');
    const newTariffsPanel = document.getElementById('newTariffsPanel');

    const editModal = document.getElementById('serviceEditModal');
    const editForm = document.getElementById('editServiceForm') as HTMLFormElement | null;
    const cancelEditBtn = document.getElementById('cancelServiceBtn');
    const closeEditX = document.getElementById('closeEditModalX');
    const saveEditBtn = document.getElementById('saveServiceBtn') as HTMLButtonElement | null;
    const editAlertBox = document.getElementById('serviceAlert');
    const editAlertText = document.getElementById('serviceAlertText');

    const editIdInput = document.getElementById('editServiceId') as HTMLInputElement | null;
    const editNameInput = document.getElementById('editServiceName') as HTMLInputElement | null;
    const editSlugInput = document.getElementById('editServiceSlug') as HTMLInputElement | null;
    const editDurationInput = document.getElementById('editServiceDuration') as HTMLInputElement | null;
    const editOrderInput = document.getElementById('editServiceOrder') as HTMLInputElement | null;
    const editActiveSelect = document.getElementById('editServiceActive') as HTMLSelectElement | null;
    const editShortDescInput = document.getElementById('editServiceShortDesc') as HTMLInputElement | null;
    const editPriceFemaleInput = document.getElementById('editServicePriceFemale') as HTMLInputElement | null;
    const editPriceMaleInput = document.getElementById('editServicePriceMale') as HTMLInputElement | null;
    const editFemalePreview = document.getElementById('editFemaleTomanPreview');
    const editMalePreview = document.getElementById('editMaleTomanPreview');

    // New Service Modal Elements
    const newModal = document.getElementById('newServiceModal');
    const newForm = document.getElementById('newServiceForm') as HTMLFormElement | null;
    const openNewBtn = document.getElementById('openNewServiceBtn');
    const cancelNewBtn = document.getElementById('cancelNewServiceBtn');
    const closeNewX = document.getElementById('closeNewModalX');
    const saveNewBtn = document.getElementById('saveNewServiceBtn') as HTMLButtonElement | null;
    const newAlertBox = document.getElementById('newServiceAlert');
    const newAlertText = document.getElementById('newServiceAlertText');

    const newNameInput = document.getElementById('newServiceName') as HTMLInputElement | null;
    const newSlugInput = document.getElementById('newServiceSlug') as HTMLInputElement | null;
    const newDurationInput = document.getElementById('newServiceDuration') as HTMLInputElement | null;
    const newOrderInput = document.getElementById('newServiceOrder') as HTMLInputElement | null;
    const newActiveSelect = document.getElementById('newServiceActive') as HTMLSelectElement | null;
    const newShortDescInput = document.getElementById('newServiceShortDesc') as HTMLInputElement | null;
    const newPriceFemaleInput = document.getElementById('newServicePriceFemale') as HTMLInputElement | null;
    const newPriceMaleInput = document.getElementById('newServicePriceMale') as HTMLInputElement | null;
    const newFemalePreview = document.getElementById('newFemaleTomanPreview');
    const newMalePreview = document.getElementById('newMaleTomanPreview');

    // Toast
    const toast = document.getElementById('servicesToast');
    const toastMsg = document.getElementById('toastMessage');
    let toastTimer: number | undefined;

    function showToast(message: string) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = message;
      toast.style.display = 'flex';
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.style.display = 'none';
      }, 3000);
    }

    // Helper: update live Toman preview
    function updateTomanPreview(input: HTMLInputElement | null, preview: HTMLElement | null) {
      if (!input || !preview) return;
      const val = Number(input.value);
      if (val > 0) {
        const toman = (val * 1000).toLocaleString('fa-IR');
        preview.textContent = `معادل: ${toman} تومان`;
        preview.classList.remove('muted');
      } else {
        preview.textContent = 'معادل: استعلام تلفنی';
        preview.classList.add('muted');
      }
    }

    // Bind preview listeners
    if (editPriceFemaleInput && editFemalePreview) {
      editPriceFemaleInput.addEventListener('input', () => updateTomanPreview(editPriceFemaleInput, editFemalePreview));
    }
    if (editPriceMaleInput && editMalePreview) {
      editPriceMaleInput.addEventListener('input', () => updateTomanPreview(editPriceMaleInput, editMalePreview));
    }
    if (newPriceFemaleInput && newFemalePreview) {
      newPriceFemaleInput.addEventListener('input', () => updateTomanPreview(newPriceFemaleInput, newFemalePreview));
    }
    if (newPriceMaleInput && newMalePreview) {
      newPriceMaleInput.addEventListener('input', () => updateTomanPreview(newPriceMaleInput, newMalePreview));
    }

    // Auto slug sanitizer for new service
    if (newSlugInput) {
      newSlugInput.addEventListener('input', () => {
        newSlugInput.value = newSlugInput.value
          .toLowerCase()
          .replace(/[^a-z0-9-]/g, '-')
          .replace(/-+/g, '-');
      });
    }

    // ── Gender tariff list: one list on screen at a time ────────────────────
    const genderLabel = (g: 'female' | 'male') => (g === 'female' ? 'بانوان' : 'آقایان');

    /** Reveals exactly one gender's price field inside a create/edit tariff panel. */
    function setPanelGender(panel: HTMLElement | null, gender: 'female' | 'male', focusInput = false) {
      if (!panel) return;
      panel.dataset.gender = gender;
      panel.querySelectorAll<HTMLButtonElement>('.modal-gender-tab').forEach((tab) => {
        const on = tab.dataset.gender === gender;
        tab.classList.toggle('active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (focusInput) {
        const input = panel.querySelector<HTMLInputElement>(
          `.modal-gender-pane[data-gender="${gender}"] input.price-input`,
        );
        if (input) window.setTimeout(() => input.focus(), 60);
      }
    }

    /** Scopes the whole page (table columns + mobile tariff boxes) to ONE gender list. */
    function setGenderList(gender: 'female' | 'male') {
      activeGender = gender;
      if (pageRoot) pageRoot.dataset.tariffGender = gender;
      genderSwitchBtns.forEach((btn) => {
        const on = btn.dataset.gender === gender;
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      try {
        sessionStorage.setItem(GENDER_STORAGE_KEY, gender);
      } catch {
        /* storage unavailable — the switch still works for this page view */
      }
      applyFilters();
    }

    genderSwitchBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const gender = btn.dataset.gender as 'female' | 'male' | undefined;
        if (gender && gender !== activeGender) setGenderList(gender);
      });
    });

    // Saving a service reloads the page — restore the list the operator was editing
    // so the gender they chose never silently flips back to بانوان.
    try {
      const savedGender = sessionStorage.getItem(GENDER_STORAGE_KEY);
      if (savedGender === 'female' || savedGender === 'male') setGenderList(savedGender);
    } catch {
      /* keep the SSR default (بانوان) */
    }

    [editTariffsPanel, newTariffsPanel].forEach((panel) => {
      if (!panel) return;
      panel.querySelectorAll<HTMLButtonElement>('.modal-gender-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const gender = tab.dataset.gender as 'female' | 'male' | undefined;
          if (gender) setPanelGender(panel, gender, true);
        });
      });
    });

    // Filter Logic
    function applyFilters() {
      const allRows = document.querySelectorAll<HTMLElement>('.service-row');
      let visibleDesktop = 0;
      let visibleMobile = 0;

      allRows.forEach((row) => {
        const cat = row.dataset.category || '';
        const active = row.dataset.active || 'true';
        const name = row.dataset.name || '';
        const slug = row.dataset.slug || '';

        const matchesCategory = activeCategory === 'all' || cat === activeCategory;
        const matchesStatus =
          activeStatus === 'all' ||
          (activeStatus === 'active' && active === 'true') ||
          (activeStatus === 'inactive' && active === 'false');
        const matchesSearch =
          !searchQuery || name.includes(searchQuery) || slug.includes(searchQuery);

        const isVisible = matchesCategory && matchesStatus && matchesSearch;
        row.style.display = isVisible ? '' : 'none';

        if (isVisible) {
          if (row.classList.contains('service-card-mobile')) {
            visibleMobile++;
          } else {
            visibleDesktop++;
          }
        }
      });

      const noResDesktop = document.getElementById('noResultsDesktop');
      const noResMobile = document.getElementById('noResultsMobile');
      if (noResDesktop) noResDesktop.style.display = visibleDesktop === 0 ? 'flex' : 'none';
      if (noResMobile) noResMobile.style.display = visibleMobile === 0 ? 'flex' : 'none';

      if (counterDisplay) {
        counterDisplay.textContent = `نمایش ${visibleDesktop.toLocaleString('fa-IR')} خدمت · فهرست تعرفه ${genderLabel(activeGender)}`;
      }
    }

    // Search event
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        if (clearSearchBtn) {
          clearSearchBtn.style.display = searchQuery ? 'flex' : 'none';
        }
        applyFilters();
      });
    }

    if (clearSearchBtn && searchInput) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.style.display = 'none';
        applyFilters();
        searchInput.focus();
      });
    }

    // Status filter event
    if (statusSelect) {
      statusSelect.addEventListener('change', () => {
        activeStatus = statusSelect.value;
        applyFilters();
      });
    }

    // Category filter tabs
    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        categoryBtns.forEach((b) => b.classList.remove('active'));
        target.classList.add('active');
        activeCategory = target.dataset.category || 'all';
        applyFilters();
      });
    });

    // Populate and open edit modal
    function openEditModal(btn: HTMLElement, focusTarget?: 'female' | 'male') {
      if (!editModal || !editIdInput || !editNameInput || !editSlugInput || !editDurationInput || !editOrderInput || !editActiveSelect || !editShortDescInput || !editPriceFemaleInput || !editPriceMaleInput) return;

      const id = btn.dataset.id || '';
      editIdInput.value = id;
      editNameInput.value = btn.dataset.name || '';
      editSlugInput.value = btn.dataset.slug || '';
      editDurationInput.value = btn.dataset.duration || '15';
      editOrderInput.value = btn.dataset.order || '0';
      editActiveSelect.value = btn.dataset.active || 'true';
      editShortDescInput.value = btn.dataset.shortdesc || '';
      editPriceFemaleInput.value = btn.dataset.priceFemale || '0';
      editPriceMaleInput.value = btn.dataset.priceMale || '0';

      updateTomanPreview(editPriceFemaleInput, editFemalePreview);
      updateTomanPreview(editPriceMaleInput, editMalePreview);

      if (editAlertBox) editAlertBox.style.display = 'none';
      editModal.style.display = 'flex';

      // The edit modal opens on the same single-gender list the page is showing
      // (or the list the quick-edit pencil was clicked from).
      const target: 'female' | 'male' = focusTarget || activeGender;
      setPanelGender(editTariffsPanel, target);

      if (focusTarget) {
        const focusField = target === 'female' ? editPriceFemaleInput : editPriceMaleInput;
        setTimeout(() => focusField.focus(), 100);
      } else {
        setTimeout(() => editNameInput.focus(), 100);
      }
    }

    document.querySelectorAll('.edit-service-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        openEditModal(target);
      });
    });

    // Quick Edit price trigger
    document.querySelectorAll('.js-quick-edit-price').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const gender = target.dataset.target as 'female' | 'male';
        const parentRow = target.closest('tr');
        if (!parentRow) return;
        const mainEditBtn = parentRow.querySelector('.edit-service-btn') as HTMLElement | null;
        if (mainEditBtn) {
          openEditModal(mainEditBtn, gender);
        }
      });
    });

    // Close edit modal
    function closeEditModal() {
      if (editModal) editModal.style.display = 'none';
    }
    if (cancelEditBtn) cancelEditBtn.addEventListener('click', closeEditModal);
    if (closeEditX) closeEditX.addEventListener('click', closeEditModal);

    // Open/Close new service modal
    if (openNewBtn && newModal) {
      openNewBtn.addEventListener('click', () => {
        if (newForm) newForm.reset();
        setPanelGender(newTariffsPanel, activeGender);
        updateTomanPreview(newPriceFemaleInput, newFemalePreview);
        updateTomanPreview(newPriceMaleInput, newMalePreview);
        if (newAlertBox) newAlertBox.style.display = 'none';
        newModal.style.display = 'flex';
        if (newNameInput) setTimeout(() => newNameInput.focus(), 100);
      });
    }

    function closeNewModal() {
      if (newModal) newModal.style.display = 'none';
    }
    if (cancelNewBtn) cancelNewBtn.addEventListener('click', closeNewModal);
    if (closeNewX) closeNewX.addEventListener('click', closeNewModal);

    // Close on backdrop click
    window.addEventListener('click', (e) => {
      if (e.target === editModal) closeEditModal();
      if (e.target === newModal) closeNewModal();
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeEditModal();
        closeNewModal();
      }
    });

    // Active Toggle Switch handler
    document.querySelectorAll('.js-toggle-active').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const serviceId = target.dataset.id;
        if (!serviceId) return;

        const currentActive = target.dataset.active === 'true';
        const newActive = !currentActive;

        target.disabled = true;

        try {
          const res = await fetch(`/api/v1/admin/services/${serviceId}`, {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ active: newActive }),
          });

          if (res.ok) {
            // Update switch state
            target.dataset.active = String(newActive);
            const track = target.querySelector('.switch-3d-track');
            const label = target.querySelector('.switch-3d-label');
            if (track) track.classList.toggle('active', newActive);
            if (label) label.textContent = newActive ? 'فعال' : 'غیرفعال';

            // Also synchronize peer switches (e.g. mobile vs desktop)
            document.querySelectorAll(`.js-toggle-active[data-id="${serviceId}"]`).forEach((peer) => {
              if (peer !== target) {
                peer.setAttribute('data-active', String(newActive));
                const peerTrack = peer.querySelector('.switch-3d-track');
                const peerLabel = peer.querySelector('.switch-3d-label');
                if (peerTrack) peerTrack.classList.toggle('active', newActive);
                if (peerLabel) peerLabel.textContent = newActive ? 'فعال' : 'غیرفعال';
              }
            });

            // Update row dataset
            document.querySelectorAll(`.service-row[data-id="${serviceId}"]`).forEach((row) => {
              (row as HTMLElement).dataset.active = String(newActive);
            });

            // Update edit buttons dataset
            document.querySelectorAll(`.edit-service-btn[data-id="${serviceId}"]`).forEach((editBtn) => {
              (editBtn as HTMLElement).dataset.active = String(newActive);
            });

            showToast(newActive ? 'خدمت با موفقیت در وب‌سایت فعال شد' : 'خدمت به حالت غیرفعال (مخفی) درآمد');
          } else {
            showToast('خطا در تغییر وضعیت انتشار خدمت');
          }
        } catch {
          showToast('خطای شبکه در ارتباط با سرور');
        } finally {
          target.disabled = false;
        }
      });
    });

    // Submit Edit Service Form
    if (editForm && editModal) {
      editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!editIdInput || !editNameInput || !editSlugInput || !editDurationInput || !editOrderInput || !editActiveSelect || !editShortDescInput || !editPriceFemaleInput || !editPriceMaleInput || !saveEditBtn) return;

        const serviceId = editIdInput.value;
        if (!serviceId) return;

        saveEditBtn.disabled = true;
        saveEditBtn.textContent = 'در حال ذخیره...';
        if (editAlertBox) editAlertBox.style.display = 'none';

        try {
          const promises: Promise<Response>[] = [
            fetch(`/api/v1/admin/services/${serviceId}`, {
              method: 'PUT',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                name: editNameInput.value.trim(),
                slug: editSlugInput.value.trim().toLowerCase(),
                durationMinutes: Number(editDurationInput.value),
                displayOrder: Number(editOrderInput.value),
                active: editActiveSelect.value === 'true',
                shortDescription: editShortDescInput.value.trim() || null,
              }),
            }),
          ];

          const femalePriceVal = Number(editPriceFemaleInput.value);
          promises.push(
            fetch(`/api/v1/admin/pricing/${serviceId}`, {
              method: 'PUT',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                pricingCategory: 'female',
                amount: femalePriceVal >= 0 ? femalePriceVal : 0,
                currency: 'IRT',
              }),
            })
          );

          const malePriceVal = Number(editPriceMaleInput.value);
          promises.push(
            fetch(`/api/v1/admin/pricing/${serviceId}`, {
              method: 'PUT',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                pricingCategory: 'male',
                amount: malePriceVal >= 0 ? malePriceVal : 0,
                currency: 'IRT',
              }),
            })
          );

          const results = await Promise.all(promises);
          const allOk = results.every((r) => r.ok);

          if (allOk) {
            saveEditBtn.textContent = 'ذخیره شد!';
            showToast('تغییرات خدمت و تعرفه با موفقیت ثبت شد');
            setTimeout(() => window.location.reload(), 450);
          } else {
            const errRes = results.find((r) => !r.ok);
            let errMsg = 'خطا در ثبت تغییرات خدمت یا تعرفه.';
            if (errRes) {
              try {
                const errData = (await errRes.json()) as ApiErrorResponse;
                errMsg = extractApiError(errData, 'خطا در ثبت تغییرات خدمت یا تعرفه.');
              } catch {
                // ignore
              }
            }
            if (editAlertText) editAlertText.textContent = errMsg;
            if (editAlertBox) editAlertBox.style.display = 'flex';
            saveEditBtn.disabled = false;
            saveEditBtn.textContent = 'ذخیره تغییرات خدمت و تعرفه';
          }
        } catch {
          if (editAlertText) editAlertText.textContent = 'خطای ارتباط با سرور.';
          if (editAlertBox) editAlertBox.style.display = 'flex';
          saveEditBtn.disabled = false;
          saveEditBtn.textContent = 'ذخیره تغییرات خدمت و تعرفه';
        }
      });
    }

    // Submit New Service Form
    if (newForm && newModal) {
      newForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!newNameInput || !newSlugInput || !newDurationInput || !newOrderInput || !newActiveSelect || !newShortDescInput || !newPriceFemaleInput || !newPriceMaleInput || !saveNewBtn) return;

        saveNewBtn.disabled = true;
        saveNewBtn.textContent = 'در حال ایجاد...';
        if (newAlertBox) newAlertBox.style.display = 'none';

        try {
          const createRes = await fetch('/api/v1/admin/services', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              name: newNameInput.value.trim(),
              slug: newSlugInput.value.trim().toLowerCase(),
              durationMinutes: Number(newDurationInput.value),
              displayOrder: Number(newOrderInput.value),
              active: newActiveSelect.value === 'true',
              featured: false,
              description: newShortDescInput.value.trim() || '',
              shortDescription: newShortDescInput.value.trim() || null,
            }),
          });

          if (!createRes.ok) {
            let errMsg = 'خطا در تعریف خدمت جدید.';
            try {
              const errData = (await createRes.json()) as ApiErrorResponse;
              errMsg = extractApiError(errData, 'خطا در تعریف خدمت جدید.');
            } catch {
              // ignore
            }
            if (newAlertText) newAlertText.textContent = errMsg;
            if (newAlertBox) newAlertBox.style.display = 'flex';
            saveNewBtn.disabled = false;
            saveNewBtn.textContent = 'ایجاد خدمت و ثبت تعرفه';
            return;
          }

          const createdData = (await createRes.json()) as { id?: string; data?: { id?: string } };
          const newId = createdData.data?.id ?? createdData.id;
          if (!newId) {
            if (newAlertText) newAlertText.textContent = 'شناسه خدمت جدید از سرور برنگشت؛ تعرفه ثبت نشد.';
            if (newAlertBox) newAlertBox.style.display = 'flex';
            saveNewBtn.disabled = false;
            saveNewBtn.textContent = 'ایجاد خدمت و ثبت تعرفه';
            return;
          }

          // Pricing promises
          const pricingPromises: Promise<Response>[] = [];

          const femalePrice = Number(newPriceFemaleInput.value);
          if (femalePrice > 0) {
            pricingPromises.push(
              fetch(`/api/v1/admin/pricing/${newId}`, {
                method: 'PUT',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                  pricingCategory: 'female',
                  amount: femalePrice,
                  currency: 'IRT',
                }),
              })
            );
          }

          const malePrice = Number(newPriceMaleInput.value);
          if (malePrice > 0) {
            pricingPromises.push(
              fetch(`/api/v1/admin/pricing/${newId}`, {
                method: 'PUT',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                  pricingCategory: 'male',
                  amount: malePrice,
                  currency: 'IRT',
                }),
              })
            );
          }

          if (pricingPromises.length > 0) {
            await Promise.all(pricingPromises);
          }

          saveNewBtn.textContent = 'ایجاد شد!';
          showToast('خدمت جدید با موفقیت به کاتالوگ اضافه شد');
          setTimeout(() => window.location.reload(), 450);
        } catch {
          if (newAlertText) newAlertText.textContent = 'خطای ارتباط با سرور.';
          if (newAlertBox) newAlertBox.style.display = 'flex';
          saveNewBtn.disabled = false;
          saveNewBtn.textContent = 'ایجاد خدمت و ثبت تعرفه';
        }
      });
    }
  </script>
</AdminLayout>
