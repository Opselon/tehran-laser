---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listAdminCustomers } from '../../server/repositories';
import { formatJalaliDate } from '../../lib/datetime/jalali';
import Icon from '../../components/ui/Icon.astro';

let customersList: any[] = [];
let clinicalRecords: any[] = [];

try {
  const custRes = await listAdminCustomers(env.DB, 100);
  customersList = custRes.items;

  // fetch latest clinical records
  clinicalRecords = (await env.DB.prepare(`
    SELECT r.*, c.name AS customerName, c.phone AS customerPhone
      FROM customer_clinical_records r
      JOIN customers c ON c.id = r.customer_id
     ORDER BY r.created_at DESC LIMIT 50
  `).all()).results as any[] || [];
} catch (e) {
  console.error('Failed to load CRM data:', e);
}

// Real KPIs computed from live data (no hardcoded fakes)
const totalSessionsBooked = clinicalRecords.reduce((s, r) => s + (Number(r.total_sessions) || 0), 0);
const completedSessions = clinicalRecords.length;
const avgProgress = totalSessionsBooked > 0
  ? Math.min(100, Math.round((completedSessions / totalSessionsBooked) * 100))
  : 0;
const totalShots = clinicalRecords.reduce((s, r) => s + (Number(r.shot_count) || 0), 0);
const avgJoules = clinicalRecords.length > 0
  ? clinicalRecords.reduce((s, r) => s + (Number(r.joules_energy) || 0), 0) / clinicalRecords.length
  : 0;

const DEVICE_LABEL = 'الکساندرایت کندلا جنتل پرومکس ۲۰۲۶';
---

<AdminLayout title="پرونده بالینی و CRM" activeNav="crm">
  <div class="admin-content-pad crm-page">
    <div class="dashboard-header-row">
      <div class="header-main-col">
        <h1 class="admin-page-title">
          <Icon name="doctor" size={26} class="title-gold-icon" />
          <span>پرونده بالینی و ارتباط با مراجعین (Clinical CRM)</span>
        </h1>
        <p class="section-block-sub">
          مدیریت پرونده‌های درمانی، رصد دوره‌های لیزر کندلا، شات‌ها، انرژی ژول و حافظه مراجعین (API First)
        </p>
      </div>
      <div class="actions">
        <button id="openNewRecordModalBtn" class="btn-3d-gold">
          <Icon name="plus" size={17} />
          <span>ثبت جلسه بالینی جدید</span>
        </button>
      </div>
    </div>

    <!-- Stats summary row -->
    <div class="kpi-grid-3d crm-kpi-grid">
      <div class="kpi-card-3d">
        <div class="kpi-header">
          <span class="kpi-title">کل مراجعین ثبت‌شده</span>
          <span class="kpi-icon crm-kpi-icon-gold"><Icon name="users" size={20} /></span>
        </div>
        <div class="kpi-value">{customersList.length.toLocaleString('fa-IR')}</div>
        <div class="kpi-footer">بانک فعال مراجعین کلینیک</div>
      </div>

      <div class="kpi-card-3d">
        <div class="kpi-header">
          <span class="kpi-title">جلسات ثبت‌شده در پرونده</span>
          <span class="kpi-icon crm-kpi-icon-blue"><Icon name="doctor" size={20} /></span>
        </div>
        <div class="kpi-value">{completedSessions.toLocaleString('fa-IR')}</div>
        <div class="kpi-footer">سوابق دوز و انرژی دستگاه</div>
      </div>

      <div class="kpi-card-3d">
        <div class="kpi-header">
          <span class="kpi-title">میانگین پیشرفت جلسات</span>
          <span class="kpi-icon crm-kpi-icon-green"><Icon name="chart" size={20} /></span>
        </div>
        <div class="kpi-value crm-kpi-progress-value">
          {avgProgress.toLocaleString('fa-IR')}<span class="crm-kpi-unit">٪</span>
        </div>
        <div class="kpi-footer">{totalSessionsBooked.toLocaleString('fa-IR')} جلسه برنامه‌ریزی‌شده کل</div>
      </div>

      <div class="kpi-card-3d">
        <div class="kpi-header">
          <span class="kpi-title">مجموع شات‌های لیزر</span>
          <span class="kpi-icon crm-kpi-icon-gold"><Icon name="lightning" size={20} /></span>
        </div>
        <div class="kpi-value">{totalShots.toLocaleString('fa-IR')}</div>
        <div class="kpi-footer">
          میانگین انرژی: {avgJoules.toLocaleString('fa-IR', { maximumFractionDigits: 1 })} J/cm²
        </div>
      </div>
    </div>

    <!-- Layout: Customer dossiers and recent clinical records -->
    <div class="g-side crm-layout">
      <!-- Right: Customer list sidebar -->
      <div class="admin-section-block crm-side-card">
        <h3 class="crm-side-title">
          <span class="crm-side-title-text">
            <Icon name="users" size={16} class="title-gold-icon" />
            <span>مراجعین اخیر</span>
          </span>
          <span class="crm-side-count">{customersList.length.toLocaleString('fa-IR')} پرونده</span>
        </h3>

        <div class="crm-search-wrap">
          <Icon name="search" size={16} class="crm-search-icon" aria-hidden="true" />
          <input
            type="text"
            id="custSearchInput"
            class="form-control-modal crm-search-input"
            placeholder="جستجوی نام یا تلفن..."
            aria-label="جستجوی مراجع"
          />
        </div>

        <div id="customerListContainer" class="crm-cust-list">
          {customersList.map((c, idx) => (
            <div
              class={`crm-cust-item ${idx === 0 ? 'active' : ''}`}
              data-id={c.id}
              data-name={c.name}
              data-phone={c.phone}
              data-category={c.pricingCategory}
              data-count={c.bookingsCount || 1}
              role="button"
              tabindex={0}
            >
              <span class="crm-cust-avatar" aria-hidden="true">{c.name?.trim()?.charAt(0) || '؟'}</span>
              <span class="crm-cust-body">
                <span class="crm-cust-top">
                  <span class="crm-cust-name">{c.name}</span>
                  <span class="crm-cust-cat">{c.pricingCategory === 'female' ? 'بانوان' : 'آقایان'}</span>
                </span>
                <span class="crm-cust-meta">
                  <span dir="ltr" class="crm-cust-phone">{c.phone}</span>
                  <span class="crm-cust-count">{(c.bookingsCount || 1).toLocaleString('fa-IR')} نوبت</span>
                </span>
              </span>
            </div>
          ))}
          {customersList.length === 0 && (
            <p class="crm-side-empty">هنوز مراجعی ثبت نشده است.</p>
          )}
        </div>
      </div>

      <!-- Left: Active Customer Clinical Dossier -->
      <div class="admin-section-block crm-dossier-card">
        <div class="crm-dossier-head">
          <div class="crm-dossier-id">
            <h2 id="dossierName" class="crm-dossier-name">
              {customersList[0]?.name || 'انتخاب مراجع'}
            </h2>
            <div class="crm-dossier-meta">
              <span class="crm-dossier-phone">
                <Icon name="phone" size={14} class="meta-icon" />
                <span id="dossierPhone" dir="ltr">{customersList[0]?.phone || ''}</span>
              </span>
              <span class="crm-dossier-cat">
                <Icon name="tag" size={14} class="meta-icon" />
                <span id="dossierCategory">دسته: {customersList[0]?.pricingCategory === 'female' ? 'بانوان' : 'آقایان'}</span>
              </span>
            </div>
          </div>

          <div class="crm-dossier-actions">
            <button id="sendDirectSmsBtn" class="btn-3d-complete crm-dossier-btn">
              <Icon name="sms" size={15} />
              <span>ارسال پیامک مستقیم</span>
            </button>
            <button id="addSessionForCustBtn" class="btn-3d-gold crm-dossier-btn">
              <Icon name="plus" size={15} />
              <span>جلسه جدید کندلا</span>
            </button>
          </div>
        </div>

        <!-- Device + Course Progress -->
        <div class="crm-course-panel">
          <div class="crm-device-line">
            <Icon name="lightning" size={17} class="title-gold-icon" />
            <span class="crm-device-name">دستگاه فعال:</span>
            <span class="crm-device-value">{DEVICE_LABEL}</span>
          </div>

          <div class="crm-progress-head">
            <span class="crm-progress-label">وضعیت پیشرفت پکیج لیزر (تعداد جلسات سپری شده):</span>
            <span id="dossierProgressText" class="crm-progress-value">جلسه ۲ از ۸ (۲۵٪)</span>
          </div>
          <div class="crm-progress-track">
            <div id="dossierProgressBar" class="crm-progress-fill"></div>
          </div>
        </div>

        <!-- Clinical records table -->
        <h4 class="crm-records-title">
          <Icon name="document" size={16} class="title-gold-icon" />
          <span>تاریخچه جلسات، شات‌ها و دوز انرژی کندلا</span>
        </h4>

        <div class="admin-table-container crm-table-wrap">
          <table class="admin-table-3d crm-table">
            <thead>
              <tr>
                <th><Icon name="clock" size={14} class="th-icon" />جلسه</th>
                <th><Icon name="calendar" size={14} class="th-icon" />تاریخ جلسه</th>
                <th><Icon name="pin" size={14} class="th-icon" />ناحیه تحت درمان</th>
                <th><Icon name="lightning" size={14} class="th-icon" />انرژی (J/cm²)</th>
                <th><Icon name="clock" size={14} class="th-icon" />عرض پالس</th>
                <th><Icon name="target" size={14} class="th-icon" />شات‌ها</th>
                <th><Icon name="eye" size={14} class="th-icon" />واکنش پوست</th>
                <th><Icon name="users" size={14} class="th-icon" />اپراتور</th>
              </tr>
            </thead>
            <tbody id="clinicalRecordsTbody">
              {clinicalRecords.map((r) => (
                <tr data-custid={r.customer_id}>
                  <td>
                    <span class="crm-session-badge">جلسه {r.session_number} از {r.total_sessions}</span>
                  </td>
                  <td class="crm-date-cell">{formatJalaliDate(r.created_at)}</td>
                  <td class="crm-area-cell">{r.treated_areas}</td>
                  <td>
                    <span class="crm-joule-chip">{r.joules_energy} J</span>
                  </td>
                  <td>
                    <span class="crm-pulse-chip">{r.pulse_width_ms} ms</span>
                  </td>
                  <td>
                    <span class="crm-shot-chip">{(Number(r.shot_count) || 0).toLocaleString('fa-IR')}</span>
                  </td>
                  <td class="crm-reaction-cell">{r.skin_reaction}</td>
                  <td class="crm-operator-cell">{r.operator_name || 'اپراتور'}</td>
                </tr>
              ))}
              {clinicalRecords.length === 0 && (
                <tr>
                  <td colspan="8" class="crm-empty-row">
                    <span class="empty-icon-3d"><Icon name="doctor" size={34} /></span>
                    <span>هنوز جلسه بالینی ثبت نشده است. از دکمه بالا برای ثبت اولین جلسه استفاده کنید.</span>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Add Clinical Record -->
  <div id="newRecordModal" class="modal-3d-backdrop" style="display: none;">
    <div class="modal-3d-card" style="max-width: 620px;">
      <div class="modal-3d-header">
        <h3 class="modal-3d-title">
          <Icon name="doctor" size={20} class="title-gold-icon" />
          <span>ثبت جلسه درمانی و پارامترهای لیزر</span>
        </h3>
        <button id="closeRecordModalBtn" class="modal-close-btn" aria-label="بستن">
          <Icon name="close" size={18} />
        </button>
      </div>

      <form id="recordForm" class="crm-form">
        <input type="hidden" id="recordCustId" value={customersList[0]?.id || ''} />

        <div class="g-2 crm-form-row">
          <div class="customers-field">
            <label class="form-label-modal" for="recSessionNum">
              <Icon name="clock" size={14} class="field-icon" />
              <span>شماره جلسه:</span>
            </label>
            <input type="number" id="recSessionNum" class="form-control-modal" value="1" min="1" max="15" required />
          </div>
          <div class="customers-field">
            <label class="form-label-modal" for="recTotalSessions">
              <Icon name="calendar" size={14} class="field-icon" />
              <span>کل جلسات پکیج:</span>
            </label>
            <input type="number" id="recTotalSessions" class="form-control-modal" value="8" min="1" max="15" required />
          </div>
        </div>

        <div class="customers-field">
          <label class="form-label-modal" for="recAreas">
            <Icon name="pin" size={14} class="field-icon" />
            <span>نواحی تحت درمان:</span>
          </label>
          <input type="text" id="recAreas" class="form-control-modal" value="فول بادی کاربردی (ساق، ساعد، زیربغل، بیکینی)" required />
        </div>

        <div class="crm-dose-grid">
          <div class="customers-field">
            <label class="form-label-modal" for="recJoules">
              <Icon name="lightning" size={14} class="field-icon" />
              <span>انرژی (J/cm²):</span>
            </label>
            <input type="number" id="recJoules" step="0.5" class="form-control-modal crm-dose-input" value="14.0" required />
          </div>
          <div class="customers-field">
            <label class="form-label-modal" for="recPulse">
              <Icon name="clock" size={14} class="field-icon" />
              <span>عرض پالس (ms):</span>
            </label>
            <input type="number" id="recPulse" step="0.5" class="form-control-modal crm-dose-input" value="3.0" required />
          </div>
          <div class="customers-field">
            <label class="form-label-modal" for="recShots">
              <Icon name="target" size={14} class="field-icon" />
              <span>تعداد شات:</span>
            </label>
            <input type="number" id="recShots" class="form-control-modal crm-dose-input" value="550" required />
          </div>
        </div>

        <div class="customers-field">
          <label class="form-label-modal" for="recReaction">
            <Icon name="eye" size={14} class="field-icon" />
            <span>واکنش پوست مراجع:</span>
          </label>
          <input type="text" id="recReaction" class="form-control-modal" value="اریتم خفیف طبیعی، بدون سوختگی، کمپرس سرد اعمال شد" />
        </div>

        <div class="customers-field">
          <label class="form-label-modal" for="recOperator">
            <Icon name="users" size={14} class="field-icon" />
            <span>اپراتور / پزشک ناظر:</span>
          </label>
          <input type="text" id="recOperator" class="form-control-modal" value="خانم دکتر افشار / اپراتور ارشد" />
        </div>

        <div class="crm-form-actions">
          <button type="button" id="cancelRecordBtn" class="btn-3d-secondary">
            <Icon name="close" size={16} />
            <span>انصراف</span>
          </button>
          <button type="submit" id="saveRecordSubmitBtn" class="btn-3d-gold">
            <Icon name="check" size={17} />
            <span>ثبت دائم در پرونده بالینی</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let activeCustId = (document.getElementById('recordCustId') as HTMLInputElement)?.value || '';

    // Customer search filter
    const custSearchInput = document.getElementById('custSearchInput') as HTMLInputElement;
    const custItems = document.querySelectorAll('.crm-cust-item');

    custSearchInput?.addEventListener('input', () => {
      const q = custSearchInput.value.toLowerCase().trim();
      custItems.forEach((el) => {
        const item = el as HTMLElement;
        const name = (item.dataset.name || '').toLowerCase();
        const phone = (item.dataset.phone || '').toLowerCase();
        if (name.includes(q) || phone.includes(q)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });

    // Select customer item
    custItems.forEach((el) => {
      el.addEventListener('click', () => {
        custItems.forEach(i => i.classList.remove('active'));
        el.classList.add('active');
        const item = el as HTMLElement;
        activeCustId = item.dataset.id || '';

        const nameEl = document.getElementById('dossierName');
        const phoneEl = document.getElementById('dossierPhone');
        const catEl = document.getElementById('dossierCategory');
        const recCustId = document.getElementById('recordCustId') as HTMLInputElement;

        if (nameEl) nameEl.innerText = item.dataset.name || '';
        if (phoneEl) phoneEl.innerText = item.dataset.phone || '';
        if (catEl) catEl.innerText = `دسته: ${item.dataset.category === 'female' ? 'بانوان' : 'آقایان'}`;
        if (recCustId) recCustId.value = activeCustId;

        // Filter clinical records table
        const rows = document.querySelectorAll('#clinicalRecordsTbody tr');
        rows.forEach(r => {
          const row = r as HTMLElement;
          if (!row.dataset.custid || row.dataset.custid === activeCustId) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    });

    // Modal controls
    const newRecordModal = document.getElementById('newRecordModal');
    const openBtn = document.getElementById('openNewRecordModalBtn');
    const addSessionForCustBtn = document.getElementById('addSessionForCustBtn');
    const closeBtn = document.getElementById('closeRecordModalBtn');
    const cancelBtn = document.getElementById('cancelRecordBtn');
    const recordForm = document.getElementById('recordForm');
    const saveBtn = document.getElementById('saveRecordSubmitBtn') as HTMLButtonElement;

    function openModal() {
      if (newRecordModal) newRecordModal.style.display = 'flex';
    }
    function closeModal() {
      if (newRecordModal) newRecordModal.style.display = 'none';
    }

    openBtn?.addEventListener('click', openModal);
    addSessionForCustBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    recordForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      saveBtn.innerText = 'در حال ثبت...';

      const payload = {
        customerId: activeCustId,
        sessionNumber: Number((document.getElementById('recSessionNum') as HTMLInputElement).value),
        totalSessions: Number((document.getElementById('recTotalSessions') as HTMLInputElement).value),
        treatedAreas: (document.getElementById('recAreas') as HTMLInputElement).value.trim(),
        joulesEnergy: Number((document.getElementById('recJoules') as HTMLInputElement).value),
        pulseWidthMs: Number((document.getElementById('recPulse') as HTMLInputElement).value),
        shotCount: Number((document.getElementById('recShots') as HTMLInputElement).value),
        skinReaction: (document.getElementById('recReaction') as HTMLInputElement).value.trim(),
        operatorName: (document.getElementById('recOperator') as HTMLInputElement).value.trim(),
      };

      try {
        const res = await fetch('/api/v1/admin/crm/records', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          alert('✓ جلسه بالینی با موفقیت در پرونده الکترونیک مراجع ثبت شد.');
          window.location.reload();
        } else {
          alert('خطا در ثبت جلسه بالینی.');
          saveBtn.disabled = false;
          saveBtn.innerText = 'ثبت دائم در پرونده بالینی';
        }
      } catch {
        alert('خطای اتصال به سرور.');
        saveBtn.disabled = false;
        saveBtn.innerText = 'ثبت دائم در پرونده بالینی';
      }
    });

    // Direct SMS button
    document.getElementById('sendDirectSmsBtn')?.addEventListener('click', () => {
      const phone = document.getElementById('dossierPhone')?.innerText;
      if (phone) {
        window.location.href = `/admin/sms?phone=${encodeURIComponent(phone)}`;
      }
    });
  </script>
</AdminLayout>