---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listAdminCustomers } from '../../../server/repositories';
import { formatJalaliDate } from '../../../lib/datetime/jalali';

const url = Astro.url;
const search = url.searchParams.get('q') || undefined;

let customers: Awaited<ReturnType<typeof listAdminCustomers>> = { items: [], nextCursor: null };
try {
  customers = await listAdminCustomers(env.DB, 50, undefined, search);
} catch (e) {
  console.error('Failed to load customers:', e);
}
---

<AdminLayout title="بانک مراجعین" activeNav="customers">
  <div class="admin-content-pad">
    <div class="page-title-row mb-4">
      <div>
        <h1 class="text-xl font-bold">بانک اطلاعات مراجعین کلینیک</h1>
        <p class="text-muted small">لیست مراجعین ثبت‌شده و سوابق پرونده‌ها</p>
      </div>
    </div>

    <!-- Search Form (§28) -->
    <div class="card p-3 mb-4">
      <form method="GET" class="filter-form-grid">
        <div class="form-group flex-grow-1">
          <input
            type="text"
            name="q"
            class="form-control form-control-sm"
            placeholder="جستجو با نام مراجع یا شماره تلفن (مثال: ۰۹۱۲)..."
            value={search || ''}
          />
        </div>
        <div class="form-group">
          <button type="submit" class="btn btn-primary btn-sm">جستجو</button>
          <a href="/admin/customers" class="btn btn-outline btn-sm mr-2">پاک کردن</a>
        </div>
      </form>
    </div>

    <!-- Customers Table -->
    <div class="card p-0">
      {customers.items.length === 0 ? (
        <div class="p-5 text-center text-muted">
          <p class="mb-0">مراجع مطابق با جستجوی شما یافت نشد.</p>
        </div>
      ) : (
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>نام و نام خانوادگی</th>
                <th>شماره همراه</th>
                <th>بخش</th>
                <th>تعداد نوبت‌ها</th>
                <th>آخرین مراجعه</th>
                <th>تاریخ عضویت</th>
              </tr>
            </thead>
            <tbody>
              {customers.items.map((c) => (
                <tr>
                  <td class="font-bold">{c.name}</td>
                  <td dir="ltr">
                    <a href={`tel:${c.phone}`} class="phone-link">{c.phone}</a>
                  </td>
                  <td>{c.pricingCategory === 'female' ? 'بانوان' : 'آقایان'}</td>
                  <td>{c.bookingsCount.toLocaleString('fa-IR')} نوبت</td>
                  <td>{c.lastBookingAt ? formatJalaliDate(c.lastBookingAt.slice(0, 10)) : '—'}</td>
                  <td>{formatJalaliDate(c.createdAt.slice(0, 10))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
