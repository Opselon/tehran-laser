---
/**
 * /admin/operators/[id] — one operator's profile.
 *
 * The SSR payload is exactly what the profile island would fetch
 * (operator + 30-day stats + today's agenda + the unassigned pool), so the first
 * paint is complete and a refresh costs one request.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/ui/Icon.astro';
import { OperatorProfileApp } from '../../../components/admin/operators/OperatorProfileApp';
import { env } from 'cloudflare:workers';
import { getPublicSettings } from '../../../server/repositories';
import {
  getOperatorAgenda,
  getOperatorById,
  getOperatorStats,
  listUnassignedSessions,
} from '../../../server/operators';
import { loadOperatorCatalog, loadServiceOptions } from '../../../server/operator-view';
import { hasPermission } from '../../../domain/rbac/rbac.types';
import { todayWeekday } from '../../../domain/operators/operators';
import { workdayLabel } from '../../../domain/operators/catalog';
import { localDateOf } from '../../../lib/datetime/timezone';

const auth = Astro.locals.auth;
const allowed = Boolean(auth && hasPermission(auth, 'operator.read'));
const capabilities = {
  canWrite: Boolean(auth && hasPermission(auth, 'operator.write')),
  canManageAccounts: Boolean(auth && hasPermission(auth, 'operator.account')),
  currentUserId: auth?.id ?? null,
};

const id = Astro.params.id ?? '';

let timezone = 'Asia/Tehran';
try {
  timezone = (await getPublicSettings(env.DB)).timezone || timezone;
} catch {
  /* API default */
}

const now = new Date();
const localDate = localDateOf(now.toISOString(), timezone);
const weekday = todayWeekday(timezone, now);

let operator: Awaited<ReturnType<typeof getOperatorById>> = null;
let page: {
  initial: Parameters<typeof OperatorProfileApp>[0]['initial'];
  catalog: Parameters<typeof OperatorProfileApp>[0]['catalog'];
  services: Array<{ id: string; name: string }>;
  capabilities: typeof capabilities;
} | null = null;
let error: string | null = null;

if (allowed && id) {
  try {
    operator = await getOperatorById(env.DB, id);
    if (operator) {
      const [stats, agenda, unassigned, catalog, services] = await Promise.all([
        getOperatorStats(env.DB, id, { days: 30, timezone, now }),
        getOperatorAgenda(env.DB, id, localDate, timezone),
        listUnassignedSessions(env.DB, localDate, timezone),
        loadOperatorCatalog(env.DB),
        loadServiceOptions(env.DB),
      ]);

      page = {
        initial: {
          operator,
          stats,
          agenda,
          unassigned,
          today: { weekday, label: workdayLabel(weekday), localDate },
        },
        catalog,
        services,
        capabilities,
      };
    }
  } catch (err) {
    console.error('[operators] failed to load operator profile:', err);
    error = 'بارگذاری پروفایل اپراتور ناموفق بود.';
  }
}
---

<AdminLayout
  title={operator ? `${operator.displayName} | تیم` : 'پروفایل اپراتور'}
  activeNav="operators"
>
  <div class="admin-content-pad">
    {!allowed ? (
      <section class="ops-shell" style="margin-top: 12px">
        <div class="ops-empty">
          <div class="ops-empty__icon">
            <Icon name="lock" size={24} />
          </div>
          <h3>دسترسی به پروفایل اپراتور ندارید</h3>
          <p>این صفحه به مجوز «مشاهده تیم اپراتور» نیاز دارد و بررسی آن در سرور انجام می‌شود.</p>
          <div class="ops-hero__actions" style="justify-content: center">
            <a class="ops-btn" href="/admin">
              بازگشت به داشبورد
            </a>
          </div>
        </div>
      </section>
    ) : error ? (
      <section class="ops-shell" style="margin-top: 12px">
        <div class="ops-empty">
          <div class="ops-empty__icon">
            <Icon name="warning" size={24} />
          </div>
          <h3>خطا در بارگذاری</h3>
          <p>{error}</p>
          <div class="ops-hero__actions" style="justify-content: center">
            <a class="ops-btn" href="/admin/operators">
              بازگشت به فهرست تیم
            </a>
          </div>
        </div>
      </section>
    ) : !page ? (
      <section class="ops-shell" style="margin-top: 12px">
        <div class="ops-empty">
          <div class="ops-empty__icon">
            <Icon name="search" size={24} />
          </div>
          <h3>اپراتور پیدا نشد</h3>
          <p>
            این پروفایل حذف شده یا شناسه آن معتبر نیست. فهرست تیم را ببینید و از آنجا اپراتور را
            انتخاب کنید.
          </p>
          <div class="ops-hero__actions" style="justify-content: center">
            <a class="ops-btn ops-btn--primary" href="/admin/operators">
              فهرست تیم
            </a>
          </div>
        </div>
      </section>
    ) : (
      <OperatorProfileApp
        client:load
        initial={page.initial}
        catalog={page.catalog}
        services={page.services}
        capabilities={page.capabilities}
      />
    )}
  </div>
</AdminLayout>
