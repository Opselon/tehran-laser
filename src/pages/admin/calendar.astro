---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listAdminBookings } from '../../server/repositories';
import { formatJalaliDate } from '../../lib/datetime/jalali';

const url = Astro.url;
const targetDate = url.searchParams.get('date') || new Date().toISOString().slice(0, 10);
const fromIso = `${targetDate}T00:00:00.000Z`;
const toIso = `${targetDate}T23:59:59.999Z`;

let bookings: Awaited<ReturnType<typeof listAdminBookings>> = { items: [], nextCursor: null };
try {
  bookings = await listAdminBookings(env.DB, {
    fromStartsAt: fromIso,
    toStartsAt: toIso,
    limit: 100,
  });
} catch (e) {
  console.error('Failed to load calendar bookings:', e);
}
---

<AdminLayout title="تقویم روزانه کلینیک" activeNav="calendar">
  <div class="admin-content-pad">
    <!-- 3D Header Row -->
    <div class="dashboard-header-row">
      <div>
        <h1 class="admin-page-title">تقویم زمان‌بندی روزانه کلینیک</h1>
        <p class="section-block-sub">
          نمایش نوبت‌ها به تفکیک روز انتخابی — <strong style="color: #f5d77f;">{formatJalaliDate(targetDate)}</strong>
        </p>
      </div>

      <div class="date-selector-form">
        <form method="GET" style="display: flex; align-items: center; gap: 10px;">
          <label style="font-size: 0.85rem; font-weight: 700; color: #cbd5e1;">انتخاب تاریخ:</label>
          <input
            type="date"
            name="date"
            class="form-control-modal"
            style="margin-top: 0; padding: 8px 14px;"
            value={targetDate}
            onchange="this.form.submit()"
          />
        </form>
      </div>
    </div>

    <!-- Day Schedule Visual Timeline -->
    <div class="admin-section-block">
      <div class="section-block-header">
        <h2 class="section-block-title">
          <span>📅 جدول زمان‌بندی نوبت‌های {formatJalaliDate(targetDate)}</span>
          <span style="font-size: 0.85rem; color: #f5d77f; background: rgba(212, 175, 55, 0.15); border: 1px solid rgba(212, 175, 55, 0.35); padding: 2px 10px; border-radius: 999px;">
            {bookings.items.length.toLocaleString('fa-IR')} نوبت ثبت‌شده
          </span>
        </h2>
      </div>

      {bookings.items.length === 0 ? (
        <div class="empty-state-card">
          <span class="empty-icon">🗓️</span>
          <p class="empty-text">هیچ نوبتی برای این روز ثبت نشده است.</p>
        </div>
      ) : (
        <div class="pending-bookings-list">
          {bookings.items.map((b) => {
            const timeStr = new Date(b.startsAt).toLocaleTimeString('fa-IR', {
              hour: '2-digit',
              minute: '2-digit',
              timeZone: 'Asia/Tehran',
            });

            return (
              <div class="pending-booking-card" style="border-color: rgba(212, 175, 55, 0.35);">
                <div>
                  <div class="card-top-row">
                    <div class="customer-info">
                      <span class="customer-name">{b.customer.name}</span>
                      <a href={`tel:${b.customer.phone}`} class="customer-phone" dir="ltr">
                        📞 {b.customer.phone}
                      </a>
                    </div>
                    <div class="booking-ref-badge" dir="ltr">{b.reference}</div>
                  </div>

                  <div class="card-meta-grid">
                    <div class="meta-item">
                      <strong>زمان:</strong> ساعت {timeStr}
                    </div>
                    <div class="meta-item">
                      <strong>خدمت:</strong> {b.service.name}
                    </div>
                    <div class="meta-item">
                      <strong>بخش:</strong> {b.pricingCategory === 'female' ? 'بانوان' : 'آقایان'}
                    </div>
                    <div class="meta-item">
                      <strong>مبلغ:</strong> {(b.quotedAmount * 1000).toLocaleString('fa-IR')} ت
                    </div>
                  </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
                  <span class={`badge-status badge-status-${b.status}`}>
                    {b.status === 'confirmed' && 'تأییدشده'}
                    {b.status === 'pending' && 'در انتظار'}
                    {b.status === 'completed' && 'انجام‌شده'}
                    {b.status === 'cancelled' && 'لغوشده'}
                    {b.status === 'rejected' && 'ردشده'}
                    {b.status === 'no_show' && 'عدم حضور'}
                  </span>
                  <span style="font-size: 0.8rem; color: #94a3b8;">کد: {b.id.slice(0, 10)}</span>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</AdminLayout>