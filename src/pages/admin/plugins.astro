---
/**
 * /admin/plugins — the module/plugin hub.
 *
 * Every section of the public site is a module with a registry definition
 * (src/domain/features/registry.ts). A module that is not enabled renders
 * NOTHING on the public site — no markup, no placeholder, no API entry — which
 * is what "تا فعالش نکنی نمایش داده نشه" means in practice.
 *
 * The page is server-rendered (no client framework): the only JS is the small
 * inline controller that talks to /api/v1/admin/features.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { env } from 'cloudflare:workers';
import { listAdminModules } from '../../server/features';
import { CATEGORY_LABELS, type AdminModuleView } from '../../domain/features/registry';

let modules: AdminModuleView[] = [];
let loadError: string | null = null;
try {
  modules = await listAdminModules(env.DB);
} catch (e) {
  console.error('Failed to load feature modules:', e);
  loadError = 'خواندن وضعیت افزونه‌ها از دیتابیس ممکن نشد.';
}

const enabledCount = modules.filter((m) => m.enabled).length;
const premiumCount = modules.filter((m) => m.premium).length;
const overrideCount = modules.filter((m) => m.hasOverride).length;
const publicCount = modules.filter((m) => !m.internal).length;

/** Field values arrive as strings from inputs; booleans keep their own shape. */
const fieldValue = (m: AdminModuleView, key: string): string => {
  const v = m.config[key];
  return v === undefined || v === null ? '' : String(v);
};

const categories = Object.entries(CATEGORY_LABELS) as Array<[string, string]>;
---

<AdminLayout title="افزونه‌ها و بخش‌های سایت" activeNav="plugins">
  <div class="admin-content-pad plugin-hub" id="pluginHubRoot">
    <header class="dashboard-header-row plugin-hub__header">
      <div class="plugin-hub__heading">
        <span class="plugin-hub__emblem"><Icon name="puzzle" size={26} /></span>
        <div>
          <h1 class="admin-page-title">هاب افزونه‌ها و بخش‌های سایت</h1>
          <p class="section-block-sub">
            هر بخش مثل یک پلاگین حرفه‌ای وردپرس: تا فعالش نکنید در سایت چیزی نمایش داده نمی‌شود،
            تنظیماتش از همین‌جا قابل تعریف، ویرایش و بازنشانی است — همه از طریق API نسخه‌دار.
          </p>
        </div>
      </div>

      <div class="plugin-hub__stats" role="list">
        <div class="plugin-stat" role="listitem">
          <span class="plugin-stat__value" data-stat="enabled">{enabledCount}</span>
          <span class="plugin-stat__label">فعال</span>
        </div>
        <div class="plugin-stat" role="listitem">
          <span class="plugin-stat__value" data-stat="disabled">{modules.length - enabledCount}</span>
          <span class="plugin-stat__label">غیرفعال</span>
        </div>
        <div class="plugin-stat plugin-stat--gold" role="listitem">
          <span class="plugin-stat__value">{premiumCount}</span>
          <span class="plugin-stat__label">افزونه پرمیوم</span>
        </div>
        <div class="plugin-stat" role="listitem">
          <span class="plugin-stat__value">{publicCount}</span>
          <span class="plugin-stat__label">اثرگذار بر سایت</span>
        </div>
      </div>
    </header>

    {loadError && (
      <div class="plugin-alert" role="alert">
        <Icon name="warning" size={18} />
        <span>{loadError}</span>
      </div>
    )}

    <div class="plugin-toolbar">
      <div class="plugin-filters" role="tablist" aria-label="فیلتر دسته‌بندی افزونه‌ها">
        <button type="button" class="plugin-filter is-active" data-filter="all" role="tab" aria-selected="true">
          همه <span class="plugin-filter__count">{modules.length}</span>
        </button>
        {categories.map(([key, label]) => {
          const count = modules.filter((m) => m.category === key).length;
          return (
            <button type="button" class="plugin-filter" data-filter={key} role="tab" aria-selected="false">
              {label} <span class="plugin-filter__count">{count}</span>
            </button>
          );
        })}
      </div>
      <p class="plugin-toolbar__hint">
        <Icon name="info" size={14} />
        <span>{overrideCount} افزونه تنظیمات اختصاصی ذخیره‌شده دارد.</span>
      </p>
    </div>

    <div class="plugin-grid" id="pluginGrid">
      {modules.map((m, index) => (
        <article
          class:list={['plugin-card', m.enabled ? 'is-enabled' : 'is-disabled', m.premium && 'is-premium']}
          data-module={m.key}
          data-category={m.category}
          data-order={m.order}
          data-enabled={m.enabled ? '1' : '0'}
          data-has-override={m.hasOverride ? '1' : '0'}
          data-index={index}
        >
          <div class="plugin-card__top">
            <span class="plugin-card__icon"><Icon name={m.icon} size={20} /></span>
            <div class="plugin-card__title-wrap">
              <h2 class="plugin-card__title">{m.name}</h2>
              <div class="plugin-card__chips">
                <span class="plugin-chip">{CATEGORY_LABELS[m.category]}</span>
                {m.premium && <span class="plugin-chip plugin-chip--gold">پرمیوم</span>}
                {m.internal && <span class="plugin-chip plugin-chip--muted">فقط پنل</span>}
                {m.fields.length > 0 && (
                  <span class="plugin-chip plugin-chip--muted">{m.fields.length} تنظیم</span>
                )}
              </div>
            </div>

            <label class="plugin-switch" for={`switch-${m.key}`}>
              <input
                type="checkbox"
                id={`switch-${m.key}`}
                class="plugin-switch__input"
                data-toggle={m.key}
                checked={m.enabled}
              />
              <span class="plugin-switch__track" aria-hidden="true"><span class="plugin-switch__thumb" /></span>
              <span class="plugin-switch__text" data-switch-label>{m.enabled ? 'فعال' : 'خاموش'}</span>
            </label>
          </div>

          <p class="plugin-card__desc">{m.description}</p>

          <p class="plugin-card__offnote" data-offnote hidden={m.enabled}>
            <Icon name="eye" size={14} />
            <span>{m.offNote}</span>
          </p>

          <div class="plugin-card__footer">
            <div class="plugin-card__actions">
              {m.fields.length > 0 ? (
                <button type="button" class="plugin-btn plugin-btn--ghost" data-open-config={m.key} aria-expanded="false">
                  <Icon name="settings" size={15} />
                  <span>تنظیمات</span>
                </button>
              ) : (
                <span class="plugin-card__toggleonly">
                  <Icon name="lock" size={14} />
                  <span>فقط روشن/خاموش</span>
                </span>
              )}

              <button type="button" class="plugin-btn plugin-btn--icon" data-move="up" data-key={m.key} aria-label={`انتقال ${m.name} به بالا`}>
                <Icon name="chevronUp" size={16} />
              </button>
              <button type="button" class="plugin-btn plugin-btn--icon" data-move="down" data-key={m.key} aria-label={`انتقال ${m.name} به پایین`}>
                <Icon name="chevronDown" size={16} />
              </button>

              {m.hasOverride && (
                <button type="button" class="plugin-btn plugin-btn--danger" data-reset={m.key}>
                  <Icon name="refresh" size={15} />
                  <span>بازنشانی</span>
                </button>
              )}
            </div>

            <span class="plugin-card__status" data-status>
              <span class="plugin-status-dot" aria-hidden="true" />
              <span data-status-text>{m.enabled ? 'در حال نمایش در سایت' : 'پنهان از سایت'}</span>
            </span>
          </div>

          {m.fields.length > 0 && (
            <section class="plugin-config" data-config-panel={m.key} hidden aria-label={`تنظیمات ${m.name}`}>
              <div class="plugin-config__grid">
                {m.fields.map((field) => (
                  <div class:list={['plugin-field', field.type === 'textarea' && 'plugin-field--wide']}>
                    <label class="plugin-field__label" for={`cfg-${m.key}-${field.key}`}>
                      {field.label}
                    </label>
                    {field.type === 'boolean' ? (
                      <label class="plugin-field__bool" for={`cfg-${m.key}-${field.key}`}>
                        <input
                          type="checkbox"
                          id={`cfg-${m.key}-${field.key}`}
                          data-config-key={field.key}
                          data-config-type="boolean"
                          checked={fieldValue(m, field.key) === 'true'}
                        />
                        <span>{field.help ?? 'فعال'}</span>
                      </label>
                    ) : field.type === 'textarea' ? (
                      <textarea
                        id={`cfg-${m.key}-${field.key}`}
                        class="plugin-field__input"
                        rows={3}
                        maxlength={field.maxLength ?? 1200}
                        placeholder={field.placeholder ?? ''}
                        data-config-key={field.key}
                        data-config-type={field.type}>{fieldValue(m, field.key)}</textarea>
                    ) : (
                      <input
                        id={`cfg-${m.key}-${field.key}`}
                        class="plugin-field__input"
                        type={field.type === 'number' ? 'number' : 'text'}
                        inputmode={field.type === 'number' ? 'numeric' : undefined}
                        min={field.min}
                        max={field.max}
                        maxlength={field.type === 'number' ? undefined : field.maxLength ?? 300}
                        value={fieldValue(m, field.key)}
                        placeholder={field.placeholder ?? ''}
                        dir={field.type === 'url' ? 'ltr' : undefined}
                        data-config-key={field.key}
                        data-config-type={field.type}
                      />
                    )}
                    {field.help && field.type !== 'boolean' && (
                      <span class="plugin-field__help">{field.help}</span>
                    )}
                  </div>
                ))}
              </div>

              <div class="plugin-config__actions">
                <button type="button" class="plugin-btn plugin-btn--gold" data-save-config={m.key}>
                  <Icon name="check" size={16} />
                  <span>ذخیره تنظیمات</span>
                </button>
                <span class="plugin-config__meta" data-config-meta>
                  از طریق <code>PUT /api/v1/admin/features/{m.key}</code>
                </span>
              </div>
            </section>
          )}
        </article>
      ))}
    </div>

    <div class="plugin-toast" id="pluginToast" role="status" aria-live="polite" hidden></div>

    <section class="plugin-help">
      <h2 class="plugin-help__title"><Icon name="info" size={16} /><span>این هاب چطور کار می‌کند؟</span></h2>
      <ul class="plugin-help__list">
        <li><strong>پنهان تا فعال‌سازی:</strong> هر بخش تا وقتی سوئیچ آن روشن نشود، نه در HTML صفحه ساخته می‌شود و نه در <code>GET /api/v1/features</code> دیده می‌شود.</li>
        <li><strong>تنظیمات زنده:</strong> مقادیر فرم‌ها همان فیلدهای ثبت‌شده در رجیستری افزونه هستند؛ سرور پیش از ذخیره، آن‌ها را اعتبارسنجی می‌کند.</li>
        <li><strong>بازنشانی:</strong> حذف تنظیمات اختصاصی، افزونه را به حالت پیش‌فرض کارخانه برمی‌گرداند (بدون حذف خود افزونه).</li>
        <li><strong>API First:</strong> همه عملیات همین صفحه از مسیرهای <code>/api/v1/admin/features</code> انجام می‌شود و مستقل از UI قابل اتوماسیون است.</li>
      </ul>
    </section>
  </div>
</AdminLayout>

<script>
  type FeatureUpdatePayload = {
    enabled?: boolean;
    displayOrder?: number;
    config?: Record<string, string | number | boolean>;
  };

  const root = document.getElementById('pluginHubRoot');

  function csrfSafeFetch(input: string, init?: RequestInit): Promise<Response> {
    return fetch(input, {
      ...init,
      headers: { 'content-type': 'application/json', ...(init?.headers ?? {}) },
      credentials: 'same-origin',
    });
  }

  function toast(message: string, kind: 'ok' | 'err' = 'ok') {
    const el = document.getElementById('pluginToast');
    if (!el) return;
    el.textContent = message;
    el.classList.toggle('is-error', kind === 'err');
    el.hidden = false;
    window.clearTimeout((toast as unknown as { t?: number }).t);
    (toast as unknown as { t?: number }).t = window.setTimeout(() => {
      el.hidden = true;
    }, 3200);
  }

  function cardOf(key: string): HTMLElement | null {
    return root?.querySelector<HTMLElement>(`.plugin-card[data-module="${key}"]`) ?? null;
  }

  function updateEnabledUi(card: HTMLElement, enabled: boolean) {
    card.dataset.enabled = enabled ? '1' : '0';
    card.classList.toggle('is-enabled', enabled);
    card.classList.toggle('is-disabled', !enabled);

    const text = card.querySelector('[data-switch-label]');
    if (text) text.textContent = enabled ? 'فعال' : 'خاموش';

    const status = card.querySelector('[data-status-text]');
    if (status) status.textContent = enabled ? 'در حال نمایش در سایت' : 'پنهان از سایت';

    const offnote = card.querySelector<HTMLElement>('[data-offnote]');
    if (offnote) offnote.hidden = enabled;

    const hub = document.getElementById('pluginHubRoot');
    const enabledStat = hub?.querySelector<HTMLElement>('[data-stat="enabled"]');
    const disabledStat = hub?.querySelector<HTMLElement>('[data-stat="disabled"]');
    const cards = hub?.querySelectorAll('.plugin-card') ?? [];
    const enabledTotal = Array.from(cards).filter((c) => (c as HTMLElement).dataset.enabled === '1').length;
    if (enabledStat) enabledStat.textContent = String(enabledTotal);
    if (disabledStat) disabledStat.textContent = String(cards.length - enabledTotal);
  }

  async function toggleModule(key: string, enabled: boolean, input: HTMLInputElement) {
    const card = cardOf(key);
    input.disabled = true;
    try {
      const res = await csrfSafeFetch(`/api/v1/admin/features/${encodeURIComponent(key)}`, {
        method: 'PUT',
        body: JSON.stringify({ enabled } satisfies FeatureUpdatePayload),
      });
      if (!res.ok) {
        input.checked = !enabled;
        toast('تغییر وضعیت ذخیره نشد. دوباره تلاش کنید.', 'err');
        return;
      }
      if (card) updateEnabledUi(card, enabled);
      toast(enabled ? 'افزونه فعال شد و از این پس در سایت نمایش داده می‌شود.' : 'افزونه خاموش شد و از سایت حذف شد.');
    } catch {
      input.checked = !enabled;
      toast('خطای شبکه در ارتباط با سرور.', 'err');
    } finally {
      input.disabled = false;
    }
  }

  async function saveConfig(key: string, button: HTMLButtonElement) {
    const card = cardOf(key);
    const panel = root?.querySelector<HTMLElement>(`[data-config-panel="${key}"]`);
    if (!card || !panel) return;

    const config: Record<string, string | number | boolean> = {};
    panel.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-config-key]').forEach((input) => {
      const fieldKey = input.dataset.configKey;
      if (!fieldKey) return;
      if (input.dataset.configType === 'boolean') {
        config[fieldKey] = (input as HTMLInputElement).checked;
      } else {
        config[fieldKey] = input.value;
      }
    });

    button.disabled = true;
    try {
      const res = await csrfSafeFetch(`/api/v1/admin/features/${encodeURIComponent(key)}`, {
        method: 'PUT',
        body: JSON.stringify({ config }),
      });
      const json = (await res.json()) as { error?: { message?: string; fields?: Record<string, string[]> } };
      if (!res.ok) {
        const fieldHint = json.error?.fields
          ? Object.values(json.error.fields).flat().join(' · ')
          : json.error?.message;
        toast(fieldHint || 'ذخیره تنظیمات ناموفق بود.', 'err');
        return;
      }
      const reset = card.querySelector<HTMLButtonElement>('[data-reset]');
      if (reset) reset.hidden = false;
      card.dataset.hasOverride = '1';
      toast('تنظیمات افزونه ذخیره شد.');
    } catch {
      toast('خطای شبکه در ارتباط با سرور.', 'err');
    } finally {
      button.disabled = false;
    }
  }

  async function resetModule(key: string) {
    if (!window.confirm('تنظیمات اختصاصی این افزونه حذف و به پیش‌فرض کارخانه بازگردد؟')) return;
    try {
      const res = await csrfSafeFetch(`/api/v1/admin/features/${encodeURIComponent(key)}`, { method: 'DELETE' });
      if (!res.ok) {
        toast('بازنشانی انجام نشد.', 'err');
        return;
      }
      window.location.reload();
    } catch {
      toast('خطای شبکه در ارتباط با سرور.', 'err');
    }
  }

  /** Swap this module's display order with its neighbour, persist both. */
  async function move(key: string, direction: 'up' | 'down') {
    if (!root) return;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.plugin-card')).sort(
      (a, b) => Number(a.dataset.order) - Number(b.dataset.order) || a.dataset.module!.localeCompare(b.dataset.module!),
    );
    const index = cards.findIndex((c) => c.dataset.module === key);
    const neighbour = cards[direction === 'up' ? index - 1 : index + 1];
    if (index < 0 || !neighbour) return;

    const current = Number(cards[index]!.dataset.order);
    const other = Number(neighbour.dataset.order);
    const order = [
      { key, displayOrder: other },
      { key: neighbour.dataset.module!, displayOrder: current },
    ];

    try {
      const res = await csrfSafeFetch('/api/v1/admin/features/order', {
        method: 'POST',
        body: JSON.stringify({ order }),
      });
      if (!res.ok) {
        toast('تغییر ترتیب ذخیره نشد.', 'err');
        return;
      }
      window.location.reload();
    } catch {
      toast('خطای شبکه در ارتباط با سرور.', 'err');
    }
  }

  root?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    if (input.matches('[data-toggle]')) {
      void toggleModule(input.dataset.toggle!, input.checked, input);
    }
  });

  root?.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>('button');
    if (!target) return;

    const openConfig = target.dataset.openConfig;
    if (openConfig) {
      const panel = root.querySelector<HTMLElement>(`[data-config-panel="${openConfig}"]`);
      if (!panel) return;
      const willOpen = panel.hidden;
      panel.hidden = !willOpen;
      target.setAttribute('aria-expanded', String(willOpen));
      panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      return;
    }

    if (target.dataset.saveConfig) {
      void saveConfig(target.dataset.saveConfig, target as HTMLButtonElement);
      return;
    }

    if (target.dataset.reset) {
      void resetModule(target.dataset.reset);
      return;
    }

    const moveTarget = target.closest<HTMLElement>('[data-move]');
    if (moveTarget) {
      const key = moveTarget.closest<HTMLElement>('.plugin-card')?.dataset.module;
      if (key) void move(key, moveTarget.dataset.move as 'up' | 'down');
      return;
    }

    const filter = target.dataset.filter;
    if (filter) {
      root.querySelectorAll<HTMLElement>('[data-filter]').forEach((btn) => {
        const active = btn === target;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', String(active));
      });
      root.querySelectorAll<HTMLElement>('.plugin-card').forEach((card) => {
        card.hidden = filter !== 'all' && card.dataset.category !== filter;
      });
    }
  });
</script>
