---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AdminDashboard } from '../../components/admin/AdminDashboard';
import { env } from 'cloudflare:workers';
import { getAdminDashboard } from '../../server/repositories';

const todayStr = new Date().toISOString().slice(0, 10);
const todayStartIso = `${todayStr}T00:00:00.000Z`;
const todayEndIso = `${todayStr}T23:59:59.999Z`;

let initialDashboard: Awaited<ReturnType<typeof getAdminDashboard>> | undefined = undefined;
try {
  initialDashboard = await getAdminDashboard(env.DB, todayStartIso, todayEndIso);
} catch (e) {
  console.error('Failed to load initial admin dashboard data:', e);
}
---

<AdminLayout title="داشبورد و وضعیت امروز" activeNav="dashboard">
  <div class="admin-content-pad">
    <AdminDashboard client:load initialData={initialDashboard} />
  </div>
</AdminLayout>

<style is:global>
  @keyframes adminSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes adminLiveBadgePulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.18); opacity: 0.7; } }
  .spin-icon { animation: adminSpin 1s linear infinite; display: inline-block; vertical-align: middle; }

  .admin-dashboard-page {
    display: flex; flex-direction: column; gap: 24px; width: 100%; max-width: 100%; box-sizing: border-box; overflow-x: hidden;
  }

  .dashboard-live-indicator {
    display: inline-flex; align-items: center; gap: 7px; padding: 3px 10px; background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35); border-radius: 999px; font-size: 0.78rem; font-weight: 700; color: #34d399; margin-inline-start: 12px;
  }
  .live-dot-pulse {
    width: 7px; height: 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981; animation: adminLiveBadgePulse 1.8s ease-in-out infinite;
  }

  /* 3D Quick Actions Hub */
  .quick-actions-section {
    background: linear-gradient(145deg, rgba(17, 22, 34, 0.88) 0%, rgba(10, 13, 20, 0.96) 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.22); border-radius: 20px; padding: 18px 20px;
    box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.12);
  }
  .quick-actions-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; gap: 10px; }
  .quick-actions-title { display: inline-flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 800; color: #f5d77f; margin: 0; }
  .quick-actions-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr)); gap: 12px; }
  .quick-action-card-3d {
    display: flex; align-items: center; gap: 11px; padding: 12px 14px;
    background: linear-gradient(145deg, rgba(22, 29, 46, 0.75) 0%, rgba(13, 17, 27, 0.9) 100%);
    border: 1.2px solid rgba(212, 175, 55, 0.2); border-radius: 14px; text-decoration: none; color: #f1f5f9;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45); transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1); min-width: 0;
  }
  .quick-action-card-3d:hover {
    transform: translateY(-3px); border-color: rgba(212, 175, 55, 0.7);
    background: linear-gradient(145deg, rgba(28, 38, 60, 0.9) 0%, rgba(16, 21, 34, 0.95) 100%);
    box-shadow: 0 12px 24px -4px rgba(0, 0, 0, 0.65), 0 0 18px rgba(212, 175, 55, 0.25); color: #ffffff;
  }
  .quick-action-icon-wrap {
    display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; flex-shrink: 0;
    border-radius: 10px; background: rgba(212, 175, 55, 0.12); border: 1px solid rgba(212, 175, 55, 0.3); color: #f5d77f;
  }
  .quick-action-texts { display: flex; flex-direction: column; gap: 2px; min-width: 0; overflow: hidden; }
  .quick-action-label { font-size: 0.86rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .quick-action-sub { font-size: 0.72rem; color: #94a3b8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* 3D KPI Metrics */
  .admin-metrics-grid-5 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 16px; }
  .admin-metric-card-3d {
    position: relative; background: linear-gradient(145deg, rgba(22, 28, 44, 0.88) 0%, rgba(12, 16, 26, 0.96) 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.22); border-radius: 20px; padding: 20px 18px;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.8), inset 0 1px 1px rgba(255, 255, 255, 0.16);
    transition: all 0.22s ease; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between;
  }
  .admin-metric-card-3d::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.6), transparent);
  }
  .admin-metric-card-3d:hover {
    transform: translateY(-4px); border-color: rgba(212, 175, 55, 0.7);
    box-shadow: 0 24px 44px -8px rgba(0, 0, 0, 0.88), 0 0 26px rgba(212, 175, 55, 0.25);
  }
  .admin-metric-card-3d.highlight-amber { border-color: rgba(245, 158, 11, 0.45); }
  .admin-metric-card-3d.highlight-amber::before { background: linear-gradient(90deg, transparent, #f59e0b, transparent); }
  .admin-metric-card-3d.highlight-emerald { border-color: rgba(16, 185, 129, 0.45); }
  .admin-metric-card-3d.highlight-emerald::before { background: linear-gradient(90deg, transparent, #10b981, transparent); }

  /* 3D Analytics & Distribution */
  .analytics-section-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 18px; }
  .analytics-card-3d {
    background: linear-gradient(145deg, rgba(18, 23, 36, 0.85) 0%, rgba(10, 13, 20, 0.95) 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.2); border-radius: 20px; padding: 20px;
    box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.12);
    display: flex; flex-direction: column; gap: 16px; min-width: 0;
  }
  .analytics-card-title { display: inline-flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 800; color: #f8fafc; margin: 0; }
  .gauge-track-3d {
    width: 100%; height: 12px; background: rgba(15, 20, 32, 0.95); border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px; overflow: hidden; position: relative; box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.8);
  }
  .gauge-fill-3d {
    height: 100%; background: linear-gradient(90deg, #d4af37 0%, #f5d77f 70%, #10b981 100%);
    border-radius: 999px; box-shadow: 0 0 12px rgba(212, 175, 55, 0.5); transition: width 0.6s ease;
  }
  .gauge-stats-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: #94a3b8; flex-wrap: wrap; gap: 6px; }
  .service-breakdown-list { display: flex; flex-direction: column; gap: 11px; }
  .service-item-row { display: flex; flex-direction: column; gap: 4px; }
  .service-item-header { display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem; }
  .service-item-name { font-weight: 700; color: #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 70%; }
  .service-item-count { font-weight: 700; color: #f5d77f; }
  .service-bar-track { width: 100%; height: 7px; background: rgba(15, 20, 32, 0.9); border-radius: 999px; overflow: hidden; }
  .service-bar-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #d4af37 0%, #f5d77f 100%); transition: width 0.4s ease; }
  .demographics-row { display: flex; gap: 10px; align-items: center; }
  .demographic-pill {
    flex: 1; display: flex; align-items: center; justify-content: space-between; padding: 9px 12px;
    border-radius: 11px; background: rgba(15, 20, 32, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.8rem;
  }
  .demographic-pill.female { border-color: rgba(244, 114, 182, 0.3); background: rgba(244, 114, 182, 0.07); color: #f472b6; }
  .demographic-pill.male { border-color: rgba(56, 189, 248, 0.3); background: rgba(56, 189, 248, 0.07); color: #38bdf8; }

  /* Toolbar */
  .schedule-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .schedule-search-box { position: relative; flex: 1; min-width: 220px; }
  .schedule-search-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: rgba(212, 175, 55, 0.8); pointer-events: none; }
  .schedule-search-input {
    width: 100%; background: rgba(11, 15, 24, 0.9); border: 1.5px solid rgba(212, 175, 55, 0.25);
    border-radius: 12px; padding: 9px 38px 9px 12px; font-family: inherit; font-size: 0.88rem; color: #ffffff;
    outline: none; box-sizing: border-box; transition: all 0.18s ease;
  }
  .schedule-search-input:focus { border-color: #d4af37; box-shadow: 0 0 14px rgba(212, 175, 55, 0.28); }
  .schedule-filter-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .filter-chip-btn {
    display: inline-flex; align-items: center; gap: 5px; background: rgba(15, 20, 32, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1); color: #94a3b8; padding: 7px 12px; border-radius: 10px;
    font-family: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.16s ease;
  }
  .filter-chip-btn:hover { color: #f1f5f9; border-color: rgba(212, 175, 55, 0.4); }
  .filter-chip-btn.active { background: rgba(212, 175, 55, 0.2); border-color: #d4af37; color: #f5d77f; box-shadow: 0 0 10px rgba(212, 175, 55, 0.25); }
  .view-switch-btn {
    display: inline-flex; align-items: center; gap: 6px; background: rgba(15, 20, 32, 0.8);
    border: 1px solid rgba(212, 175, 55, 0.25); color: #cbd5e1; padding: 7px 12px; border-radius: 10px;
    font-family: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.16s ease;
  }
  .view-switch-btn:hover { color: #ffffff; border-color: #d4af37; }

  /* Mobile Card View for Schedule */
  .schedule-cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 14px; margin-top: 14px; }
  .schedule-card-item {
    background: linear-gradient(145deg, rgba(20, 26, 40, 0.85) 0%, rgba(11, 15, 24, 0.95) 100%);
    border: 1.2px solid rgba(212, 175, 55, 0.2); border-radius: 16px; padding: 16px;
    display: flex; flex-direction: column; gap: 12px; box-shadow: 0 8px 22px rgba(0, 0, 0, 0.5); min-width: 0;
  }

  /* Activity Feed Widget */
  .activity-feed-widget {
    background: linear-gradient(145deg, rgba(18, 23, 36, 0.85) 0%, rgba(10, 13, 20, 0.95) 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.2); border-radius: 20px; padding: 20px;
    box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.7); display: flex; flex-direction: column; gap: 14px;
  }
  .activity-stream-list { display: flex; flex-direction: column; gap: 10px; position: relative; }
  .activity-stream-item {
    display: flex; align-items: flex-start; gap: 12px; padding: 10px 12px;
    background: rgba(14, 18, 29, 0.6); border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05); min-width: 0;
  }
  .activity-stream-icon-box {
    display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
    background: rgba(212, 175, 55, 0.12); color: #f5d77f; border: 1px solid rgba(212, 175, 55, 0.25);
  }
  .activity-stream-details { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }

  /* Breakpoints */
  @media (max-width: 1024px) { .analytics-section-grid { grid-template-columns: 1fr; } }
  @media (max-width: 768px) {
    .admin-metrics-grid-5 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .quick-actions-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .schedule-toolbar { flex-direction: column; align-items: stretch; }
    .schedule-search-box { width: 100%; }
  }
  @media (max-width: 480px) {
    .admin-metrics-grid-5 { grid-template-columns: minmax(0, 1fr); }
    .dashboard-header-row { padding: 14px; }
    .dashboard-header-row h1 { font-size: 1.22rem; }
    .admin-metric-card-3d { padding: 16px 14px; }
    .quick-action-card-3d { padding: 10px; gap: 8px; }
    .quick-action-icon-wrap { width: 32px; height: 32px; }
    .quick-action-label { font-size: 0.8rem; }
    .quick-action-sub { display: none; }
  }
  @media (max-width: 340px) {
    .quick-actions-grid { grid-template-columns: minmax(0, 1fr); }
    .admin-dashboard-page { gap: 16px; }
    .quick-actions-section, .analytics-card-3d, .admin-section-block, .activity-feed-widget { padding: 14px 10px !important; border-radius: 14px; }
  }
</style>
