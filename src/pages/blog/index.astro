---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { env } from 'cloudflare:workers';
import { listPublicBlogPosts } from '../../server/repositories';
import { isModuleEnabled } from '../../server/features';

/* Plugin gate: the blog module can be switched off from the hub; the index then
   redirects home and its nav entry disappears (PublicLayout). */
let blogEnabled = true;
try {
  blogEnabled = await isModuleEnabled(env.DB, 'content-blog');
} catch (e) {
  console.error('blog module gate read failed:', e);
}
if (!blogEnabled) return Astro.redirect('/', 307);
import { formatJalaliDate, toPersianDigits } from '../../lib/datetime/jalali';
import { cspSafeCover, readingMinutes } from '../../lib/content/blog-presenter';
import { createBreadcrumbSchema } from '../../lib/seo';
import Icon from '../../components/ui/Icon.astro';
import '../../styles/blog-index.css';

let postsPage: Awaited<ReturnType<typeof listPublicBlogPosts>> = { items: [], nextCursor: null };
try {
  postsPage = await listPublicBlogPosts(env.DB, 24);
} catch (e) {
  console.error('Failed to load blog posts:', e);
}

const allPosts = postsPage.items;

function getCategory(title: string, excerpt: string): { id: string; label: string; icon: string } {
  const combined = (title + ' ' + excerpt).toLowerCase();
  if (combined.includes('مراقبت') || combined.includes('آمادگی') || combined.includes('شیو') || combined.includes('قبل') || combined.includes('بعد')) {
    return { id: 'care', label: 'آمادگی و مراقبت', icon: 'shield' };
  }
  if (combined.includes('دستگاه') || combined.includes('الکساندرایت') || combined.includes('رادو پلاس') || combined.includes('کولینگ') || combined.includes('تکنولوژی')) {
    return { id: 'tech', label: 'دستگاه و تکنولوژی', icon: 'lightning' };
  }
  if (combined.includes('پوست') || combined.includes('دارو') || combined.includes('راکوتان') || combined.includes('سولاریوم') || combined.includes('پزشک')) {
    return { id: 'health', label: 'سلامت و تیپ پوستی', icon: 'gem' };
  }
  return { id: 'standards', label: 'استاندارد کلینیکال', icon: 'sparkles' };
}

const featuredPost = allPosts.length > 0 ? allPosts[0] : null;
const regularPosts = allPosts.length > 1 ? allPosts.slice(1) : [];
const featuredCover = cspSafeCover(featuredPost?.coverImage, Astro.url.origin);

const categories = [
  { id: 'all', label: 'همه مقالات', icon: 'list' },
  { id: 'care', label: 'آمادگی و مراقبت', icon: 'shield' },
  { id: 'tech', label: 'تکنولوژی و دستگاه‌ها', icon: 'lightning' },
  { id: 'health', label: 'سلامت و تیپ پوستی', icon: 'gem' },
  { id: 'standards', label: 'استاندارد کلینیکال', icon: 'sparkles' },
];

const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
  { name: 'مجله تخصصی', url: '/blog' },
]);
---

<PublicLayout
  title="مجله تخصصی زیبایی و لیزر — کلینیک تهران لیزر"
  description="مرجع علمی و کاربردی مراقبت‌های پوستی، چک‌لیست قبل و بعد از لیزر، تکنولوژی لیزر تماسی و استانداردهای کلینیکال پاسداران."
  canonicalUrl="/blog"
  keywords={[
    'مجله لیزر موهای زائد',
    'مقالات لیزر تماسی',
    'مراقبت‌های بعد از لیزر',
    'راهنمای لیزر موهای زائد',
  ]}
  jsonLd={breadcrumbJsonLd}
  theme="dark"
  bodyClass="blog-page-obsidian"
>
  <div class="blog-obsidian-wrapper">
    <!-- Hero / Header Section -->
    <header class="blog-hero-section">
      <div class="container text-center">
        <div class="hero-badge">
          <Icon name="sparkles" size={15} class="badge-icon" />
          <span>مرجع علمی و آموزش کلینیکال تهران لیزر</span>
        </div>
        <h1 class="blog-hero-title">مجله تخصصی و راهنمای مراجعین</h1>
        <p class="blog-hero-desc">
          راهنماهای گام‌به‌گام آمادگی جلسات، مراقبت‌های پس از درمان، تحلیل تکنولوژی لیزر تماسی و سلامت پوست با راهنمایی تیم محتوای کلینیک
        </p>

        <!-- Fast Patient Guides Strip -->
        <div class="patient-guides-grid">
          <div class="patient-guide-card">
            <div class="guide-icon-box">
              <Icon name="checkCircle" size={22} />
            </div>
            <div class="guide-text">
              <div class="guide-title">چک‌لیست قبل از لیزر</div>
              <div class="guide-sub">شیو با تیغ ۲۴ ساعت قبل، عدم آفتاب‌سوختگی، پوست کاملاً تمیز</div>
            </div>
          </div>

          <div class="patient-guide-card">
            <div class="guide-icon-box">
              <Icon name="shield" size={22} />
            </div>
            <div class="guide-text">
              <div class="guide-title">مراقبت ۲۴ ساعت طلایی</div>
              <div class="guide-sub">ژل زینک اکساید، پرهیز از دوش آب داغ و استخر، کرم ضدآفتاب</div>
            </div>
          </div>

          <div class="patient-guide-card">
            <div class="guide-icon-box">
              <Icon name="gem" size={22} />
            </div>
            <div class="guide-text">
              <div class="guide-title">تکنولوژی لیزر تماسی</div>
              <div class="guide-sub">سه طول موج ۷۵۵ و ۸۰۸ و ۱۰۶۴ نانومتر با سرمایش پیوسته بدون درد</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="container blog-main-container">
      <!-- Category Filter Tabs -->
      <nav class="blog-category-bar" aria-label="فیلتر دسته‌بندی مقالات">
        <div class="category-chips-list" id="categoryChips">
          {categories.map((cat) => (
            <button
              type="button"
              class={`category-chip ${cat.id === 'all' ? 'active' : ''}`}
              data-cat={cat.id}
            >
              <Icon name={cat.icon} size={15} />
              <span>{cat.label}</span>
            </button>
          ))}
        </div>
      </nav>

      {allPosts.length === 0 ? (
        <div class="empty-state-3d text-center">
          <div class="empty-icon-wrap">
            <Icon name="blog" size={36} />
          </div>
          <h2 class="empty-title">به‌زودی مقالات جدید منتشر می‌شود</h2>
          <p class="empty-desc">تیم تولید محتوای پزشکی کلینیک در حال آماده‌سازی راهنماهای تخصصی جدید است.</p>
        </div>
      ) : (
        <div class="articles-flow">
          <!-- Featured Article Hero Card -->
          {featuredPost && (
            <section class="featured-article-section" id="featuredSection" data-category={getCategory(featuredPost.title, featuredPost.excerpt).id}>
              <article class="featured-card-3d">
                <div class="featured-image-col">
                  {featuredCover ? (
                    <img
                      src={featuredCover}
                      alt={`تصویر شاخص مقاله ${featuredPost.title}`}
                      class="featured-img"
                      width="1200"
                      height="675"
                      loading="eager"
                      decoding="async"
                      onerror="this.style.display='none';this.parentElement.classList.add('img-load-failed')"
                    />
                  ) : (
                    <div class="featured-img-fallback">
                      <Icon name="document" size={48} />
                    </div>
                  )}
                  <div class="featured-img-fallback img-failed-layer" aria-hidden="true">
                    <Icon name="document" size={48} />
                  </div>
                  <div class="featured-badge-pill">
                    <Icon name="star" size={13} />
                    <span>مقاله ویژه و برگزیده</span>
                  </div>
                </div>

                <div class="featured-content-col">
                  <div class="card-meta-row">
                    <span class="meta-tag meta-category">
                      <Icon name={getCategory(featuredPost.title, featuredPost.excerpt).icon} size={13} />
                      <span>{getCategory(featuredPost.title, featuredPost.excerpt).label}</span>
                    </span>
                    <span class="meta-tag meta-time">
                      <Icon name="clock" size={13} />
                      <span>{toPersianDigits(readingMinutes(featuredPost.excerpt))} دقیقه مطالعه</span>
                    </span>
                    {featuredPost.publishedAt && (
                      <span class="meta-tag meta-date">
                        <Icon name="calendar" size={13} />
                        <span>{formatJalaliDate(featuredPost.publishedAt.slice(0, 10))}</span>
                      </span>
                    )}
                  </div>

                  <h2 class="featured-title">
                    <a href={`/blog/${featuredPost.slug}`}>{featuredPost.title}</a>
                  </h2>

                  <p class="featured-excerpt">{featuredPost.excerpt}</p>

                  <div class="featured-footer">
                    <div class="author-badge">
                      <div class="author-avatar-mini">
                        <Icon name="users" size={14} />
                      </div>
                      <span class="author-name">{featuredPost.author || 'تیم علمی تهران لیزر'}</span>
                    </div>

                    <a href={`/blog/${featuredPost.slug}`} class="btn-read-featured">
                      <span>مطالعه کامل مقاله</span>
                      <Icon name="arrowLeft" size={16} />
                    </a>
                  </div>
                </div>
              </article>
            </section>
          )}

          <!-- Regular Articles Grid -->
          <section class="articles-grid-section">
            <div class="blog-grid" id="articlesGrid">
              {(regularPosts.length > 0 ? regularPosts : allPosts).map((post) => {
                const cat = getCategory(post.title, post.excerpt);
                const readMinutes = readingMinutes(post.excerpt);
                const postCover = cspSafeCover(post.coverImage, Astro.url.origin);
                return (
                  <article class="article-card-3d" data-category={cat.id}>
                    <div class="article-card-img-wrap">
                      {postCover ? (
                        <img
                          src={postCover}
                          alt={`تصویر شاخص مقاله ${post.title}`}
                          class="article-card-img"
                          width="800"
                          height="450"
                          loading="lazy"
                          decoding="async"
                          onerror="this.style.display='none';this.parentElement.classList.add('img-load-failed')"
                        />
                      ) : (
                        <div class="article-card-img-fallback">
                          <Icon name="document" size={32} />
                        </div>
                      )}
                      <div class="article-card-img-fallback img-failed-layer" aria-hidden="true">
                        <Icon name="document" size={32} />
                      </div>
                      <span class="card-category-tag">
                        <Icon name={cat.icon} size={12} />
                        <span>{cat.label}</span>
                      </span>
                    </div>

                    <div class="article-card-body">
                      <div class="card-meta-row mb-2">
                        <span class="meta-item">
                          <Icon name="clock" size={13} />
                          <span>{toPersianDigits(readMinutes)} دقیقه</span>
                        </span>
                        {post.publishedAt && (
                          <span class="meta-item">
                            <Icon name="calendar" size={13} />
                            <span>{formatJalaliDate(post.publishedAt.slice(0, 10))}</span>
                          </span>
                        )}
                      </div>

                      <h3 class="article-card-title">
                        <a href={`/blog/${post.slug}`}>{post.title}</a>
                      </h3>

                      <p class="article-card-excerpt">{post.excerpt}</p>

                      <div class="article-card-footer">
                        <div class="author-inline">
                          <Icon name="users" size={13} />
                          <span>{post.author || 'تهران لیزر'}</span>
                        </div>
                        <a href={`/blog/${post.slug}`} class="read-link-action">
                          <span>مطالعه</span>
                          <Icon name="arrowLeft" size={14} />
                        </a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        </div>
      )}

      <!-- Bottom Clinical Consultation CTA -->
      <section class="blog-cta-banner">
        <div class="cta-inner">
          <div class="cta-text-col">
            <span class="cta-label">
              <Icon name="sparkles" size={16} />
              <span>مشاوره تخصصی و تعیین تیپ پوستی</span>
            </span>
            <h2 class="cta-title">سوالی درباره روند درمان و جلسات لیزر دارید؟</h2>
            <p class="cta-sub">
              پزشکان و کارشناسان کلینیک تخصصی تهران لیزر در خیابان پایدارفرد پاسداران آماده پاسخگویی و ارائه مشاوره دقیق به شما هستند.
            </p>
          </div>
          <div class="cta-actions-col">
            <a href="/booking" class="btn-cta-primary">
              <Icon name="calendar" size={17} />
              <span>رزرو آنلاین نوبت با تخفیف</span>
            </a>
            <a href="tel:+989035555090" class="btn-cta-secondary" aria-label="تماس با کلینیک ۰۹۰۳ ۵۵۵ ۵۰۹۰">
              <Icon name="phone" size={17} />
              <span>تماس مستقیم: <bdi dir="ltr">۰۹۰۳ ۵۵۵ ۵۰۹۰</bdi></span>
            </a>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script>
    // Client-side category filtering
    const chips = document.querySelectorAll<HTMLButtonElement>('.category-chip');
    const articles = document.querySelectorAll<HTMLElement>('.article-card-3d');
    const featuredSec = document.getElementById('featuredSection');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');

        const cat = chip.dataset.cat || 'all';

        // Filter regular cards
        articles.forEach((art) => {
          const cardCat = art.dataset.category;
          if (cat === 'all' || cardCat === cat) {
            art.style.display = 'flex';
          } else {
            art.style.display = 'none';
          }
        });

        // Filter featured section
        if (featuredSec) {
          const featCat = featuredSec.dataset.category;
          if (cat === 'all' || featCat === cat) {
            featuredSec.style.display = 'block';
          } else {
            featuredSec.style.display = 'none';
          }
        }
      });
    });
  </script>
</PublicLayout>
