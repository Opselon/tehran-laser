  <script>
    // Client-side category filtering
    const chips = document.querySelectorAll<HTMLButtonElement>('.category-chip');
    const articles = document.querySelectorAll<HTMLElement>('.article-card-3d');
    const featuredSec = document.getElementById('featuredSection');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');

        const cat = chip.dataset.cat || 'all';

        // Filter regular cards
        articles.forEach((art) => {
          const cardCat = art.dataset.category;
          if (cat === 'all' || cardCat === cat) {
            art.style.display = 'flex';
          } else {
            art.style.display = 'none';
          }
        });

        // Filter featured section
        if (featuredSec) {
          const featCat = featuredSec.dataset.category;
          if (cat === 'all' || featCat === cat) {
            featuredSec.style.display = 'block';
          } else {
            featuredSec.style.display = 'none';
          }
        }
      });
    });
  </script>
