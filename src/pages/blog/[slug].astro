  <script>
    // Active TOC link highlighting on scroll
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const headingMap = new Map<string, Element>();

    tocLinks.forEach((link) => {
      const id = link.dataset.tocId;
      if (id) {
        const heading = document.getElementById(id);
        if (heading) headingMap.set(id, heading);
      }
    });

    if (headingMap.size > 0) {
      const setActive = () => {
        let currentId: string | null = null;
        let currentTop = -Infinity;
        const scrollPos = window.scrollY + 120;

        headingMap.forEach((heading, id) => {
          const top = heading.getBoundingClientRect().top + window.scrollY;
          if (top <= scrollPos && top > currentTop) {
            currentTop = top;
            currentId = id;
          }
        });

        tocLinks.forEach((link) => {
          if (link.dataset.tocId === currentId) {
            link.classList.add('toc-active');
          } else {
            link.classList.remove('toc-active');
          }
        });
      };

      window.addEventListener('scroll', setActive, { passive: true });
      setActive();
    }

    // Smooth scroll for TOC links
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.dataset.tocId;
        if (!id) return;
        const heading = document.getElementById(id);
        if (!heading) return;
        e.preventDefault();
        const top = heading.getBoundingClientRect().top + window.scrollY - 104;
        window.scrollTo({ top, behavior: 'smooth' });
        if (history.replaceState) {
          history.replaceState(null, '', `#${id}`);
        }
      });
    });
  </script>
