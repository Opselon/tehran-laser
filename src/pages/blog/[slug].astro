---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { env } from 'cloudflare:workers';
import { findPublicBlogPostBySlug, listPublicBlogPosts } from '../../server/repositories';
import { formatJalaliDate } from '../../lib/datetime/jalali';
import { createArticleSchema, createBreadcrumbSchema } from '../../lib/seo';
import Icon from '../../components/ui/Icon.astro';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/blog');

const post = await findPublicBlogPostBySlug(env.DB, slug);
if (!post) return Astro.redirect('/404');

// Related posts (same published set, exclude current)
let related: Awaited<ReturnType<typeof listPublicBlogPosts>>['items'] = [];
try {
  const page = await listPublicBlogPosts(env.DB, 6);
  related = page.items.filter((p) => p.slug !== post.slug).slice(0, 3);
} catch (e) {
  console.error('Failed to load related posts:', e);
}

const readingMinutes = Math.max(
  3,
  Math.ceil(post.content.replace(/<[^>]*>/g, ' ').trim().split(/\s+/).filter(Boolean).length / 150),
);

// Table of contents extracted from H2/H3 headings in the article body
interface TocItem {
  id: string;
  text: string;
  level: number;
}

function extractToc(html: string): TocItem[] {
  const items: TocItem[] = [];
  const seen = new Set<string>();
  const headingRe = /<h([23])[^>]*>([\s\S]*?)<\/h\1>/gi;
  let match: RegExpExecArray | null;
  while ((match = headingRe.exec(html)) !== null) {
    if (!match[2]) continue;
    const level = Number(match[1]);
    const raw = match[2].replace(/<[^>]*>/g, '').trim();
    if (!raw) continue;
    let id = raw
      .toLowerCase()
      .replace(/[^\p{L}\p{N}]+/gu, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60);
    if (!id) id = 'section-' + items.length;
    let unique = id;
    let n = 2;
    while (seen.has(unique)) {
      unique = `${id}-${n}`;
      n += 1;
    }
    seen.add(unique);
    items.push({ id: unique, text: raw, level });
  }
  return items;
}

function injectHeadingIds(html: string, toc: TocItem[]): string {
  let idx = 0;
  const headingRe = /<h([23])([^>]*)>/gi;
  return html.replace(headingRe, (full, level, attrs) => {
    const item = toc[idx];
    idx += 1;
    if (!item) return full;
    if (/id\s*=\s*["'][^"']*["']/i.test(attrs)) return full;
    return `<h${level}${attrs} id="${item.id}">`;
  });
}

const toc = extractToc(post.content);
const contentWithIds = injectHeadingIds(post.content, toc);
const hasToc = toc.length > 0;

// Pre / post treatment callouts injected around the article body
const preCareHtml = `
<div class="clinical-callout callout-pre">
  <div class="callout-icon-box"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 19.5 5.5v6c0 5-3.2 8.6-7.5 10-4.3-1.4-7.5-5-7.5-10v-6L12 2.5Zm-3.2 8.2 2.3 2.3 4.2-4.2"></path></svg></div>
  <div class="callout-body">
    <div class="callout-title">چک‌لیست قبل از جلسه لیزر</div>
    <div class="callout-text">شیو با تیغ ۲۴ ساعت قبل، پوست تمیز و بدون لوسیون، پرهیز ۳ تا ۴ هفته‌ای از برنزه‌سازی و سولاریوم.</div>
  </div>
</div>`;

const postCareHtml = `
<div class="clinical-callout callout-post">
  <div class="callout-icon-box"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19Zm-3 10 2.5 2.5 5-5"></path></svg></div>
  <div class="callout-body">
    <div class="callout-title">مراقبت ۲۴ ساعت طلایی پس از درمان</div>
    <div class="callout-text">استفاده از ژل زینک اکساید و آلوئه‌ورا، پرهیز از دوش آب داغ، استخر، سونا و ورزش‌های تعریق‌زا تا ۲۴ ساعت.</div>
  </div>
</div>`;

// Schema.org Article + MedicalWebPage JSON-LD (§31, §135)
const articleJsonLd = createArticleSchema({
  title: post.title,
  slug: post.slug,
  excerpt: post.excerpt,
  coverImage: post.coverImage ?? undefined,
  author: post.author || undefined,
  publishedAt: post.publishedAt || undefined,
});

// BreadcrumbList schema for nested blog detail pages (§31, §135)
const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
  { name: 'مجله تخصصی', url: '/blog' },
  { name: post.title, url: `/blog/${post.slug}` },
]);

const blogJsonLdArray = [articleJsonLd, breadcrumbJsonLd];
---

<PublicLayout
  title={`${post.seo.seoTitle || post.title} — تهران لیزر`}
  description={post.seo.seoDescription || post.excerpt}
  canonicalUrl={post.seo.canonicalUrl || `/blog/${post.slug}`}
  ogType="article"
  ogImage={post.coverImage ?? undefined}
  jsonLd={blogJsonLdArray}
  theme="dark"
  bodyClass="blog-article-obsidian"
>
  <div class="article-obsidian-wrapper">
    <!-- Article Header -->
    <header class="article-hero-section">
      <div class="container container-sm text-center">
        <nav class="article-breadcrumbs" aria-label="مسیر صفحه">
          <a href="/">صفحه اصلی</a>
          <Icon name="chevronLeft" size={13} class="bc-sep-icon" />
          <a href="/blog">مجله تخصصی</a>
          <Icon name="chevronLeft" size={13} class="bc-sep-icon" />
          <span class="bc-current">{post.title}</span>
        </nav>

        <h1 class="article-hero-title">{post.title}</h1>

        <div class="article-meta-row">
          <span class="meta-pill">
            <Icon name="users" size={14} />
            <span>{post.author || 'تیم علمی تهران لیزر'}</span>
          </span>
          <span class="meta-pill">
            <Icon name="calendar" size={14} />
            <span>{formatJalaliDate(post.publishedAt.slice(0, 10))}</span>
          </span>
          <span class="meta-pill meta-pill-gold">
            <Icon name="clock" size={14} />
            <span>{readingMinutes} دقیقه مطالعه</span>
          </span>
        </div>
      </div>
    </header>

    <!-- Article Body + Sticky TOC -->
    <section class="article-body-section">
      <div class="container article-layout-grid">
        <!-- Sticky Table of Contents Sidebar (RTL: right column) -->
        {hasToc && (
          <aside class="article-toc-sidebar" id="tocSidebar" aria-label="فهرست بخش‌های مقاله">
            <div class="toc-inner">
              <div class="toc-header">
                <Icon name="list" size={16} />
                <span>فهرست بخش‌ها</span>
              </div>
              <nav class="toc-nav">
                <ul class="toc-list">
                  {toc.map((item) => (
                    <li class={`toc-item toc-level-${item.level}`}>
                      <a href={`#${item.id}`} class="toc-link" data-toc-id={item.id}>
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
              <a href="/booking" class="toc-cta-btn">
                <Icon name="calendar" size={15} />
                <span>رزرو نوبت</span>
              </a>
            </div>
          </aside>
        )}

        <!-- Main Article Column -->
        <article class="article-main-col">
          {post.coverImage && (
            <div class="article-cover-wrap" id="articleCoverWrap">
              <img
                src={post.coverImage}
                alt={post.title}
                class="article-cover-img"
                loading="eager"
                onerror="this.style.display='none';document.getElementById('articleCoverWrap').classList.add('cover-fallback')"
              />
              <div class="article-cover-shade"></div>
              <div class="article-cover-fallback" aria-hidden="true">
                <Icon name="camera" size={34} class="cover-fallback-icon" />
                <span>کلینیک تهران لیزر</span>
              </div>
            </div>
          )}

          <div class="article-excerpt-callout">
            <Icon name="sparkles" size={17} class="callout-spark" />
            <p>{post.excerpt}</p>
          </div>

          {hasToc && (
            <details class="toc-mobile-details">
              <summary class="toc-mobile-summary">
                <span class="toc-mobile-title">
                  <Icon name="list" size={16} />
                  <span>فهرست بخش‌های مقاله</span>
                </span>
                <Icon name="chevronDown" size={16} class="toc-mobile-chevron" />
              </summary>
              <nav class="toc-nav toc-nav-mobile">
                <ul class="toc-list">
                  {toc.map((item) => (
                    <li class={`toc-item toc-level-${item.level}`}>
                      <a href={`#${item.id}`} class="toc-link" data-toc-id={item.id}>
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )}

          <div class="article-content-body">
            <Fragment set:html={preCareHtml} />
            {/<[a-z][\s\S]*>/i.test(contentWithIds) ? (
              <div class="rich-article-content" set:html={contentWithIds} />
            ) : (
              <div class="rich-article-content">
                {contentWithIds.split('\n\n').map((paragraph) => {
                  if (paragraph.startsWith('## ')) {
                    return <h2 class="article-h2">{paragraph.replace('## ', '')}</h2>;
                  }
                  if (paragraph.startsWith('### ')) {
                    return <h3 class="article-h3">{paragraph.replace('### ', '')}</h3>;
                  }
                  if (paragraph.startsWith('- ')) {
                    return (
                      <ul class="article-list">
                        {paragraph.split('\n').map((item) => (
                          <li>{item.replace(/^- /, '')}</li>
                        ))}
                      </ul>
                    );
                  }
                  return <p class="article-p">{paragraph}</p>;
                })}
              </div>
            )}
            <Fragment set:html={postCareHtml} />
          </div>

          <!-- Author Footer -->
          <div class="article-author-card">
            <div class="author-avatar">
              <Icon name="users" size={22} />
            </div>
            <div class="author-info">
              <div class="author-label">نویسنده مقاله</div>
              <div class="author-name-big">{post.author || 'تیم علمی تهران لیزر'}</div>
              <div class="author-bio">تیم تولید محتوای علمی و کلینیکال کلینیک تخصصی تهران لیزر پاسداران</div>
            </div>
          </div>

          <!-- Article CTA Cards -->
          <div class="article-cta-grid">
            <a href="/booking" class="article-cta-card cta-gold">
              <div class="cta-icon-box">
                <Icon name="calendar" size={22} />
              </div>
              <div class="cta-card-text">
                <div class="cta-card-title">رزرو آنلاین نوبت</div>
                <div class="cta-card-sub">با ۱۵٪ تخفیف ویژه پکیج کل بدن در سامانه رزرو</div>
              </div>
              <Icon name="arrowLeft" size={18} class="cta-arrow" />
            </a>

            <a href="tel:09000005090" class="article-cta-card cta-outline">
              <div class="cta-icon-box">
                <Icon name="phone" size={22} />
              </div>
              <div class="cta-card-text">
                <div class="cta-card-title">مشاوره تلفنی رایگان</div>
                <div class="cta-card-sub">پاسخگویی به سوالات شما توسط کارشناسان کلینیک</div>
              </div>
              <Icon name="arrowLeft" size={18} class="cta-arrow" />
            </a>
          </div>

          <a href="/blog" class="back-to-blog">
            <Icon name="arrowRight" size={16} />
            <span>بازگشت به فهرست همه مقالات</span>
          </a>
        </article>
      </div>
    </section>

    <!-- Related Articles -->
    {related.length > 0 && (
      <section class="related-section">
        <div class="container">
          <h2 class="related-section-title">
            <Icon name="document" size={20} />
            <span>مقالات مرتبط و پیشنهادی</span>
          </h2>
          <div class="related-grid">
            {related.map((rp) => (
              <a href={`/blog/${rp.slug}`} class="related-card">
                {rp.coverImage ? (
                  <div class="related-img-wrap">
                    <img src={rp.coverImage} alt={rp.title} class="related-img" loading="lazy" />
                  </div>
                ) : (
                  <div class="related-img-wrap related-img-fallback">
                    <Icon name="document" size={26} />
                  </div>
                )}
                <div class="related-body">
                  <span class="related-date">
                    <Icon name="calendar" size={12} />
                    <span>{rp.publishedAt ? formatJalaliDate(rp.publishedAt.slice(0, 10)) : ''}</span>
                  </span>
                  <h3 class="related-title">{rp.title}</h3>
                  <p class="related-excerpt">{rp.excerpt}</p>
                  <span class="related-read-more">
                    <span>مطالعه مقاله</span>
                    <Icon name="arrowLeft" size={13} />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>

  <style>
    /* ── Dark 3D Obsidian-Gold Article ── */
    :global(body.blog-article-obsidian) {
      background-color: #0a0b0d !important;
      color: #f1f5f9;
      overflow-x: hidden;
    }

    .article-obsidian-wrapper {
      background-color: #0a0b0d;
      background-image:
        radial-gradient(ellipse 70% 45% at 50% -8%, rgba(16, 185, 129, 0.1) 0%, transparent 70%),
        radial-gradient(ellipse 50% 35% at 10% 30%, rgba(16, 185, 129, 0.03) 0%, transparent 60%);
      min-height: 100vh;
      padding-bottom: 60px;
      /* clip, NOT hidden: hidden computes overflow-y to auto and makes this a
         scroll container, which silently kills position:sticky on the TOC. */
      overflow-x: clip;
      width: 100%;
    }

    .article-hero-section {
      padding: 40px 16px 30px;
      border-bottom: 1px solid rgba(16, 185, 129, 0.16);
    }

    .article-breadcrumbs {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 0.82rem;
      color: #94a3b8;
      margin-bottom: 18px;
    }

    .article-breadcrumbs a {
      color: #cbd5e1;
      text-decoration: none;
      transition: color 0.2s;
    }

    .article-breadcrumbs a:hover {
      color: #34d399;
    }

    .bc-sep-icon {
      color: rgba(16, 185, 129, 0.6);
      flex-shrink: 0;
    }

    .bc-current {
      color: #34d399;
      font-weight: 700;
      max-width: 260px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .article-hero-title {
      font-size: clamp(1.5rem, 3.6vw, 2.4rem);
      font-weight: 900;
      color: #ffffff;
      line-height: 1.5;
      margin-bottom: 20px;
      letter-spacing: -0.02em;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    }

    .article-meta-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .meta-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(18, 22, 31, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #cbd5e1;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 999px;
    }

    .meta-pill-gold {
      background: rgba(16, 185, 129, 0.14);
      border-color: rgba(16, 185, 129, 0.4);
      color: #34d399;
    }

    /* ── Layout grid: TOC sidebar + article column ── */
    .article-body-section {
      padding: 34px 0 0;
    }

    .article-layout-grid {
      display: grid;
      grid-template-columns: 296px minmax(0, 1fr);
      gap: 44px;
      align-items: start;
    }

    /* Sticky TOC Sidebar (clears the 78px sticky site header) */
    .article-toc-sidebar {
      position: sticky;
      top: 94px;
      max-height: calc(100vh - 118px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(16, 185, 129, 0.3) transparent;
      align-self: start;
    }

    .toc-inner {
      background: linear-gradient(160deg, rgba(20, 24, 33, 0.9) 0%, rgba(12, 15, 22, 0.95) 100%);
      border: 1px solid rgba(16, 185, 129, 0.22);
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    }

    .toc-header {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #34d399;
      font-size: 0.88rem;
      font-weight: 800;
      padding-bottom: 12px;
      margin-bottom: 12px;
      border-bottom: 1px solid rgba(16, 185, 129, 0.2);
    }

    .toc-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .toc-item {
      margin: 0;
    }

    .toc-link {
      display: block;
      padding: 9px 12px;
      border-radius: 9px;
      color: #94a3b8;
      font-size: 0.85rem;
      line-height: 1.7;
      text-decoration: none;
      transition: color 0.18s, background 0.18s, border-right-color 0.18s;
      border-right: 2px solid transparent;
    }

    .toc-link:hover {
      color: #34d399;
      background: rgba(16, 185, 129, 0.08);
    }

    .toc-link.toc-active {
      color: #34d399;
      background: rgba(16, 185, 129, 0.14);
      border-right-color: #10b981;
      font-weight: 700;
    }

    .toc-level-3 .toc-link {
      padding-right: 22px;
      font-size: 0.78rem;
    }

    .toc-cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
      width: 100%;
      background: linear-gradient(135deg, #10b981 0%, #aa8421 100%);
      color: #0b0e14;
      font-size: 0.82rem;
      font-weight: 800;
      padding: 9px 14px;
      border-radius: 10px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.28);
      transition: filter 0.2s, transform 0.2s;
    }

    .toc-cta-btn:hover {
      filter: brightness(1.1);
      transform: translateY(-1px);
    }

    /* Mobile TOC (details/summary) */
    .toc-mobile-details {
      display: none;
      background: rgba(18, 22, 31, 0.8);
      border: 1px solid rgba(16, 185, 129, 0.22);
      border-radius: 14px;
      padding: 0;
      margin: 0 0 22px;
      overflow: hidden;
    }

    .toc-mobile-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 13px 16px;
      cursor: pointer;
      list-style: none;
      color: #34d399;
      font-size: 0.88rem;
      font-weight: 800;
    }

    .toc-mobile-summary::-webkit-details-marker {
      display: none;
    }

    .toc-mobile-title {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .toc-mobile-chevron {
      transition: transform 0.22s;
      color: #94a3b8;
    }

    .toc-mobile-details[open] .toc-mobile-chevron {
      transform: rotate(180deg);
    }

    .toc-nav-mobile {
      padding: 4px 12px 14px;
      max-height: 260px;
      overflow-y: auto;
    }

    /* ── Article main column ── */
    .article-main-col {
      min-width: 0;
      overflow-wrap: break-word;
    }

    .article-cover-wrap {
      position: relative;
      border-radius: 18px;
      overflow: hidden;
      max-height: 420px;
      border: 1px solid rgba(16, 185, 129, 0.25);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
      margin-bottom: 26px;
    }

    .article-cover-fallback {
      display: none;
      position: absolute;
      inset: 0;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 240px;
      background:
        radial-gradient(120% 100% at 30% 0%, rgba(16, 185, 129, 0.18), transparent 60%),
        linear-gradient(160deg, #121417 0%, #0a0b0d 70%);
      color: #10b981;
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: 0.5px;
    }

    .article-cover-wrap.cover-fallback .article-cover-fallback {
      display: flex;
    }

    .article-cover-wrap.cover-fallback .article-cover-shade {
      display: none;
    }

    .cover-fallback-icon {
      opacity: 0.85;
      filter: drop-shadow(0 6px 18px rgba(16, 185, 129, 0.35));
    }

    .article-cover-img {
      width: 100%;
      height: 100%;
      max-height: 420px;
      object-fit: cover;
      display: block;
    }

    .article-cover-shade {
      position: absolute;
      inset: auto 0 0 0;
      height: 45%;
      background: linear-gradient(to top, rgba(10, 11, 13, 0.75), transparent);
      pointer-events: none;
    }

    .article-excerpt-callout {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: rgba(16, 185, 129, 0.09);
      border: 1px solid rgba(16, 185, 129, 0.28);
      border-right: 3px solid #10b981;
      border-radius: 14px;
      padding: 16px 20px;
      margin-bottom: 26px;
    }

    .callout-spark {
      color: #34d399;
      flex-shrink: 0;
      margin-top: 3px;
    }

    .article-excerpt-callout p {
      margin: 0;
      color: #e2e8f0;
      font-size: 0.96rem;
      line-height: 1.9;
      font-weight: 500;
    }

    /* ── Reading typography ── */
    .article-content-body {
      color: #d1d8e3;
    }

    .rich-article-content :global(h2),
    .article-h2 {
      font-size: clamp(1.25rem, 2.4vw, 1.6rem);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.5;
      margin: 34px 0 14px;
      padding-right: 14px;
      border-right: 3px solid rgba(16, 185, 129, 0.55);
      scroll-margin-top: 104px;
    }

    .rich-article-content :global(h3),
    .article-h3 {
