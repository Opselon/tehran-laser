---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { createBreadcrumbSchema, resolveCanonicalOrigin } from '../lib/seo';

// The layout already emits the canonical MedicalClinic entity (with geo, hours,
// offer catalog). The /clinic page adds an AboutPage entity + breadcrumbs so
// Google sees one consistent clinic node, not two conflicting ones.
// Origin comes from the runtime SITE_URL var — tehranlaser.ir is a parked
// domain and must never appear in emitted structured data.
const origin = resolveCanonicalOrigin();
const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['AboutPage', 'MedicalWebPage'],
  '@id': `${origin}/clinic#about`,
  url: `${origin}/clinic`,
  name: 'درباره کلینیک تخصصی تهران لیزر پاسداران',
  description:
    'مرکز تخصصی لیزر و زیبایی تهران لیزر در پاسداران با تجهیزات اورجینال کندلا جنتل مکس پرو ۲۰۲۶، سیستم سرمایش DCD و کادر مجرب پزشکی.',
  inLanguage: 'fa-IR',
  mainEntity: { '@id': `${origin}/#clinic` },
  isPartOf: { '@id': `${origin}/#website` },
};

const breadcrumbJsonLd = createBreadcrumbSchema([
  { name: 'صفحه اصلی', url: '/' },
  { name: 'درباره کلینیک', url: '/clinic' },
]);
---

<PublicLayout
  title="درباره کلینیک و تکنولوژی کندلا ۲۰۲۶ — کلینیک تهران لیزر پاسداران"
  description="معرفی فناوری کندلا جنتل مکس پرو ۲۰۲۶ (الکساندرایت ۷۵۵nm و ان‌دی‌یاگ ۱۰۶۴nm)، خنک‌کننده کرایوژنیک DCD، اسپات سایز ۲۴mm و پروتکل‌های بهداشتی کلینیک تهران لیزر."
  canonicalUrl="/clinic"
  keywords={[
    'کلینیک لیزر پاسداران',
    'کندلا جنتل مکس پرو ۲۰۲۶',
    'مرکز لیزر الکساندرایت تهران',
    'کلینیک زیبایی پایدارفرد',
  ]}
  jsonLd={[aboutJsonLd, breadcrumbJsonLd]}
  bodyClass="clinic-obsidian-root"
>
  <div class="clinic-page-wrapper">
    <!-- Hero / Header Showcase -->
    <header class="clinic-hero">
      <div class="container">
        <div class="hero-chip">
          <Icon name="sparkles" size={16} class="gold-icon" />
          <span>مرکز تخصصی لیزر و زیبایی پاسداران</span>
        </div>
        <h1 class="hero-title">
          تکنولوژی فوق‌پیشرفته <span class="gold-gradient-text">کندلا جنتل مکس پرو ۲۰۲۶</span> در تهران
        </h1>
        <p class="hero-desc">
          استاندارد طلایی پزشکی پوست و مو با تلفیق دو طول موج الکساندرایت و ان‌دی‌یاگ، سرمایش داینامیک کرایوژنیک بدون درد و نظارت مستقیم پزشکان متخصص در محیطی آرام و استاندارد.
        </p>

        <div class="hero-cta-row">
          <a href="/booking" class="hero-cta-primary">
            <Icon name="calendar" size={18} />
            <span>رزرو آنلاین نوبت با ۱۵٪ تخفیف</span>
          </a>
          <a href="/services" class="hero-cta-secondary">
            <Icon name="services" size={18} />
            <span>مشاهده تعرفه خدمات بانوان و آقایان</span>
          </a>
        </div>

        <!-- Trust Badges Strip -->
        <div class="hero-badges-grid">
          <div class="hero-badge-card">
            <div class="badge-icon-box"><Icon name="award" size={22} /></div>
            <div>
              <div class="badge-title">تاییدیه رسمی FDA و CE</div>
              <div class="badge-sub">مجوز رسمی تجهیزات پزشکی آمریکا و اروپا</div>
            </div>
          </div>
          <div class="hero-badge-card">
            <div class="badge-icon-box"><Icon name="lightning" size={22} /></div>
            <div>
              <div class="badge-title">دو طول موج همزمان</div>
              <div class="badge-sub">Alexandrite 755nm + Nd:YAG 1064nm</div>
            </div>
          </div>
          <div class="hero-badge-card">
            <div class="badge-icon-box"><Icon name="snowflake" size={22} /></div>
            <div>
              <div class="badge-title">کولینگ کرایوژنیک DCD</div>
              <div class="badge-sub">خنک‌کنندگی منفی ۲۰ درجه، تجربه بدون درد</div>
            </div>
          </div>
          <div class="hero-badge-card">
            <div class="badge-icon-box"><Icon name="doctor" size={22} /></div>
            <div>
              <div class="badge-title">تحت نظارت پزشک متخصص</div>
              <div class="badge-sub">پرونده بالینی و اپراتورهای ارشد آموزش‌دیده</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Candela GentleMax Pro 2026 Showcase -->
    <section class="section tech-section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="pill-label"><Icon name="gem" size={14} /> شناسنامه فناوری</div>
          <h2 class="section-title">بررسی تخصصی دستگاه <span class="gold-gradient-text">Candela GentleMax Pro 2026</span></h2>
          <p class="section-lead">
            دستگاه کندلا ۲۰۲۶ برترین پلتفرم درمانی موهای زائد در کلینیک‌های معتبر بین‌المللی است که اثربخشی قطعی را با حداکثر ایمنی و سرعت ترکیب کرده است.
          </p>
        </div>

        <!-- Interactive Wavelength Explorer -->
        <div class="tech-explorer-card">
          <div class="wavelength-tabs" role="tablist" aria-label="انتخاب طول موج دستگاه کندلا">
            <button id="tab-alex" class="wl-tab active" data-target="alex" role="tab" aria-selected="true" aria-controls="panel-alex">
              <Icon name="lightning" size={18} />
              <span>الکساندرایت ۷۵۵ نانومتر (Alexandrite)</span>
            </button>
            <button id="tab-yag" class="wl-tab" data-target="yag" role="tab" aria-selected="false" aria-controls="panel-yag">
              <Icon name="target" size={18} />
              <span>ان‌دی‌یاگ ۱۰۶۴ نانومتر (Nd:YAG)</span>
            </button>
          </div>

          <div class="wavelength-panel active" id="panel-alex" role="tabpanel" aria-labelledby="tab-alex" tabindex="0">
            <div class="wl-grid">
              <div class="wl-content">
                <span class="wl-pill">پیک جذب ملانین فوق‌العاده بالا</span>
                <h3 class="wl-title">طول موج ۷۵۵nm الکساندرایت؛ طلایه‌دار موهای روشن و نازک</h3>
                <p class="wl-text">
                  طول موج ۷۵۵ نانومتر دارای بالاترین ضریب جذب نوری توسط رنگدانه‌های ملانین در ساقه و ریشه مو است. این ویژگی سبب تخریب حرارتی کامل پیاز مو (Papilla) در کمترین تعداد جلسات درمانی می‌شود.
                </p>
                <ul class="spec-checks">
                  <li><Icon name="checkCircle" size={16} /> <span>ایده‌آل برای تیپ‌های پوستی روشن تا گندمی (Fitzpatrick I-III)</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>قدرت برتر در تخریب موهای کرکی، نازک و کم‌رنگ باقی‌مانده</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>ریزش تا ۹۰ درصدی موها تنها پس از جلسه اول و دوم</span></li>
                </ul>
              </div>
              <div class="wl-stats">
                <div class="stat-box">
                  <span class="stat-num">۷۵۵</span>
                  <span class="stat-unit">نانومتر</span>
                  <span class="stat-desc">طول موج فوتونیک دقیق</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">۶-۸</span>
                  <span class="stat-unit">جلسه</span>
                  <span class="stat-desc">طول دوره پاسخ کامل</span>
                </div>
              </div>
            </div>
          </div>

          <div class="wavelength-panel" id="panel-yag" role="tabpanel" aria-labelledby="tab-yag" tabindex="0">
            <div class="wl-grid">
              <div class="wl-content">
                <span class="wl-pill yag">نفوذ ایمن و عمیق به درمیس</span>
                <h3 class="wl-title">طول موج ۱۰۶۴nm ان‌دی‌یاگ؛ امنیت ۱۰۰٪ برای پوست‌های سبزه و برنزه</h3>
                <p class="wl-text">
                  پالس‌های بلند ۱۰۶۴ نانومتر از ملانین سطحی اپیدرم عبور کرده و انرژی گرمایی را مستقیماً به عروق تغذیه‌کننده فولیکول در لایه‌های عمقی می‌رسانند. بدون کوچک‌ترین ریسک سوختگی یا لک.
                </p>
                <ul class="spec-checks">
                  <li><Icon name="checkCircle" size={16} /> <span>کاملاً ایمن برای پوست‌های سبزه، گندمی تیره و برنزه (Fitzpatrick IV-VI)</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>پیشگیری مطلق از هایپرپیگمانتاسیون (PIH) پس از درمان</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>نفوذ عمیق برای موهای ریشه‌دار و ضخیم نواحی مقاوم بدن</span></li>
                </ul>
              </div>
              <div class="wl-stats">
                <div class="stat-box">
                  <span class="stat-num">۱۰۶۴</span>
                  <span class="stat-unit">نانومتر</span>
                  <span class="stat-desc">طول موج نفوذ عمقی</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">۰٪</span>
                  <span class="stat-unit">ریسک لک</span>
                  <span class="stat-desc">ایمنی اثبات‌شده بالینی</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Candela 2026 Technical Datasheet -->
        <div class="spec-datasheet">
          <div class="spec-datasheet-head">
            <div class="spec-datasheet-title">
              <Icon name="gem" size={18} class="gold-icon" />
              <span>شناسنامه فنی دستگاه — Candela GentleMax Pro</span>
            </div>
            <span class="spec-datasheet-model">مدل ۲۰۲۶ · ساخت آمریکا (Candela Corporation)</span>
          </div>
          <div
            class="spec-table-wrap"
            role="region"
            aria-label="جدول مشخصات فنی دستگاه کندلا"
            tabindex="0"
          >
            <table class="spec-table">
              <caption class="spec-caption">مشخصات فنی رسمی دستگاه کندلا جنتل مکس پرو ۲۰۲۶</caption>
              <thead>
                <tr>
                  <th scope="col">پارامتر فنی</th>
                  <th scope="col">الکساندرایت (Alexandrite)</th>
                  <th scope="col">ان‌دی‌یاگ (Nd:YAG)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">طول موج</th>
                  <td>۷۵۵ نانومتر</td>
                  <td>۱۰۶۴ نانومتر</td>
                </tr>
                <tr>
                  <th scope="row">حداکثر توان خروجی</th>
                  <td>۱۰۰ J/cm²</td>
                  <td>۱۰۰ J/cm²</td>
                </tr>
                <tr>
                  <th scope="row">پهنای پالس</th>
                  <td>۲ الی ۳۰۰ میلی‌ثانیه</td>
                  <td>۲ الی ۳۰۰ میلی‌ثانیه</td>
                </tr>
                <tr>
                  <th scope="row">قطر اسپات (Spot Size)</th>
                  <td>۲۴ میلی‌متر</td>
                  <td>۲۴ میلی‌متر</td>
                </tr>
                <tr>
                  <th scope="row">نرخ تکرار (Repeat Rate)</th>
                  <td>۱۰ Hz</td>
                  <td>۱۰ Hz</td>
                </tr>
                <tr>
                  <th scope="row">سیستم خنک‌کننده</th>
                  <td colspan="2">DCD — سرمایش داینامیک کرایوژنیک تا منفی ۲۰ درجه سانتی‌گراد</td>
                </tr>
                <tr>
                  <th scope="row">تیپ پوستی مطلوب</th>
                  <td>Fitzpatrick I الی III</td>
                  <td>Fitzpatrick IV الی VI</td>
                </tr>
                <tr>
                  <th scope="row">تاییدیه‌ها</th>
                  <td colspan="2">US FDA · CE Mark · ISO 13485</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3D Feature Cards: DCD Cooling & 24mm Spot Size -->
        <div class="features-dual-grid">
          <div class="feature-card-3d">
            <div class="card-icon-accent"><Icon name="snowflake" size={30} /></div>
            <h3 class="card-title">سیستم خنک‌کننده کرایوژنیک DCD هوشمند</h3>
            <p class="card-body">
              فناوری انحصاری Dynamic Cooling Device کندلا، پیش از هر پالس لیزر، مه خنک‌کننده کرایوژنیک گاز هیدروفلوئوروکربن را در کسری از ثانیه روی اپیدرم اسپری می‌کند. دمای پوست تا منفی ۲۰ درجه سانتی‌گراد افت کرده و گیرنده‌های درد را موقتاً بی‌حس می‌سازد.
            </p>
            <div class="card-metric-tag">
              <Icon name="shield" size={16} />
              <span>محافظت کامل لایه شاخی پوست در برابر شوک حرارتی</span>
            </div>
          </div>

          <div class="feature-card-3d">
            <div class="card-icon-accent"><Icon name="target" size={30} /></div>
            <h3 class="card-title">اسپات سایز بزرگ ۲۴ میلی‌متری و فرکانس 10Hz</h3>
            <p class="card-body">
              قطر تابش ۲۴ میلی‌متری کندلا ۲۰۲۶ با کاهش پدیده پراکندگی نوری (Optical Scattering)، عمق نفوذ فوتون‌ها را تا ۴۰٪ افزایش می‌دهد. علاوه بر افزایش اثربخشی، مدت زمان درمان کل بدن (Full Body) به زیر ۳۵ دقیقه کاهش یافته است.
            </p>
            <div class="card-metric-tag">
              <Icon name="clock" size={16} />
              <span>کاهش زمان جلسه تا ۵۰٪ همراه با پوشش یکنواخت شات‌ها</span>
            </div>
          </div>
        </div>

        <!-- Interactive Metrics Strip: clinical outcomes -->
        <div class="metrics-grid">
          <div class="metric-card">
            <div class="m-icon"><Icon name="chart" size={22} /></div>
            <div class="m-val">۹۲٪+</div>
            <div class="m-label">راندمان پاکسازی دائمی</div>
            <div class="m-sub">تایید بالینی مستند در پایان دوره درمان</div>
          </div>
          <div class="metric-card">
            <div class="m-icon"><Icon name="clock" size={22} /></div>
            <div class="m-val">زیر ۳۵ دقیقه</div>
            <div class="m-label">مدت جلسه لیزر کل بدن</div>
            <div class="m-sub">پوشش یکنواخت با اسپات ۲۴ میلی‌متر و نرخ ۱۰ هرتز</div>
          </div>
          <div class="metric-card">
            <div class="m-icon"><Icon name="snowflake" size={22} /></div>
            <div class="m-val">منفی ۲۰ درجه</div>
            <div class="m-label">دمای خنک‌سازی سیستم DCD</div>
            <div class="m-sub">بی‌حسی ملایم بدون نیاز به پماد زایلاپی</div>
          </div>
          <div class="metric-card">
            <div class="m-icon"><Icon name="calendar" size={22} /></div>
            <div class="m-val">۶ الی ۸ جلسه</div>
            <div class="m-label">طول دوره استاندارد درمان</div>
            <div class="m-sub">فاصله ۴ تا ۶ هفته بسته به ناحیه تحت درمان</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Medical Team & Supervision Section -->
    <section class="section team-section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="pill-label"><Icon name="doctor" size={14} /> سرمایه انسانی متخصص</div>
          <h2 class="section-title">تیم پزشکی و کادر درمانی تهران لیزر</h2>
          <p class="section-lead">
            کیفیت نتایج لیزر به اندازه دستگاه، به مهارت و دانش اپراتور و پزشک وابسته است. در تهران لیزر هر شات بر اساس پروتکل پزشکی ثبت‌شده شلیک می‌شود.
          </p>
        </div>

        <!-- Lead physician: صدف مظفری -->
        <div class="lead-doctor-card">
          <div class="lead-doctor-main">
            <div class="lead-doctor-avatar">
              <Icon name="doctor" size={56} class="gold-icon" />
              <span class="lead-doctor-badge">پزشک موسس و مسئول فنی</span>
            </div>
            <div class="lead-doctor-info">
              <div class="lead-doctor-name-row">
                <h3 class="lead-doctor-name">دکتر صدف مظفری</h3>
                <span class="lead-doctor-verified"><Icon name="checkCircle" size={14} /> مسئول فنی کلینیک صدف مظفری</span>
              </div>
              <div class="lead-doctor-role">پزشک پوست، مو و زیبایی — نظارت مستقیم بر پروتکل‌های درمانی</div>
              <p class="lead-doctor-desc">
                ارزیابی اولیه پوست، تعیین سطح ایمن انرژی و تایید پروتکل درمانی بر عهده پزشک ناظر است؛ هیچ شاتی بدون تایید ایشان شلیک نمی‌شود و پاسخ‌دهی هر جلسه در پرونده بالینی شما ثبت می‌گردد.
              </p>
              <div class="lead-doctor-facts">
                <div class="fact-item">
                  <span class="fact-num">ارزیابی اولیه</span>
                  <span class="fact-label">تعیین تیپ پوستی و سطح ایمن فلوئنس پیش از شروع</span>
                </div>
                <div class="fact-item">
                  <span class="fact-num">پروتکل شخصی</span>
                  <span class="fact-label">دوز انرژی و فاصله جلسات متناسب با هر ناحیه</span>
                </div>
                <div class="fact-item">
                  <span class="fact-num">نظارت هر جلسه</span>
                  <span class="fact-label">کنترل کیفیت شات‌ها و ثبت نتایج در پرونده بالینی</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="team-grid">
          <div class="team-card">
            <div class="team-avatar-box">
              <Icon name="doctor" size={44} class="gold-icon" />
              <div class="team-badge">پزشک ناظر</div>
            </div>
            <div class="team-info">
              <h3 class="team-name">دکتر مریم سلیمانی</h3>
              <div class="team-role">پزشک پوست، مو و زیبایی — شماره نظام پزشکی ۱۲۸۴۷۱</div>
              <p class="team-desc">
                ویزیت اولیه و ارزیابی فیتزپاتریک پوستی مراجعین، تعیین سطح ایمن فلوئنس و نظارت مستمر بر روند پاسخ‌دهی فولیکول‌ها.
              </p>
              <div class="team-skills">
                <span class="skill-tag"><Icon name="check" size={12} /> پچ‌تست حساسیت</span>
                <span class="skill-tag"><Icon name="check" size={12} /> پروتکل درمانی شخصی</span>
              </div>
            </div>
          </div>

          <div class="team-card">
            <div class="team-avatar-box">
              <Icon name="users" size={44} class="gold-icon" />
              <div class="team-badge">لاین بانوان</div>
            </div>
            <div class="team-info">
              <h3 class="team-name">اپراتورهای ارشد بانوان</h3>
              <div class="team-role">دارای گواهینامه معتبر کاربری لیزرهای پزشکی کندلا</div>
              <p class="team-desc">
                بیش از ۵۰۰۰ ساعت تجربه بالینی در لاین اختصاصی بانوان با شات‌های دقیق بدون جاانداختگی، حفظ کامل حریم خصوصی و بهداشت فردی.
              </p>
              <div class="team-skills">
                <span class="skill-tag"><Icon name="check" size={12} /> شات نامحدود دقیق</span>
