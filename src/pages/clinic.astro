    justify-content: center;
    gap: 10px;
    padding: 14px 20px;
    background: rgba(20, 24, 32, 0.7);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 14px;
    color: #a89f90;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  .wl-tab:hover {
    color: #ffffff;
    border-color: rgba(16, 185, 129, 0.45);
    background: rgba(30, 35, 48, 0.7);
  }

  .wl-tab.active {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(4, 120, 87, 0.18) 100%);
    border-color: #10b981;
    color: #34d399;
    box-shadow: 0 4px 18px rgba(16, 185, 129, 0.2), inset 0 1px 0 rgba(110, 231, 183, 0.3);
  }

  .wavelength-panel {
    display: none;
  }

  .wavelength-panel.active {
    display: block;
    animation: fadeIn 0.35s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Candela Technical Datasheet */
  .spec-datasheet {
    background: linear-gradient(180deg, #13161c 0%, #0d0f14 100%);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 24px;
    padding: 28px;
    margin-bottom: 40px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(110, 231, 183, 0.18);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .spec-datasheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(16, 185, 129, 0.2);
  }

  .spec-datasheet-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .spec-datasheet-model {
    color: #6ee7b7;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    white-space: nowrap;
  }

  .spec-caption {
    caption-side: top;
    text-align: right;
    color: #a39c8f;
    font-size: 0.8rem;
    padding-bottom: 10px;
  }

  .spec-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .spec-table th,
  .spec-table td {
    padding: 12px 14px;
    text-align: right;
    border-bottom: 1px solid rgba(16, 185, 129, 0.14);
  }

  .spec-table thead th {
    background: rgba(16, 185, 129, 0.1);
    color: #6ee7b7;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(16, 185, 129, 0.35);
  }

  .spec-table tbody th {
    color: #e5ded5;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .spec-table tbody td {
    color: #c4bcb0;
    font-variant-numeric: tabular-nums;
  }

  .spec-table tbody tr:last-child th,
  .spec-table tbody tr:last-child td {
    border-bottom: none;
  }

  .spec-table tbody tr:hover th,
  .spec-table tbody tr:hover td {
    background: rgba(16, 185, 129, 0.05);
  }

  .wl-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
  }

  .wl-pill {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 8px;
    color: #34d399;
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .wl-pill.yag {
    background: rgba(85, 130, 200, 0.15);
    border-color: rgba(120, 160, 230, 0.35);
    color: #a8c7fa;
  }

  .wl-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 14px;
    line-height: 1.4;
  }

  .wl-text {
    color: #c4bcb0;
    line-height: 1.9;
    margin: 0 0 20px;
    font-size: 0.98rem;
  }

  .spec-checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .spec-checks li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #e5ded5;
    font-size: 0.92rem;
  }

  .spec-checks li :global(svg) {
    color: #10b981;
    flex-shrink: 0;
  }

  .wl-stats {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 180px;
  }

  .stat-box {
    background: rgba(15, 18, 24, 0.9);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 16px;
    padding: 18px;
    text-align: center;
    box-shadow: inset 0 1px 0 rgba(110, 231, 183, 0.1);
  }

  .stat-num {
    display: block;
    font-size: 1.85rem;
    font-weight: 900;
    color: #34d399;
    line-height: 1.1;
  }

  .stat-unit {
    display: block;
    font-size: 0.8rem;
    color: #ffffff;
    font-weight: 700;
    margin-top: 2px;
  }

  .stat-desc {
    display: block;
    font-size: 0.76rem;
    color: #a39c8f;
    margin-top: 6px;
  }

  /* 3D Features Dual Grid (DCD Cooling & 24mm Spot) */
  .features-dual-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .feature-card-3d {
    background: linear-gradient(145deg, #151821 0%, #0e1016 100%);
    border: 1px solid rgba(16, 185, 129, 0.28);
    border-radius: 20px;
    padding: 32px 28px;
    position: relative;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(110, 231, 183, 0.15);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .feature-card-3d:hover {
    transform: translateY(-4px);
    border-color: rgba(16, 185, 129, 0.6);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.6), 0 0 24px rgba(16, 185, 129, 0.2);
  }

  .card-icon-accent {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(4, 120, 87, 0.1) 100%);
    border: 1px solid rgba(16, 185, 129, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #34d399;
    margin-bottom: 22px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 14px;
    line-height: 1.4;
  }

  .card-body {
    color: #bdb5a8;
    font-size: 0.95rem;
    line-height: 1.85;
    margin: 0 0 20px;
  }

  .card-metric-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 10px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #34d399;
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .metric-card {
    background: rgba(16, 19, 26, 0.85);
    border: 1px solid rgba(16, 185, 129, 0.22);
    border-radius: 18px;
    padding: 22px 18px;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .m-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #34d399;
    margin: 0 auto 12px;
  }

  .m-val {
    font-size: 1.45rem;
    font-weight: 900;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .m-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #34d399;
    margin-bottom: 4px;
  }

  .m-sub {
    font-size: 0.78rem;
    color: #9c9486;
    line-height: 1.4;
  }

  /* Team Section */
  .team-section {
    background: #0d0f14;
    border-block: 1px solid rgba(16, 185, 129, 0.15);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  /* Featured lead physician — صدف مظفری */
  .lead-doctor-card {
    position: relative;
    background:
      radial-gradient(circle at 100% 0%, rgba(16, 185, 129, 0.14) 0%, rgba(10, 11, 13, 0) 55%),
      linear-gradient(160deg, #171b24 0%, #0f1218 100%);
    border: 1px solid rgba(16, 185, 129, 0.45);
    border-radius: 24px;
    padding: 32px 30px;
    margin-bottom: 32px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(110, 231, 183, 0.2);
  }

  .lead-doctor-card::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 24px;
    bottom: 24px;
    width: 4px;
    border-radius: 999px;
    background: linear-gradient(180deg, #34d399 0%, #047857 100%);
  }

  .lead-doctor-main {
    display: flex;
    align-items: flex-start;
    gap: 28px;
  }

  .lead-doctor-avatar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .lead-doctor-avatar :global(svg) {
    width: 96px;
    height: 96px;
    padding: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(4, 120, 87, 0.1) 100%);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
    box-sizing: border-box;
  }

  .lead-doctor-badge {
    padding: 5px 14px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
    font-size: 0.75rem;
    font-weight: 800;
    text-align: center;
    white-space: nowrap;
  }

  .lead-doctor-info {
    min-width: 0;
    flex: 1;
  }

  .lead-doctor-name-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 6px;
  }

  .lead-doctor-name {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 900;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }

  .lead-doctor-verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #34d399;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .lead-doctor-role {
    color: #10b981;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .lead-doctor-desc {
    color: #c4bcb0;
    font-size: 0.98rem;
    line-height: 1.9;
    margin: 0 0 22px;
  }

  .lead-doctor-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 4px;
  }

  .fact-item {
    flex: 1 1 170px;
    min-width: 0;
    background: rgba(10, 12, 16, 0.7);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 14px;
    padding: 14px 16px;
    text-align: center;
  }

  .fact-num {
    display: block;
    font-size: 1.35rem;
    font-weight: 900;
    color: #34d399;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .fact-label {
    display: block;
    font-size: 0.78rem;
    color: #a39c8f;
    line-height: 1.5;
  }

  .team-card {
    background: #141720;
    border: 1px solid rgba(16, 185, 129, 0.22);
    border-radius: 20px;
    padding: 28px 24px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .team-avatar-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .team-badge {
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .team-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .team-role {
    color: #10b981;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 14px;
  }

  .team-desc {
    color: #bcb4a6;
    font-size: 0.92rem;
    line-height: 1.8;
    margin: 0 0 20px;
  }

  .team-skills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e5ded5;
    font-size: 0.78rem;
  }

  /* Hygiene & Certification Layout */
  .hygiene-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: 36px;
    align-items: start;
  }

  .hygiene-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 28px;
  }

  .hygiene-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: #141720;
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 16px;
    padding: 18px 20px;
  }

  .h-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #34d399;
    flex-shrink: 0;
  }

  .h-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px;
  }

  .h-desc {
    color: #a89f91;
    font-size: 0.88rem;
    line-height: 1.7;
    margin: 0;
  }

  .certifications-card {
    background: linear-gradient(160deg, #161922 0%, #0f1218 100%);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 24px;
    padding: 32px 28px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(110, 231, 183, 0.15);
  }

  .cert-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 24px;
    line-height: 1.4;
  }

  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .cert-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .cert-check {
    color: #10b981;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .cert-item strong {
    display: block;
    color: #ffffff;
    font-size: 0.95rem;
    margin-bottom: 2px;
  }

  .cert-item span {
    display: block;
    color: #a39c8f;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  /* Authenticity & calibration guarantees strip */
  .authenticity-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
    margin-top: 36px;
  }

  .auth-item {
    display: flex;
    align-items: center;
    gap: 14px;
    background: linear-gradient(150deg, rgba(19, 22, 28, 0.95) 0%, rgba(13, 15, 20, 0.9) 100%);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }

  .auth-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #34d399;
  }

  .auth-body {
    min-width: 0;
  }

  .auth-title {
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 3px;
    line-height: 1.5;
  }

  .auth-sub {
    color: #a39c8f;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  /* Location Card 3D */
  .location-card-3d {
    background: #13161d;
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .loc-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: 36px;
    align-items: center;
  }

  .loc-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .loc-desc {
    color: #bcb4a6;
    font-size: 0.95rem;
    line-height: 1.85;
    margin: 0 0 24px;
  }

  .loc-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #e5ded5;
    font-size: 0.92rem;
  }

  .meta-row a {
    color: #34d399;
    text-decoration: none;
    font-weight: 700;
    padding-block: 11px;
  }

  .amenities-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 16px;
  }

  .amenities-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .amenities-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #c9c1b3;
    font-size: 0.9rem;
  }

  .amenities-list li :global(svg) {
    color: #10b981;
    flex-shrink: 0;
  }

  /* FAQ Accordion */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq-section {
    background: #0d0f14;
    border-block: 1px solid rgba(16, 185, 129, 0.15);
  }

  .faq-section .section-title {
    color: #ffffff;
  }

  .faq-item {
    background: #141720;
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .faq-item[open] {
    border-color: rgba(16, 185, 129, 0.45);
  }

  .faq-summary {
    padding: 20px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
    list-style: none;
    gap: 12px;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.5;
  }

  .faq-arrow {
    color: #10b981;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 22px 20px;
    color: #bcb4a6;
    font-size: 0.94rem;
    line-height: 1.85;
  }

  /* 3D Obsidian-Gold Booking CTA */
  .obsidian-cta-card {
    background: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.22) 0%, rgba(18, 21, 28, 0.95) 70%), #101319;
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 28px;
    padding: 56px 32px;
    text-align: center;
    position: relative;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(110, 231, 183, 0.25);
    max-width: 920px;
    margin-inline: auto;
  }

  .cta-sparkle-decor {
    color: #34d399;
    margin-bottom: 18px;
    display: inline-block;
    filter: drop-shadow(0 0 12px rgba(16, 185, 129, 0.5));
  }

  .cta-title {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 16px;
    line-height: 1.35;
  }

  .cta-desc {
