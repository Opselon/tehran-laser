---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { createBreadcrumbSchema, resolveCanonicalOrigin } from '../lib/seo';
import '../styles/clinic.css';

// The layout already emits the canonical MedicalClinic entity (with geo, hours,
// offer catalog). The /clinic page adds an AboutPage entity + breadcrumbs so
// Google sees one consistent clinic node, not two conflicting ones.
// Origin comes from the runtime SITE_URL var — tehranlaser.ir is a parked
// domain and must never appear in emitted structured data.
const origin = resolveCanonicalOrigin();
const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['AboutPage', 'MedicalWebPage'],
  '@id': `${origin}/clinic#about`,
  url: `${origin}/clinic`,
  name: 'درباره کلینیک تخصصی تهران لیزر پاسداران',
  description:
    'مرکز تخصصی لیزر و زیبایی تهران لیزر در پاسداران با دستگاه لیزر تماسی رادو پلاس، سه طول موج ۷۵۵ و ۸۰۸ و ۱۰۶۴ نانومتر، سیستم خنک‌کننده TEC Double و کادر آموزش‌دیده.',
  inLanguage: 'fa-IR',
  mainEntity: { '@id': `${origin}/#clinic` },
  isPartOf: { '@id': `${origin}/#website` },
};

const breadcrumbItems = [
  { name: 'صفحه اصلی', url: '/' },
  { name: 'درباره کلینیک', url: '/clinic' },
];

const breadcrumbJsonLd = createBreadcrumbSchema(breadcrumbItems);
---

<PublicLayout
  title="درباره کلینیک و تکنولوژی لیزر تماسی رادو پلاس — کلینیک تهران لیزر پاسداران"
  description="معرفی فناوری لیزر تماسی رادو پلاس با سه طول موج ۷۵۵ و ۸۰۸ و ۱۰۶۴ نانومتر، توان خروجی ۱۶۰۰ وات، خنک‌کننده TEC Double و پروتکل‌های بهداشتی کلینیک تهران لیزر."
  canonicalUrl="/clinic"
  keywords={[
    'کلینیک لیزر پاسداران',
    'لیزر تماسی رادو پلاس',
    'مرکز لیزر تماسی تهران',
    'کلینیک زیبایی پایدارفرد',
  ]}
  jsonLd={[aboutJsonLd, breadcrumbJsonLd]}
  bodyClass="clinic-obsidian-root"
>
  <div class="clinic-page-wrapper">
    <Breadcrumbs items={breadcrumbItems} />
    <!-- Hero / Header Showcase -->
    <header class="clinic-hero">
      <div class="container">
        <div class="hero-chip">
          <Icon name="sparkles" size={16} class="gold-icon" />
          <span>مرکز تخصصی لیزر و زیبایی پاسداران</span>
        </div>
        <h1 class="hero-title">
          تکنولوژی لیزر تماسی <span class="gold-gradient-text">رادو پلاس</span> در تهران
        </h1>
        <p class="hero-desc">
          لیزر تماسی (لمسی) با تلفیق سه طول موج الکساندرایت، دیود و ان‌دی‌یاگ، سرمایش پیوسته TEC Double و پروتکل بهداشتی اختصاصی در محیطی آرام و استاندارد.
        </p>

        <div class="hero-cta-row">
          <a href="/booking" class="hero-cta-primary">
            <Icon name="calendar" size={18} />
            <span>رزرو آنلاین نوبت با ۱۵٪ تخفیف</span>
          </a>
          <a href="/services" class="hero-cta-secondary">
            <Icon name="services" size={18} />
            <span>مشاهده تعرفه خدمات بانوان و آقایان</span>
          </a>
        </div>

        <!-- Trust Badges Strip -->
        <div class="hero-badges-grid">
          <div class="hero-badge-card">
            <div class="badge-icon-box"><Icon name="award" size={22} /></div>
            <div>
              <div class="badge-title">تاییدیه رسمی FDA و CE</div>
              <div class="badge-sub">مجوز رسمی تجهیزات پزشکی آمریکا و اروپا</div>
            </div>
          </div>
          <div class="hero-badge-card">
            <div class="badge-icon-box"><Icon name="lightning" size={22} /></div>
            <div>
              <div class="badge-title">سه طول موج همزمان</div>
              <div class="badge-sub" dir="ltr">Alexandrite 755nm + Diode 808nm + Nd:YAG 1064nm</div>
            </div>
          </div>
          <div class="hero-badge-card">
            <div class="badge-icon-box"><Icon name="snowflake" size={22} /></div>
            <div>
              <div class="badge-title">خنک‌کننده TEC Double</div>
              <div class="badge-sub">سرمایش پیوسته، تجربه بدون درد</div>
            </div>
          </div>
          <div class="hero-badge-card">
            <div class="badge-icon-box"><Icon name="shield" size={22} /></div>
            <div>
              <div class="badge-title">پروتکل بهداشتی اختصاصی</div>
              <div class="badge-sub">پرونده هر مراجع و اپراتورهای آموزش‌دیده</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Rado Plus Contact Laser Showcase -->
    <section class="section tech-section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="pill-label"><Icon name="gem" size={14} /> شناسنامه فناوری</div>
          <h2 class="section-title">بررسی تخصصی دستگاه <span class="gold-gradient-text">Rado Plus</span></h2>
          <p class="section-lead">
            دستگاه رادو پلاس یک لیزر تماسی (لمسی) با توان خروجی ۱۶۰۰ وات و سه طول موج است که اثربخشی قطعی را با حداکثر ایمنی و سرعت ترکیب کرده است.
          </p>
        </div>

        <!-- Interactive Wavelength Explorer -->
        <div class="tech-explorer-card">
          <div class="wavelength-tabs" role="tablist" aria-label="انتخاب طول موج دستگاه رادو پلاس">
            <button id="tab-alex" class="wl-tab active" data-target="alex" role="tab" aria-selected="true" aria-controls="panel-alex">
              <Icon name="lightning" size={18} />
              <span>الکساندرایت ۷۵۵ نانومتر (Alexandrite)</span>
            </button>
            <button id="tab-diode" class="wl-tab" data-target="diode" role="tab" aria-selected="false" aria-controls="panel-diode">
              <Icon name="services" size={18} />
              <span>دیود ۸۰۸ نانومتر (Diode)</span>
            </button>
            <button id="tab-yag" class="wl-tab" data-target="yag" role="tab" aria-selected="false" aria-controls="panel-yag">
              <Icon name="target" size={18} />
              <span>ان‌دی‌یاگ ۱۰۶۴ نانومتر (Nd:YAG)</span>
            </button>
          </div>

          <div class="wavelength-panel active" id="panel-alex" role="tabpanel" aria-labelledby="tab-alex" tabindex="0">
            <div class="wl-grid">
              <div class="wl-content">
                <span class="wl-pill">پیک جذب ملانین فوق‌العاده بالا</span>
                <h3 class="wl-title">طول موج ۷۵۵nm الکساندرایت؛ طلایه‌دار موهای روشن و نازک</h3>
                <p class="wl-text">
                  طول موج ۷۵۵ نانومتر دارای بالاترین ضریب جذب نوری توسط رنگدانه‌های ملانین در ساقه و ریشه مو است. این ویژگی سبب تخریب حرارتی کامل پیاز مو (Papilla) در کمترین تعداد جلسات درمانی می‌شود.
                </p>
                <ul class="spec-checks">
                  <li><Icon name="checkCircle" size={16} /> <span>ایده‌آل برای تیپ‌های پوستی روشن تا گندمی (Fitzpatrick I-III)</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>قدرت برتر در تخریب موهای کرکی، نازک و کم‌رنگ باقی‌مانده</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>ریزش تا ۹۰ درصدی موها تنها پس از جلسه اول و دوم</span></li>
                </ul>
              </div>
              <div class="wl-stats">
                <div class="stat-box">
                  <span class="stat-num">۷۵۵</span>
                  <span class="stat-unit">نانومتر</span>
                  <span class="stat-desc">طول موج فوتونیک دقیق</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">۶-۸</span>
                  <span class="stat-unit">جلسه</span>
                  <span class="stat-desc">طول دوره پاسخ کامل</span>
                </div>
              </div>
            </div>
          </div>

          <div class="wavelength-panel" id="panel-diode" role="tabpanel" aria-labelledby="tab-diode" tabindex="0">
            <div class="wl-grid">
              <div class="wl-content">
                <span class="wl-pill">تعادل طلایی عمق نفوذ و سرعت</span>
                <h3 class="wl-title">طول موج ۸۰۸nm دیود؛ ستون فقرات لیزرهای تماسی</h3>
                <p class="wl-text">
                  طول موج ۸۰۸ نانومتر عمیق‌ترین نفوذ را در میان سه طول موج این دستگاه دارد و بالاترین توان پیوسته را برای حرکت سریع هندپیس روی پوست فراهم می‌کند. این ویژگی، تعداد جلسات نواحی وسیع مانند پا و پشت را کاهش می‌دهد.
                </p>
                <ul class="spec-checks">
                  <li><Icon name="checkCircle" size={16} /> <span>مناسب طیف گسترده‌ای از تیپ‌های پوستی گندمی تا سبزه</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>بالاترین سرعت حرکت هندپیس برای نواحی وسیع بدن</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>نفوذ مؤثر برای موهای ضخیم و ریشه‌دار</span></li>
                </ul>
              </div>
              <div class="wl-stats">
                <div class="stat-box">
                  <span class="stat-num">۸۰۸</span>
                  <span class="stat-unit">نانومتر</span>
                  <span class="stat-desc">طول موج عمق نفوذ</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">۱-۲۰</span>
                  <span class="stat-unit">شات در ثانیه</span>
                  <span class="stat-desc">نرخ پرتاب سیستم FHR</span>
                </div>
              </div>
            </div>
          </div>

          <div class="wavelength-panel" id="panel-yag" role="tabpanel" aria-labelledby="tab-yag" tabindex="0">
            <div class="wl-grid">
              <div class="wl-content">
                <span class="wl-pill yag">نفوذ ایمن و عمیق به درمیس</span>
                <h3 class="wl-title">طول موج ۱۰۶۴nm ان‌دی‌یاگ؛ امنیت ۱۰۰٪ برای پوست‌های سبزه و برنزه</h3>
                <p class="wl-text">
                  پالس‌های بلند ۱۰۶۴ نانومتر از ملانین سطحی اپیدرم عبور کرده و انرژی گرمایی را مستقیماً به عروق تغذیه‌کننده فولیکول در لایه‌های عمقی می‌رسانند. بدون کوچک‌ترین ریسک سوختگی یا لک.
                </p>
                <ul class="spec-checks">
                  <li><Icon name="checkCircle" size={16} /> <span>کاملاً ایمن برای پوست‌های سبزه، گندمی تیره و برنزه (Fitzpatrick IV-VI)</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>پیشگیری مطلق از هایپرپیگمانتاسیون (PIH) پس از درمان</span></li>
                  <li><Icon name="checkCircle" size={16} /> <span>نفوذ عمیق برای موهای ریشه‌دار و ضخیم نواحی مقاوم بدن</span></li>
                </ul>
              </div>
              <div class="wl-stats">
                <div class="stat-box">
                  <span class="stat-num">۱۰۶۴</span>
                  <span class="stat-unit">نانومتر</span>
                  <span class="stat-desc">طول موج نفوذ عمقی</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">۰٪</span>
                  <span class="stat-unit">ریسک لک</span>
                  <span class="stat-desc">ایمنی اثبات‌شده بالینی</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Rado Plus Technical Datasheet -->
        <div class="spec-datasheet">
          <div class="spec-datasheet-head">
            <div class="spec-datasheet-title">
              <Icon name="gem" size={18} class="gold-icon" />
              <span>شناسنامه فنی دستگاه — Rado Plus</span>
            </div>
            <span class="spec-datasheet-model">لیزر تماسی (لمسی) · ساخت شرکت بهین جهد داتیس</span>
          </div>
          <div
            class="spec-table-wrap"
            role="region"
            aria-label="جدول مشخصات فنی دستگاه رادو پلاس"
            tabindex="0"
          >
            <table class="spec-table">
              <caption class="spec-caption">مشخصات فنی رسمی دستگاه لیزر تماسی رادو پلاس</caption>
              <thead>
                <tr>
                  <th scope="col">پارامتر فنی</th>
                  <th scope="col">الکساندرایت (Alexandrite)</th>
                  <th scope="col">دیود (Diode)</th>
                  <th scope="col">ان‌دی‌یاگ (Nd:YAG)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">طول موج</th>
                  <td>۷۵۵ نانومتر</td>
                  <td>۸۰۸ نانومتر</td>
                  <td>۱۰۶۴ نانومتر</td>
                </tr>
                <tr>
                  <th scope="row">حداکثر توان خروجی دستگاه</th>
                  <td colspan="3">۱۶۰۰ وات (خروجی واقعی)</td>
                </tr>
                <tr>
                  <th scope="row">مدت پالس</th>
                  <td colspan="3">تنظیم‌پذیر بر اساس تیپ پوستی و ضخامت مو</td>
                </tr>
                <tr>
                  <th scope="row">سیستم خنک‌کننده</th>
                  <td colspan="3">دو سیستم داخلی و خارجی — TEC Double و Continuous Cooling</td>
                </tr>
                <tr>
                  <th scope="row">نرخ پرتاب شات (FHR)</th>
                  <td colspan="3">۱ تا ۲۰ شات در ثانیه</td>
                </tr>
                <tr>
                  <th scope="row">عمر نوار لیزر</th>
                  <td colspan="3">۱۰۰ میلیون شات (ساخت Coherent آمریکا)</td>
                </tr>
                <tr>
                  <th scope="row">نمایشگر</th>
                  <td colspan="3">صفحه لمسی ۱۰.۴ اینچ ثبت پارامترها و اطلاعات مراجع</td>
                </tr>
                <tr>
                  <th scope="row">روشن‌کنندگی (Whitening)</th>
                  <td colspan="3">دارد — بهبود نواحی تیره و یک تا دو درجه روشن‌تر شدن</td>
                </tr>
                <tr>
                  <th scope="row">تیپ پوستی مطلوب</th>
                  <td>Fitzpatrick I الی III</td>
                  <td>Fitzpatrick II الی V</td>
                  <td>Fitzpatrick IV الی VI</td>
                </tr>
                <tr>
                  <th scope="row">تاییدیه‌ها</th>
                  <td colspan="3">مجوز تجهیزات پزشکی ایران · ISO 13485</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3D Feature Cards: TEC Double Cooling & FHR Speed -->
        <div class="features-dual-grid">
          <div class="feature-card-3d">
            <div class="card-icon-accent"><Icon name="snowflake" size={30} /></div>
            <h3 class="card-title">سیستم خنک‌کننده دوگانه TEC Double</h3>
            <p class="card-body">
              دستگاه رادو پلاس دو سیستم خنک‌کننده مجزا دارد: سیستم داخلی با پمپ آب ایتالیایی، اجزای دستگاه را در استفاده‌های طولانی سالم نگه می‌دارد و سیستم خارجی با سرمایش پیوسته (Continuous Cooling) دمای سطح پوست را پایین می‌آورد تا درد و احتمال سوختگی به حداقل برسد.
            </p>
            <div class="card-metric-tag">
              <Icon name="shield" size={16} />
              <span>سرمایش پیوسته سطح پوست در تمام طول جلسه</span>
            </div>
          </div>

          <div class="feature-card-3d">
            <div class="card-icon-accent"><Icon name="target" size={30} /></div>
            <h3 class="card-title">سیستم FHR با نرخ ۱ تا ۲۰ شات در ثانیه</h3>
            <p class="card-body">
              فناوری Fast Hair Removal با پرتاب سریع و متوالی پالس‌ها، حرکت هندپیس را روی نواحی وسیع مانند پا، پشت و کمر سرعت می‌بخشد و مدت زمان درمان کل بدن (Full Body) را به‌طور محسوس کوتاه می‌کند.
            </p>
            <div class="card-metric-tag">
              <Icon name="clock" size={16} />
              <span>کوتاه‌شدن زمان جلسه همراه با پوشش یکنواخت نواحی وسیع</span>
            </div>
          </div>
        </div>

        <!-- Interactive Metrics Strip: clinical outcomes -->
        <div class="metrics-grid">
          <div class="metric-card">
            <div class="m-icon"><Icon name="chart" size={22} /></div>
            <div class="m-val">۹۲٪+</div>
            <div class="m-label">راندمان پاکسازی دائمی</div>
            <div class="m-sub">تایید بالینی مستند در پایان دوره درمان</div>
          </div>
          <div class="metric-card">
            <div class="m-icon"><Icon name="clock" size={22} /></div>
            <div class="m-val">۳ طول موج</div>
            <div class="m-label">پوشش همه رنگ‌های پوستی</div>
            <div class="m-sub">الکساندرایت ۷۵۵ · دیود ۸۰۸ · ان‌دی‌یاگ ۱۰۶۴ نانومتر</div>
          </div>
          <div class="metric-card">
            <div class="m-icon"><Icon name="snowflake" size={22} /></div>
            <div class="m-val">۱ تا ۲۰</div>
            <div class="m-label">شات در ثانیه (سیستم FHR)</div>
            <div class="m-sub">سرمایش پیوسته TEC Double بدون نیاز به پماد بی‌حسی</div>
          </div>
          <div class="metric-card">
            <div class="m-icon"><Icon name="calendar" size={22} /></div>
            <div class="m-val">۶ الی ۸ جلسه</div>
            <div class="m-label">طول دوره استاندارد درمان</div>
            <div class="m-sub">فاصله ۴ تا ۶ هفته بسته به ناحیه تحت درمان</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact (Touch) Laser Benefits — 7 reasons (§ owner copy) -->
    <section class="section benefits-section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="pill-label"><Icon name="checkCircle" size={14} /> چرا لیزر تماسی</div>
          <h2 class="section-title">چرا لیزر تماسی (لمسی) انتخاب بهتری است</h2>
          <p class="section-lead">
            در لیزر تماسی هندپیس مستقیماً روی پوست حرکت می‌کند و انرژی از نزدیک‌ترین فاصله به ریشه مو می‌رسد. هفت دلیل مهم که این روش را به انتخاب اول تبدیل می‌کند:
          </p>
        </div>

        <div class="benefits-grid">
          <div class="benefit-card-3d">
            <span class="benefit-index">۱</span>
            <h3 class="benefit-title">اثرگذاری بیشتر</h3>
            <p class="benefit-body">به خاطر تماس مستقیم، امواج از فاصله نزدیک‌تر به فولیکول‌ها می‌رسند و نتیجه سریع‌تر و قوی‌تر است.</p>
          </div>
          <div class="benefit-card-3d">
            <span class="benefit-index">۲</span>
            <h3 class="benefit-title">پوشش کامل همه نواحی</h3>
            <p class="benefit-body">به دلیل کاور بیشتر، هیچ نقطه‌ای جا نمی‌ماند.</p>
          </div>
          <div class="benefit-card-3d">
            <span class="benefit-index">۳</span>
            <h3 class="benefit-title">درد کمتر و پخش انرژی یکنواخت</h3>
            <p class="benefit-body">استفاده از ژل خنک‌کننده و تماس مستقیم هندپیس با پوست به کاهش درد و یکنواخت کردن پخش انرژی در سطح پوست کمک می‌کند.</p>
          </div>
          <div class="benefit-card-3d">
            <span class="benefit-index">۴</span>
