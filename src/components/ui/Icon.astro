---

<svg
  id={id}
  class={className}
  width={sizeAttr}
  height={sizeAttr}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={hasLabel ? 'img' : 'presentation'}
  aria-label={label}
  aria-hidden={hasLabel ? undefined : 'true'}
  focusable="false"
>
  <path d={d} />
</svg>
