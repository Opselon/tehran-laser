---
/**
 * Icon — inline SVG icon system (replaces emoji as UI icons).
 *
 * Why not an icon library: the project ships zero icon deps and runs on the
 * Cloudflare edge; these paths are ~0.3KB each and theming is free via
 * `currentColor`. Keep this map as the single source of truth for app icons.
 *
 * Usage:
 *   <Icon name="dashboard" class="nav-icon" size={20} />
 *   <Icon name="calendar" size={16} aria-hidden />
 *
 * All icons inherit font color/size by default; `size` overrides width/height.
 */

export interface Props {
  name: string;
  size?: number | string;
  class?: string;
  id?: string;
  /** aria-hidden by default; pass a label to expose it to screen readers */
  label?: string;
  /** stroke width override (default 1.75) */
  stroke?: number;
}

const { name, size, class: className, id, label, stroke = 1.75 } = Astro.props;

const sizeAttr = size !== undefined ? String(size) : '1em';
const hasLabel = !!label;

