---
/**
 * BrandMark — the clinic's monogram, drawn rather than typed.
 *
 * A laser aperture ring with the beam cone beneath it: the mark reads at 24px
 * in a favicon and at 42px in the header, and it is one SVG path set, so it
 * costs ~300 bytes inline and inherits `currentColor` from `.logo-mark`.
 *
 * Usage: <BrandMark size={22} /> inside the `.logo-mark` tile.
 */
export interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- aperture halo -->
  <path d="M5.4 7.1a8 8 0 0 1 13.2 0" opacity="0.55" />
  <!-- emitter head -->
  <circle cx="12" cy="9.4" r="3.35" />
  <circle cx="12" cy="9.4" r="1.1" fill="currentColor" stroke="none" />
  <!-- neck -->
  <path d="M12 12.75v1.7" />
  <!-- beam cone -->
  <path d="M8.7 20.3 12 14.45l3.3 5.85" />
  <path d="M12 17.2v.01" opacity="0.7" />
</svg>
