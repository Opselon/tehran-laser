---
import Icon from '../ui/Icon.astro';
---

<section class="section candela-showcase-section">
  <div class="container">
    <div class="candela-showcase-card">
      <div class="candela-badge-row">
        <span class="candela-gold-pill">
          <Icon name="award" size={16} />
          <span>لیزر تماسی (لمسی) با سه طول موج</span>
        </span>
        <span class="candela-sub-tag">تجهیز رسمی دارای مجوز وزارت بهداشت</span>
      </div>

      <div class="candela-header-block">
        <h2 class="candela-title">
          تکنولوژی لیزر تماسی رادو پلاس
          <span class="candela-en-sub">Rado Plus Contact Laser</span>
        </h2>
        <p class="candela-lead">
          دستگاه رادو پلاس یک لیزر تماسی (لمسی) با توان خروجی ۱۶۰۰ وات و سه طول موج ۷۵۵ و ۸۰۸ و ۱۰۶۴
          نانومتر است. تماس مستقیم هندپیس با پوست، انرژی را از نزدیک‌ترین فاصله به فولیکول می‌رساند
          و بالاترین اثربخشی بالینی با امنیت کامل برای همه رنگ‌های پوستی فراهم می‌گردد.
        </p>
      </div>

      <div class="candela-features-grid">
        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="snowflake" size={26} />
          </div>
          <h3 class="candela-feat-title">خنک‌کننده دوگانه TEC Double</h3>
          <p class="candela-feat-desc">
            دو سیستم خنک‌کننده داخلی و خارجی با سرمایش پیوسته، دمای سطح پوست را در تمام طول جلسه
            پایین نگه می‌دارد و ژل خنک‌کننده درد و التهاب را به حداقل می‌رساند.
          </p>
        </div>

        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="target" size={26} />
          </div>
          <h3 class="candela-feat-title">سه طول موج Alex + Diode + Nd:YAG</h3>
          <p class="candela-feat-desc">
            طول موج ۷۵۵nm برای پوست‌های روشن و موهای نازک، ۸۰۸nm برای عمق نفوذ بالا در نواحی وسیع، و
            ۱۰۶۴nm برای پوست‌های گندمی و تیره.
          </p>
        </div>

        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="lightning" size={26} />
          </div>
          <h3 class="candela-feat-title">سیستم FHR با ۱ تا ۲۰ شات در ثانیه</h3>
          <p class="candela-feat-desc">
            پرتاب سریع و متوالی پالس‌ها روی نواحی وسیع مانند پا و پشت، زمان جلسه را به‌طور محسوس
            کوتاه می‌کند و پوشش کاملی در اختیار می‌گذارد.
          </p>
        </div>

        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="shield" size={26} />
          </div>
          <h3 class="candela-feat-title">تست شات رایگان و ایمنی ۱۰۰٪</h3>
          <p class="candela-feat-desc">
            بررسی حساسیت پوستی پیش از شروع دوره و پایش مستمر درجه انرژی ژول توسط کادر آموزش‌دیده
            کلینیک.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Persian is a joined script — the shared sheet's positive tracking on the
     eyebrow opens gaps between joined glyphs. Scoped to this component. */
  .section-subtitle {
    letter-spacing: normal;
  }
</style>
