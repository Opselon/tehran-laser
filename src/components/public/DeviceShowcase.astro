---
import Icon from '../ui/Icon.astro';
---

<section class="section candela-showcase-section">
  <div class="container">
    <div class="candela-showcase-card">
      <div class="candela-badge-row">
        <span class="candela-gold-pill">
          <Icon name="award" size={16} />
          <span>لیزر تماسی (لمسی) دایود</span>
        </span>
        <span class="candela-sub-tag">تجهیز رسمی دارای مجوز وزارت بهداشت</span>
      </div>

      <div class="candela-header-block">
        <h2 class="candela-title">
          تکنولوژی لیزر تماسی رادو پلاس
          <span class="candela-en-sub">Rado Plus Contact Laser</span>
        </h2>
        <p class="candela-lead">
          دستگاه رادو پلاس یک لیزر تماسی (لمسی) دایود ۸۰۸nm با توان خروجی ۱۶۰۰ وات است. تماس مستقیم
          هندپیس با پوست، انرژی را از نزدیک‌ترین فاصله به فولیکول می‌رساند و بالاترین اثربخشی بالینی
          با امنیت کامل برای همه رنگ‌های پوستی فراهم می‌گردد.
        </p>
      </div>

      <div class="candela-features-grid">
        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="snowflake" size={26} />
          </div>
          <h3 class="candela-feat-title">خنک‌کننده دوگانه TEC Double</h3>
          <p class="candela-feat-desc">
            دو سیستم خنک‌کننده داخلی و خارجی با سرمایش پیوسته، دمای سطح پوست را در تمام طول جلسه
            پایین نگه می‌دارد و ژل خنک‌کننده درد و التهاب را به حداقل می‌رساند.
          </p>
        </div>

        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="target" size={26} />
          </div>
          <h3 class="candela-feat-title">طول موج دایود ۸۰۸nm</h3>
          <p class="candela-feat-desc">
            طول موج دایود ۸۰۸ نانومتر با عمق نفوذ بالا، ریشه‌های متراکم و ضخیم را هدف قرار می‌دهد و
            برای همه تیپ‌های پوستی مناسب است.
          </p>
        </div>

        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="lightning" size={26} />
          </div>
          <h3 class="candela-feat-title">سیستم FHR با ۱ تا ۲۰ شات در ثانیه</h3>
          <p class="candela-feat-desc">
            پرتاب سریع و متوالی پالس‌ها روی نواحی وسیع مانند پا و پشت، زمان جلسه را به‌طور محسوس
            کوتاه می‌کند و پوشش کاملی در اختیار می‌گذارد.
          </p>
        </div>

        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="shield" size={26} />
          </div>
          <h3 class="candela-feat-title">تست شات رایگان و ایمنی ۱۰۰٪</h3>
          <p class="candela-feat-desc">
            بررسی حساسیت پوستی پیش از شروع دوره و پایش مستمر درجه انرژی ژول توسط کادر آموزش‌دیده
            کلینیک.
          </p>
        </div>
      </div>
    </div>

    <!-- Second device: Deka (shot-based). The owner confirmed Deka's
         wavelengths (Alexandrite 755nm + Nd:YAG 1064nm); its power was never
         given, so no wattage is stated for it anywhere on the site. -->
    <div class="candela-showcase-card candela-showcase-card-deka">
      <div class="candela-badge-row">
        <span class="candela-gold-pill">
          <Icon name="award" size={16} />
          <span>لیزر شاتی با دو طول موج</span>
        </span>
        <span class="candela-sub-tag">دستگاه پریمیوم کلینیک</span>
      </div>

      <div class="candela-header-block">
        <h2 class="candela-title">
          دستگاه دکا
          <span class="candela-en-sub">Deka Shot-Based Laser</span>
        </h2>
        <p class="candela-lead">
          دومین دستگاه کلینیک، دکا، به‌صورت شاتی کار می‌کند و با دو طول موج الکساندرایت ۷۵۵nm و
          ان‌دی‌یاگ ۱۰۶۴nm، برای پوست‌های روشن تا سبزه و موهای نازک تا ضخیم مناسب است. تعرفه‌های دکا
          بالاتر از رادو پلاس است و هنگام رزرو آنلاین می‌توانید دستگاه مورد نظر خود را انتخاب کنید.
        </p>
      </div>

      <div class="candela-features-grid">
        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="target" size={26} />
          </div>
          <h3 class="candela-feat-title">دو طول موج الکساندرایت + ان‌دی‌یاگ</h3>
          <p class="candela-feat-desc">
            طول موج ۷۵۵nm برای پوست‌های روشن و موهای نازک، و ۱۰۶۴nm برای نفوذ عمیق و پوست‌های گندمی
            و تیره.
          </p>
        </div>

        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="lightning" size={26} />
          </div>
          <h3 class="candela-feat-title">شات‌های دقیق تک‌تک</h3>
          <p class="candela-feat-desc">
            لیزر شاتی با پرتاب تک‌شات‌های دقیق و کنترل‌شده روی هر ناحیه — مناسب نواحی حساس و موهای
            مقاوم.
          </p>
        </div>

        <div class="candela-feature-card">
          <div class="candela-feat-icon">
            <Icon name="wallet" size={26} />
          </div>
          <h3 class="candela-feat-title">تعرفه‌های دکا و انتخاب دستگاه</h3>
          <p class="candela-feat-desc">
            تعرفه‌های دکا برای بانوان و آقایان در صفحهٔ خدمات آمده است و هنگام رزرو آنلاین می‌توانید
            دستگاه مورد نظر خود را انتخاب کنید.
          </p>
          <p>
            <a href="/services" class="btn-3d-outline-sm">
              <span>مشاهده تعرفه‌های دکا</span>
              <Icon name="chevronLeft" size={14} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Persian is a joined script — the shared sheet's positive tracking on the
     eyebrow opens gaps between joined glyphs. Scoped to this component. */
  .section-subtitle {
    letter-spacing: normal;
  }
</style>
