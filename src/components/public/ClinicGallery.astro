---
import Icon from '../ui/Icon.astro';

// ── Clinic ambience band (Lane L2) ───────────────────────────────────────────
// Imagery-led "visual proof" band: real clinic ambience instead of more prose.
// All photos are decorative ambience — no fabricated device, staff or
// before/after claims (@CONTRACT "Do not fabricate"). CSP is img-src 'self',
// so every source is a self-hosted /images/*.avif with a .webp sibling.
interface AmbienceTile {
  /** Manifest basename under /images (AVIF + WebP + JPEG at 1600w and 800w). */
  src: string;
  alt: string;
  title: string;
  desc: string;
  icon: string;
  wide?: boolean;
}

const tiles: AmbienceTile[] = [
  {
    src: 'spa-treatment-room',
    alt: 'سنگ‌های گرم ماساژ و گل‌های سفید روی ملحفه تمیز؛ نمایی از آرامش فضای درمان',
    title: 'آرامش از لحظه ورود',
    desc: 'فضای درمانی آرام و بی‌استرس، پوشش یکبار مصرف و تهویه مطبوع در هر جلسه.',
    icon: 'clean',
    wide: true,
  },
  {
    src: 'facial-clay-mask',
    alt: 'ماسک صورت رس‌دار سفید روی پوست به‌همراه هدبند بهداشتی',
    title: 'حساسیت به پوست شما',
    desc: 'تنظیم انرژی ژول بر اساس فوتوتایپ، ریسک لک و سوختگی را به حداقل می‌رساند.',
    icon: 'target',
  },
  {
    src: 'spa-massage',
    alt: 'ماساژ پشت و شانه در فضایی آرام با ملحفه تمیز',
    title: 'رفاه و آرامش در انتظار',
    desc: 'فضای انتظار آرام، پذیرایی و هماهنگی دقیق نوبت‌ها بدون معطلی.',
    icon: 'gem',
  },
];
---

<section class="section clinic-gallery-section" aria-labelledby="clinic-gallery-title">
  <div class="container">
    <header class="section-header text-center">
      <span class="section-subtitle">نگاهی به فضای درمان</span>
      <h2 class="section-title" id="clinic-gallery-title">محیطی VIP، آرام و کاملاً بهداشتی در قلب پاسداران</h2>
      <p class="section-desc">
        استانداردهای بهداشتی کلینیک تهران لیزر پیش از هر جلسه اجرا می‌شود؛ از تعویض پوشش تخت تا استریل‌سازی سری
        دستگاه رادو پلاس. تصاویر زیر صرفاً حال‌وهوای آرام و حرفه‌ای این فضا را نشان می‌دهند.
      </p>
    </header>

    <div class="cg-rail">
      {tiles.map((tile) => (
        <figure class={tile.wide ? 'cg-tile cg-tile-wide' : 'cg-tile'}>
          <div class="cg-frame media-frame">
            <picture>
              <!-- The rail shows a tile at 86vw on phones (≈335 CSS px), so the
                   560w/800w rungs cover DPR 1–3 without ever pulling the 1600w
                   file; desktop gets the full ladder because a wide tile is
                   ~40vw. Every rung is generated by `npm run images:optimize`. -->
              <source
                type="image/avif"
                media="(max-width: 900px)"
                srcset={`/images/${tile.src}-560.avif 560w, /images/${tile.src}-800.avif 800w`}
                sizes="86vw"
              />
              <source
                type="image/webp"
                media="(max-width: 900px)"
                srcset={`/images/${tile.src}-560.webp 560w, /images/${tile.src}-800.webp 800w`}
                sizes="86vw"
              />
              <source
                type="image/avif"
                srcset={`/images/${tile.src}-560.avif 560w, /images/${tile.src}-800.avif 800w, /images/${tile.src}.avif 1600w`}
                sizes={tile.wide ? '40vw' : '30vw'}
              />
              <source
                type="image/webp"
                srcset={`/images/${tile.src}-560.webp 560w, /images/${tile.src}-800.webp 800w, /images/${tile.src}.webp 1600w`}
                sizes={tile.wide ? '40vw' : '30vw'}
              />
              <img
                class="cg-img media-cover"
                src={`/images/${tile.src}-800.jpg`}
                srcset={`/images/${tile.src}-560.jpg 560w, /images/${tile.src}-800.jpg 800w, /images/${tile.src}.jpg 1600w`}
                sizes={tile.wide ? '(max-width: 900px) 86vw, 40vw' : '(max-width: 900px) 86vw, 30vw'}
                alt={tile.alt}
                width="1600"
                height="1067"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </picture>
          </div>
          <figcaption class="cg-caption glass-panel">
            <span class="cg-icon" aria-hidden="true">
              <Icon name={tile.icon} size={18} />
            </span>
            <span class="cg-copy">
              <strong class="cg-title">{tile.title}</strong>
              <span class="cg-desc">{tile.desc}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* Self-contained: dark obsidian surfaces, explicit light text only. */
  .clinic-gallery-section {
    background:
      radial-gradient(900px 320px at 20% 0%, rgba(52, 211, 153, 0.07), transparent 60%),
      #0a0b0d;
    border-top: 1px solid rgba(148, 163, 184, 0.12);
  }

  .clinic-gallery-section .section-subtitle {
    color: #6ee7b7;
    /* Persian joined script — the shared sheet's positive tracking on the
       eyebrow opens gaps between joined glyphs. */
    letter-spacing: normal;
  }

  .clinic-gallery-section .section-desc {
    color: #94a3b8;
    margin-inline: auto;
    max-width: 720px;
  }

  .cg-rail {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
    margin-top: 36px;
  }

  .cg-tile {
    position: relative;
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .cg-tile-wide {
    grid-row: span 2;
  }

  .cg-frame {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    /* Fallback ambient surface: if an asset has not shipped yet the frame still
       reads as a dark gradient panel rather than a broken white box. */
    background: linear-gradient(150deg, #14202a 0%, #0d1116 70%);
    border: 1px solid rgba(52, 211, 153, 0.22);
    box-shadow: 0 18px 44px -22px rgba(0, 0, 0, 0.85);
    flex: 1 1 auto;
  }

  .cg-tile .cg-frame {
    aspect-ratio: 4 / 3;
  }

  .cg-tile-wide .cg-frame {
    aspect-ratio: 3 / 4;
  }

  .cg-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cg-caption {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 12px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(16, 19, 27, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.16);
  }

  .cg-icon {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #062018;
    background: linear-gradient(135deg, #34d399 0%, #f5d78e 100%);
  }

  .cg-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cg-title {
    color: #f1f5f9;
    font-size: 1rem;
    font-weight: 800;
  }

  .cg-desc {
    color: #94a3b8;
    font-size: 0.86rem;
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .cg-rail {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .cg-tile-wide {
      grid-row: auto;
    }

    .cg-tile .cg-frame,
    .cg-tile-wide .cg-frame {
      aspect-ratio: 16 / 10;
    }
  }

  /* ── ≤768px: a compact horizontal rail ────────────────────────────────
     The homepage has a hard height budget at 390px, so the band becomes one
     swipeable row (scroll-snap) instead of three stacked photos. Tiles keep
     their caption; nothing is removed from the DOM. */
  @media (max-width: 768px) {
    .clinic-gallery-section {
      padding-top: 34px;
      padding-bottom: 38px;
    }

    .cg-rail {
      display: flex;
      gap: 14px;
      margin-top: 22px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 6px;
      scrollbar-width: thin;
    }

    .cg-tile {
      flex: 0 0 78%;
      scroll-snap-align: center;
    }

    .cg-tile .cg-frame,
    .cg-tile-wide .cg-frame {
      aspect-ratio: 16 / 10;
    }

    .cg-desc {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .cg-tile {
      flex: 0 0 86%;
    }
  }
</style>
