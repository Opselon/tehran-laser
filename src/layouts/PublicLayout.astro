---
import '@fontsource-variable/vazirmatn/index.css';
import '../styles/tokens.css';
import '../styles/utilities.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/public.css';
// v2 design layer — mobile-first, loaded last so it refines public.css.
import '../styles/site-v2.css';
import Icon from '../components/ui/Icon.astro';
import BrandMark from '../components/ui/BrandMark.astro';
import SeoHead from '../components/ui/SeoHead.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import LayoutStyles from '../components/ui/LayoutStyles.astro';
import arabicWoff2 from '@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2?url';
import {
  buildCanonicalUrl,
  resolveCanonicalOrigin,
  createMedicalClinicSchema,
  createWebSiteSchema,
  createWebPageSchema,
  createNavigationItemListSchema,
  createBreadcrumbSchema,
  breadcrumbsForPath,
  isPrivatePath,
  buildOgImageUrl,
  DEFAULT_SEO_TITLE,
  DEFAULT_SEO_DESCRIPTION,
  PRIMARY_KEYWORDS,
  CLINIC_GEO_LOCATION,
  CLINIC_CONTACT,
  PRIMARY_NAV,
  BOTTOM_NAV,
} from '../lib/seo';

interface PreloadAsset {
  href: string;
  as: 'image' | 'font' | 'script' | 'style';
  type?: string;
  media?: string;
  imagesrcset?: string;
  imagesizes?: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  /** Above-the-fold assets to fetch before the parser reaches the markup. */
  preload?: PreloadAsset[];
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string | undefined;
  /** Alt text for the share image. Defaults to the clinic's branded alt. */
  ogImageAlt?: string | undefined;
  keywords?: string[];
  noindex?: boolean;
  nofollow?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  theme?: 'dark' | 'light';
  bodyClass?: string;
  /** Open Graph article extensions; only read when ogType="article". */
  articlePublishedTime?: string | undefined;
  articleModifiedTime?: string | undefined;
  articleAuthor?: string | undefined;
  articleSection?: string | undefined;
}

const {
  title = DEFAULT_SEO_TITLE,
  description = DEFAULT_SEO_DESCRIPTION,
  canonicalUrl,
  preload = [],
  ogType = 'website',
  ogImage,
  ogImageAlt,
  keywords,
  noindex = false,
  nofollow = false,
  jsonLd,
  // The public site is a dark obsidian design throughout. The old 'light'
  // default left pages that forgot to pass theme="dark" rendering near-black
  // text (#16130f --color-ink) on a near-black background — invisible.
  // Dark is now the default; a page can still opt out with theme="light".
  theme = 'dark',
  bodyClass = '',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;

// Live origin for canonical/OG/JSON-LD URLs (SITE_URL env var → live fallback).
// Never hardcoded to the parked tehranlaser.ir vanity domain.
const siteOrigin = resolveCanonicalOrigin();
const currentPath = Astro.url.pathname;

// Dynamic canonical URL: protocol/domain normalization + marketing-param stripping (§133)
const resolvedCanonical = buildCanonicalUrl(Astro.url, canonicalUrl, siteOrigin);

// Social crawlers require absolute image URLs
const absoluteOgImage = buildOgImageUrl(ogImage, siteOrigin);

// Fine-grained noindex / nofollow controls (§133). Admin/API/404/500 are forced
// noindex even if a page forgets, so a stray index/follow can never leak.
const robotsContent = [
  noindex || isPrivatePath(currentPath) ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
].join(', ');

// Keywords: explicit page-level override wins over the clinic's primary set
const resolvedKeywords = keywords && keywords.length > 0 ? keywords : PRIMARY_KEYWORDS;

// MedicalClinic + MedicalBusiness structured data for every public page (§31, §135)
const clinicJsonLd = createMedicalClinicSchema(siteOrigin);

// WebSite entity (sitelinks search box + publisher linkage)
const websiteJsonLd = createWebSiteSchema(siteOrigin);

// WebPage entity for THIS document, connected to the site + clinic graph
const webpageJsonLd = createWebPageSchema({
  origin: siteOrigin,
  url: resolvedCanonical,
  name: title,
  description,
});

// SiteNavigationElement list, generated from the same PRIMARY_NAV the markup
// below renders from — the schema can never advertise a link the page hides.
const navigationJsonLd = createNavigationItemListSchema(PRIMARY_NAV, siteOrigin);

// Fallback BreadcrumbList: pages that declare their own trail pass `jsonLd`,
// which wins. For index pages this derives Home → Section from the pathname.
const pageBreadcrumbs = breadcrumbsForPath(currentPath);
const breadcrumbJsonLd =
  pageBreadcrumbs && pageBreadcrumbs.length > 1
    ? createBreadcrumbSchema(pageBreadcrumbs, siteOrigin)
    : undefined;

const pageJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [...jsonLd]
    : [jsonLd]
  : [];

// Page-declared breadcrumbs always win over the derived fallback.
const hasOwnBreadcrumb = pageJsonLd.some(
  (node) => node && (node as Record<string, unknown>)['@type'] === 'BreadcrumbList',
);
if (breadcrumbJsonLd && !hasOwnBreadcrumb) pageJsonLd.unshift(breadcrumbJsonLd);
if (navigationJsonLd) pageJsonLd.unshift(navigationJsonLd);
pageJsonLd.unshift(webpageJsonLd);

const structuredData = [clinicJsonLd, websiteJsonLd, ...pageJsonLd];

const articleMeta =
  ogType === 'article'
    ? {
        publishedTime: articlePublishedTime,
        modifiedTime: articleModifiedTime,
        author: articleAuthor,
        section: articleSection,
      }
    : undefined;

// Current-nav highlighting: a trailing-slash-safe prefix match so
// /services/full-body still highlights خدمات و تعرفه‌ها.
const isActive = (href: string): 'active' | undefined =>
  href === '/'
    ? currentPath === '/'
      ? 'active'
      : undefined
    : currentPath === href || currentPath.startsWith(`${href}/`)
      ? 'active'
      : undefined;

---

<!doctype html>
<html lang="fa-IR" dir="rtl">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={resolvedCanonical}
      keywords={resolvedKeywords}
      robotsContent={robotsContent}
      ogType={ogType}
      ogImage={absoluteOgImage}
      ogImageAlt={ogImageAlt}
      articleMeta={articleMeta}
      geo={CLINIC_GEO_LOCATION}
      hreflangAlternate={resolvedCanonical}
      structuredData={structuredData}
    />

    <!-- Resource hints for Core Web Vitals (§136). The hero photography is
         self-hosted under CSP img-src 'self', so no third-party origin is
         preconnected — the old unsplash.com hints were dead weight (a DNS
         lookup and a TLS handshake to an origin this page never uses). -->
    <!-- The Arabic subset carries every Persian glyph, so it is the one font
         file on the critical path; preloading it removes the swap-induced
         reflow that measured 0.196 CLS on desktop. -->
    <link rel="preload" href={arabicWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    {
      preload.map((asset) => (
        <link
          rel="preload"
          as={asset.as}
          href={asset.href}
          type={asset.type}
          media={asset.media}
          imagesrcset={asset.imagesrcset}
          imagesizes={asset.imagesizes}
        />
      ))
    }

    <!-- Service worker registration (§47) -->
    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body class:list={[theme === 'dark' ? 'theme-dark-obsidian' : '', bodyClass]}>
    <!-- WCAG 2.4.1 Bypass Blocks — first focusable element -->
    <a href="#main-content" class="skip-link">پرش به محتوای اصلی</a>

    <!-- Top announcement / trust strip. The message is allowed to wrap at
         ≤768px (a previous fix) so the 15% offer is never truncated; the CTA
         stays a single 44px-min tap target underneath it. -->
    <aside class="announcement-strip" aria-label="اطلاعیه تخفیف">
      <div class="container announcement-inner">
        <span class="announcement-text">
          <Icon name="sparkles" size={14} aria-hidden="true" />
          جشنواره پاییزه تهران لیزر: ۱۵٪ تخفیف ویژه پکیج کل بدن در رزرو آنلاین
        </span>
        <a href="/booking" class="announcement-link">
          <span>رزرو با تخفیف</span>
          <Icon name="arrowLeft" size={14} aria-hidden="true" />
        </a>
      </div>
    </aside>

    <!-- Header -->
    <header class="site-header" data-header-scroll>
      <div class="container header-inner">
        <a href="/" class="brand-logo" aria-current={currentPath === '/' ? 'page' : undefined}>
          <span class="logo-mark" aria-hidden="true"><BrandMark size={22} /></span>
          <span class="logo-text">
            <span class="logo-title">تهران لیزر</span>
            <span class="logo-sub">کلینیک تخصصی زیبایی و لیزر</span>
          </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="desktop-nav" aria-label="منوی اصلی">
          {PRIMARY_NAV.map((item) => (
            <a
              href={item.href}
              class:list={['nav-link', isActive(item.href)]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Header Actions -->
        <div class="header-actions">
          <a href={`tel:${CLINIC_CONTACT.telephone}`} class="header-phone" aria-label={`تماس با کلینیک: ${CLINIC_CONTACT.phoneDisplay}`}>
            <span class="icon-phone"><Icon name="phone" size={16} aria-hidden="true" /></span>
            <span class="phone-digits"><bdi dir="ltr">{CLINIC_CONTACT.phoneDisplay}</bdi></span>
          </a>
          <a href="/booking" class="btn btn-primary header-cta">رزرو آنلاین نوبت</a>
          <!-- One-tap call on phones: the header is the only persistent
               surface, so the highest-intent local action lives here. -->
          <a
            href={`tel:${CLINIC_CONTACT.telephone}`}
            class="header-call-icon tap-target"
            aria-label={`تماس با کلینیک: ${CLINIC_CONTACT.phoneDisplay}`}
          >
            <Icon name="phone" size={18} aria-hidden="true" />
          </a>
          <!-- Mobile Menu Trigger. aria-controls pairs the button with the
               drawer so assistive tech announces WHAT expands, not just that
               something did. -->
          <button
            id="mobileMenuBtn"
            class="mobile-menu-btn tap-target"
            type="button"
            aria-label="باز کردن منو"
            aria-expanded="false"
            aria-controls="mobileDrawer"
          >
            <span class="bar" aria-hidden="true"></span>
            <span class="bar" aria-hidden="true"></span>
            <span class="bar" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer. Labelled by the brand mark so a screen
           reader lands here with context instead of a bare "navigation". -->
      <div id="mobileDrawer" class="mobile-drawer" hidden aria-label="منوی موبایل">
        <nav class="mobile-drawer-nav" aria-label="منوی موبایل">
          {PRIMARY_NAV.map((item) => (
            <a
              href={item.href}
              class:list={['drawer-link', isActive(item.href)]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <div class="drawer-actions">
            <a href="/booking" class="btn btn-primary btn-block">رزرو آنلاین نوبت</a>
            <a href={`tel:${CLINIC_CONTACT.telephone}`} class="btn btn-outline btn-block mt-2">
              تماس: <bdi dir="ltr">{CLINIC_CONTACT.phoneDisplay}</bdi>
            </a>
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
        <SiteFooter />

    <!-- Mobile Bottom Navigation (≤768px) — A2. Icons are decorative; the
         label span carries the accessible name. -->
    <nav class="bottom-nav" aria-label="ناوبری پایین">
      <div class="bottom-nav-inner">
        {BOTTOM_NAV.map((item) => (
          <a
            href={item.href}
            class:list={['bottom-nav-link', 'tap-target', isActive(item.href)]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <Icon name={item.icon} size={20} aria-hidden="true" />
            <span class="bottom-nav-label">{item.label}</span>
          </a>
        ))}
      </div>
    </nav>

    <!-- Sticky Mobile CTA (§140, §141) — ONE slim row instead of the old
         two-tier stack (floating cart/install chips above a separate bar,
         which burned 194px = 23% of a 390x844 viewport).
         · تماس is dropped from this row: the bottom nav right below it
           already carries تماس as its 4th tab, so it was a duplicate.
         · سبد and نصب moved IN here as icon-only chips (aria-label keeps
           their accessible names), so the floating tier disappears. -->
    <div class="mobile-sticky-bar">
      <a href="/booking" class="btn btn-primary sticky-book tap-target">
        <span>رزرو آنلاین نوبت</span>
        <span class="promo-tag">۱۵٪ تخفیف</span>
      </a>
      <button
        id="basketFab"
        class="basket-fab tap-target"
        type="button"
        aria-expanded="false"
        aria-controls="basketDrawer"
        aria-label="سبد سفارش"
      >
        <Icon name="shoppingBag" size={20} aria-hidden="true" />
        <span class="basket-fab-label">سبد</span>
        <span id="basketCount" class="basket-count" hidden aria-live="polite">۰</span>
      </button>
      <!-- PWA install control (A3) — revealed only on beforeinstallprompt -->
      <button id="pwaInstallBtn" class="pwa-install tap-target" type="button" aria-label="نصب اپلیکیشن" hidden>
        <Icon name="sparkles" size={18} aria-hidden="true" />
        <span class="pwa-install-label">نصب اپلیکیشن</span>
      </button>
    </div>

    <!-- Basket drawer: labelled dialog with an inert scrim while open. The
         fab's aria-expanded + this dialog's aria-labelledby give AT a
         two-way link; `inert` on the page wrapper (toggled in the script)
         stops background links from being reachable while the drawer is up. -->
    <div
      id="basketDrawer"
      class="basket-drawer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="basketTitle"
      hidden
    >
      <div class="basket-head">
        <strong id="basketTitle" class="basket-title">سبد سفارش</strong>
        <button id="basketClose" class="basket-close tap-target" type="button" aria-label="بستن سبد">
          <Icon name="x" size={18} aria-hidden="true" />
        </button>
      </div>
      <ul id="basketList" class="basket-list"></ul>
      <p id="basketEmpty" class="basket-empty">سبد شما خالی است. از بخش خدمات و تعرفه‌ها می‌توانید خدمت مورد نظر را اضافه کنید.</p>
      <div class="basket-foot">
        <div class="basket-total">
          <span>مجموع</span>
          <strong id="basketTotal">۰ تومان</strong>
        </div>
        <a id="basketCta" href="/booking" class="btn btn-primary btn-block basket-cta tap-target">
          ادامه و رزرو نوبت
        </a>
        <button id="basketClear" class="basket-clear tap-target" type="button">خالی کردن سبد</button>
      </div>
    </div>
    <div id="basketScrim" class="basket-scrim" aria-hidden="true" hidden></div>

    <!-- Client-side navigation toggle script -->
    <script is:inline>
      const btn = document.getElementById('mobileMenuBtn');
      const drawer = document.getElementById('mobileDrawer');

      function setDrawer(open, restoreFocus) {
        if (!btn || !drawer) return;
        const wasOpen = !drawer.hidden && drawer.style.display !== 'none';
        drawer.hidden = !open;
        drawer.style.display = open ? 'block' : 'none';
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'بستن منو' : 'باز کردن منو');
        document.body.classList.toggle('drawer-open', open);
        // Focus management (WCAG 2.4.3): on open move focus into the drawer so a
        // keyboard user is not left behind the trigger; on close return it to the
        // trigger, or the user's focus is destroyed when the drawer unmounts.
        if (open && !wasOpen) {
          const first = drawer.querySelector('a[href], button');
          if (first) first.focus();
        } else if (!open && wasOpen && restoreFocus !== false) {
          btn.focus();
        }
      }

      if (btn && drawer) {
        btn.addEventListener('click', () => {
          const isOpen = !drawer.hidden && drawer.style.display !== 'none';
          setDrawer(!isOpen);
        });

        drawer.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setDrawer(false));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !drawer.hidden) setDrawer(false);
        });

        // Tab trap while the drawer is open. Without this, Tab walks into the
        // page content BEHIND the open drawer — the classic modal focus leak
        // that strands keyboard users on invisible controls.
        drawer.addEventListener('keydown', (e) => {
          if (e.key !== 'Tab') return;
          const focusables = Array.from(drawer.querySelectorAll('a[href], button:not([disabled])'));
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });

        // Reset state when crossing to desktop width. Focus is *not* yanked to
        // the (now hidden) trigger here: the breakpoint change is the user's own
        // resize, and stealing focus mid-resize is worse than leaving it.
        const mq = window.matchMedia('(min-width: 993px)');
        mq.addEventListener('change', (e) => {
          if (e.matches) setDrawer(false, false);
        });
      }
    </script>

    <!-- A3 · PWA install prompt capture -->
    <script is:inline>
      (function () {
        var deferred = null;
        var installBtn = document.getElementById('pwaInstallBtn');
        if (!installBtn) return;

        window.addEventListener('beforeinstallprompt', function (e) {
          e.preventDefault();
          deferred = e;
          installBtn.hidden = false;
        });

        installBtn.addEventListener('click', function () {
          if (!deferred) return;
          deferred.prompt();
          deferred.userChoice.then(function () {
            deferred = null;
            installBtn.hidden = true;
          });
        });

        window.addEventListener('appinstalled', function () {
          deferred = null;
          installBtn.hidden = true;
        });
      })();
    </script>

    <!-- A4 · ORDER BASKET — sessionStorage persistence, RTL drawer -->
    <script is:inline define:vars={{ basketAddEndpoint: '/services' }}>
      (function () {
        var KEY = 'tl_basket_v1';
        var fab = document.getElementById('basketFab');
        var drawer = document.getElementById('basketDrawer');
        var scrim = document.getElementById('basketScrim');
        var closeBtn = document.getElementById('basketClose');
        var list = document.getElementById('basketList');
        var emptyMsg = document.getElementById('basketEmpty');
        var countEl = document.getElementById('basketCount');
        var totalEl = document.getElementById('basketTotal');
        var cta = document.getElementById('basketCta');
        var clearBtn = document.getElementById('basketClear');
        if (!fab || !drawer) return;

        var FA_DIGITS = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
        function toFa(n) { return String(n).replace(/\d/g, function (d) { return FA_DIGITS[+d]; }); }
        function faNum(n) { return toFa(n.toLocaleString('en-US')); }

        function read() {
          try { var raw = sessionStorage.getItem(KEY); return raw ? JSON.parse(raw) : []; }
          catch (e) { return []; }
        }
        function write(items) {
          try { sessionStorage.setItem(KEY, JSON.stringify(items)); } catch (e) {}
        }

        function render() {
          var items = read();
          countEl.textContent = toFa(items.length);
          countEl.hidden = items.length === 0;
          list.innerHTML = '';
          var total = 0;
          items.forEach(function (it) {
            total += Number(it.price) || 0;
            var li = document.createElement('li');
            li.className = 'basket-item';

            var name = document.createElement('span');
            name.className = 'basket-item-name';
            name.textContent = it.name;

            var price = document.createElement('span');
            price.className = 'basket-item-price';
            price.textContent = faNum(it.price) + ' تومان';

            var del = document.createElement('button');
            del.type = 'button';
            del.className = 'basket-item-del';
            del.setAttribute('aria-label', 'حذف ' + it.name + ' از سبد');
            del.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>';
            del.addEventListener('click', function () {
              var all = read().filter(function (x) { return x.id !== it.id; });
              write(all); render();
            });

            li.appendChild(name);
            var mid = document.createElement('span');
            mid.className = 'basket-item-mid';
            mid.appendChild(price);
            li.appendChild(mid);
            li.appendChild(del);
            list.appendChild(li);
          });
          emptyMsg.hidden = items.length > 0;
          totalEl.textContent = faNum(total) + ' تومان';
          cta.setAttribute('aria-disabled', items.length === 0 ? 'true' : 'false');
          fab.classList.toggle('basket-fab--has-items', items.length > 0);
        }

        function setOpen(open) {
          drawer.hidden = !open;
          if (scrim) scrim.hidden = !open;
          fab.setAttribute('aria-expanded', String(open));
          document.body.classList.toggle('basket-open', open);
          if (open && closeBtn) closeBtn.focus();
        }

        // aria-modal="true" promises the rest of the page is inert. Make that
        // literally true so Tab cannot land on a background link behind the
        // drawer, and restore the true page-title tabindex on close.
        function trapTab(e) {
          if (e.key !== 'Tab') return;
          var focusables = Array.prototype.slice.call(
            drawer.querySelectorAll('a[href], button:not([disabled])'),
          );
          if (!focusables.length) return;
          var first = focusables[0];
          var last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }

        fab.addEventListener('click', function () { setOpen(drawer.hidden); });
        if (closeBtn) closeBtn.addEventListener('click', function () { setOpen(false); fab.focus(); });
        if (scrim) scrim.addEventListener('click', function () { setOpen(false); fab.focus(); });
        if (clearBtn) clearBtn.addEventListener('click', function () { write([]); render(); });
        drawer.addEventListener('keydown', trapTab);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !drawer.hidden) { setOpen(false); fab.focus(); }
        });
        document.addEventListener('visibilitychange', function () {
          if (document.hidden && !drawer.hidden) setOpen(false);
        });

        // Any page may add a service: dispatch `tl:basket-add` { id, name, price }
        window.addEventListener('tl:basket-add', function (e) {
          var d = e.detail || {};
          if (!d.id || !d.name) return;
          var items = read();
          if (items.some(function (x) { return x.id === d.id; })) return;
          items.push({ id: d.id, name: d.name, price: Number(d.price) || 0 });
          write(items); render();
          setOpen(true);
        });

        render();
      })();
    </script>

    <!-- Chrome scroll state: the header gains a solid backdrop once the page
         moves, and the booking bar only docks after the hero's own CTA has
         scrolled away (so the first screen is never double-CTA'd). rAF-throttled,
         passive, and a no-op when a user prefers reduced motion. -->
    <script is:inline>
      (function () {
        var header = document.querySelector('[data-header-scroll]');
        var hero = document.querySelector('.hero-section');
        var body = document.body;
        var dockAt = hero ? Math.round(hero.offsetHeight * 0.72) : 420;
        var ticking = false;
        var lastDocked = null;

        function apply() {
          ticking = false;
          var y = window.scrollY || window.pageYOffset || 0;
          if (header) header.classList.toggle('is-scrolled', y > 8);
          var docked = y > dockAt;
          if (docked !== lastDocked) {
            body.classList.toggle('chrome-docked', docked);
            lastDocked = docked;
          }
        }

        function onScroll() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(apply);
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', function () {
          dockAt = hero ? Math.round(hero.offsetHeight * 0.72) : 420;
          onScroll();
        }, { passive: true });
        apply();
      })();
    </script>

    <LayoutStyles />
  </body>
</html>
