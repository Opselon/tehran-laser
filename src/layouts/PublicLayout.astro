---
import '@fontsource-variable/vazirmatn/index.css';
import '../styles/tokens.css';
import '../styles/utilities.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/public.css';
import Icon from '../components/ui/Icon.astro';
import {
  buildCanonicalUrl,
  resolveCanonicalOrigin,
  createMedicalClinicSchema,
  DEFAULT_SEO_TITLE,
  DEFAULT_SEO_DESCRIPTION,
  PRIMARY_KEYWORDS,
  CLINIC_GEO_LOCATION,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string | undefined;
  keywords?: string[];
  noindex?: boolean;
  nofollow?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  theme?: 'dark' | 'light';
  bodyClass?: string;
}

const {
  title = DEFAULT_SEO_TITLE,
  description = DEFAULT_SEO_DESCRIPTION,
  canonicalUrl,
  ogType = 'website',
  ogImage = '/images/og-share.jpg',
  keywords,
  noindex = false,
  nofollow = false,
  jsonLd,
  // The public site is a dark obsidian design throughout. The old 'light'
  // default left pages that forgot to pass theme="dark" rendering near-black
  // text (#16130f --color-ink) on a near-black background — invisible.
  // Dark is now the default; a page can still opt out with theme="light".
  theme = 'dark',
  bodyClass = '',
} = Astro.props;

// Live origin for canonical/OG/JSON-LD URLs (SITE_URL env var → live fallback).
// Never hardcoded to the parked tehranlaser.ir vanity domain.
const siteOrigin = resolveCanonicalOrigin();
const currentPath = Astro.url.pathname;

// Dynamic canonical URL: protocol/domain normalization + marketing-param stripping (§133)
const resolvedCanonical = buildCanonicalUrl(Astro.url, canonicalUrl, siteOrigin);

// Social crawlers require absolute image URLs
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteOrigin}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`;

// Fine-grained noindex / nofollow controls (§133)
const robotsContent = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow'].join(', ');

// Keywords: explicit page-level override wins over the clinic's primary set
const resolvedKeywords = keywords && keywords.length > 0 ? keywords : PRIMARY_KEYWORDS;

// MedicalClinic + MedicalBusiness structured data for every public page (§31, §135)
const clinicJsonLd = createMedicalClinicSchema(siteOrigin);

// WebSite entity (sitelinks search box + publisher linkage)
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  url: siteOrigin,
  name: 'کلینیک تخصصی تهران لیزر',
  alternateName: 'Tehran Laser Clinic',
  description: DEFAULT_SEO_DESCRIPTION,
  inLanguage: 'fa-IR',
  publisher: { '@id': `${siteOrigin}/#clinic` },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteOrigin}/services?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const structuredData = jsonLd
  ? Array.isArray(jsonLd)
    ? [clinicJsonLd, websiteJsonLd, ...jsonLd]
    : [clinicJsonLd, websiteJsonLd, jsonLd]
  : [clinicJsonLd, websiteJsonLd];
---

<!doctype html>
<html lang="fa-IR" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={resolvedKeywords.join('، ')} />
    <meta name="author" content="کلینیک تخصصی تهران لیزر" />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Geo-targeting for local Pasdaran / Tehran SEO (§133) -->
    <meta name="geo.region" content={CLINIC_GEO_LOCATION.region} />
    <meta name="geo.placename" content={CLINIC_GEO_LOCATION.placename} />
    <meta name="geo.position" content={CLINIC_GEO_LOCATION.position} />
    <meta name="ICBM" content={CLINIC_GEO_LOCATION.icbm} />

    <!-- Open Graph / Facebook (§134) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="کلینیک تخصصی تهران لیزر — مرکز لیزر موهای زائد پاسداران" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="تهران لیزر" />

    <!-- Twitter Card (§134) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="کلینیک تخصصی تهران لیزر — مرکز لیزر موهای زائد پاسداران" />

    <!-- PWA metadata -->
    <meta name="theme-color" content="#0f766e" />
    <meta name="application-name" content="کلینیک تهران لیزر" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <!-- Modern counterpart: Chrome logs the Apple-prefixed tag as deprecated
         unless this one is present. Harmless to ship both. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="تهران لیزر" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Sitemap & hreflang discovery -->
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="alternate" hreflang="fa-IR" href={resolvedCanonical} />
    <link rel="alternate" hreflang="x-default" href={resolvedCanonical} />

    <!-- Resource hints for Core Web Vitals (§136) -->
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    <!-- JSON-LD Structured Data (§31, §135) -->
    <!-- set:html with a JSON.stringify payload must escape `<` or an admin
         setting containing `</script>` breaks out of this block and injects
         markup (stored XSS via e.g. business_name). Escape the delimiter and
         the solidus that closes the tag. -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026')}
    />

    <!-- Service worker registration (§47) -->
    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body class:list={[theme === 'dark' ? 'theme-dark-obsidian' : '', bodyClass]}>
    <!-- WCAG 2.4.1 Bypass Blocks — first focusable element -->
    <a href="#main-content" class="skip-link">پرش به محتوای اصلی</a>

    <!-- Top announcement / trust strip -->
    <div class="announcement-strip">
      <div class="container announcement-inner">
        <span><Icon name="sparkles" size={14} aria-hidden /> جشنواره پاییزه تهران لیزر: ۱۵٪ تخفیف ویژه پکیج کل بدن در رزرو آنلاین</span>
        <a href="/booking" class="announcement-link">رزرو با تخفیف</a>
      </div>
    </div>

    <!-- Header -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-logo" aria-label="صفحه اصلی تهران لیزر">
          <span class="logo-mark">TL</span>
          <div class="logo-text">
            <span class="logo-title">تهران لیزر</span>
            <span class="logo-sub">کلینیک تخصصی زیبایی و لیزر</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="desktop-nav" aria-label="منوی اصلی">
          <a href="/" class={currentPath === '/' ? 'nav-link active' : 'nav-link'}>صفحه اصلی</a>
          <a href="/services" class={currentPath.startsWith('/services') ? 'nav-link active' : 'nav-link'}>خدمات و تعرفه‌ها</a>
          <a href="/clinic" class={currentPath === '/clinic' ? 'nav-link active' : 'nav-link'}>درباره کلینیک</a>
          <a href="/faq" class={currentPath === '/faq' ? 'nav-link active' : 'nav-link'}>سوالات متداول</a>
          <a href="/blog" class={currentPath.startsWith('/blog') ? 'nav-link active' : 'nav-link'}>مجله تخصصی</a>
          <a href="/contact" class={currentPath === '/contact' ? 'nav-link active' : 'nav-link'}>تماس و آدرس</a>
        </nav>

        <!-- Header Actions -->
        <div class="header-actions">
          <a href="tel:+989035555090" class="btn btn-ghost header-phone" aria-label="تماس با کلینیک">
            <span class="icon-phone"><Icon name="phone" size={16} aria-hidden /></span>
            <span class="phone-digits">۰۹۰۳ ۵۵۵ ۵۰۹۰</span>
          </a>
          <a href="/booking" class="btn btn-primary header-cta">رزرو آنلاین نوبت</a>
          <!-- Mobile Menu Trigger -->
          <button id="mobileMenuBtn" class="mobile-menu-btn" aria-label="باز کردن منو" aria-expanded="false">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobileDrawer" class="mobile-drawer" hidden>
        <nav class="mobile-drawer-nav">
          <a href="/" class="drawer-link">صفحه اصلی</a>
          <a href="/services" class="drawer-link">خدمات و تعرفه‌ها</a>
          <a href="/clinic" class="drawer-link">درباره کلینیک</a>
          <a href="/faq" class="drawer-link">سوالات متداول</a>
          <a href="/blog" class="drawer-link">مجله تخصصی</a>
          <a href="/contact" class="drawer-link">تماس و آدرس</a>
          <div class="drawer-actions">
            <a href="/booking" class="btn btn-primary btn-block">رزرو آنلاین نوبت</a>
            <a href="tel:+989035555090" class="btn btn-outline btn-block mt-2">تماس: ۰۹۰۳ ۵۵۵ ۵۰۹۰</a>
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container footer-content">
        <div class="footer-col brand-col">
          <div class="brand-logo mb-3">
            <span class="logo-mark">TL</span>
            <div class="logo-text">
              <span class="logo-title">تهران لیزر</span>
              <span class="logo-sub">مرکز تخصصی لیزر پاسداران</span>
            </div>
          </div>
          <p class="footer-desc">
            تهران لیزر با بهره‌گیری از پیشرفته‌ترین تکنولوژی‌های روز دنیا و رعایت بالاترین استانداردهای بهداشتی، محیطی لوکس و آرام برای تجربه بهترین نتایج لیزر موهای زائد فراهم آورده است.
          </p>
          <div class="clinic-direct-contact mt-3">
            <p><strong>آدرس:</strong> پاسداران، خیابان پایدارفرد، نبش بوستان هفتم</p>
            <p><strong>شماره تماس:</strong> <a href="tel:+989035555090" dir="ltr">+98 903 555 5090</a></p>
          </div>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">دسترسی سریع</h2>
          <ul class="footer-links">
            <li><a href="/services">تعرفه لیزر بانوان و آقایان</a></li>
            <li><a href="/booking">سامانه رزرو آنلاین</a></li>
            <li><a href="/clinic">معرفی کلینیک و دستگاه‌ها</a></li>
            <li><a href="/faq">سوالات متداول مراجعین</a></li>
            <li><a href="/blog">مقالات و راهنمای مراقبت</a></li>
            <li><a href="/contact">راه‌های ارتباطی و نقشه</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">خدمات پرطرفدار بانوان</h2>
          <ul class="footer-links">
            <li><a href="/services/full-body">لیزر کل بدن (پکیج تخفیف‌دار)</a></li>
            <li><a href="/services/underarm">لیزر زیر بغل</a></li>
            <li><a href="/services/bikini">لیزر بیکینی</a></li>
            <li><a href="/services/full-legs">لیزر فول بادی پا</a></li>
            <li><a href="/services/full-arms">لیزر دست کامل</a></li>
            <li><a href="/services/face">لیزر کامل صورت</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">ساعات کاری و پذیرش</h2>
          <p class="footer-hours">
            شنبه تا چهارشنبه: ۰۹:۰۰ الی ۲۰:۰۰<br />
            پنجشنبه‌ها: ۰۹:۰۰ الی ۱۸:۰۰<br />
            جمعه‌ها: تعطیل
          </p>
          <div class="footer-cta-box mt-3">
            <p class="small text-muted mb-2">پذیرش فقط با هماهنگی و رزرو قبلی</p>
            <a href="/booking" class="btn btn-primary btn-sm btn-block">رزرو اینترنتی نوبت</a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="container footer-bottom-inner">
          <p class="copyright">
            © {new Date().getFullYear()} کلینیک تخصصی تهران لیزر. تمامی حقوق محفوظ است.
          </p>
          <div class="legal-links">
            <a href="/privacy">حریم خصوصی</a>
            <span class="sep">•</span>
            <a href="/terms">قوانین و مقررات</a>
            <span class="sep">•</span>
            <a href="/admin/login" class="admin-entry-link">ورود پرسنل</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Bottom Navigation (≤768px) — A2 -->
    <nav class="bottom-nav" aria-label="ناوبری پایین">
      <div class="bottom-nav-inner">
        <a href="/" class={currentPath === '/' ? 'bottom-nav-link active' : 'bottom-nav-link'}>
          <Icon name="dashboard" size={20} aria-hidden />
          <span class="bottom-nav-label">خانه</span>
        </a>
        <a href="/services" class={currentPath.startsWith('/services') ? 'bottom-nav-link active' : 'bottom-nav-link'}>
          <Icon name="services" size={20} aria-hidden />
          <span class="bottom-nav-label">خدمات</span>
        </a>
        <a href="/booking" class={currentPath.startsWith('/booking') ? 'bottom-nav-link active' : 'bottom-nav-link'}>
          <Icon name="calendar" size={20} aria-hidden />
          <span class="bottom-nav-label">رزرو</span>
        </a>
        <a href="/contact" class={currentPath.startsWith('/contact') ? 'bottom-nav-link active' : 'bottom-nav-link'}>
          <Icon name="phone" size={20} aria-hidden />
          <span class="bottom-nav-label">تماس</span>
        </a>
      </div>
    </nav>

    <!-- Sticky Mobile CTA (§140, §141) -->
    <div class="mobile-sticky-bar">
      <a href="tel:+989035555090" class="btn btn-outline sticky-phone" aria-label="تماس تلفنی">
        <span><Icon name="phone" size={16} aria-hidden /> تماس</span>
      </a>
      <a href="/booking" class="btn btn-primary sticky-book">
        <span>رزرو آنلاین نوبت</span>
        <span class="promo-tag">۱۵٪ تخفیف</span>
      </a>
    </div>

    <!-- A4 · ORDER BASKET (سبد سفارش) — FAB + drawer, sessionStorage-persisted -->
    <button id="basketFab" class="basket-fab" type="button" aria-expanded="false" aria-controls="basketDrawer" aria-label="سبد سفارش">
      <Icon name="shoppingBag" size={20} aria-hidden />
      <span class="basket-fab-label">سبد</span>
      <span id="basketCount" class="basket-count" hidden>0</span>
    </button>

    <div id="basketDrawer" class="basket-drawer" role="dialog" aria-modal="true" aria-label="سبد سفارش خدمات" hidden>
      <div class="basket-head">
        <strong class="basket-title">سبد سفارش</strong>
        <button id="basketClose" class="basket-close" type="button" aria-label="بستن سبد">
          <Icon name="x" size={18} aria-hidden />
        </button>
      </div>
      <ul id="basketList" class="basket-list"></ul>
      <p id="basketEmpty" class="basket-empty">سبد شما خالی است. از بخش خدمات و تعرفه‌ها می‌توانید خدمت مورد نظر را اضافه کنید.</p>
      <div class="basket-foot">
        <div class="basket-total">
          <span>مجموع</span>
          <strong id="basketTotal">۰ تومان</strong>
        </div>
        <a id="basketCta" href="/booking" class="btn btn-primary btn-block basket-cta">
          ادامه و رزرو نوبت
        </a>
        <button id="basketClear" class="basket-clear" type="button">خالی کردن سبد</button>
      </div>
    </div>
    <div id="basketScrim" class="basket-scrim" hidden></div>

    <!-- PWA install control (A3) — revealed only on beforeinstallprompt -->
    <button id="pwaInstallBtn" class="pwa-install" type="button" hidden>
      <Icon name="sparkles" size={16} aria-hidden />
      <span>نصب اپلیکیشن</span>
    </button>

    <!-- Client-side navigation toggle script -->
    <script is:inline>
      const btn = document.getElementById('mobileMenuBtn');
      const drawer = document.getElementById('mobileDrawer');

      function setDrawer(open) {
        if (!btn || !drawer) return;
        drawer.hidden = !open;
        drawer.style.display = open ? 'block' : 'none';
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'بستن منو' : 'باز کردن منو');
        document.body.classList.toggle('drawer-open', open);
      }

      if (btn && drawer) {
        btn.addEventListener('click', () => {
          const isOpen = !drawer.hidden && drawer.style.display !== 'none';
          setDrawer(!isOpen);
        });

        drawer.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setDrawer(false));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setDrawer(false);
        });

        // Reset state when crossing to desktop width
        const mq = window.matchMedia('(min-width: 993px)');
        mq.addEventListener('change', (e) => {
          if (e.matches) setDrawer(false);
        });
      }
    </script>

    <!-- A3 · PWA install prompt capture -->
    <script is:inline>
      (function () {
        var deferred = null;
        var installBtn = document.getElementById('pwaInstallBtn');
        if (!installBtn) return;

        window.addEventListener('beforeinstallprompt', function (e) {
          e.preventDefault();
          deferred = e;
          installBtn.hidden = false;
        });

        installBtn.addEventListener('click', function () {
          if (!deferred) return;
          deferred.prompt();
          deferred.userChoice.then(function () {
            deferred = null;
            installBtn.hidden = true;
          });
        });

        window.addEventListener('appinstalled', function () {
          deferred = null;
          installBtn.hidden = true;
        });
      })();
    </script>

    <!-- A4 · ORDER BASKET — sessionStorage persistence, RTL drawer -->
    <script is:inline define:vars={{ basketAddEndpoint: '/services' }}>
      (function () {
        var KEY = 'tl_basket_v1';
        var fab = document.getElementById('basketFab');
        var drawer = document.getElementById('basketDrawer');
        var scrim = document.getElementById('basketScrim');
        var closeBtn = document.getElementById('basketClose');
        var list = document.getElementById('basketList');
        var emptyMsg = document.getElementById('basketEmpty');
        var countEl = document.getElementById('basketCount');
        var totalEl = document.getElementById('basketTotal');
        var cta = document.getElementById('basketCta');
        var clearBtn = document.getElementById('basketClear');
        if (!fab || !drawer) return;

        var FA_DIGITS = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
        function toFa(n) { return String(n).replace(/\d/g, function (d) { return FA_DIGITS[+d]; }); }
        function faNum(n) { return toFa(n.toLocaleString('en-US')); }

        function read() {
          try { var raw = sessionStorage.getItem(KEY); return raw ? JSON.parse(raw) : []; }
          catch (e) { return []; }
        }
        function write(items) {
          try { sessionStorage.setItem(KEY, JSON.stringify(items)); } catch (e) {}
        }

        function render() {
          var items = read();
          countEl.textContent = toFa(items.length);
          countEl.hidden = items.length === 0;
          list.innerHTML = '';
          var total = 0;
          items.forEach(function (it) {
            total += Number(it.price) || 0;
            var li = document.createElement('li');
            li.className = 'basket-item';

            var name = document.createElement('span');
            name.className = 'basket-item-name';
            name.textContent = it.name;

            var price = document.createElement('span');
            price.className = 'basket-item-price';
            price.textContent = faNum(it.price) + ' تومان';

            var del = document.createElement('button');
            del.type = 'button';
            del.className = 'basket-item-del';
            del.setAttribute('aria-label', 'حذف ' + it.name + ' از سبد');
            del.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>';
            del.addEventListener('click', function () {
              var all = read().filter(function (x) { return x.id !== it.id; });
              write(all); render();
            });

            li.appendChild(name);
            var mid = document.createElement('span');
            mid.className = 'basket-item-mid';
            mid.appendChild(price);
            li.appendChild(mid);
            li.appendChild(del);
            list.appendChild(li);
          });
          emptyMsg.hidden = items.length > 0;
          totalEl.textContent = faNum(total) + ' تومان';
          cta.setAttribute('aria-disabled', items.length === 0 ? 'true' : 'false');
          fab.classList.toggle('basket-fab--has-items', items.length > 0);
        }

        function setOpen(open) {
          drawer.hidden = !open;
          scrim.hidden = !open;
          fab.setAttribute('aria-expanded', String(open));
          document.body.classList.toggle('basket-open', open);
          if (open && closeBtn) closeBtn.focus();
        }

        fab.addEventListener('click', function () { setOpen(drawer.hidden); });
        if (closeBtn) closeBtn.addEventListener('click', function () { setOpen(false); fab.focus(); });
        if (scrim) scrim.addEventListener('click', function () { setOpen(false); });
        if (clearBtn) clearBtn.addEventListener('click', function () { write([]); render(); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !drawer.hidden) { setOpen(false); fab.focus(); }
        });
        document.addEventListener('visibilitychange', function () {
          if (document.hidden && !drawer.hidden) setOpen(false);
        });

        // Any page may add a service: dispatch `tl:basket-add` { id, name, price }
        window.addEventListener('tl:basket-add', function (e) {
          var d = e.detail || {};
          if (!d.id || !d.name) return;
          var items = read();
          if (items.some(function (x) { return x.id === d.id; })) return;
          items.push({ id: d.id, name: d.name, price: Number(d.price) || 0 });
          write(items); render();
          setOpen(true);
        });

        render();
      })();
    </script>

    <style is:global>
      /* A2 · Bottom nav must never force horizontal scroll */
      .bottom-nav,
      .bottom-nav-inner {
        max-width: 100%;
        box-sizing: border-box;
      }

      /* WCAG 2.4.1 Bypass Blocks (RTL-safe) */
      .skip-link {
        position: fixed;
        inset-block-start: 8px;
        inset-inline-start: 8px;
        inset-inline-end: auto;
        z-index: 200;
        transform: translateY(-220%);
        padding: 12px 22px;
        background: var(--color-ink-bg, #16130f);
        color: var(--color-on-ink, #f7f3ec);
        border: 1.5px solid var(--gold-500, #10b981);
        border-radius: var(--radius-md, 14px);
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        box-shadow: var(--elevation-3d-3, 0 18px 45px rgba(0, 0, 0, 0.65));
        transition: transform var(--motion-fast, 180ms) var(--ease-out, ease);
      }

      .skip-link:focus,
      .skip-link:focus-visible {
        transform: translateY(0);
        outline: 2px solid var(--gold-400, #34d399);
        outline-offset: 2px;
      }

      /* A3 · Install control — obsidian/gold, ≥44px tap target */
      .pwa-install {
        position: fixed;
        inset-block-end: calc(78px + env(safe-area-inset-bottom, 0px));
        inset-inline-end: 14px;
        z-index: 94;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        padding: 11px 18px;
        background: var(--color-ink-bg-soft, #211d18);
        color: var(--gold-400, #34d399);
        border: 1px solid rgba(52, 211, 153, 0.5);
        border-radius: 999px;
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
      }

      .pwa-install[hidden] { display: none !important; }
      .pwa-install:hover { border-color: var(--gold-400, #6ee7b7); }

      @media (min-width: 769px) {
        .pwa-install { inset-block-end: 20px; }
      }

      @media (max-width: 768px) {
        /* The sticky CTA occupies bottom 64px → ~132px. The install control was
           left at bottom:78px, i.e. INSIDE that band, where .basket-fab
           (z-index 95 vs 94) sat directly on top of it — elementFromPoint at
           this button's centre returned .basket-fab, so it was unclickable.
           Lift it clear and mirror it to the leading edge so the two floats
           never share an anchor point. */
        .pwa-install {
          inset-block-end: calc(144px + env(safe-area-inset-bottom, 0px));
          inset-inline-end: auto;
          inset-inline-start: 14px;
        }
      }
    </style>
  </body>
</html>
