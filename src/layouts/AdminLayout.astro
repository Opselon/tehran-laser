---
import '@fontsource-variable/vazirmatn/index.css';
import '../styles/tokens.css';
import '../styles/admin/admin.css';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'سامانه مدیریت تهران لیزر', activeNav = 'dashboard' } = Astro.props;
const auth = Astro.locals.auth;

// Contract §326: unauthenticated requests must be redirected immediately
if (!auth) {
  return Astro.redirect('/admin/login');
}

const navItems = [
  { id: 'dashboard', label: 'داشبورد و امروز', href: '/admin', icon: '📊' },
  { id: 'walkin', label: 'پذیرش فوری و جلسه بعد', href: '/admin/walkin', icon: '⚡' },
  { id: 'bookings', label: 'مدیریت نوبت‌ها', href: '/admin/bookings', icon: '📋' },
  { id: 'calendar', label: 'تقویم نوبت‌ها', href: '/admin/calendar', icon: '📅' },
  { id: 'crm', label: 'پرونده بالینی و CRM', href: '/admin/crm', icon: '🩺' },
  { id: 'customers', label: 'بانک مراجعین', href: '/admin/customers', icon: '👥' },
  { id: 'accounting', label: 'حسابداری و نمودارها', href: '/admin/accounting', icon: '💰' },
  { id: 'sms', label: 'پنل پیامک و اطلاع‌رسانی', href: '/admin/sms', icon: '✉️' },
  { id: 'lottery', label: 'قرعه‌کشی و گردونه شانس', href: '/admin/lottery', icon: '🎰' },
  { id: 'festivals', label: 'جشنواره‌ها و تایم‌لاین', href: '/admin/festivals', icon: '🎪' },
  { id: 'instagram', label: 'تنظیمات اینستاگرام', href: '/admin/instagram', icon: '📸' },
  { id: 'services', label: 'خدمات و تعرفه‌ها', href: '/admin/services', icon: '💎' },
  { id: 'schedule', label: 'ساعات کاری و زمان‌بندی', href: '/admin/schedule', icon: '⏱' },
  { id: 'blog', label: 'مقالات و محتوا', href: '/admin/blog', icon: '✍️' },
  { id: 'settings', label: 'تنظیمات کلینیک', href: '/admin/settings', icon: '⚙️' },
  { id: 'audit', label: 'گزارش وقایع و لاگ', href: '/admin/audit', icon: '📜' },
];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | پنل مدیریت تهران لیزر</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <!-- 3D High-Tech Topbar -->
      <header class="admin-topbar">
        <div class="admin-topbar__brand">
          <a href="/admin" class="brand-link">
            <div class="brand-emblem-mini">💎</div>
            <div class="brand-text-col">
              <strong class="brand-name">تهران لیزر</strong>
              <span class="brand-sub">سامانه فرماندهی عملیات</span>
            </div>
          </a>
        </div>

        <div class="admin-topbar__center">
          <div class="hud-telemetry-badge">
            <span class="hud-pulse-dot"></span>
            <span>سرور لایو • اتصال D1 پایدار</span>
          </div>

          <div class="hud-clock-widget" id="liveClockWidget">
            <span id="liveClockTime">⏱ --:--:--</span>
          </div>
        </div>

        <div class="admin-topbar__actions">
          <div class="user-profile-badge">
            <div class="user-avatar-circle">
              {(auth.displayName || 'ادمین').slice(0, 1)}
            </div>
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <span class="user-name">{auth.displayName || auth.email}</span>
              <span class="badge-role-gold">SUPER ADMIN</span>
            </div>
          </div>

          <button type="button" class="btn-3d-logout" id="adminLogoutBtn" title="خروج از سامانه">
            <span>خروج</span>
            <span>⎋</span>
          </button>
        </div>
      </header>

      <!-- 3D Obsidian Sidebar -->
      <aside class="admin-sidebar">
        <nav class="admin-sidebar__nav">
          <ul class="admin-nav-list">
            {navItems.map((item) => (
              <li class="admin-nav-item">
                <a
                  href={item.href}
                  class={`admin-nav-link ${activeNav === item.id ? 'active' : ''}`}
                >
                  <span class="nav-icon">{item.icon}</span>
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="admin-sidebar__footer">
          <a href="/" target="_blank" class="view-website-link">
            <span>🌐 مشاهده وب‌سایت اصلی ↗</span>
          </a>
          <div class="version-tag">نسخه ۳.۲.۰ — Cloudflare Edge Native</div>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="admin-main">
        <slot />
      </main>
    </div>

    <!-- Script for Clock & Logout -->
    <script>
      // Live Tehran Time Clock
      function updateLiveClock() {
        const clockEl = document.getElementById('liveClockTime');
        if (!clockEl) return;
        try {
          const now = new Date();
          const timeStr = now.toLocaleTimeString('fa-IR', {
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            timeZone: 'Asia/Tehran',
          });
          clockEl.innerText = `⏱ ${timeStr}`;
        } catch {
          // fallback
        }
      }
      setInterval(updateLiveClock, 1000);
      updateLiveClock();

      // Logout handler
      const logoutBtn = document.getElementById('adminLogoutBtn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          try {
            await fetch('/api/v1/auth/logout', { method: 'POST' });
            window.location.href = '/admin/login';
          } catch {
            window.location.href = '/admin/login';
          }
        });
      }
    </script>
  </body>
</html>