---
import '@fontsource-variable/vazirmatn/index.css';
import '../styles/tokens.css';
import '../styles/utilities.css';
import '../styles/admin/admin.css';
import '../styles/admin/components-3d.css';
import '../styles/admin/responsive.css';
// Premium layer — loaded LAST, refines the three sheets above (nav groups,
// switch/hub styles, focus rings). Append new shared admin rules there.
import '../styles/admin/premium.css';
// Team/Operators module shell — owns its own design tokens under .ops-shell.
import '../styles/admin/operators.css';
import Icon from '../components/ui/Icon.astro';
import { hasPermission } from '../domain/rbac/rbac.types';
import type { Permission } from '../domain/rbac/rbac.types';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'سامانه مدیریت تهران لیزر', activeNav = 'dashboard' } = Astro.props;
const auth = Astro.locals.auth || {
  id: 'usr_admin_live',
  email: 'admin@tehranlaser.ir',
  displayName: 'مدیر ارشد کلینیک',
  role: 'SUPER_ADMIN',
  permissions: ['booking.read', 'settings.read', 'customer.read', 'audit.read'],
};

interface NavItem {
  id: string;
  label: string;
  href: string;
  icon: string;
  group: string;
  /** When set, the link only renders for sessions holding this permission. */
  permission?: Permission | undefined;
}

const navItems: NavItem[] = [
  { id: 'dashboard', label: 'داشبورد و امروز', href: '/admin', icon: 'dashboard', group: 'فرماندهی' },
  { id: 'plugins', label: 'افزونه‌ها و بخش‌های سایت', href: '/admin/plugins', icon: 'puzzle', group: 'فرماندهی' },
  { id: 'walkin', label: 'پذیرش فوری و جلسه بعد', href: '/admin/walkin', icon: 'walkin', group: 'عملیات' },
  { id: 'bookings', label: 'مدیریت نوبت‌ها', href: '/admin/bookings', icon: 'bookings', group: 'عملیات' },
  { id: 'operators', label: 'تیم و اپراتورها', href: '/admin/operators', icon: 'users', group: 'عملیات', permission: 'operator.read' },
  { id: 'calendar', label: 'تقویم نوبت‌ها', href: '/admin/calendar', icon: 'calendar', group: 'عملیات' },
  { id: 'crm', label: 'پرونده بالینی و CRM', href: '/admin/crm', icon: 'crm', group: 'عملیات' },
  { id: 'customers', label: 'بانک مراجعین', href: '/admin/customers', icon: 'customers', group: 'عملیات' },
  { id: 'accounting', label: 'حسابداری و نمودارها', href: '/admin/accounting', icon: 'accounting', group: 'عملیات' },
  { id: 'sms', label: 'پنل پیامک و اطلاع‌رسانی', href: '/admin/sms', icon: 'sms', group: 'رشد و بازاریابی' },
  { id: 'lottery', label: 'قرعه‌کشی و گردونه شانس', href: '/admin/lottery', icon: 'lottery', group: 'رشد و بازاریابی' },
  { id: 'festivals', label: 'جشنواره‌ها و تایم‌لاین', href: '/admin/festivals', icon: 'festivals', group: 'رشد و بازاریابی' },
  { id: 'instagram', label: 'تنظیمات اینستاگرام', href: '/admin/instagram', icon: 'instagram', group: 'رشد و بازاریابی' },
  { id: 'services', label: 'خدمات و تعرفه‌ها', href: '/admin/services', icon: 'services', group: 'محتوا و تنظیمات' },
  { id: 'schedule', label: 'ساعات کاری و زمان‌بندی', href: '/admin/schedule', icon: 'schedule', group: 'محتوا و تنظیمات' },
  { id: 'blog', label: 'مقالات و محتوا', href: '/admin/blog', icon: 'blog', group: 'محتوا و تنظیمات' },
  { id: 'settings', label: 'تنظیمات کلینیک', href: '/admin/settings', icon: 'settings', group: 'محتوا و تنظیمات' },
  { id: 'audit', label: 'گزارش وقایع و لاگ', href: '/admin/audit', icon: 'audit', group: 'محتوا و تنظیمات' },
];

/* Sidebar renders one quiet group heading when the group changes, so 17 links
   read as four short clusters instead of one wall (see admin/premium.css). */
const visibleNav = navItems.filter((item) => !item.permission || hasPermission(auth, item.permission));
const navGroups = visibleNav.reduce<Array<{ group: string; items: typeof navItems }>>((acc, item) => {
  const last = acc[acc.length - 1];
  if (last && last.group === item.group) last.items.push(item);
  else acc.push({ group: item.group, items: [item] });
  return acc;
}, []);
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | پنل مدیریت تهران لیزر</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <!-- 3D High-Tech Topbar -->
      <header class="admin-topbar">
        <div class="admin-topbar__brand">
          <button
            type="button"
            class="admin-menu-btn"
            id="adminMenuBtn"
            aria-label="باز کردن منو"
            aria-expanded="false"
            aria-controls="adminSidebar"
          >
            <span class="bar"></span><span class="bar"></span><span class="bar"></span>
          </button>
          <a href="/admin" class="brand-link">
            <div class="brand-emblem-mini"><Icon name="gem" size={20} aria-hidden /></div>
            <div class="brand-text-col">
              <strong class="brand-name">تهران لیزر</strong>
              <span class="brand-sub">سامانه فرماندهی عملیات</span>
            </div>
          </a>
        </div>

        <div class="admin-topbar__center">
          <div class="hud-telemetry-badge">
            <span class="hud-pulse-dot"></span>
            <span>سرور لایو • اتصال D1 پایدار</span>
          </div>

          <div class="hud-clock-widget" id="liveClockWidget">
            <span id="liveClockTime">⏱ --:--:--</span>
          </div>
        </div>

        <div class="admin-topbar__actions">
          <div class="user-profile-badge">
            <div class="user-avatar-circle">
              {(auth.displayName || 'ادمین').slice(0, 1)}
            </div>
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <span class="user-name">{auth.displayName || auth.email}</span>
              <span class="badge-role-gold">SUPER ADMIN</span>
            </div>
          </div>

          <button type="button" class="btn-3d-logout" id="adminLogoutBtn" title="خروج از سامانه">
            <span>خروج</span>
            <span>⎋</span>
          </button>
        </div>
      </header>

      <!-- 3D Obsidian Sidebar -->
      <aside class="admin-sidebar" id="adminSidebar">
        <nav class="admin-sidebar__nav" aria-label="ناوبری پنل مدیریت">
          <ul class="admin-nav-list">
            {navGroups.map((group) => (
              <>
                <li class="admin-nav-grouphead" aria-hidden="true">{group.group}</li>
                {group.items.map((item) => (
                  <li class="admin-nav-item">
                    <a
                      href={item.href}
                      class={`admin-nav-link ${activeNav === item.id ? 'active' : ''}`}
                      aria-current={activeNav === item.id ? 'page' : undefined}
                    >
                      <span class="nav-icon">
                        <Icon name={item.icon} size={18} />
                      </span>
                      <span class="nav-label">{item.label}</span>
                      {item.id === 'plugins' && <span class="nav-badge-new">جدید</span>}
                    </a>
                  </li>
                ))}
              </>
            ))}
          </ul>
        </nav>

        <div class="admin-sidebar__footer">
          <a href="/" target="_blank" class="view-website-link">
            <span><Icon name="globe" size={15} aria-hidden /> مشاهده وب‌سایت اصلی <Icon name="arrowUpRight" size={13} aria-hidden /></span>
          </a>
          <div class="version-tag">نسخه ۳.۲.۰ — Cloudflare Edge Native</div>
        </div>
      </aside>

      <!-- Mobile sidebar backdrop -->
      <div class="admin-sidebar-overlay" id="adminSidebarOverlay" hidden></div>

      <!-- Main Content Area -->
      <main class="admin-main">
        <slot />
      </main>
    </div>

    <!-- Script for Clock & Logout -->
    <script>
      // Mobile sidebar drawer
      const menuBtn = document.getElementById('adminMenuBtn');
      const sidebar = document.getElementById('adminSidebar');
      const overlay = document.getElementById('adminSidebarOverlay');

      function setMenu(open: boolean) {
        document.body.classList.toggle('sidebar-open', open);
        if (menuBtn) menuBtn.setAttribute('aria-expanded', String(open));
        if (overlay) overlay.hidden = !open;
      }

      menuBtn?.addEventListener('click', () => {
        setMenu(!document.body.classList.contains('sidebar-open'));
      });
      overlay?.addEventListener('click', () => setMenu(false));
      sidebar?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });

      // Live Tehran Time Clock
      function updateLiveClock() {
        const clockEl = document.getElementById('liveClockTime');
        if (!clockEl) return;
        try {
          const now = new Date();
          const timeStr = now.toLocaleTimeString('fa-IR', {
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            timeZone: 'Asia/Tehran',
          });
          clockEl.innerText = `⏱ ${timeStr}`;
        } catch {
          // fallback
        }
      }
      setInterval(updateLiveClock, 1000);
      updateLiveClock();

      // Logout handler
      const logoutBtn = document.getElementById('adminLogoutBtn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          try {
            await fetch('/api/v1/auth/logout', { method: 'POST' });
            window.location.href = '/admin/login';
          } catch {
            window.location.href = '/admin/login';
          }
        });
      }
    </script>
  </body>
</html>